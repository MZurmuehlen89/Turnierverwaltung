<Project Sdk="Microsoft.NET.Sdk">

  <!-- #49: einmaliger Umzug des Bestands von SQL Server nach PostgreSQL. Nicht Teil der Solution und nicht von
       Dependabot erfasst (tools/), weil es nur einmal je Installation läuft. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Infrastructure\Fussballturnierverwaltung.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Hebt das transitive Pkcs 9.0.11 aus SqlClient über GHSA-846f-f764-76mx und GHSA-2fmv-rv2c-59x7 (wie früher in der
         Infrastruktur, #493) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
