<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (TestContext.Current.CancellationToken durchreichen) ist abgeschaltet: die Tests laufen gegen
         die InMemory-Datenbank in Sekunden, ein schnellerer Abbruch einzelner Tests bringt keinen Nutzen (#493) -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.14" />
    <!-- Code Coverage unter MTP (coverlet läuft dort nicht), Aufruf siehe tests/…/CLAUDE.md (#497) -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Microsoft.NET.Test.Sdk und xunit.runner.visualstudio laut xunit-Doku vorerst behalten: sie halten den
         VSTest-Weg für ältere Test-Explorer offen (#497) -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Architekturtests unter Architektur/ (#540): schlanker als ArchUnitNET, prüft Abhängigkeiten per Namespace -->
    <PackageReference Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <!-- Läuft auf der Microsoft Testing Platform, Runner repo-weit über global.json festgelegt (#497) -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Domain\Fussballturnierverwaltung.Domain.csproj" />
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Application\Fussballturnierverwaltung.Application.csproj" />
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Infrastructure\Fussballturnierverwaltung.Infrastructure.csproj" />
  </ItemGroup>

</Project>