<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (TestContext.Current.CancellationToken durchreichen) ist abgeschaltet: die Tests laufen gegen
         die InMemory-Datenbank in Sekunden, ein schnellerer Abbruch einzelner Tests bringt keinen Nutzen (#493) -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Variante ohne Microsoft Testing Platform: hält "dotnet test" und coverlet auf dem bisherigen VSTest-Weg,
         den xunit.v3 4.x mit dem .NET-10-SDK sonst ablehnt (#493) -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Domain\Fussballturnierverwaltung.Domain.csproj" />
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Application\Fussballturnierverwaltung.Application.csproj" />
    <ProjectReference Include="..\..\src\Fussballturnierverwaltung.Infrastructure\Fussballturnierverwaltung.Infrastructure.csproj" />
  </ItemGroup>

</Project>