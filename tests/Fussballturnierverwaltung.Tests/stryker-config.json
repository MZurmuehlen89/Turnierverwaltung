{
  "stryker-config": {
    "project": "Fussballturnierverwaltung.Application.csproj",
    "test-runner": "mtp",
    "mutate": [
      "**/Auslosungen/**/*.cs",
      "**/Spielplan/**/*.cs",
      "**/Tabelle/**/*.cs",
      "**/Simulation/**/*.cs",
      "!**/*Service.cs"
    ],
    "additional-timeout": 120000,
    "ignore-methods": [
      "LogInformation", "LogWarning", "LogError", "LogDebug", "LogTrace", "Vorgang",
      "*Exception.ctor"
    ],
    "reporters":[ "html", "json", "progress" ],
    "thresholds": { "high": 80, "low": 60, "break": 0 }
  }
}
