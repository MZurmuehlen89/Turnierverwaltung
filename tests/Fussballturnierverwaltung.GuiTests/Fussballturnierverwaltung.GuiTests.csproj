<Project Sdk="Microsoft.NET.Sdk">

  <!-- GUI-Tests der Turnierverwaltung (#494, #521): steuern die echte App per UI Automation. Sie übernehmen Maus
       und Fenster und brauchen eine eigens gebaute, ungepackte Testvariante der App – Aufruf deshalb nur über
       build/GuiTests-Ausfuehren.ps1, nicht im normalen "dotnet test" (siehe tests/…/CLAUDE.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- Wie in der Infrastruktur (#493): hebt das transitive Pkcs 9.0.11 aus SqlClient über die Sicherheitslücken
         GHSA-846f-f764-76mx und GHSA-2fmv-rv2c-59x7. Entfernen, sobald SqlClient selbst eine gepatchte Version mitbringt -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuiTest.Framework\GuiTest.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
