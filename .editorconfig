# EditorConfig für Turnierverwaltung.
# Kodifiziert den bereits im Code gelebten Stil — siehe CLAUDE.md ("Naming Conventions" /
# "Formatting Conventions") für die menschenlesbare Zusammenfassung. Bindend für neuen/angefassten
# Code, keine rückwirkende Reformatierung von unangefasstem Bestandscode (Issue #142/#143).
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# Namespaces: file-scoped
csharp_style_namespace_declarations = file_scoped:suggestion

# Klammern: Allman-Stil (öffnende Klammer auf eigener Zeile); einzeilige if/for/foreach-Bodies
# dürfen ohne Klammern bleiben, mehrzeilige verlangen sie.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion

# using-Direktiven: ein flacher Block, rein alphabetisch (kein separates System.*-Grouping)
dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false

# var wird durchgängig bevorzugt
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# ── Naming: _camelCase (private/static Felder), camelCase (Locals/Parameter),
#    ALL_UPPER (Konstanten), PascalCase (alles andere) ──────────────────────────

dotnet_naming_style.camel_case_underscore_style.capitalization = camel_case
dotnet_naming_style.camel_case_underscore_style.required_prefix = _

dotnet_naming_style.camel_case_style.capitalization = camel_case

dotnet_naming_style.all_upper_style.capitalization = all_upper
dotnet_naming_style.all_upper_style.word_separator = _

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_symbols.constants_symbols.applicable_kinds = field, local
dotnet_naming_symbols.constants_symbols.applicable_accessibilities = *
dotnet_naming_symbols.constants_symbols.required_modifiers = const

dotnet_naming_symbols.private_fields_symbols.applicable_kinds = field
dotnet_naming_symbols.private_fields_symbols.applicable_accessibilities = private

dotnet_naming_symbols.locals_symbols.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_symbols.applicable_accessibilities = *

dotnet_naming_symbols.everything_else_symbols.applicable_kinds = class, struct, interface, enum, property, method, event, delegate, type_parameter, local_function
dotnet_naming_symbols.everything_else_symbols.applicable_accessibilities = *

# Reihenfolge ist bindend (erste Regel gewinnt) — Konstanten vor Feldern/Locals prüfen,
# sonst würde eine private const-Feld-Regel schon von der allgemeinen Feld-Regel gegriffen.
dotnet_naming_rule.constants_rule.symbols = constants_symbols
dotnet_naming_rule.constants_rule.style = all_upper_style
dotnet_naming_rule.constants_rule.severity = suggestion

dotnet_naming_rule.private_fields_rule.symbols = private_fields_symbols
dotnet_naming_rule.private_fields_rule.style = camel_case_underscore_style
dotnet_naming_rule.private_fields_rule.severity = suggestion

dotnet_naming_rule.locals_rule.symbols = locals_symbols
dotnet_naming_rule.locals_rule.style = camel_case_style
dotnet_naming_rule.locals_rule.severity = suggestion

dotnet_naming_rule.everything_else_rule.symbols = everything_else_symbols
dotnet_naming_rule.everything_else_rule.style = pascal_case_style
dotnet_naming_rule.everything_else_rule.severity = suggestion

[*.{xaml,xml,resx}]
indent_style = space
indent_size = 4

[*.{csproj,json}]
indent_style = space
indent_size = 2
