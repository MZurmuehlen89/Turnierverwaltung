<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Zentrale CornerRadius-Stufen (Issue #190). Nur die drei durchgängig verwendeten Werte — vereinzelte
         Sonderwerte (z.B. richtungsabhängige Radien wie "4,4,0,0" oder Ausreißer wie 3/10) bleiben bewusst
         als Literal in der jeweiligen View, um keine ungeprüften visuellen Änderungen einzuführen. -->
    <CornerRadius x:Key="Radius4">4</CornerRadius>
    <CornerRadius x:Key="Radius6">6</CornerRadius>
    <CornerRadius x:Key="Radius8">8</CornerRadius>

</ResourceDictionary>
