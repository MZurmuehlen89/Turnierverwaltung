<Application x:Class="Fussballturnierverwaltung.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Fluent;component/Themes/Generic.xaml" />
                <!-- Dark Theme (Issue #3/#257): MaterialDesignInXaml liefert Default-Styles für alle
                     Standard-Controls (Button/ComboBox/TextBox/DataGrid/...), erprobt im isolierten
                     Mannschaften-Prototyp. Nach Fluent.Ribbon gemerged, damit Ribbon-eigene Typen
                     (RibbonButton etc.) unangetastet bleiben; MaterialDesign deckt nur, was Fluent
                     nicht selbst stylt (also plain Button/ComboBox/TextBox in unseren eigenen Views). -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Metrics.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:UmgekehrterBoolZuSichtbarkeitsConverter x:Key="InverseBoolToVisibility" />
            <conv:NullZuGeklapptConverter x:Key="NullToCollapsed" />
            <conv:NullZuSichtbarConverter x:Key="NullToVisible" />
            <conv:BildDatenZuBildquelleConverter x:Key="BildDatenZuBildquelle" />
            <conv:MannschaftZuWappenBildquelleConverter x:Key="MannschaftZuWappenBildquelle" />
            <conv:MannschaftHatWappenConverter x:Key="MannschaftHatWappen" />
            <conv:MannschaftHatKeinWappenConverter x:Key="MannschaftHatKeinWappen" />
            <conv:VerfahrenArtZuTextConverter x:Key="VerfahrenArtZuText" />
            <conv:VorlagenKategorieZuTextConverter x:Key="VorlagenKategorieZuText" />
            <conv:RundenartZuTextConverter x:Key="RundenartZuText" />
            <conv:TurnierStatusZuTextConverter x:Key="TurnierStatusZuText" />
            <conv:SpielStatusZuTextConverter x:Key="SpielStatusZuText" />
            <conv:SpielStatusZuFarbeConverter x:Key="SpielStatusZuFarbe" />
            <conv:EntscheidungArtZuTextConverter x:Key="EntscheidungArtZuText" />
            <conv:QualifikationsstatusZuFarbeConverter x:Key="QualifikationsstatusZuFarbe" />
            <conv:SpieltagOptionZuTextConverter x:Key="SpieltagOptionZuText" />
            <conv:BoolZuAngepinnterSpaltenbreiteConverter x:Key="BoolZuAngepinnterSpaltenbreite" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
