<Window x:Class="Fussballturnierverwaltung.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="urn:fluent-ribbon"
        xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
        xmlns:views="clr-namespace:Fussballturnierverwaltung.Wpf.Views"
        Title="Fussballturnierverwaltung"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlatzhalterViewModel}">
            <views:PlatzhalterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MannschaftenViewModel}">
            <views:MannschaftenView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LandUndVerbandViewModel}">
            <views:LandUndVerbandView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegelwerkViewModel}">
            <views:RegelwerkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RanglisteViewModel}">
            <views:RanglisteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TurnierVorlageViewModel}">
            <views:TurnierVorlageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TurnierInstanzViewModel}">
            <views:TurnierInstanzView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuslosungViewModel}">
            <views:AuslosungView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TurnierBereichViewModel}">
            <views:TurnierBereichView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpielplanViewModel}">
            <views:SpielplanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TurnierBaumViewModel}">
            <views:TurnierBaumView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimulationsViewModel}">
            <views:SimulationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RundenEditorViewModel}">
            <views:RundenEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AufstiegsregelViewModel}">
            <views:AufstiegsregelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VerbandsQuoteViewModel}">
            <views:VerbandsQuoteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TurnierEditorViewModel}">
            <views:TurnierEditorView />
        </DataTemplate>

        <!-- Für den Ribbon-DropDownButton "Auslosungs-Regeln" (Issue #162) — implizit, kein x:Key
             nötig, da RegelViewModel ausschließlich dort verwendet wird. -->
        <DataTemplate DataType="{x:Type vm:RegelViewModel}">
            <Border Margin="0,3" Padding="8,7" CornerRadius="4" Width="660"
                    BorderThickness="1" BorderBrush="#E2E8F0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IstRedundant}" Value="True">
                                <Setter Property="Background" Value="#F8FAFC" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <CheckBox IsChecked="{Binding IstAktiv, Mode=TwoWay}"
                              FontSize="13" FontWeight="SemiBold">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IstRedundant}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <TextBlock Text="{Binding Anzeige}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1E293B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IstRedundant}" Value="True">
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox>
                    <TextBlock Text="{Binding Beschreibung}"
                               FontSize="11" Foreground="#64748B"
                               TextWrapping="Wrap" Margin="20,3,0,0" />
                    <TextBlock Text="{Binding RedundanzHinweis}"
                               FontSize="11" Foreground="#F59E0B"
                               FontStyle="Italic"
                               TextWrapping="Wrap" Margin="20,3,0,0"
                               Visibility="{Binding IstRedundant, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="4,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ── Ribbon ─────────────────────────────────────────── -->
        <fluent:Ribbon DockPanel.Dock="Top"
                       AutomaticStateManagement="False"
                       IsQuickAccessToolBarVisible="False">

            <!-- Dauerhafter Tab — immer sichtbar -->
            <fluent:RibbonTabItem x:Name="StartTab" Header="Start">
                <fluent:RibbonGroupBox Header="Anwendung">
                    <fluent:Button Header="Beenden"
                                   SizeDefinition="Middle"
                                   Click="BeendenButton_Click">
                        <fluent:Button.Icon>
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </fluent:Button.Icon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>
            </fluent:RibbonTabItem>

            <!-- Seitenspezifischer Tab — nur wenn ein Editor aktiv ist -->
            <fluent:RibbonTabItem x:Name="SeitenTab"
                                  Header="{Binding RibbonTabTitel}"
                                  Visibility="{Binding HatRibbonBereich, Converter={StaticResource BoolToVisibility}}">

                <fluent:RibbonGroupBox Header="Datensatz"
                                       Visibility="{Binding HatStandardAktionen, Converter={StaticResource BoolToVisibility}}">
                    <fluent:Button Header="Neu"
                                   Command="{Binding RibbonNeuBefehl}"
                                   SizeDefinition="Large">
                        <fluent:Button.LargeIcon>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="32" />
                        </fluent:Button.LargeIcon>
                        <fluent:Button.Icon>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </fluent:Button.Icon>
                    </fluent:Button>
                    <fluent:Button Header="Speichern"
                                   Command="{Binding RibbonSpeichernBefehl}"
                                   SizeDefinition="Large">
                        <fluent:Button.LargeIcon>
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="32" />
                        </fluent:Button.LargeIcon>
                        <fluent:Button.Icon>
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </fluent:Button.Icon>
                    </fluent:Button>
                    <fluent:Button Header="Abbrechen"
                                   Command="{Binding RibbonAbbrechenBefehl}"
                                   SizeDefinition="Large">
                        <fluent:Button.LargeIcon>
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="32" />
                        </fluent:Button.LargeIcon>
                        <fluent:Button.Icon>
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </fluent:Button.Icon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>

                <fluent:RibbonGroupBox Header="Bearbeiten"
                                       Visibility="{Binding HatStandardAktionen, Converter={StaticResource BoolToVisibility}}">
                    <fluent:Button Header="Löschen"
                                   Command="{Binding RibbonLoeschenBefehl}"
                                   SizeDefinition="Large">
                        <fluent:Button.LargeIcon>
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="32" />
                        </fluent:Button.LargeIcon>
                        <fluent:Button.Icon>
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        </fluent:Button.Icon>
                    </fluent:Button>
                </fluent:RibbonGroupBox>

            </fluent:RibbonTabItem>
        </fluent:Ribbon>

        <!-- ── Hauptbereich ───────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="#1E293B">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,20,16,16"
                            BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="⚽" FontSize="22" />
                            <TextBlock Text="Turnierverwaltung"
                                       Foreground="White" FontSize="14" FontWeight="Bold"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding NavigationsGruppen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Titel}"
                                                   Foreground="#64748B" FontSize="11"
                                                   FontWeight="SemiBold" Margin="16,16,8,4" />
                                        <ItemsControl ItemsSource="{Binding Eintraege}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Titel}"
                                                            Command="{Binding Befehl}"
                                                            Style="{StaticResource NavButtonStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#334155" />

            <!-- Inhaltsbereich -->
            <ContentControl Grid.Column="1" Content="{Binding AktuellesViewModel}" />
        </Grid>
    </DockPanel>
</Window>
