<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.ImportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource MaterialDesign.Brush.Background}">
        <StackPanel MaxWidth="680" Margin="32,28" HorizontalAlignment="Left"
                    TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

            <!-- Seitentitel -->
            <TextBlock Text="Import / Export" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
            <TextBlock FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,28"
                       TextWrapping="Wrap">
                Mannschaften und Turnierdaten importieren oder exportieren.
                Ribbon: <Run FontWeight="SemiBold">Neu</Run> = Import,
                <Run FontWeight="SemiBold">Speichern</Run> = Mannschaften-Export.
            </TextBlock>

            <!-- Lade-Indikator -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Verarbeite…" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" FontSize="13" />
            </Border>

            <!-- Fehlermeldung -->
            <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Import-Detail (Fehler-Zeilen) -->
            <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding ImportDetail, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ImportDetail}" Foreground="#92400E"
                           FontSize="12" TextWrapping="Wrap" FontFamily="Consolas" />
            </Border>

            <!-- Statusmeldung -->
            <Border Background="{StaticResource SuccessSoftBrush}" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,20"
                    Visibility="{Binding StatusMeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding StatusMeldung}" Foreground="{StaticResource SuccessBrush}"
                           FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- ── Karte: Import ── -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius6}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="IMPORT" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <TextBlock Grid.Column="0" Text="&#xE896;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Mannschaften importieren (CSV)"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextWrapping="Wrap"
                                       Margin="0,0,0,10">
                                CSV-Datei mit Mannschaftsdaten einlesen
                                (Name;Kurzname;Mannschaftsart;LandFifaCode;Ratings…).
                                Entspricht dem Ribbon-Befehl <Run FontWeight="SemiBold">Neu</Run>.
                            </TextBlock>
                            <Button Content="Datei auswählen und importieren…"
                                    Command="{Binding NeuBefehl}"
                                    HorizontalAlignment="Left" Padding="12,6" FontSize="13"
                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Karte: Export Stammdaten ── -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius6}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="EXPORT — STAMMDATEN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE898;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="28"
                                   Foreground="#10B981" VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Mannschaften exportieren (CSV)"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextWrapping="Wrap"
                                       Margin="0,0,0,10">
                                Alle Mannschaften inkl. Ratings als CSV-Datei speichern.
                                Entspricht dem Ribbon-Befehl <Run FontWeight="SemiBold">Speichern</Run>.
                            </TextBlock>
                            <Button Content="Speicherort wählen und exportieren…"
                                    Command="{Binding SpeichernBefehl}"
                                    HorizontalAlignment="Left" Padding="12,6" FontSize="13"
                                    Background="#10B981" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Karte: Export Turnierdaten ── -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius6}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="EXPORT — TURNIERDATEN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <!-- Turnier-Auswahl -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Turnier auswählen:" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Instanzen}"
                                  SelectedItem="{Binding AusgewaehlteInstanz}"
                                  DisplayMemberPath="Name"
                                  MaxWidth="360" HorizontalAlignment="Left"
                                  FontSize="13" />
                    </StackPanel>

                    <!-- Export-Buttons nebeneinander -->
                    <StackPanel Orientation="Horizontal">

                        <!-- Spielplan CSV -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}" Padding="16,12" Margin="0,0,12,0" Width="210">
                            <StackPanel>
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Spielplan (CSV)" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Alle Spiele mit Ergebnissen"
                                           FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                           TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button Content="Exportieren…"
                                        Command="{Binding SpielplanExportierenBefehl}"
                                        HorizontalAlignment="Left" Padding="10,5" FontSize="12"
                                        Background="{StaticResource WarningBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Turnier JSON -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}" Padding="16,12" Width="210">
                            <StackPanel>
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#8B5CF6"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Turnierdaten (JSON)" FontSize="13"
                                           FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Vollständige Turnierdaten mit Runden"
                                           FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                           TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button Content="Exportieren…"
                                        Command="{Binding TurnierJsonExportierenBefehl}"
                                        HorizontalAlignment="Left" Padding="10,5" FontSize="12"
                                        Background="#8B5CF6" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
