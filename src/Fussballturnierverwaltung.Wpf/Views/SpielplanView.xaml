<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.SpielplanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             xmlns:tabelle="clr-namespace:Fussballturnierverwaltung.Application.Tabelle;assembly=Fussballturnierverwaltung.Application"
             xmlns:enums="clr-namespace:Fussballturnierverwaltung.Domain.Enums;assembly=Fussballturnierverwaltung.Domain">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Runden ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <!-- Runden -->
            <TextBlock DockPanel.Dock="Top" Text="RUNDEN"
                       FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                       Margin="12,10,8,4" />

            <!-- Ranking-Kriterien (unter der Rundenliste) -->
            <Border DockPanel.Dock="Bottom"
                    Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    Padding="12,8"
                    Visibility="{Binding HatRankingKriterien, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="RANKING-KRITERIEN" FontSize="10" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding RankingRegelSetName}"
                               FontSize="11" FontWeight="SemiBold" Foreground="#475569"
                               Margin="0,0,0,4"
                               Visibility="{Binding RankingRegelSetName, Converter={StaticResource NullToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding RankingKriterien}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#64748B"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Runden}"
                     SelectedItem="{Binding AusgewaehlteRunde}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Rechter Bereich: Spielliste + Formular ── -->
        <DockPanel Grid.Column="2">

            <!-- Ergebnis-Formular (rechts angedockt, nur wenn FormAktiv) -->
            <Border DockPanel.Dock="Right" Width="4" Background="#E2E8F0"
                    Visibility="{Binding FormAktiv, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer DockPanel.Dock="Right" Width="310"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding FormAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,14">

                    <!-- Spiel-Kopfzeile -->
                    <TextBlock Text="{Binding FormSpielInfo}"
                               FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                               Margin="0,0,0,8" />

                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="#1E293B"
                               Margin="0,0,0,16" TextWrapping="Wrap">
                        <Run Text="{Binding FormHeimName}" />
                        <Run Text=" vs. " Foreground="#94A3B8" />
                        <Run Text="{Binding FormAuswaertsName}" />
                    </TextBlock>

                    <!-- Fehlermeldung -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Reguläre Zeit -->
                    <TextBlock Text="REGULÄRE SPIELZEIT" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding FormHeimName}" FontSize="11"
                                       Foreground="#475569" Margin="0,0,0,3"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding HeimToreRegulaer, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text=":" FontSize="20" FontWeight="Bold"
                                   Foreground="#94A3B8" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding FormAuswaertsName}" FontSize="11"
                                       Foreground="#475569" Margin="0,0,0,3"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding AuswaertsToreRegulaer, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Verlängerung -->
                    <StackPanel Visibility="{Binding VerlaengerungAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNIS NACH VERLÄNGERUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding HeimToreVerlaengerung, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                                       Foreground="#94A3B8" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding AuswaertsToreVerlaengerung, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                        </Grid>
                    </StackPanel>

                    <!-- Elfmeterschießen -->
                    <StackPanel Visibility="{Binding ElfmeterAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ELFMETER" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding HeimElfmetertore, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                                       Foreground="#94A3B8" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding AuswaertsElfmetertore, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                        </Grid>
                    </StackPanel>

                    <!-- Spiel simulieren -->
                    <Button Command="{Binding SpielSimulierenBefehl}"
                            Margin="0,0,0,6" Padding="0,8" FontSize="12" Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Background="#8B5CF6" Foreground="White" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#8B5CF6" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Spiel simulieren
                    </Button>

                    <!-- Ausführliche Simulation (→ Simulations-Bereich) -->
                    <Button Command="{Binding AusfuehrlichSimulierenBefehl}"
                            Margin="0,0,0,12" Padding="0,7" FontSize="11" Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            BorderBrush="#8B5CF6" BorderThickness="1">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White" />
                                <Setter Property="Foreground" Value="#8B5CF6" />
                                <Setter Property="BorderBrush" Value="#8B5CF6" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        Ausführliche Simulation →
                    </Button>

                    <!-- Hinweis: Simulieren erst nach Zurücksetzen des bestehenden Ergebnisses möglich -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding FormHatErgebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Dieses Spiel hat bereits ein Ergebnis. Zum Neu-Simulieren zuerst über 'Löschen' zurücksetzen."
                                   Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Spielplan-Tabelle ── -->
            <Grid>
                <!-- Kein Turnier / Runde gewählt -->
                <TextBlock Text="Bitte ein Turnier und eine Runde auswählen."
                           Foreground="#94A3B8" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HatRunde, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- Spielliste -->
                <DockPanel Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}">

                    <!-- Header mit Ansicht-Umschalter -->
                    <Border DockPanel.Dock="Top" Background="White"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel>
                            <!-- Simulations-Aktionen (rechts, vor Ansicht-Toggle) -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,0,8,0">
                                <ComboBox ItemsSource="{Binding SimulationsModusOptionen}"
                                          SelectedItem="{Binding AusgewaehlterSimulationsModus}"
                                          DisplayMemberPath="Anzeige"
                                          FontSize="11" Width="160" VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                <Button Command="{Binding RundeSimulierenBefehl}"
                                        Padding="10,4" FontSize="11" Cursor="Hand"
                                        Background="#8B5CF6" Foreground="White"
                                        BorderThickness="0" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#8B5CF6" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    Runde simulieren
                                </Button>
                                <Button Command="{Binding RundeZuruecksetzenBefehl}"
                                        Padding="10,4" FontSize="11" Cursor="Hand"
                                        Background="White" Foreground="#DC2626"
                                        BorderBrush="#FCA5A5" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="6,0,0,0"
                                        ToolTip="Alle Ergebnisse dieser Runde zurücksetzen">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    Runde zurücksetzen
                                </Button>
                                <Button Command="{Binding MehrfachZuruecksetzenBefehl}"
                                        Padding="10,4" FontSize="11" Cursor="Hand"
                                        Background="White" Foreground="#DC2626"
                                        BorderBrush="#FCA5A5" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="6,0,0,0"
                                        ToolTip="Ausgewählte Ergebnisse zurücksetzen (Strg+Klick/Umschalt+Klick zum Mehrfachauswählen)">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock>
                                        <Run Text="Auswahl (" />
                                        <Run Text="{Binding AnzahlMehrfachZuruecksetzbar, Mode=OneWay}" />
                                        <Run Text=") zurücksetzen" />
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- Spielplan (neu) generieren -->
                            <Button DockPanel.Dock="Right"
                                    Content="Spielplan generieren"
                                    Command="{Binding NeuBefehl}"
                                    Padding="10,4" FontSize="11" Cursor="Hand"
                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                    BorderBrush="#3B82F6" BorderThickness="1">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="#3B82F6" />
                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="#94A3B8">
                                <Run Text="SPIELE · " />
                                <Run Text="{Binding AusgewaehlteRunde.Name}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Spiele.Count, Mode=OneWay}" />
                                <Run Text=" Spiel(e)" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Fehlermeldung bei Spielplan-Generierung -->
                    <Border DockPanel.Dock="Top"
                            Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="12,8,12,0"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Platzhalter-Banner -->
                    <Border DockPanel.Dock="Top"
                            Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1"
                            Padding="12,8"
                            Visibility="{Binding HatPlatzhalterSpiele, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="Platzhalter aktualisieren"
                                    Command="{Binding PlatzhalterBefehl}"
                                    Padding="12,5" FontSize="12"
                                    Background="#3B82F6" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" />
                            <TextBlock Text="Dieser Spielplan enthält Platzhalter. Sobald die Vorrunden-Ergebnisse vorliegen, können die Teams hier aufgelöst werden."
                                       Foreground="#1D4ED8" FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>

                    <!-- Haupt-Inhaltsbereich: Spielplan ODER auf eine Gruppe gefilterte Spielliste -->
                    <Grid>

                        <!-- ── Spielplan-Ansicht ── -->
                        <ListView x:Name="SpielListView"
                                  ItemsSource="{Binding Spiele}"
                                  SelectedItem="{Binding AusgewaehlteSpiel}"
                                  SelectionMode="Extended"
                                  SelectionChanged="SpielListView_SelectionChanged"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IstGefiltertAufGruppe, Converter={StaticResource InverseBoolToVisibility}}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ST" Width="44">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding SpieltagAnzeige}"
                                                           FontSize="12" Foreground="#64748B"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Nr" Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding Spielnummer}"
                                                           FontSize="12" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Gr." Width="38">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding GruppeAnzeige}"
                                                           FontSize="11" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Heim" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding HeimName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Ergebnis" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ErgebnisText}"
                                                               FontSize="14" FontWeight="Bold"
                                                               FontFamily="Consolas">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                                                        <Setter Property="Foreground" Value="#1E293B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ErgebnisDetail}"
                                                               FontSize="10" Foreground="#94A3B8"
                                                               Margin="4,3,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Auswärts" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding AuswaertsName}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Status" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <Border CornerRadius="10" Padding="6,2"
                                                        Background="{Binding Status,
                                                            Converter={StaticResource SpielStatusZuFarbe}}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status,
                                                                   Converter={StaticResource SpielStatusZuText}}"
                                                               FontSize="11" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,4" />
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Ausgewählte Ergebnisse zurücksetzen"
                                                          Command="{Binding PlacementTarget.Tag.MehrfachZuruecksetzenBefehl,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                            <Setter Property="Foreground" Value="#1E40AF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- ── Auf Gruppe gefilterte Spielliste ── -->
                        <DockPanel Visibility="{Binding IstGefiltertAufGruppe, Converter={StaticResource BoolToVisibility}}">

                            <!-- Toolbar: Filter aufheben + Gruppenname + Spieltag-Navigation -->
                            <Border DockPanel.Dock="Top" Background="White"
                                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel>
                                    <!-- Spieltag-Navigation (rechts, nur bei mehreren Spieltagen) -->
                                    <Border DockPanel.Dock="Right"
                                            CornerRadius="6" Background="#F1F5F9" Padding="2"
                                            Visibility="{Binding HatMehrereSpieltage, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding FokusAlleSpieltageBefehl}"
                                                    Padding="8,3" Cursor="Hand" FontSize="11">
                                                <Button.Content>Alle</Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FokusAlleAktiv}" Value="True">
                                                                <Setter Property="Background" Value="White" />
                                                                <Setter Property="Foreground" Value="#1E40AF" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Command="{Binding FokusVorigerSpieltag}"
                                                    Content="&lt;" Padding="6,3" Cursor="Hand" FontSize="12"
                                                    BorderThickness="0" Background="Transparent" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FokusSpieltagnummer}"
                                                       FontSize="11" Foreground="#475569"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                            <Button Command="{Binding FokusNaechsterSpieltag}"
                                                    Content="&gt;" Padding="6,3" Cursor="Hand" FontSize="12"
                                                    BorderThickness="0" Background="Transparent" Foreground="#64748B" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Filter aufheben-Button + Gruppenname + Simulations-Buttons -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding ZurueckZurUebersichtBefehl}"
                                                Padding="8,4" FontSize="11" Cursor="Hand"
                                                Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                                                Foreground="#475569" Margin="0,0,12,0"
                                                ToolTip="Gruppenfilter aufheben, alle Spiele der Runde anzeigen">
                                            ✕ Filter aufheben
                                        </Button>
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#1E293B"
                                                   VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Run Text="Gruppe " />
                                            <Run Text="{Binding AusgewaehlteGruppe.GruppenNummer}" />
                                        </TextBlock>
                                        <!-- Spieltag simulieren (nur bei spezifischem Spieltag) -->
                                        <Button Command="{Binding SpieltagSimulierenBefehl}"
                                                Padding="8,4" FontSize="11" Cursor="Hand"
                                                BorderThickness="0" Margin="0,0,6,0"
                                                Visibility="{Binding FokusAlleAktiv, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock>
                                                <Run Text="Spieltag " />
                                                <Run Text="{Binding FokusAktiverSpieltag}" />
                                                <Run Text=" simulieren" />
                                            </TextBlock>
                                        </Button>
                                        <!-- Spieltag zurücksetzen (nur bei spezifischem Spieltag) -->
                                        <Button Command="{Binding SpieltagZuruecksetzenBefehl}"
                                                Padding="8,4" FontSize="11" Cursor="Hand"
                                                Background="White" Foreground="#DC2626"
                                                BorderBrush="#FCA5A5" BorderThickness="1"
                                                Margin="0,0,12,0"
                                                Visibility="{Binding FokusAlleAktiv, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock>
                                                <Run Text="Spieltag " />
                                                <Run Text="{Binding FokusAktiverSpieltag}" />
                                                <Run Text=" zurücksetzen" />
                                            </TextBlock>
                                        </Button>
                                        <!-- Gruppe simulieren -->
                                        <Button Command="{Binding GruppeSimulierenBefehl}"
                                                Padding="8,4" FontSize="11" Cursor="Hand"
                                                BorderThickness="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#8B5CF6" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            Gruppe simulieren
                                        </Button>
                                        <!-- Gruppe zurücksetzen -->
                                        <Button Command="{Binding GruppeZuruecksetzenBefehl}"
                                                Padding="8,4" FontSize="11" Cursor="Hand"
                                                Background="White" Foreground="#DC2626"
                                                BorderBrush="#FCA5A5" BorderThickness="1"
                                                Margin="6,0,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            Gruppe zurücksetzen
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Spielliste der fokussierten Gruppe -->
                            <TextBlock DockPanel.Dock="Top"
                                       Text="SPIELE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"
                                       Margin="12,10,8,4" />
                            <ListView x:Name="FokusSpielListView"
                                      ItemsSource="{Binding FokusSpiele}"
                                      SelectedItem="{Binding AusgewaehlteSpiel}"
                                      SelectionMode="Extended"
                                      SelectionChanged="SpielListView_SelectionChanged"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ST" Width="44">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <TextBlock Text="{Binding SpieltagAnzeige}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Nr" Width="36">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <TextBlock Text="{Binding Spielnummer}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Heim" Width="160">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <TextBlock Text="{Binding HeimName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Ergebnis" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ErgebnisText}"
                                                                   FontSize="14" FontWeight="Bold" FontFamily="Consolas">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                                                            <Setter Property="Foreground" Value="#1E293B" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ErgebnisDetail}" FontSize="10" Foreground="#94A3B8" Margin="4,3,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Auswärts" Width="160">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <TextBlock Text="{Binding AuswaertsName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Status" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <Border CornerRadius="10" Padding="6,2"
                                                            Background="{Binding Status, Converter={StaticResource SpielStatusZuFarbe}}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource SpielStatusZuText}}"
                                                                   FontSize="11" Foreground="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,4" />
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Ausgewählte Ergebnisse zurücksetzen"
                                                              Command="{Binding PlacementTarget.Tag.MehrfachZuruecksetzenBefehl,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF" />
                                                <Setter Property="Foreground" Value="#1E40AF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>

                        </DockPanel>

                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>

    </Grid>
</UserControl>
