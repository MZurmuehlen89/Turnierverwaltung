<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.SpielplanView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             xmlns:tabelle="clr-namespace:Fussballturnierverwaltung.Application.Tabelle;assembly=Fussballturnierverwaltung.Application"
             xmlns:enums="clr-namespace:Fussballturnierverwaltung.Domain.Enums;assembly=Fussballturnierverwaltung.Domain"
             xmlns:helpers="clr-namespace:Fussballturnierverwaltung.Wpf.Helpers">

    <!-- Issue #63: Ctrl+S speichert das aktive Ergebnis-Formular. ElementName-Binding statt
         {Binding SpeichernBefehl} direkt, da InputBindings nicht im Visual Tree liegen und daher
         nicht automatisch den geerbten DataContext sehen. -->
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding DataContext.SpeichernBefehl, ElementName=Root}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- Gedämpfter Zelltext (ST/Nr/Gr./Ergebnis-Detail) in den GridView-Spielzeilen: statt eines
             lokalen Foreground (bricht Vererbung vom ListViewItem-Foreground-Trigger, siehe Issue #264)
             bleibt Foreground geerbt und nur Opacity reduziert — folgt damit automatisch Hover/Selected
             der Zeile, ohne separaten Hover-Trigger. -->
        <Style x:Key="SpielplanGedaempfterZellText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.60" />
        </Style>

        <!-- Issue #191: GridView/GridViewColumnHeader haben kein MaterialDesign-Template (anders als
             Standard-Controls kann hier nichts geerbt werden) und fielen bisher auf das native
             Aero2-Template zurück — sichtbarer Stilbruch zum Card-Look. Eigener ControlTemplate von
             Grund auf, analog zu den bestehenden Card-Headern (Card.Background/Card.Border,
             BorderThickness 0,0,0,1, siehe z.B. die "SPIELE ·"-Kopfzeile weiter unten). -->
        <Style x:Key="SpielplanGridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border x:Name="HeaderBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter x:Name="HeaderContent"
                                                   Margin="{TemplateBinding Padding}"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="Center"
                                                   RecognizesAccessKey="True" />
                            </Border>
                            <!-- PART_HeaderGripper: GridViewColumnHeader verdrahtet die Spaltenbreiten-Anpassung
                                 selbst per TemplatePart-Namenskonvention, sobald ein Thumb mit diesem Namen im
                                 Template steckt — Resize-Verhalten bleibt damit ohne eigenen Code erhalten. -->
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="14"
                                   Margin="0,0,-7,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent" Padding="6,0">
                                            <Rectangle Width="1" Fill="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                            </Trigger>
                            <!-- Role=Padding: der von GridView automatisch angehängte Füll-Header am rechten
                                 Rand (füllt die Kopfzeile bis zum ScrollViewer-Rand) — kein Inhalt, kein Gripper. -->
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kontextmenü der GridView-Spielzeilen: der geteilte StandardGridViewItemStyle (Issue #270,
             Resources/RowItemStyles.xaml) deckt nur Farben/Struktur ab, dieses View-spezifische
             ContextMenu bleibt lokal und wird per BasedOn ergänzt. -->
        <Style x:Key="SpielplanGridViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource StandardGridViewItemStyle}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Ausgewählte Ergebnisse zurücksetzen"
                                  Command="{Binding PlacementTarget.Tag.LoeschenBefehl,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="{Binding PlacementTarget.Tag.AuswahlSimulierenMenuText,
                                                   RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding PlacementTarget.Tag.AuswahlSimulierenBefehl,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Runden ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <!-- Runden -->
            <TextBlock DockPanel.Dock="Top" Text="RUNDEN"
                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                       Margin="12,10,8,4" />

            <!-- Ranking-Kriterien (unter der Rundenliste) -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,1,0,0"
                    Padding="12,8"
                    Visibility="{Binding HatRankingKriterien, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="RANKING-KRITERIEN" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding RankingRegelSetName}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Margin="0,0,0,4"
                               Visibility="{Binding RankingRegelSetName, Converter={StaticResource NullToCollapsed}}" />
                    <ItemsControl ItemsSource="{Binding RankingKriterien}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Regelwerk-Kurzinfo für K.-o.-Runden (Issue #82): Ranking-Kriterien ergeben hier
                 keinen Sinn (keine Tabelle), stattdessen Verlängerungs-/Elfmeter-/Auswärtstorregel. -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,1,0,0"
                    Padding="12,8"
                    Visibility="{Binding HatRegelwerkInfo, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="REGELWERK" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,3" />
                    <ItemsControl ItemsSource="{Binding RegelwerkKurzinfo}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                           Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Runden}"
                     SelectedItem="{Binding AusgewaehlteRunde}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <StaticResource ResourceKey="StandardListBoxItemStyle" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechter Bereich: Spielliste + Formular ── -->
        <DockPanel Grid.Column="2">

            <!-- Ergebnis-Formular (rechts angedockt, nur wenn FormAktiv) -->
            <Border DockPanel.Dock="Right" Width="4" Background="{DynamicResource MaterialDesign.Brush.Card.Border}"
                    Visibility="{Binding FormAktiv, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer DockPanel.Dock="Right" Width="310"
                          VerticalScrollBarVisibility="Auto"
                          KeyDown="ErgebnisFormular_KeyDown"
                          Visibility="{Binding FormAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,14">

                    <!-- Spiel-Kopfzeile -->
                    <TextBlock Text="{Binding FormSpielInfo}"
                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                               Margin="0,0,0,8" />

                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Margin="0,0,0,16" TextWrapping="Wrap">
                        <Run Text="{Binding FormHeimName}" />
                        <Run Text=" vs. " Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                        <Run Text="{Binding FormAuswaertsName}" />
                    </TextBlock>

                    <!-- Fehlermeldung -->
                    <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Reguläre Zeit -->
                    <TextBlock Text="REGULÄRE SPIELZEIT" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding FormHeimName}" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="ErstesFormularFeld"
                                     Text="{Binding HeimToreRegulaer, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                     Padding="8,6" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text=":" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding FormAuswaertsName}" FontSize="11"
                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding AuswaertsToreRegulaer, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                     Padding="8,6" FontSize="18" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Halbzeitstand (Issue #104): optional, unabhängig von Rundenart/Entscheidungsart -->
                    <TextBlock Text="HALBZEITSTAND (OPTIONAL)" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding HeimHalbzeitTore, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                 Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                 BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="2"
                                 Text="{Binding AuswaertsHalbzeitTore, UpdateSourceTrigger=PropertyChanged}"
                                 helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                 Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                 BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                    </Grid>

                    <!-- Verlängerung -->
                    <StackPanel Visibility="{Binding VerlaengerungAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNIS NACH VERLÄNGERUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding HeimToreVerlaengerung, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding AuswaertsToreVerlaengerung, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </Grid>
                    </StackPanel>

                    <!-- Elfmeterschießen -->
                    <StackPanel Visibility="{Binding ElfmeterAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ELFMETER" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding HeimElfmetertore, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding AuswaertsElfmetertore, UpdateSourceTrigger=PropertyChanged}"
                                     helpers:TextBoxSelectAllOnFocusBehavior.SelectAllOnFocus="True"
                                     Padding="8,6" FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </Grid>
                    </StackPanel>

                    <!-- Hinweis: Simulieren erst nach Zurücksetzen des bestehenden Ergebnisses möglich -->
                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding FormHatErgebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Dieses Spiel hat bereits ein Ergebnis. Zum Neu-Simulieren zuerst über 'Löschen' zurücksetzen."
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Issue #240: Zugriff auf den detaillierten Spielverlauf eines bereits
                         simulierten Spiels (Ereignisse Minute für Minute, wie in der
                         Einzelspiel-Simulation) — springt in den Simulation-Tab, ohne das
                         vorhandene Ergebnis zu überschreiben. -->
                    <Button Content="Spielverlauf ansehen"
                            Command="{Binding SpielverlaufAnsehenBefehl}"
                            HorizontalAlignment="Stretch" Padding="10,7" FontSize="12" Cursor="Hand"
                            Visibility="{Binding FormHatErgebnis, Converter={StaticResource BoolToVisibility}}" />

                </StackPanel>
            </ScrollViewer>

            <!-- ── Spielplan-Tabelle ── -->
            <Grid>
                <!-- Kein Turnier / Runde gewählt -->
                <TextBlock Text="Bitte ein Turnier und eine Runde auswählen."
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HatRunde, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- Spielliste -->
                <DockPanel Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}">

                    <!-- Header mit Ansicht-Umschalter -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="12,8">
                        <DockPanel>

                            <!-- Liga-Ansicht-Umschalter: Gesamt-Spielplan vs. pro Spieltag (Issue #246) -->
                            <Border DockPanel.Dock="Right"
                                    CornerRadius="{StaticResource Radius6}" Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="2"
                                    Visibility="{Binding ZeigeLigaSpieltagUmschalter, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding LigaGesamtAnsichtBefehl}"
                                            Content="Gesamt" Padding="8,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LigaProSpieltagAktiv}" Value="False">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding LigaProSpieltagAnsichtBefehl}"
                                            Content="Pro Spieltag" Padding="8,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LigaProSpieltagAktiv}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}">
                                <Run Text="SPIELE · " />
                                <Run Text="{Binding AusgewaehlteRunde.Name}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Spiele.Count, Mode=OneWay}" />
                                <Run Text=" Spiel(e)" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Fehlermeldung bei Spielplan-Generierung -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="12,8,12,0"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Issue #90: Platzhalter lösen sich automatisch nach jedem Ergebnis auf, das
                         vormalige Banner mit manuellem "Platzhalter aktualisieren"-Button ist damit
                         entfallen. Vorschau für noch offene Platzhalter läuft über den Ribbon-Umschalter
                         "Platzhalter-Vorschau" (Issue #208). -->

                    <!-- Haupt-Inhaltsbereich: Spielplan ODER auf eine Gruppe gefilterte Spielliste -->
                    <Grid>

                        <!-- ── Spielplan-Ansicht ── -->
                        <ListView x:Name="SpielListView"
                                  ItemsSource="{Binding Spiele}"
                                  SelectedItem="{Binding AusgewaehlteSpiel}"
                                  SelectionMode="Extended"
                                  SelectionChanged="SpielListView_SelectionChanged"
                                  KeyDown="SpielListView_KeyDown"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding ZeigeFokusListe, Converter={StaticResource InverseBoolToVisibility}}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource SpielplanGridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="ST" Width="44">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding SpieltagAnzeige}"
                                                           FontSize="12" Style="{StaticResource SpielplanGedaempfterZellText}"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Nr" Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding Spielnummer}"
                                                           FontSize="12" Style="{StaticResource SpielplanGedaempfterZellText}"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Gr." Width="38">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <TextBlock Text="{Binding GruppeAnzeige}"
                                                           FontSize="11" Style="{StaticResource SpielplanGedaempfterZellText}"
                                                           HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Heim" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <DockPanel>
                                                    <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                        <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" />
                                                        <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Opacity="0.35"
                                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding HeimName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Ergebnis" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ErgebnisText}"
                                                               FontSize="14" FontWeight="Bold"
                                                               FontFamily="Consolas">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Opacity" Value="0.60" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ErgebnisDetail}"
                                                               FontSize="10" Style="{StaticResource SpielplanGedaempfterZellText}"
                                                               Margin="4,3,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Auswärts" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <DockPanel>
                                                    <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                        <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" />
                                                        <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Opacity="0.35"
                                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding AuswaertsName}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Status" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                <Border CornerRadius="10" Padding="6,2"
                                                        Background="{Binding Status,
                                                            Converter={StaticResource SpielStatusZuFarbe}}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status,
                                                                   Converter={StaticResource SpielStatusZuText}}"
                                                               FontSize="11" Foreground="White" />
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>

                            <ListView.ItemContainerStyle>
                                <StaticResource ResourceKey="SpielplanGridViewItemStyle" />
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <!-- ── Auf Gruppe gefilterte Spielliste ODER Liga-Ansicht pro Spieltag (Issue #246) ── -->
                        <DockPanel Visibility="{Binding ZeigeFokusListe, Converter={StaticResource BoolToVisibility}}">

                            <!-- Toolbar: (bei Gruppenfilter) Filter aufheben + Gruppenname, sonst nur Spieltag-Navigation -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="12,8">
                                <DockPanel>
                                    <!-- Spieltag-Navigation (rechts, nur bei mehreren Spieltagen) -->
                                    <Border DockPanel.Dock="Right"
                                            CornerRadius="{StaticResource Radius6}" Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="2"
                                            Visibility="{Binding HatMehrereSpieltage, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding FokusAlleSpieltageBefehl}"
                                                    Padding="8,3" Cursor="Hand" FontSize="11">
                                                <Button.Content>Alle</Button.Content>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FokusAlleAktiv}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Command="{Binding FokusVorigerSpieltag}"
                                                    Content="&lt;" Padding="6,3" Cursor="Hand" FontSize="12"
                                                    BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                            <TextBlock Text="{Binding FokusSpieltagnummer}"
                                                       FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                            <Button Command="{Binding FokusNaechsterSpieltag}"
                                                    Content="&gt;" Padding="6,3" Cursor="Hand" FontSize="12"
                                                    BorderThickness="0" Background="Transparent" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Filter aufheben-Button + Gruppenname (nur bei explizitem Gruppenfilter, nicht in der Liga-Ansicht) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Visibility="{Binding IstGefiltertAufGruppe, Converter={StaticResource BoolToVisibility}}">
                                        <Button Command="{Binding ZurueckZurUebersichtBefehl}"
                                                Padding="8,4" FontSize="11" Cursor="Hand"
                                                Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,12,0"
                                                ToolTip="Gruppenfilter aufheben, alle Spiele der Runde anzeigen">
                                            ✕ Filter aufheben
                                        </Button>
                                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Run Text="Gruppe " />
                                            <Run Text="{Binding AusgewaehlteGruppe.GruppenNummer}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Spielliste der fokussierten Gruppe -->
                            <TextBlock DockPanel.Dock="Top"
                                       Text="SPIELE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       Margin="12,10,8,4" />
                            <ListView x:Name="FokusSpielListView"
                                      ItemsSource="{Binding FokusSpiele}"
                                      SelectedItem="{Binding AusgewaehlteSpiel}"
                                      SelectionMode="Extended"
                                      SelectionChanged="SpielListView_SelectionChanged"
                                      KeyDown="SpielListView_KeyDown"
                                      BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource SpielplanGridViewColumnHeaderStyle}">
                                        <GridViewColumn Header="ST" Width="44">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <TextBlock Text="{Binding SpieltagAnzeige}" FontSize="12" Style="{StaticResource SpielplanGedaempfterZellText}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Nr" Width="36">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <TextBlock Text="{Binding Spielnummer}" FontSize="12" Style="{StaticResource SpielplanGedaempfterZellText}" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Heim" Width="160">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <DockPanel>
                                                        <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" />
                                                            <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.35"
                                                                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding HeimName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Ergebnis" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ErgebnisText}"
                                                                   FontSize="14" FontWeight="Bold" FontFamily="Consolas">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="0.60" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ErgebnisDetail}" FontSize="10" Style="{StaticResource SpielplanGedaempfterZellText}" Margin="4,3,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Auswärts" Width="160">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <DockPanel>
                                                        <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" />
                                                            <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.35"
                                                                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding AuswaertsName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Status" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                                    <Border CornerRadius="10" Padding="6,2"
                                                            Background="{Binding Status, Converter={StaticResource SpielStatusZuFarbe}}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource SpielStatusZuText}}"
                                                                   FontSize="11" Foreground="White" />
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <StaticResource ResourceKey="SpielplanGridViewItemStyle" />
                                </ListView.ItemContainerStyle>
                            </ListView>

                        </DockPanel>

                    </Grid>
                </DockPanel>
            </Grid>
        </DockPanel>

    </Grid>
</UserControl>
