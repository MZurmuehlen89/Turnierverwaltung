<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.AufstiegsregelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="RundeItemTemplate">
            <TextBlock>
                <Run Text="{Binding Reihenfolge, Mode=OneWay}" />
                <Run Text=". " />
                <Run Text="{Binding Name, Mode=OneWay}" />
                <Run Text=" [" /><Run Text="{Binding Rundenart, Mode=OneWay}" /><Run Text="]" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240" MaxWidth="420" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Turnier-Auswahl + Regel-Liste ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="#3B82F6"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock DockPanel.Dock="Top"
                       Text="Bitte zuerst ein Turnier wählen."
                       Visibility="{Binding TurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}"
                       Foreground="#9CA3AF" FontSize="12" Margin="12,16" TextWrapping="Wrap" />

            <ListBox ItemsSource="{Binding Regeln}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     Visibility="{Binding TurnierGewaehlt, Converter={StaticResource BoolToVisibility}}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="#1E40AF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#EFF6FF" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding QuellRunde.Name, Mode=OneWay}" />
                                <Run Text=" → " />
                                <Run Text="{Binding ZielRunde.Name, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#9CA3AF">
                                <Run Text="Platz " /><Run Text="{Binding PlatzierungVon, Mode=OneWay}" />
                                <Run Text="–" /><Run Text="{Binding PlatzierungBis, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" Background="#E2E8F0" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Platzhalter -->
            <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="🔀" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Regel auswählen oder" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                           FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Formular -->
            <ScrollViewer Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" MaxWidth="600">

                    <TextBlock Text="AUFSTIEGSREGEL" FontWeight="SemiBold" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,12" />

                    <TextBlock Text="Quellrunde" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Runden}"
                              SelectedItem="{Binding QuellRunde}"
                              ItemTemplate="{StaticResource RundeItemTemplate}"
                              Padding="8,5" FontSize="13" Margin="0,0,0,12"
                              BorderBrush="#D1D5DB" BorderThickness="1" />

                    <TextBlock Text="Zielrunde" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding ZielRundenOptionen}"
                              SelectedItem="{Binding ZielRunde}"
                              ItemTemplate="{StaticResource RundeItemTemplate}"
                              Padding="8,5" FontSize="13" Margin="0,0,0,12"
                              BorderBrush="#D1D5DB" BorderThickness="1" />

                    <StackPanel Visibility="{Binding GruppeIndexSichtbar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding GruppeIndexLabel}" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                        <TextBox Text="{Binding GruppeIndex, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,5" FontSize="13" Margin="0,0,0,12"
                                 BorderBrush="#D1D5DB" BorderThickness="1" />
                    </StackPanel>

                    <TextBlock Margin="0,0,0,3">
                        <Run Text="Platzierungsbereich" FontSize="12" Foreground="#374151" />
                        <Run Text="{Binding PlatzierungHinweis, Mode=OneWay}" FontSize="12" Foreground="#9CA3AF" />
                    </TextBlock>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="von" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,3" />
                            <TextBox Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="#D1D5DB" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="bis" FontSize="11" Foreground="#9CA3AF" Margin="0,0,0,3" />
                            <TextBox Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="#D1D5DB" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Fehlermeldung -->
                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
