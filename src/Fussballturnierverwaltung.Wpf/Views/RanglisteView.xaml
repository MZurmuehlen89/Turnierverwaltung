<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.RanglisteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="TeamSucheTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="🔍  Suche…" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>
        <!-- BasedOn StandardDataGridRowStyle: nur die Drag&amp;Drop-Ergänzungen bleiben hier lokal. -->
        <Style x:Key="EintraegeRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource StandardDataGridRowStyle}">
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EintraegeRow_PreviewMouseLeftButtonDown" />
            <EventSetter Event="MouseMove" Handler="EintraegeRow_MouseMove" />
            <EventSetter Event="Drop" Handler="EintraegeRow_Drop" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Suche + Liste ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="🔍  Suchen …"
                         materialDesign:HintAssist.IsFloating="False"
                         Padding="6,4" FontSize="13"
                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding RanglistenGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <StaticResource ResourceKey="StandardListBoxItemStyle" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Datum, StringFormat=yyyy-MM-dd}"
                                           FontSize="10" Opacity="0.60" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Eintraege.Count, StringFormat={}{0} Einträge}"
                                           FontSize="10" Opacity="0.60" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Platzhalter -->
            <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Rangliste auswählen oder" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                           FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Formular -->
            <ScrollViewer Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" MaxWidth="700">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Datum (JJJJ-MM-TT)" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Datum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quelle" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Quelle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- EINTRÄGE -->
                    <TextBlock Text="EINTRÄGE" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,4" />
                    <TextBlock Text="Rang ergibt sich aus der Reihenfolge (per Hoch/Runter oder Ziehen anpassbar). Punkte sind optional und rein informativ (z.B. FIFA-Punktewert) — für Sortierung/Lostopf-Zuordnung zählt nur der Rang."
                               FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="8" Margin="0,0,0,24">
                        <StackPanel>
                            <DataGrid x:Name="EintraegeGrid"
                                      ItemsSource="{Binding Eintraege}"
                                      SelectedItem="{Binding AusgewaehlterEintrag}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                                      HeadersVisibility="Column"
                                      AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                      Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                      BorderThickness="0"
                                      RowHeight="28"
                                      FontSize="12"
                                      Height="200"
                                      Margin="0,0,0,6"
                                      RowStyle="{StaticResource EintraegeRowStyle}">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>

                                    <!-- Rang (nicht editierbar - ergibt sich aus der Position in der Liste) -->
                                    <DataGridTextColumn Header="Rang"
                                                        Binding="{Binding Rang}"
                                                        Width="70"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Mannschaft (nicht editierbar - Team ändern = entfernen + neu hinzufügen) -->
                                    <DataGridTemplateColumn Header="Mannschaft" Width="*" MinWidth="120" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                        <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" />
                                                        <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Opacity="0.35"
                                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Mannschaft.Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Punkte (optional, rein informativ - siehe Hinweistext oben) -->
                                    <DataGridTextColumn Header="Punkte"
                                                        Binding="{Binding Punkte, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                        Width="80">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip"
                                                        Value="Optionaler Zusatzwert (z.B. FIFA-Punkte). Rein informativ — für Sortierung/Lostopf-Zuordnung zählt nur der Rang." />
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Team-Auswahl: Suchfeld + Verband-Filter, dann Auswahl -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MannschaftSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TeamSucheTextBox}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                          SelectedItem="{Binding MannschaftVerbandFilter}"
                                          DisplayMemberPath="Anzeige"
                                          Padding="6,4" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding VerfuegbareMannschaftenGefiltert}"
                                          SelectedItem="{Binding NeueMannschaft}"
                                          DisplayMemberPath="Name"
                                          Padding="6,4" FontSize="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                <Button Grid.Column="2"
                                        Content="Hinzufügen"
                                        Command="{Binding EintragHinzufuegenCommand}"
                                        Padding="10,4" FontSize="12" Cursor="Hand" />
                            </Grid>

                            <!-- Bearbeiten-Leiste -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="↑"
                                        Command="{Binding EintragHochCommand}"
                                        Padding="8,3" FontSize="13" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="Nach oben" />
                                <Button Content="↓"
                                        Command="{Binding EintragRunterCommand}"
                                        Padding="8,3" FontSize="13" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="Nach unten" />
                                <Button Content="Entfernen"
                                        Command="{Binding EintragEntfernenCommand}"
                                        Padding="8,3" FontSize="12" Cursor="Hand"
                                        Foreground="{StaticResource ErrorBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fehlermeldung -->
                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{StaticResource ErrorSoftBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
