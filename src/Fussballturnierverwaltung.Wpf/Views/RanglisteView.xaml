<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.RanglisteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="TeamSucheTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍  Suche…" Foreground="#9CA3AF" Margin="6,4" FontSize="12" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EintraegeRowStyle" TargetType="DataGridRow">
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EintraegeRow_PreviewMouseLeftButtonDown" />
            <EventSetter Event="MouseMove" Handler="EintraegeRow_MouseMove" />
            <EventSetter Event="Drop" Handler="EintraegeRow_Drop" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Suche + Liste ── -->
        <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="13"
                         BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍  Suchen …"
                                                               Foreground="#9CA3AF" Margin="8,4"
                                                               FontSize="13" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding RanglistenGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Datum, StringFormat=yyyy-MM-dd}"
                                           FontSize="10" Foreground="#9CA3AF" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Eintraege.Count, StringFormat={}{0} Einträge}"
                                           FontSize="10" Foreground="#9CA3AF" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Platzhalter -->
            <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Rangliste auswählen oder" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                           FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Formular -->
            <ScrollViewer Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" MaxWidth="700">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="#D1D5DB" BorderThickness="1" />

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Datum (JJJJ-MM-TT)" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Datum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="#D1D5DB" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quelle" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Quelle, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="#D1D5DB" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- EINTRÄGE -->
                    <TextBlock Text="EINTRÄGE" FontWeight="SemiBold" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,4" />
                    <TextBlock Text="Rang ergibt sich aus der Reihenfolge (per Hoch/Runter oder Ziehen anpassbar). Punkte sind optional und rein informativ (z.B. FIFA-Punktewert) — für Sortierung/Lostopf-Zuordnung zählt nur der Rang."
                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="8" Margin="0,0,0,24">
                        <StackPanel>
                            <DataGrid x:Name="EintraegeGrid"
                                      ItemsSource="{Binding Eintraege}"
                                      SelectedItem="{Binding AusgewaehlterEintrag}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                      HeadersVisibility="Column"
                                      AlternatingRowBackground="{StaticResource SurfaceBrush}"
                                      Background="White"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                      RowHeight="28"
                                      FontSize="12"
                                      Height="200"
                                      Margin="0,0,0,6"
                                      RowStyle="{StaticResource EintraegeRowStyle}">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Foreground" Value="#374151" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="8,0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>

                                    <!-- Rang (nicht editierbar - ergibt sich aus der Position in der Liste) -->
                                    <DataGridTextColumn Header="Rang"
                                                        Binding="{Binding Rang}"
                                                        Width="70"
                                                        IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Mannschaft (nicht editierbar - Team ändern = entfernen + neu hinzufügen) -->
                                    <DataGridTextColumn Header="Mannschaft"
                                                        Binding="{Binding Mannschaft.Name}"
                                                        Width="*" MinWidth="120"
                                                        IsReadOnly="True" />

                                    <!-- Punkte (optional, rein informativ - siehe Hinweistext oben) -->
                                    <DataGridTextColumn Header="Punkte"
                                                        Binding="{Binding Punkte, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                        Width="80">
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="ToolTip"
                                                        Value="Optionaler Zusatzwert (z.B. FIFA-Punkte). Rein informativ — für Sortierung/Lostopf-Zuordnung zählt nur der Rang." />
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Team-Auswahl: Suchfeld + Verband-Filter, dann Auswahl -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MannschaftSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TeamSucheTextBox}" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                          SelectedItem="{Binding MannschaftVerbandFilter}"
                                          DisplayMemberPath="Anzeige"
                                          Padding="6,4" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding VerfuegbareMannschaftenGefiltert}"
                                          SelectedItem="{Binding NeueMannschaft}"
                                          DisplayMemberPath="Name"
                                          Padding="6,4" FontSize="12" BorderBrush="{StaticResource BorderStrongBrush}" />
                                <Button Grid.Column="2"
                                        Content="Hinzufügen"
                                        Command="{Binding EintragHinzufuegenCommand}"
                                        Padding="10,4" FontSize="12" Cursor="Hand" />
                            </Grid>

                            <!-- Bearbeiten-Leiste -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="↑"
                                        Command="{Binding EintragHochCommand}"
                                        Padding="8,3" FontSize="13" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="Nach oben" />
                                <Button Content="↓"
                                        Command="{Binding EintragRunterCommand}"
                                        Padding="8,3" FontSize="13" Margin="0,0,4,0" Cursor="Hand"
                                        ToolTip="Nach unten" />
                                <Button Content="Entfernen"
                                        Command="{Binding EintragEntfernenCommand}"
                                        Padding="8,3" FontSize="12" Cursor="Hand"
                                        Foreground="{StaticResource ErrorBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Fehlermeldung -->
                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{StaticResource ErrorSoftBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
