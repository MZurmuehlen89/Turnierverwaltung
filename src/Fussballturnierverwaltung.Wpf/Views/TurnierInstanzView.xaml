<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierInstanzView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters"
             xmlns:helpers="clr-namespace:Fussballturnierverwaltung.Wpf.Helpers">

    <UserControl.Resources>
        <conv:TurnierStatusZuTextConverter x:Key="StatusZuText" />
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Filter + Liste ── -->
        <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="13" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍  Suchen …" Foreground="#9CA3AF"
                                                               Margin="8,4" FontSize="13" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <!-- Status-Filter -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <ComboBox ItemsSource="{Binding StatusFilterOptionen}"
                          SelectedItem="{Binding StatusFilter}"
                          DisplayMemberPath="Anzeige" FontSize="13" />
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding InstanzenGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SaisonOderJahr}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusZuText}}"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- ── Rechte Spalte: Formular ── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Platzhalter -->
                <TextBlock Text="Wählen Sie ein Turnier aus oder legen Sie ein neues an."
                           Foreground="{StaticResource TextSubtleBrush}" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,8" />

                    <TextBlock Text="Name" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />

                    <TextBlock Text="Saison / Jahr" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SaisonOderJahr, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Startjahr" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Startdatum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Endjahr" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Enddatum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Status (nur für gespeicherte Turniere) -->
                    <StackPanel Visibility="{Binding RundenSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}" Padding="8,6">
                            <TextBlock Text="{Binding StatusAnzeige}" FontSize="13" Foreground="#374151" />
                        </Border>
                    </StackPanel>

                    <!-- AUSLOSUNGSFILTER -->
                    <TextBlock Text="AUSLOSUNGSFILTER" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,8" />

                    <TextBlock Text="Verband" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding VerbandOptionen}"
                              SelectedItem="{Binding VerbandFilter}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Mannschaftsart" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TeamfilterOptionen}"
                              SelectedValuePath="Wert"
                              SelectedValue="{Binding TeamFilter}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,20" />

                    <!-- REGELWERK-STANDARD -->
                    <TextBlock Text="REGELWERK-STANDARD" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,8" />

                    <TextBlock FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" TextWrapping="Wrap">
                        Wird automatisch für neue Runden im Runden-Editor vorbelegt.
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding StandardRegelwerkOptionen}"
                              SelectedItem="{Binding StandardRegelwerk}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,20" />

                    <!-- VERBAND-QUOTEN (nur für bereits gespeicherte Turniere ohne Verbandsfilter, Issue #161/#154) -->
                    <StackPanel Visibility="{Binding VerbandsQuotenSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,20">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="VERBAND-QUOTEN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSubtleBrush}" />
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource TextSubtleBrush}"
                                       Visibility="{Binding KapazitaetsHinweisSichtbar, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="max. Summe " /><Run Text="{Binding ErsteRundeEingang, Mode=OneWay}" /><Run Text=" (Eingang 1. Runde)" />
                            </TextBlock>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding QuotenZeilen}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True" CanUserDeleteRows="True"
                                  CanUserSortColumns="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                  RowHeaderWidth="24" MaxHeight="240" FontSize="13">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Verband" Width="*"
                                                         ItemsSource="{Binding Data.AlleVerbaende, Source={StaticResource Proxy}}"
                                                         DisplayMemberPath="Name"
                                                         SelectedItemBinding="{Binding Verband}" />
                                <DataGridTextColumn Header="Anzahl" Width="70"
                                                     Binding="{Binding Anzahl, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,16,0,0"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
