<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierInstanzView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters"
             xmlns:helpers="clr-namespace:Fussballturnierverwaltung.Wpf.Helpers"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <conv:TurnierStatusZuTextConverter x:Key="StatusZuText" />
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style x:Key="QuotenGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="QuotenGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.DataGrid.Selected}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="False" />
                    </MultiTrigger.Conditions>
                    <!-- Eigener Hover-Brush statt Card.Border (Issue #268 Pkt. 2): Card.Border ist
                         auch AlternatingRowBackground, auf geraden Zeilen wäre der Hover sonst unsichtbar. -->
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.DataGrid.RowHoverBackground}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Filter + Liste ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="🔍  Suchen …"
                         materialDesign:HintAssist.IsFloating="False"
                         Padding="6,4" FontSize="13" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
            </Border>

            <!-- Status-Filter -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <ComboBox ItemsSource="{Binding StatusFilterOptionen}"
                          SelectedItem="{Binding StatusFilter}"
                          DisplayMemberPath="Anzeige" FontSize="13" />
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding InstanzenGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                         und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                         (theme-unabhängig hell) ist und unsere eigenen Trigger-Setter ignoriert. -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListBoxItem.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SaisonOderJahr}" FontSize="11" Opacity="0.60" />
                                <TextBlock Text=" · " FontSize="11" Opacity="0.60" />
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusZuText}}"
                                           FontSize="11" Opacity="0.60" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechte Spalte: Formular ── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Platzhalter -->
                <TextBlock Text="Wählen Sie ein Turnier aus oder legen Sie ein neues an."
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <TextBlock Text="Saison / Jahr" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SaisonOderJahr, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Startjahr" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Startdatum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Endjahr" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Enddatum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Status (nur für gespeicherte Turniere) -->
                    <StackPanel Visibility="{Binding RundenSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}" Padding="8,6">
                            <TextBlock Text="{Binding StatusAnzeige}" FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                        </Border>
                    </StackPanel>

                    <!-- AUSLOSUNGSFILTER -->
                    <TextBlock Text="AUSLOSUNGSFILTER" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <TextBlock Text="Verband" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding VerbandOptionenGefiltert}"
                              SelectedItem="{Binding VerbandFilter}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Land" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding LandOptionenGefiltert}"
                              SelectedItem="{Binding LandFilter}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Mannschaftsart" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding TeamfilterOptionen}"
                              SelectedValuePath="Wert"
                              SelectedValue="{Binding TeamFilter}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,20" />

                    <!-- REGELWERK-STANDARD -->
                    <TextBlock Text="REGELWERK-STANDARD" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <TextBlock FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,6" TextWrapping="Wrap">
                        Wird automatisch für neue Runden im Runden-Editor vorbelegt.
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding StandardRegelwerkOptionen}"
                              SelectedItem="{Binding StandardRegelwerk}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,20" />

                    <!-- VERBAND-QUOTEN (nur für bereits gespeicherte Turniere ohne Verbandsfilter, Issue #161/#154) -->
                    <StackPanel Visibility="{Binding VerbandsQuotenSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,20">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="VERBAND-QUOTEN" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       Visibility="{Binding KapazitaetsHinweisSichtbar, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="max. Summe " /><Run Text="{Binding ErsteRundeEingang, Mode=OneWay}" /><Run Text=" (Eingang 1. Runde)" />
                            </TextBlock>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding QuotenZeilen}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True" CanUserDeleteRows="True"
                                  CanUserSortColumns="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                                  AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                  Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                  BorderThickness="0"
                                  RowHeaderWidth="24" MaxHeight="240" FontSize="13"
                                  ColumnHeaderStyle="{StaticResource QuotenGridColumnHeaderStyle}"
                                  RowStyle="{StaticResource QuotenGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Verband" Width="*"
                                                         ItemsSource="{Binding Data.AlleVerbaende, Source={StaticResource Proxy}}"
                                                         DisplayMemberPath="Name"
                                                         SelectedItemBinding="{Binding Verband}" />
                                <DataGridTextColumn Header="Anzahl" Width="70"
                                                     Binding="{Binding Anzahl, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,16,0,0"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
