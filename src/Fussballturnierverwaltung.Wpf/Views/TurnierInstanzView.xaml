<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierInstanzView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters">

    <UserControl.Resources>
        <conv:TurnierStatusZuTextConverter x:Key="StatusZuText" />
        <conv:RundenartZuTextConverter     x:Key="RundenartZuText" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" MaxWidth="400" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Filter + Liste ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍  Suchen …" Foreground="#9CA3AF"
                                                               Margin="8,4" FontSize="13" />
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <!-- Status-Filter -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,6">
                <ComboBox ItemsSource="{Binding StatusFilterOptionen}"
                          SelectedItem="{Binding StatusFilter}"
                          DisplayMemberPath="Anzeige" FontSize="13" />
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="#3B82F6"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding InstanzenGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SaisonOderJahr}" FontSize="11" Foreground="#64748B" />
                                <TextBlock Text=" · " FontSize="11" Foreground="#64748B" />
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusZuText}}"
                                           FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Rechte Spalte: Formular ── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Platzhalter -->
                <TextBlock Text="Wählen Sie ein Turnier aus oder legen Sie ein neues an."
                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,8" />

                    <TextBlock Text="Name" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="#CBD5E1" BorderThickness="1" />

                    <TextBlock Text="Saison / Jahr" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SaisonOderJahr, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="#CBD5E1" BorderThickness="1" />

                    <TextBlock Text="Turniervorlage" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding VorlageOptionen}"
                              SelectedItem="{Binding AusgewaehlteVorlage}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Startjahr" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Startdatum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Endjahr" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Enddatum, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Status" FontSize="12" Foreground="#475569" Margin="0,0,0,4"
                               Visibility="{Binding RundenAnzeigeAktiv, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox ItemsSource="{Binding StatusOptionen}"
                              SelectedItem="{Binding AusgewaehlterStatus}"
                              DisplayMemberPath="Anzeige" FontSize="13" Margin="0,0,0,20"
                              Visibility="{Binding RundenAnzeigeAktiv, Converter={StaticResource BoolToVisibility}}" />

                    <!-- RUNDEN (Bearbeiten-Modus: read-only) -->
                    <StackPanel Visibility="{Binding RundenAnzeigeAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="RUNDEN" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,8" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <ItemsControl ItemsSource="{Binding AktuelleRunden}"
                                          Background="White">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Reihenfolge}"
                                                           Foreground="#94A3B8" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" FontSize="13" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Rundenart, Converter={StaticResource RundenartZuText}}"
                                                                   FontSize="11" Foreground="#64748B" />
                                                        <TextBlock FontSize="11" Foreground="#64748B">
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding EingangsMannschaftsanzahl}" />
                                                            <Run Text="→" />
                                                            <Run Text="{Binding AusgangsMannschaftsanzahl}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding Regelwerk.Name}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- RUNDEN (Neu-Modus: editierbar) -->
                    <StackPanel Visibility="{Binding RundenbauenAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="RUNDEN" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,8" />

                        <!-- Liste der definierten Runden -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0"
                                     ItemsSource="{Binding RundenListe}"
                                     SelectedItem="{Binding MarkierteRunde}"
                                     DisplayMemberPath="Anzeige"
                                     MinHeight="60" MaxHeight="200"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <Button Content="↑" Width="28" Height="28" Margin="0,0,0,4"
                                        Command="{Binding RundeHochCommand}"
                                        FontSize="14" />
                                <Button Content="↓" Width="28" Height="28" Margin="0,0,0,4"
                                        Command="{Binding RundeRunterCommand}"
                                        FontSize="14" />
                                <Button Content="✕" Width="28" Height="28"
                                        Command="{Binding RundeEntfernenCommand}"
                                        FontSize="14" Foreground="#DC2626" />
                            </StackPanel>
                        </Grid>

                        <!-- Neue-Runde-Formular -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Runde hinzufügen" FontSize="12" FontWeight="Bold"
                                           Foreground="#475569" Margin="0,0,0,10" />

                                <TextBlock Text="Name" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NeueRundeName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" FontSize="13" Margin="0,0,0,8"
                                         BorderBrush="#CBD5E1" BorderThickness="1" />

                                <TextBlock Text="Rundenart" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RundenartOptionen}"
                                          SelectedItem="{Binding NeueRundeRundenart}"
                                          FontSize="13" Margin="0,0,0,8">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource RundenartZuText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Eingang" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NeueRundeEingang, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ausgang" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding NeueRundeAusgang, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4" FontSize="13" BorderBrush="#CBD5E1" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Regelwerk" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding RegelwerkOptionen}"
                                          SelectedItem="{Binding NeueRundeRegelwerk}"
                                          DisplayMemberPath="Anzeige"
                                          FontSize="13" Margin="0,0,0,8" />

                                <CheckBox Content="Auswärtstorregel (nur K.o. Hin- &amp; Rückspiel)"
                                          IsChecked="{Binding NeueRundeAuswaertstorRegel}"
                                          IsEnabled="{Binding AuswaertstorAktivierbar}"
                                          FontSize="12" Margin="0,0,0,10" />

                                <Button Content="Runde hinzufügen"
                                        Command="{Binding RundeHinzufuegenCommand}"
                                        Padding="12,6" FontSize="13"
                                        Background="#3B82F6" Foreground="White"
                                        BorderThickness="0"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,8,0,0"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
