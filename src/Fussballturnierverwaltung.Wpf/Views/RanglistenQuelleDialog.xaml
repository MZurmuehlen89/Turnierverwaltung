<Window x:Class="Fussballturnierverwaltung.Wpf.Views.RanglistenQuelleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ranglisten-Quelle"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16">

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Padding="6,4" Margin="0,0,0,10" />

        <TextBlock Text="URL" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" Padding="6,4" Margin="0,0,0,10" />

        <TextBlock Text="CSS-Selektor der Tabelle (leer = per Index wählen)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="TabellenSelektorBox" Padding="6,4" Margin="0,0,0,10" />

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tabellenindex (0-basiert)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="TabellenIndexBox" Padding="6,4" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Team-/Landname-Spalte (0-basiert)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="MannschaftSpalteBox" Padding="6,4" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="PunkteSpalteCheckbox" Content="Punkte-Spalte vorhanden" Margin="0,0,0,6" />
        <TextBlock Text="Punkte-Spalte (0-basiert)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="PunkteSpalteBox" Padding="6,4" Margin="0,0,0,10"
                 IsEnabled="{Binding IsChecked, ElementName=PunkteSpalteCheckbox}" />

        <CheckBox x:Name="KopfzeileCheckbox" Content="Erste Zeile ist Kopfzeile (überspringen)" Margin="0,0,0,10" />

        <TextBlock x:Name="FehlerText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Click="AbbrechenButton_Click"
                    Padding="14,6" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Speichern" Click="SpeichernButton_Click"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>

    </StackPanel>
</Window>
