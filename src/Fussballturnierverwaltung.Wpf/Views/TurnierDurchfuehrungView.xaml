<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierDurchfuehrungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fussballturnierverwaltung.Wpf.Views">

    <DockPanel>

        <!-- ── Gemeinsamer Header: Turnier-Auswahl ── -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Turnier" FontSize="11" FontWeight="Bold"
                           Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                <views:TurnierAuswahlView DataContext="{Binding TabKoordinator}" />
            </StackPanel>
        </Border>

        <!-- ── Sub-Navigation: Auslosung, Spielplan & Baum, Simulation ── -->
        <TabControl SelectedIndex="{Binding TabKoordinator.AktiverTabIndex, Mode=TwoWay}"
                    BorderThickness="0">

            <TabItem Header="Auslosung">
                <ContentControl Content="{Binding AuslosungVm}" />
            </TabItem>
            <TabItem Header="Spielplan &amp; Baum">
                <ContentControl Content="{Binding SpielplanUndBaumVm}" />
            </TabItem>
            <TabItem Header="Simulation">
                <ContentControl Content="{Binding SimulationVm}" />
            </TabItem>

        </TabControl>

    </DockPanel>

</UserControl>
