<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.RundenUebergaengeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

        <!-- Kein Turnier gewählt -->
        <TextBlock Text="Bitte ein Turnier auswählen."
                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

        <DockPanel Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}">

            <!-- Lade-Spinner -->
            <TextBlock DockPanel.Dock="Top" Text="Lade…" Margin="16,12"
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="13"
                       Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Fehlermeldung -->
            <Border DockPanel.Dock="Top" Margin="16,12,16,0"
                    Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Padding="12,8"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Keine Runden -->
            <TextBlock DockPanel.Dock="Top" Text="Noch keine Runden angelegt — siehe Tab &quot;Runden&quot;."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="13"
                       HorizontalAlignment="Center" Margin="16,48"
                       Visibility="{Binding HatKeineRunden, Converter={StaticResource BoolToVisibility}}" />

            <!-- Runden als Karten, Spaltenposition = Graphtiefe der Übergangsregeln (nicht die freie
                 Reihenfolge im Runden-Editor) — Runden ohne gemeinsamen Vorgänger, aber gleicher Tiefe
                 (z.B. Finale + Spiel um Platz 3, beide aus dem Halbfinale) landen so nebeneinander in
                 derselben Spalte statt in zwei verschiedenen (Issue #249, Nutzerfeedback 2026-08-30).
                 Verbindungslinien analog zum Turnierbaum-Overlay (Issue #244): die real gerenderten
                 Kartenpositionen werden nach jedem Layout-Durchlauf gemessen und im Code-behind gezeichnet. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16,32">
                <Grid>
                    <ItemsControl x:Name="KartenItems" ItemsSource="{Binding Karten}"
                                  Width="{Binding CanvasBreite}" Height="{Binding CanvasHoehe}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RundenUebergangKarte}">
                                <Border Width="190"
                                        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius8}" Padding="12,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HatUnstimmigkeit}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningSoftBorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RundenartText}" FontSize="11"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding EinAusgangText}" FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding AuslosungsLabel}" FontSize="10"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HatAuslosungsLabel, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding UnstimmigkeitText}" FontSize="10"
                                                   Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HatUnstimmigkeit, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas x:Name="VerbindungsCanvas" Background="Transparent" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>

        </DockPanel>

    </Grid>

</UserControl>
