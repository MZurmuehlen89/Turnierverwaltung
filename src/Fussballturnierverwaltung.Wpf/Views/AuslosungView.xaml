<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.AuslosungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Turnier + Auslosungs-Liste ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <!-- Turnier-Auswahl -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,8">
                <StackPanel>
                    <TextBlock Text="Turnier" FontSize="11" Foreground="#94A3B8"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Instanzen}"
                              SelectedItem="{Binding AusgewaehlteInstanz}"
                              DisplayMemberPath="Name"
                              FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="#3B82F6"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Auslosungs-Liste -->
            <DockPanel DockPanel.Dock="Top" Background="White"
                       LastChildFill="True" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="AUSLOSUNGEN" FontSize="11"
                           FontWeight="Bold" Foreground="#94A3B8" Margin="12,10,8,4" />
                <ListBox ItemsSource="{Binding Auslosungen}"
                         SelectedItem="{Binding AusgewaehlteAuslosung}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding TurnierRunde.Name}" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Kein Turnier gewählt -->
            <TextBlock Text="Bitte zuerst ein Turnier auswählen."
                       Foreground="#94A3B8" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding AusgewaehlteInstanz, Converter={StaticResource NullToCollapsed}}" />

            <!-- Neue Auslosung anlegen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding NeuFormAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="24,20" MaxWidth="480">
                    <TextBlock Text="NEUE AUSLOSUNG" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NeuName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="#CBD5E1" BorderThickness="1" />

                    <TextBlock Text="Auslosungsart" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AuslosungsartOptionen}"
                              SelectedValuePath="Wert"
                              SelectedValue="{Binding NeuAuslosungsart}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Runde" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding InstanzRunden}"
                              SelectedItem="{Binding NeuRunde}"
                              DisplayMemberPath="Name"
                              FontSize="13" Margin="0,0,0,20" />

                    <!-- Fehlermeldung im Formular -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Auslosung-Workspace (Detail) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding DetailAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,14">

                    <!-- Kopfzeile: Info + Aktions-Buttons -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="▶  Auslosung durchführen"
                                    Command="{Binding AuslosungAusfuehrenCommand}"
                                    Padding="12,6" FontSize="13"
                                    Background="#16A34A" Foreground="White" BorderThickness="0"
                                    Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="↩  Zurücksetzen"
                                    Command="{Binding AuslosungZuruecksetzenCommand}"
                                    Padding="12,6" FontSize="13" Margin="8,0,0,0"
                                    Background="#DC2626" Foreground="White" BorderThickness="0"
                                    Visibility="{Binding IstAbgeschlossen, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AuslosungKopfzeile}"
                                   FontSize="13" Foreground="#475569"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- WORKSPACE: Verfügbare Teams + Lostoepfe (nur wenn bearbeitbar) -->
                    <StackPanel Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="DRAG &amp; DROP: Teams in Töpfe ziehen"
                                   FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />

                        <Grid MinHeight="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Verfügbare Mannschaften -->
                            <StackPanel Grid.Column="0">
                                <Border Background="#F1F5F9" Padding="8,4" CornerRadius="4,4,0,0">
                                    <TextBlock Text="{Binding VerfuegbareMannschaften.Count, StringFormat='Verfügbar ({0})'}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#475569" />
                                </Border>
                                <ListBox x:Name="VerfuegbarListBox"
                                         ItemsSource="{Binding VerfuegbareMannschaften}"
                                         AllowDrop="True"
                                         MinHeight="180"
                                         BorderBrush="#CBD5E1" BorderThickness="1,0,1,1"
                                         Background="White"
                                         Drop="VerfuegbarListBox_Drop"
                                         DragOver="ListBox_DragOver"
                                         DragEnter="VerfuegbarListBox_DragEnter"
                                         DragLeave="ListBox_DragLeave"
                                         PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                         MouseMove="ListBox_MouseMove"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                                <TextBlock Text="{Binding Land.Kurzname}" FontSize="10"
                                                           Foreground="#94A3B8" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- Lostoepfe -->
                            <ScrollViewer Grid.Column="2"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Lostoepfe}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LostopfViewModel}">
                                            <Border Width="175" Margin="0,0,8,0"
                                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <Border Background="#F1F5F9" Padding="8,4"
                                                            CornerRadius="4,4,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#475569" />
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding Mannschaften}"
                                                             AllowDrop="True"
                                                             MinHeight="140" MaxHeight="280"
                                                             BorderThickness="0"
                                                             Background="White"
                                                             Drop="TopfListBox_Drop"
                                                             DragOver="ListBox_DragOver"
                                                             DragEnter="TopfListBox_DragEnter"
                                                             DragLeave="ListBox_DragLeave"
                                                             PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                                             MouseMove="ListBox_MouseMove"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                                                    <TextBlock Text="{Binding Land.Kurzname}"
                                                                               FontSize="10" Foreground="#94A3B8" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Border Background="#F8FAFC" Padding="8,3">
                                                        <TextBlock Text="{Binding Mannschaften.Count, StringFormat='{}{0} Teams'}"
                                                                   FontSize="11" Foreground="#94A3B8" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- Lostopf hinzufügen -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox Text="{Binding NeuerLostopfName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180" Padding="8,5" FontSize="13"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                            <Button Content="+ Topf hinzufügen"
                                    Command="{Binding LostopfHinzufuegenCommand}"
                                    Padding="10,5" FontSize="13" Margin="8,0,0,0"
                                    Background="#3B82F6" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- REGELN -->
                    <Expander Header="AUSLOSUNGS-REGELN" FontSize="12" FontWeight="Bold"
                              Foreground="#94A3B8" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Regeln}" Margin="8,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RegelViewModel}">
                                    <CheckBox Content="{Binding Anzeige}"
                                              IsChecked="{Binding IstAktiv, Mode=TwoWay}"
                                              FontSize="13" Margin="0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- ERGEBNISSE (wenn abgeschlossen) -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IstAbgeschlossen, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNISSE DER AUSLOSUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,8" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <ItemsControl ItemsSource="{Binding Ergebnisse}" Background="White">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PaarungsNummer}"
                                                           Foreground="#94A3B8" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                                    <Setter Property="Text"
                                                                            Value="{Binding HeimMannschaft.Name, StringFormat='Freilos: {0}'}" />
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding HeimMannschaft.Name}" FontWeight="SemiBold" />
                                                    <Run Text="  vs  " Foreground="#94A3B8" />
                                                    <Run Text="{Binding AuswaertsMannschaft.Name}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
