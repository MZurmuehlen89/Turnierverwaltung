<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.AuslosungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <!-- Verband-Quoten-Spalte (Issue #188) — 0 Breite solange keine Quoten für die aktuelle
                 Runde bestehen, damit sie ohne Warnungen keinen Platz beansprucht. -->
            <ColumnDefinition Width="{Binding ZeigeVerbandsQuoten, Converter={StaticResource BoolZuAngepinnterSpaltenbreite}, ConverterParameter=4}" />
            <ColumnDefinition Width="{Binding ZeigeVerbandsQuoten, Converter={StaticResource BoolZuAngepinnterSpaltenbreite}, ConverterParameter=280}"
                              MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Turnier + Auslosungs-Liste ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Auslosungs-Liste -->
            <DockPanel DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                       LastChildFill="True" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="AUSLOSUNGEN" FontSize="11"
                           FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="12,10,8,4" />
                <ListBox ItemsSource="{Binding Auslosungen}"
                         SelectedItem="{Binding AusgewaehlteAuslosung}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                             und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                             (theme-unabhängig hell) ist und unsere eigenen Trigger-Setter ignoriert. -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding TurnierRunde.Name}" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Fix #1: KeinTurnierGewaehlt bool (not NullToCollapsed on object) -->
            <TextBlock Text="Bitte zuerst ein Turnier auswählen."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <!-- Neue Auslosung anlegen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding NeuFormAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="24,20" MaxWidth="480">
                    <TextBlock Text="NEUE AUSLOSUNG" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <TextBlock Text="Auslosungsart" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding NeuAuslosungsartOptionen}"
                              SelectedValuePath="Wert"
                              SelectedValue="{Binding NeuAuslosungsart}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,8" />

                    <!-- Erklärung zur gewählten Auslosungsart -->
                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,7" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AuslosungsartHinweis}" FontSize="12"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Warnung bei unpassender Auslosungsart/Rundenart-Kombination -->
                    <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding AuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding AuslosungsartWarnung}" FontSize="12"
                                   Foreground="#92400E" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Runde" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding NeuRundenOptionen}"
                              SelectedItem="{Binding NeuRunde}"
                              DisplayMemberPath="Name"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Anzahl Töpfe" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NeuAnzahlLostoepfe, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding NeuAnzahlLostoepfeBearbeitbar}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,4"
                             Width="80" HorizontalAlignment="Left"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" TextAlignment="Center" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,20"
                               Text="Bei 1 Topf werden alle verfügbaren Teams automatisch zugeordnet."
                               Visibility="{Binding NeuAnzahlLostoepfeBearbeitbar, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,20"
                               Text="Diese Auslosungsart kennt keine Topf-Struktur und ist auf 1 Lostopf begrenzt."
                               Visibility="{Binding NeuAnzahlLostoepfeBearbeitbar, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Auslosung-Workspace (Detail) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding DetailAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,14">

                    <!-- Kopfzeile: Info.
                         "Auslosung durchführen" liegt seit #162 im Ribbon (Tab "Auslosung", Gruppe
                         "Auslosung") als SplitButton — Klick führt sofort aus, der Dropdown-Pfeil
                         öffnet TV-Modus/TV-Modus manuell (waren vorher hier rechts leicht zu übersehen).
                         "Zurücksetzen" liegt dort ebenfalls, analog Speichern/Abbrechen immer sichtbar,
                         aber nur aktiv wenn gebraucht (CanExecute), statt hier ein-/auszublenden. -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding AuslosungKopfzeile}"
                                   FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- TV-Modus: Live-Ziehungsbanner -->
                    <Border Background="#0F172A" CornerRadius="{StaticResource Radius6}" Padding="16,14" Margin="0,0,0,16"
                            Visibility="{Binding AnimationLaeuft, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="🎬 LIVE-ZIEHUNG" FontSize="11" FontWeight="Bold"
                                           Foreground="#FBBF24" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding AnimationFortschrittText}" FontSize="11"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                                <Border Background="{DynamicResource MaterialDesign.Brush.Foreground}" CornerRadius="{StaticResource Radius4}" Padding="14,8" Margin="0,0,8,0" MinWidth="150">
                                    <StackPanel>
                                        <TextBlock Text="MANNSCHAFT" FontSize="9" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AnimationBannerMannschaft}" FontSize="15" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{Binding AnimationBannerTopf}" FontSize="10"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding AnimationBannerZiel, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="→" FontSize="20" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="{DynamicResource MaterialDesign.Brush.Foreground}" CornerRadius="{StaticResource Radius4}" Padding="14,8" Margin="0,0,8,0" MinWidth="110">
                                        <StackPanel>
                                            <TextBlock Text="ZIEL" FontSize="9" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding AnimationBannerZiel}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#4ADE80" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding AnimationBannerSlot}" FontSize="10"
                                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center"
                                                       Visibility="{Binding AnimationBannerSlot, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding AnimationBannerPosition, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="→" FontSize="20" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="{DynamicResource MaterialDesign.Brush.Foreground}" CornerRadius="{StaticResource Radius4}" Padding="14,8" MinWidth="90">
                                        <StackPanel>
                                            <TextBlock Text="POSITION" FontSize="9" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding AnimationBannerPosition}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#60A5FA" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!-- "Weiter"/"Rest sofort anzeigen" liegen seit #162 im Ribbon (Tab
                                 "Auslosung", Gruppe "Auslosung") statt hier inline. -->
                        </StackPanel>
                    </Border>

                    <!-- TV-Modus: Lostöpfe (links) und Gruppen/Paarungen (rechts) nebeneinander statt
                         untereinander (Issue #162-Folgefeedback) — ein großer Lostopf (16+ Teams) soll
                         die Gruppenübersicht nicht mehr nach unten verdrängen. Zusätzlich bekommt jede
                         Topf-/Gruppen-Box ein eigenes Höhenlimit mit internem Scroll (analog dem
                         bestehenden Muster bei "Verfügbare Teilnehmer" weiter unten), statt unbegrenzt
                         zu wachsen. -->
                    <Grid Margin="0,0,0,16"
                          Visibility="{Binding AnimationLaeuft, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Lostöpfe: feste Anzahl Plätze pro Topf, damit sich das Layout nicht
                             verschiebt, sobald ein Topf leerer wird — gezogene Plätze werden nur
                             ausgegraut/zu "…", statt entfernt zu werden. -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LOSTÖPFE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AnimationToepfe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnimationsTopf}">
                                        <Border Width="150" Margin="0,0,8,8"
                                                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                                            <StackPanel>
                                                <Border Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="8,4" CornerRadius="4,4,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                                </Border>
                                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding Slots}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:AnimationsTopfSlot}">
                                                                <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1" Padding="8,4">
                                                                    <DockPanel>
                                                                        <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0"
                                                                              Visibility="{Binding Gezogen, Converter={StaticResource InverseBoolToVisibility}}">
                                                                            <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                                   Stretch="Uniform" />
                                                                            <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       Opacity="0.35"
                                                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding Anzeige}" FontSize="12" />
                                                                    </DockPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Gezogen}" Value="True">
                                                                        <Setter Property="TextBlock.Foreground" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Gruppen / Paarungen -->
                        <StackPanel Grid.Column="2">

                            <!-- Gruppen: alle Plätze von Anfang an sichtbar, füllen sich Slot für Slot -->
                            <StackPanel Visibility="{Binding AnimationIstGruppenmodus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GRUPPEN" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding AnimationGruppen}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AnimationsGruppe}">
                                            <Border Width="160" Margin="0,0,8,8"
                                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="10,5" CornerRadius="4,4,0,0">
                                                        <TextBlock Text="{Binding GruppenName}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                                    </Border>
                                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Slots}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:AnimationsGruppenSlot}">
                                                                    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1" Padding="10,5">
                                                                        <DockPanel>
                                                                            <TextBlock DockPanel.Dock="Left" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                       Foreground="{DynamicResource MaterialDesign.Brush.Card.Border}">
                                                                                <Run Text="{Binding Position}" />
                                                                                <Run Text="." />
                                                                            </TextBlock>
                                                                            <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0"
                                                                                  Visibility="{Binding Befuellt, Converter={StaticResource BoolToVisibility}}">
                                                                                <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                                       Stretch="Uniform" />
                                                                                <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                           Opacity="0.35"
                                                                                           Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                                            </Grid>
                                                                            <TextBlock Text="{Binding Anzeige}" FontSize="13" VerticalAlignment="Center" />
                                                                        </DockPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Befuellt}" Value="False">
                                                                            <Setter Property="TextBlock.Foreground" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Paarungen: alle Paarungen von Anfang an sichtbar, Heim/Auswärts füllen sich -->
                            <StackPanel Visibility="{Binding AnimationIstPaarungsmodus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="PAARUNGEN" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />
                                <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding AnimationPaarungen}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AnimationsPaarung}">
                                                    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1" Padding="12,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PaarungsNr}"
                                                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="12" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Freilos: " FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                                           Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />
                                                                <Grid Width="14" Height="14" Margin="0,0,5,0"
                                                                      Visibility="{Binding HeimBefuellt, Converter={StaticResource BoolToVisibility}}">
                                                                    <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                           Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                                           Stretch="Uniform" />
                                                                    <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Opacity="0.35"
                                                                               Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Heim}" FontSize="13" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}">
                                                                    <TextBlock Text="  vs  " FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                                               VerticalAlignment="Center" />
                                                                    <Grid Width="14" Height="14" Margin="0,0,5,0"
                                                                          Visibility="{Binding AuswaertsBefuellt, Converter={StaticResource BoolToVisibility}}">
                                                                        <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                               Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                                               Stretch="Uniform" />
                                                                        <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Opacity="0.35"
                                                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Auswaerts}" FontSize="13" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Fehlermeldung -->
                    <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- WORKSPACE: Verfügbare Teams + Lostoepfe (nur wenn bearbeitbar) -->
                    <StackPanel Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}">

                        <!-- Einstellungen: Auslosungsart + Lostöpfe + Rangliste-Automatik (seit #162
                             zusammengeführt; "Lostöpfe automatisch befüllen" liegt seit #162 im Ribbon). -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Auslosungsart + Lostöpfe + Rangliste in einer Zeile (Issue #162-Folgefeedback) -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auslosungsart:" FontSize="12"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DetailAuslosungsartOptionen}"
                                              SelectedValue="{Binding DetailAuslosungsart}"
                                              SelectedValuePath="Wert"
                                              DisplayMemberPath="Anzeige"
                                              FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="Lostöpfe:" FontSize="12"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="4"
                                             Text="{Binding DetailAnzahlLostoepfe, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding DetailAnzahlLostoepfeBearbeitbar}"
                                             FontSize="12" Padding="6,4" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                             TextAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="Rangliste:" FontSize="12"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="7"
                                              ItemsSource="{Binding RanglisteOptionen}"
                                              SelectedItem="{Binding AusgewaehlteRanglisteOption}"
                                              DisplayMemberPath="Anzeige"
                                              FontSize="12"
                                              ToolTip="Wird von 'Lostöpfe automatisch befüllen' im Ribbon (Tab Auslosung, Gruppe Auslosung) verwendet." />
                                </Grid>
                                <!-- Hinweis zur gewählten Auslosungsart -->
                                <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Primary.Light}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DetailAuslosungsartHinweis}"
                                               FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" TextWrapping="Wrap" />
                                </Border>
                                <!-- Warnung bei unpassender Kombination -->
                                <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,4,0,0"
                                        Visibility="{Binding DetailAuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding DetailAuslosungsartWarnung}"
                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Fortschrittsanzeige: zugewiesene vs. benötigte Teams -->
                        <Border Margin="0,0,0,10" Padding="10,6" CornerRadius="{StaticResource Radius4}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"  Value="{StaticResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TeamsVollstaendig}" Value="False">
                                            <Setter Property="Background"  Value="#FFF7ED" />
                                            <Setter Property="BorderBrush" Value="#FED7AA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TeamsStatusText}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamsVollstaendig}" Value="False">
                                                <Setter Property="Foreground" Value="#C2410C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- VERBAND-QUOTEN: lebt seit Issue #188 ausschließlich in der dauerhaft
                             angepinnten rechten Spalte (unten im äußeren Grid), nicht mehr inline
                             hier — vermeidet, dass ein Stau vieler Verbände den Formularfluss
                             verdrängt, ohne dass dafür ein Umschalten nötig ist. -->

                        <TextBlock Text="Teams zuweisen: Doppelklick, Rechtsklick oder Drag &amp; Drop"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                        <Grid MinHeight="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Fix #2+#3: Filter + Scrollbar für Verfügbare Teilnehmer.
                                 VerticalAlignment="Top" verhindert, dass diese Spalte auf die Höhe der
                                 (unbegrenzt wachsenden) Lostöpfe-Spalte gestreckt wird — sonst würde die
                                 durch MaxHeight begrenzte ListBox innerhalb der gestreckten Spalte vertikal
                                 zentriert (WPF-Standardverhalten von Stretch bei Max-beschränkten Kindern),
                                 was einen sichtbaren Leerraum zwischen Suchfeld und Liste erzeugt. -->
                            <DockPanel Grid.Column="0" VerticalAlignment="Top">
                                <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Background}"
                                        Padding="6,4" CornerRadius="4,4,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding VerfuegbareTeilnehmer.Count, StringFormat='Verfügbar ({0})'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <!-- Fix #2: Filter-Suchfeld -->
                                <TextBox DockPanel.Dock="Top"
                                         Text="{Binding TeilnehmerFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" FontSize="12"
                                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1,0,1,1" />
                                <!-- Fix #3: MaxHeight erzwingt Scrollbar -->
                                <ListBox x:Name="VerfuegbarListBox"
                                         ItemsSource="{Binding VerfuegbareTeilnehmerGefiltert}"
                                         SelectedItem="{Binding AusgewaehlterVerfuegbarTeilnehmer}"
                                         SelectionMode="Extended"
                                         AllowDrop="True"
                                         MaxHeight="260"
                                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1,0,1,1"
                                         Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                         Drop="VerfuegbarListBox_Drop"
                                         DragOver="ListBox_DragOver"
                                         DragEnter="VerfuegbarListBox_DragEnter"
                                         DragLeave="ListBox_DragLeave"
                                         PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                                         MouseMove="ListBox_MouseMove"
                                         MouseDoubleClick="VerfuegbarListBox_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <!-- Fix #4: Rechtsklick-Kontextmenü -->
                                    <ListBox.ItemContainerStyle>
                                        <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                                             und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                                             (theme-unabhängig hell) ist. -->
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                            <EventSetter Event="MouseRightButtonUp" Handler="VerfuegbarItem_MouseRightButtonUp" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TeilnehmerAnzeige}">
                                            <DockPanel>
                                                <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,6,0">
                                                    <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                           Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                           Stretch="Uniform" />
                                                    <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Opacity="0.35"
                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                </Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" />
                                                    <TextBlock Text="{Binding Kuerzel}" FontSize="10"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                               Visibility="{Binding Kuerzel, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Lostoepfe -->
                            <DockPanel Grid.Column="2">
                            <!-- "Alle Töpfe leeren" liegt seit #158 im Ribbon (Tab "Auslosung",
                                 Gruppe "Auslosung"), nicht mehr als Inline-Button hier.
                                 Kein horizontaler ScrollViewer mehr (Issue #162-Folgefeedback): der gab
                                 dem WrapPanel unbegrenzte Breite, wodurch es nie umgebrochen hat,
                                 sondern nur ein Scrollbalken erschien. Bricht jetzt wie die
                                 Gruppenübersicht anhand der verfügbaren Spaltenbreite mehrzeilig um. -->
                                <ItemsControl ItemsSource="{Binding Lostoepfe}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LostopfViewModel}">
                                            <Border Width="185" Margin="0,0,8,0"
                                                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                                    CornerRadius="{StaticResource Radius4}">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="8,4"
                                                            CornerRadius="4,4,0,0">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="✕ Leeren"
                                                                    FontSize="10" Padding="4,2"
                                                                    BorderThickness="0"
                                                                    Background="Transparent"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                                    Cursor="Hand"
                                                                    Command="{Binding DataContext.TopfLeerenCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding Teilnehmer}"
                                                             SelectionMode="Extended"
                                                             AllowDrop="True"
                                                             MinHeight="140" MaxHeight="280"
                                                             BorderThickness="0"
                                                             Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                                             Drop="TopfListBox_Drop"
                                                             DragOver="ListBox_DragOver"
                                                             DragEnter="TopfListBox_DragEnter"
                                                             DragLeave="ListBox_DragLeave"
                                                             PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                                             PreviewMouseLeftButtonUp="ListBox_PreviewMouseLeftButtonUp"
                                                             MouseMove="ListBox_MouseMove"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                            <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                                                                 und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                                                                 (theme-unabhängig hell) ist. -->
                                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                                <EventSetter Event="MouseRightButtonUp" Handler="TopfItem_MouseRightButtonUp" />
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TeilnehmerAnzeige}">
                                                                <DockPanel>
                                                                    <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                                        <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                               Stretch="Uniform" />
                                                                        <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Opacity="0.35"
                                                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                                    </Grid>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" />
                                                                        <TextBlock Text="{Binding Kuerzel}" FontSize="10"
                                                                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                                                   Visibility="{Binding Kuerzel, Converter={StaticResource NullToCollapsed}}" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="8,3">
                                                        <TextBlock Text="{Binding Teilnehmer.Count, StringFormat='{}{0} Teams'}"
                                                                   FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Grid>

                    </StackPanel>

                    <!-- REGELN: liegen seit #162 im Ribbon (Tab "Auslosung", Gruppe "Auslosung",
                         DropDownButton "Auslosungs-Regeln") statt hier ganz unten als Expander. -->

                    <!-- Gruppenphase-Ergebnis: Teams nach Gruppen (ausgeblendet während TV-Modus-Animation) -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding ZeigeGruppenErgebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="GRUPPEN DER AUSLOSUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding GruppenErgebnisse}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GruppenErgebnisAnzeige}">
                                    <Border Width="160" Margin="0,0,8,8"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                                        <StackPanel>
                                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="10,5" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding GruppenName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Teams}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:GruppenTeamAnzeige}">
                                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1"
                                                                Padding="10,5">
                                                            <DockPanel>
                                                                <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                                    <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                           Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                           Stretch="Uniform" />
                                                                    <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Opacity="0.35"
                                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- KO/Liga-Paarungs-Ergebnis (ausgeblendet während TV-Modus-Animation) -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding ZeigePaarungsergebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNISSE DER AUSLOSUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />
                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                            <ItemsControl ItemsSource="{Binding ErgebnisseAnzeige}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ErgebnisAnzeige}">
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1" Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PaarungsNummer}"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Freilos: " FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                               Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />
                                                    <Grid Width="16" Height="16" Margin="0,0,5,0">
                                                        <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" />
                                                        <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Opacity="0.35"
                                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding HeimName}" FontSize="13" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <TextBlock Text="  vs  " FontSize="13" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                                   VerticalAlignment="Center" />
                                                        <Grid Width="16" Height="16" Margin="0,0,5,0">
                                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" />
                                                            <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.35"
                                                                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding AuswaertsName}" FontSize="13" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Verband-Quoten-Spalte (Issue #188) ── Dauerhaft (kein Umschalten), erscheint nur
             solange es für die aktuelle Runde Quoten gibt. Bleibt sichtbar, auch wenn der Rest des
             Formulars (linke ScrollViewer oben) gescrollt wird — löst das Anliegen, dass ein Stau
             vieler Verbände sonst weit nach unten wandert. -->
        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesign.Brush.Card.Border}"
                      Visibility="{Binding ZeigeVerbandsQuoten, Converter={StaticResource BoolToVisibility}}" />

        <DockPanel Grid.Column="4" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                   Visibility="{Binding ZeigeVerbandsQuoten, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="VERBAND-QUOTEN" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="12,10,12,4" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VerbandsQuotenAnzeige}" Margin="8,4,8,8"
                              Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:VerbandsQuoteAnzeigeViewModel}">
                            <Grid Margin="0,3,6,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="VerbandsQuoteBreite" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="8,7" CornerRadius="{StaticResource Radius4}"
                                        BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UeberAnzahl}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UnterAnzahl}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningSoftBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AnzeigeText}"
                                                   FontSize="13" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UeberAnzahl}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UnterAnzahl}" Value="True">
                                                            <Setter Property="Foreground" Value="#D97706" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding VerbandName}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
