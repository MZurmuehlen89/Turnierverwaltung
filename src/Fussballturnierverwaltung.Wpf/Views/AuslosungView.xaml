<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.AuslosungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Turnier + Auslosungs-Liste ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <!-- Turnier-Auswahl -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,8">
                <StackPanel>
                    <TextBlock Text="Turnier" FontSize="11" Foreground="#94A3B8"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Instanzen}"
                              SelectedItem="{Binding AusgewaehlteInstanz}"
                              DisplayMemberPath="Name"
                              FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="#3B82F6"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Auslosungs-Liste -->
            <DockPanel DockPanel.Dock="Top" Background="White"
                       LastChildFill="True" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="AUSLOSUNGEN" FontSize="11"
                           FontWeight="Bold" Foreground="#94A3B8" Margin="12,10,8,4" />
                <ListBox ItemsSource="{Binding Auslosungen}"
                         SelectedItem="{Binding AusgewaehlteAuslosung}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF" />
                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding TurnierRunde.Name}" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Fix #1: KeinTurnierGewaehlt bool (not NullToCollapsed on object) -->
            <TextBlock Text="Bitte zuerst ein Turnier auswählen."
                       Foreground="#94A3B8" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <!-- Neue Auslosung anlegen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding NeuFormAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="24,20" MaxWidth="480">
                    <TextBlock Text="NEUE AUSLOSUNG" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,12" />

                    <TextBlock Text="Auslosungsart" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AuslosungsartOptionen}"
                              SelectedValuePath="Wert"
                              SelectedValue="{Binding NeuAuslosungsart}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,8" />

                    <!-- Erklärung zur gewählten Auslosungsart -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AuslosungsartHinweis}" FontSize="12"
                                   Foreground="#1E40AF" TextWrapping="Wrap" />
                    </Border>

                    <!-- Warnung bei unpassender Auslosungsart/Rundenart-Kombination -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding AuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding AuslosungsartWarnung}" FontSize="12"
                                   Foreground="#92400E" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Runde" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding InstanzRunden}"
                              SelectedItem="{Binding NeuRunde}"
                              DisplayMemberPath="Name"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Anzahl Töpfe" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NeuAnzahlLostoepfe, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,4"
                             Width="80" HorizontalAlignment="Left"
                             BorderBrush="#CBD5E1" BorderThickness="1" TextAlignment="Center" />
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,0,0,20"
                               Text="Bei 1 Topf werden alle verfügbaren Teams automatisch zugeordnet." />

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Auslosung-Workspace (Detail) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding DetailAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="16,14">

                    <!-- Kopfzeile: Info + Aktions-Buttons -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel Orientation="Vertical" Margin="0,0,10,0"
                                        Visibility="{Binding IstBearbeitbarNichtManuell, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Content="🎬 TV-Modus"
                                          IsChecked="{Binding TvModusAktiv}"
                                          FontSize="12" Foreground="#475569"
                                          ToolTip="Mannschaften werden nach der Auslosung einzeln gezogen (Mannschaft → Gruppe/Paarung → Position) statt das Ergebnis sofort komplett anzuzeigen." />
                                <CheckBox Content="🕹 manuell (Klick je Schritt)"
                                          IsChecked="{Binding TvModusManuell}"
                                          FontSize="11" Foreground="#64748B" Margin="18,2,0,0"
                                          Visibility="{Binding TvModusAktiv, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Button Content="▶  Auslosung durchführen"
                                    Command="{Binding AuslosungAusfuehrenCommand}"
                                    Padding="12,6" FontSize="13"
                                    Background="#16A34A" Foreground="White" BorderThickness="0"
                                    Visibility="{Binding IstBearbeitbarNichtManuell, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="↩  Zurücksetzen"
                                    Command="{Binding AuslosungZuruecksetzenCommand}"
                                    IsEnabled="{Binding AnimationLaeuftNicht}"
                                    Padding="12,6" FontSize="13" Margin="8,0,0,0"
                                    Background="#DC2626" Foreground="White" BorderThickness="0"
                                    Visibility="{Binding IstAbgeschlossen, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding AuslosungKopfzeile}"
                                   FontSize="13" Foreground="#475569"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>

                    <!-- TV-Modus: Live-Ziehungsbanner -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="16,14" Margin="0,0,0,16"
                            Visibility="{Binding AnimationLaeuft, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="🎬 LIVE-ZIEHUNG" FontSize="11" FontWeight="Bold"
                                           Foreground="#FBBF24" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding AnimationFortschrittText}" FontSize="11"
                                           Foreground="#94A3B8" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                                <Border Background="#1E293B" CornerRadius="4" Padding="14,8" Margin="0,0,8,0" MinWidth="150">
                                    <StackPanel>
                                        <TextBlock Text="MANNSCHAFT" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding AnimationBannerMannschaft}" FontSize="15" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{Binding AnimationBannerTopf}" FontSize="10"
                                                   Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding AnimationBannerZiel, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="→" FontSize="20" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="#1E293B" CornerRadius="4" Padding="14,8" Margin="0,0,8,0" MinWidth="110">
                                        <StackPanel>
                                            <TextBlock Text="ZIEL" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding AnimationBannerZiel}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#4ADE80" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding AnimationBannerSlot}" FontSize="10"
                                                       Foreground="#94A3B8" HorizontalAlignment="Center"
                                                       Visibility="{Binding AnimationBannerSlot, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding AnimationBannerPosition, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="→" FontSize="20" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="#1E293B" CornerRadius="4" Padding="14,8" MinWidth="90">
                                        <StackPanel>
                                            <TextBlock Text="POSITION" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding AnimationBannerPosition}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#60A5FA" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="▶  Weiter" Command="{Binding AnimationWeiterCommand}"
                                        Visibility="{Binding AnimationWartetAufWeiter, Converter={StaticResource BoolToVisibility}}"
                                        Padding="14,6" FontSize="12" Background="#16A34A" Foreground="White"
                                        BorderThickness="0" Margin="0,0,8,0" />
                                <Button Content="⏭  Rest sofort anzeigen" Command="{Binding AnimationUeberspringenCommand}"
                                        Padding="14,6" FontSize="12" Background="#334155" Foreground="White" BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TV-Modus: Lostöpfe (fixe Plätze, leeren sich) oben, Gruppen/Paarungen darunter -->
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding AnimationLaeuft, Converter={StaticResource BoolToVisibility}}">

                        <!-- Lostöpfe: feste Anzahl Plätze pro Topf, damit sich das Layout nicht
                             verschiebt, sobald ein Topf leerer wird — gezogene Plätze werden nur
                             ausgegraut/zu "…", statt entfernt zu werden. -->
                        <TextBlock Text="LOSTÖPFE" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AnimationToepfe}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AnimationsTopf}">
                                    <Border Width="150" Margin="0,0,8,8"
                                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Border Background="#F1F5F9" Padding="8,4" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#475569" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Slots}" Background="White">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:AnimationsTopfSlot}">
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="8,4">
                                                            <TextBlock Text="{Binding Anzeige}" FontSize="12" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Gezogen}" Value="True">
                                                                <Setter Property="TextBlock.Foreground" Value="#CBD5E1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Gruppen: alle Plätze von Anfang an sichtbar, füllen sich Slot für Slot -->
                        <StackPanel Visibility="{Binding AnimationIstGruppenmodus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="GRUPPEN" FontSize="11" FontWeight="Bold"
                                       Foreground="#94A3B8" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AnimationGruppen}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AnimationsGruppe}">
                                        <Border Width="160" Margin="0,0,8,8"
                                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <Border Background="#EFF6FF" Padding="10,5" CornerRadius="4,4,0,0">
                                                    <TextBlock Text="{Binding GruppenName}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#1E40AF" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Slots}" Background="White">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:AnimationsGruppenSlot}">
                                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,5">
                                                                <TextBlock FontSize="13">
                                                                    <Run Text="{Binding Position}" Foreground="#CBD5E1" />
                                                                    <Run Text=". " Foreground="#CBD5E1" />
                                                                    <Run Text="{Binding Anzeige}" />
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Befuellt}" Value="False">
                                                                    <Setter Property="TextBlock.Foreground" Value="#CBD5E1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Paarungen: alle Paarungen von Anfang an sichtbar, Heim/Auswärts füllen sich -->
                        <StackPanel Visibility="{Binding AnimationIstPaarungsmodus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PAARUNGEN" FontSize="11" FontWeight="Bold"
                                       Foreground="#94A3B8" Margin="0,0,0,8" />
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                <ItemsControl ItemsSource="{Binding AnimationPaarungen}" Background="White">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AnimationsPaarung}">
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PaarungsNr}"
                                                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Heim, StringFormat='Freilos: {0}'}" />
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Heim}" FontWeight="SemiBold" />
                                                        <Run Text="  vs  " Foreground="#94A3B8" />
                                                        <Run Text="{Binding Auswaerts}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <!-- WORKSPACE: Verfügbare Teams + Lostoepfe (nur wenn bearbeitbar) -->
                    <StackPanel Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}">

                        <!-- Einstellungen: Name + Auslosungsart + Lostöpfe editierbar -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Auslosungsart:" FontSize="12"
                                               Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AuslosungsartOptionen}"
                                              SelectedValue="{Binding DetailAuslosungsart}"
                                              SelectedValuePath="Wert"
                                              DisplayMemberPath="Anzeige"
                                              FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="Lostöpfe:" FontSize="12"
                                               Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="4"
                                             Text="{Binding DetailAnzahlLostoepfe, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="6,4" BorderBrush="#CBD5E1"
                                             TextAlignment="Center" />
                                </Grid>
                                <!-- Hinweis zur gewählten Auslosungsart -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding DetailAuslosungsartHinweis}"
                                               FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" />
                                </Border>
                                <!-- Warnung bei unpassender Kombination -->
                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                        CornerRadius="3" Padding="8,5" Margin="0,4,0,0"
                                        Visibility="{Binding DetailAuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding DetailAuslosungsartWarnung}"
                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Automatische Lostopf-Zuordnung via Rangliste (Issue #119) -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rangliste:" FontSize="12"
                                           Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding RanglisteOptionen}"
                                          SelectedItem="{Binding AusgewaehlteRanglisteOption}"
                                          DisplayMemberPath="Anzeige"
                                          FontSize="12" />
                                <Button Grid.Column="3"
                                        Content="Lostöpfe automatisch befüllen"
                                        Command="{Binding LostoepfeAutomatischBefuellenCommand}"
                                        Padding="10,5" FontSize="12" Cursor="Hand"
                                        ToolTip="Verteilt die noch nicht zugeordneten Mannschaften anhand der gewählten Rangliste auf die Lostöpfe (Vorschlag, manuell nachkorrigierbar)." />
                            </Grid>
                        </Border>

                        <!-- Fortschrittsanzeige: zugewiesene vs. benötigte Teams -->
                        <Border Margin="0,0,0,10" Padding="10,6" CornerRadius="4" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"  Value="#F0FDF4" />
                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TeamsVollstaendig}" Value="False">
                                            <Setter Property="Background"  Value="#FFF7ED" />
                                            <Setter Property="BorderBrush" Value="#FED7AA" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TeamsStatusText}" FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#15803D" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamsVollstaendig}" Value="False">
                                                <Setter Property="Foreground" Value="#C2410C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Teams zuweisen: Doppelklick, Rechtsklick oder Drag &amp; Drop"
                                   FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8" />

                        <Grid MinHeight="260">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Fix #2+#3: Filter + Scrollbar für Verfügbare Teilnehmer.
                                 VerticalAlignment="Top" verhindert, dass diese Spalte auf die Höhe der
                                 (unbegrenzt wachsenden) Lostöpfe-Spalte gestreckt wird — sonst würde die
                                 durch MaxHeight begrenzte ListBox innerhalb der gestreckten Spalte vertikal
                                 zentriert (WPF-Standardverhalten von Stretch bei Max-beschränkten Kindern),
                                 was einen sichtbaren Leerraum zwischen Suchfeld und Liste erzeugt. -->
                            <DockPanel Grid.Column="0" VerticalAlignment="Top">
                                <Border DockPanel.Dock="Top" Background="#F1F5F9"
                                        Padding="6,4" CornerRadius="4,4,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding VerfuegbareTeilnehmer.Count, StringFormat='Verfügbar ({0})'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <!-- Fix #2: Filter-Suchfeld -->
                                <TextBox DockPanel.Dock="Top"
                                         Text="{Binding TeilnehmerFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,4" FontSize="12"
                                         BorderBrush="#CBD5E1" BorderThickness="1,0,1,1" />
                                <!-- Fix #3: MaxHeight erzwingt Scrollbar -->
                                <ListBox x:Name="VerfuegbarListBox"
                                         ItemsSource="{Binding VerfuegbareTeilnehmerGefiltert}"
                                         SelectedItem="{Binding AusgewaehlterVerfuegbarTeilnehmer}"
                                         AllowDrop="True"
                                         MaxHeight="260"
                                         BorderBrush="#CBD5E1" BorderThickness="1,0,1,1"
                                         Background="White"
                                         Drop="VerfuegbarListBox_Drop"
                                         DragOver="ListBox_DragOver"
                                         DragEnter="VerfuegbarListBox_DragEnter"
                                         DragLeave="ListBox_DragLeave"
                                         PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                         MouseMove="ListBox_MouseMove"
                                         MouseDoubleClick="VerfuegbarListBox_MouseDoubleClick"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <!-- Fix #4: Rechtsklick-Kontextmenü -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                            <EventSetter Event="MouseRightButtonUp" Handler="VerfuegbarItem_MouseRightButtonUp" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TeilnehmerAnzeige}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                                <TextBlock Text="{Binding Kuerzel}" FontSize="10"
                                                           Foreground="#94A3B8"
                                                           Visibility="{Binding Kuerzel, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <!-- Lostoepfe -->
                            <DockPanel Grid.Column="2">
                            <Button DockPanel.Dock="Top"
                                    Content="Alle Töpfe leeren"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,6" Padding="8,4" FontSize="11"
                                    BorderThickness="1" BorderBrush="#E2E8F0"
                                    Background="White" Foreground="#64748B"
                                    Cursor="Hand"
                                    Command="{Binding AlleToepfeZuruecksetzenCommand}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Lostoepfe}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LostopfViewModel}">
                                            <Border Width="185" Margin="0,0,8,0"
                                                    BorderBrush="#E2E8F0" BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <Border Background="#F1F5F9" Padding="8,4"
                                                            CornerRadius="4,4,0,0">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right"
                                                                    Content="✕ Leeren"
                                                                    FontSize="10" Padding="4,2"
                                                                    BorderThickness="0"
                                                                    Background="Transparent"
                                                                    Foreground="#94A3B8"
                                                                    Cursor="Hand"
                                                                    Command="{Binding DataContext.TopfLeerenCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock DockPanel.Dock="Left"
                                                                       Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="#475569" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ListBox ItemsSource="{Binding Teilnehmer}"
                                                             AllowDrop="True"
                                                             MinHeight="140" MaxHeight="280"
                                                             BorderThickness="0"
                                                             Background="White"
                                                             Drop="TopfListBox_Drop"
                                                             DragOver="ListBox_DragOver"
                                                             DragEnter="TopfListBox_DragEnter"
                                                             DragLeave="ListBox_DragLeave"
                                                             PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                                             MouseMove="ListBox_MouseMove"
                                                             MouseDoubleClick="TopfListBox_MouseDoubleClick"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <EventSetter Event="MouseRightButtonUp" Handler="TopfItem_MouseRightButtonUp" />
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:TeilnehmerAnzeige}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                                                    <TextBlock Text="{Binding Kuerzel}" FontSize="10"
                                                                               Foreground="#94A3B8"
                                                                               Visibility="{Binding Kuerzel, Converter={StaticResource NullToCollapsed}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Border Background="#F8FAFC" Padding="8,3">
                                                        <TextBlock Text="{Binding Teilnehmer.Count, StringFormat='{}{0} Teams'}"
                                                                   FontSize="11" Foreground="#94A3B8" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </DockPanel>
                        </Grid>

                    </StackPanel>

                    <!-- REGELN -->
                    <Expander Header="AUSLOSUNGS-REGELN" FontSize="12" FontWeight="Bold"
                              Foreground="#94A3B8" Margin="0,16,0,0">
                        <ItemsControl ItemsSource="{Binding Regeln}" Margin="8,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RegelViewModel}">
                                    <Border Margin="0,3" Padding="8,7" CornerRadius="4"
                                            BorderThickness="1" BorderBrush="#E2E8F0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IstRedundant}" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IstAktiv, Mode=TwoWay}"
                                                      FontSize="13" FontWeight="SemiBold">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IstRedundant}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                                <TextBlock Text="{Binding Anzeige}" FontSize="13"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1E293B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IstRedundant}" Value="True">
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </CheckBox>
                                            <TextBlock Text="{Binding Beschreibung}"
                                                       FontSize="11" Foreground="#64748B"
                                                       TextWrapping="Wrap" Margin="20,3,0,0" />
                                            <TextBlock Text="{Binding RedundanzHinweis}"
                                                       FontSize="11" Foreground="#F59E0B"
                                                       FontStyle="Italic"
                                                       TextWrapping="Wrap" Margin="20,3,0,0"
                                                       Visibility="{Binding IstRedundant, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Gruppenphase-Ergebnis: Teams nach Gruppen (ausgeblendet während TV-Modus-Animation) -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding ZeigeGruppenErgebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="GRUPPEN DER AUSLOSUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding GruppenErgebnisse}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GruppenErgebnisAnzeige}">
                                    <Border Width="160" Margin="0,0,8,8"
                                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Border Background="#EFF6FF" Padding="10,5" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding GruppenName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1E40AF" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Teams}" Background="White">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                                                Padding="10,5">
                                                            <TextBlock Text="{Binding}" FontSize="13" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- MANUELLE AUSLOSUNG (nur bei Auslosungsart = Manuell + bearbeitbar) -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding IstManuellerModus, Converter={StaticResource BoolToVisibility}}">

                        <TextBlock Text="MANUELLE AUSLOSUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,4" />
                        <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10">
                            Doppelklick oder Ziehen aus einem Lostopf → Slot. Rechtsklick auf Slot → entfernen.
                        </TextBlock>

                        <!-- Fehleranzeige -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                CornerRadius="3" Padding="8,5" Margin="0,0,0,8"
                                Visibility="{Binding ManuellesFehler, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="{Binding ManuellesFehler}" Foreground="#DC2626"
                                       FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <!-- KO-Modus: Paarungen -->
                        <ItemsControl ItemsSource="{Binding ManuelleKoPaarungen}"
                                      Visibility="{Binding IstManuellKoModus, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ManuelleKoPaarungAnzeige}">
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4"
                                            Background="White" Margin="0,0,0,4">
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding PaarungsNr}"
                                                       Foreground="#94A3B8" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <!-- Heim-Slot -->
                                            <Border Grid.Column="1"
                                                    Tag="{Binding HeimSlot}"
                                                    BorderThickness="1" CornerRadius="3" Padding="8,5"
                                                    AllowDrop="True"
                                                    Drop="ManuellerSlot_Drop"
                                                    DragOver="ManuellerSlot_DragOver"
                                                    DragEnter="ManuellerSlot_DragEnter"
                                                    DragLeave="ManuellerSlot_DragLeave"
                                                    MouseRightButtonUp="ManuellerSlot_MouseRightButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HeimSlot.IstLeer}" Value="False">
                                                                <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                <Setter Property="Background" Value="#F0FDF4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding HeimSlot.AnzeigeName}" FontSize="12"
                                                           Foreground="#475569" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text=" vs " FontSize="12"
                                                       Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0" />
                                            <!-- Auswärts-Slot -->
                                            <Border Grid.Column="3"
                                                    Tag="{Binding AuswaertsSlot}"
                                                    BorderThickness="1" CornerRadius="3" Padding="8,5"
                                                    AllowDrop="True"
                                                    Drop="ManuellerSlot_Drop"
                                                    DragOver="ManuellerSlot_DragOver"
                                                    DragEnter="ManuellerSlot_DragEnter"
                                                    DragLeave="ManuellerSlot_DragLeave"
                                                    MouseRightButtonUp="ManuellerSlot_MouseRightButtonUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                        <Setter Property="Background" Value="#F8FAFC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AuswaertsSlot.IstLeer}" Value="False">
                                                                <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                <Setter Property="Background" Value="#F0FDF4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding AuswaertsSlot.AnzeigeName}" FontSize="12"
                                                           Foreground="#475569" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Gruppenphase-Modus: Gruppen -->
                        <ItemsControl ItemsSource="{Binding ManuelleGruppen}"
                                      Visibility="{Binding IstManuellGruppenModus, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ManuelleGruppe}">
                                    <Border Width="160" Margin="0,0,8,8"
                                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Border Background="#EFF6FF" Padding="10,5" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding GruppenName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1E40AF" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Slots}" Background="White">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ManuellerGruppenSlot}">
                                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                                                Padding="10,5" MinHeight="30"
                                                                Tag="{Binding}"
                                                                AllowDrop="True"
                                                                Drop="ManuellerSlot_Drop"
                                                                DragOver="ManuellerSlot_DragOver"
                                                                DragEnter="ManuellerSlot_DragEnter"
                                                                DragLeave="ManuellerSlot_DragLeave"
                                                                MouseRightButtonUp="ManuellerSlot_MouseRightButtonUp">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IstLeer}" Value="False">
                                                                            <Setter Property="Background" Value="#F0FDF4" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding AnzeigeName}" FontSize="12"
                                                                       Foreground="#475569" VerticalAlignment="Center" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Abschließen -->
                        <Button Content="Auslosung abschließen"
                                Command="{Binding ManuelleAuslosungAbschliessenCommand}"
                                Padding="14,7" FontSize="13" Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Background="#16A34A" Foreground="White" BorderThickness="0" />
                    </StackPanel>

                    <!-- KO/Liga-Paarungs-Ergebnis (ausgeblendet während TV-Modus-Animation) -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding ZeigePaarungsergebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNISSE DER AUSLOSUNG" FontSize="11" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,0,0,8" />
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                            <ItemsControl ItemsSource="{Binding ErgebnisseAnzeige}" Background="White">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ErgebnisAnzeige}">
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PaarungsNummer}"
                                                           Foreground="#94A3B8" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                                    <Setter Property="Text"
                                                                            Value="{Binding HeimName, StringFormat='Freilos: {0}'}" />
                                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding HeimName}" FontWeight="SemiBold" />
                                                    <Run Text="  vs  " Foreground="#94A3B8" />
                                                    <Run Text="{Binding AuswaertsName}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
