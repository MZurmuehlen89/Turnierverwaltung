<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierDefinitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fussballturnierverwaltung.Wpf.Views">

    <DockPanel Background="{DynamicResource MaterialDesign.Brush.Background}"
               TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

        <!-- ── Gemeinsamer Header: Turnier-Auswahl ── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Turnier" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <views:TurnierAuswahlView DataContext="{Binding TabKoordinator}" />
            </StackPanel>
        </Border>

        <!-- ── Hinweis-Banner, wenn Runden für das gewählte Turnier gesperrt sind ── -->
        <Border DockPanel.Dock="Top" Background="#FEF3C7" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding RundenTabAktiv, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="Nur für Turniere mit Status &quot;Geplant&quot; bearbeitbar"
                       FontSize="12" Foreground="#92400E" />
        </Border>

        <!-- ── Sub-Navigation: Runden, Rundenübergänge (Issue #249), Paarungen (Issue #251) ── -->
        <TabControl SelectedIndex="{Binding TabKoordinator.AktiverTabIndex, Mode=TwoWay}"
                    BorderThickness="0">

            <TabItem Header="Runden">
                <ContentControl Content="{Binding RundenVm}" IsEnabled="{Binding RundenTabAktiv}" />
            </TabItem>
            <TabItem Header="Rundenübergänge">
                <ContentControl Content="{Binding UebergaengeVm}" />
            </TabItem>
            <TabItem Header="Paarungen">
                <ContentControl Content="{Binding PaarungenVm}" />
            </TabItem>

        </TabControl>

    </DockPanel>

</UserControl>
