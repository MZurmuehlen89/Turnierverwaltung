<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.MannschaftenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Filter-Leiste + DataGrid ── -->
        <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">

            <!-- Horizontale Filter-Leiste -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Suche -->
                    <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Padding="6,4" FontSize="12"
                             BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                             VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="🔍  Suchen …"
                                                                   Foreground="#9CA3AF" Margin="8,4"
                                                                   FontSize="12" />
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Land -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Land " FontSize="11" Foreground="#6B7280"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding LandFilterOptionen}"
                                  SelectedItem="{Binding FilterLandOption}"
                                  DisplayMemberPath="Anzeige"
                                  Width="120" Padding="4,2" FontSize="12"
                                  BorderBrush="{StaticResource BorderStrongBrush}" />
                    </StackPanel>

                    <!-- Verband -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Verband " FontSize="11" Foreground="#6B7280"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding VerbandFilterOptionen}"
                                  SelectedItem="{Binding FilterVerbandOption}"
                                  DisplayMemberPath="Anzeige"
                                  Width="120" Padding="4,2" FontSize="12"
                                  BorderBrush="{StaticResource BorderStrongBrush}" />
                    </StackPanel>

                    <!-- Art -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Art " FontSize="11" Foreground="#6B7280"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ArtFilterOptionen}"
                                  SelectedItem="{Binding FilterArtOption}"
                                  DisplayMemberPath="Anzeige"
                                  Width="100" Padding="4,2" FontSize="12"
                                  BorderBrush="{StaticResource BorderStrongBrush}" />
                    </StackPanel>

                    <!-- Rating min -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Rating ≥ " FontSize="11" Foreground="#6B7280"
                                   VerticalAlignment="Center" />
                        <Slider Value="{Binding FilterMinRating}"
                                Minimum="0" Maximum="99"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Width="80" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FilterMinRating}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Width="24" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- Reset -->
                    <Button Content="↺ Zurücksetzen"
                            Command="{Binding FilterZuruecksetzenCommand}"
                            FontSize="11" Padding="6,3"
                            VerticalAlignment="Center"
                            Cursor="Hand" />

                </WrapPanel>
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding MannschaftenGefiltert}"
                      SelectedItem="{Binding Ausgewaehlte}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      HeadersVisibility="Column"
                      AlternatingRowBackground="#F0F4F8"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="28"
                      FontSize="12">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                        <Setter Property="Foreground" Value="#374151" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE" />
                                <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="40" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="32" Height="32">
                                    <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                           Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                           Stretch="Uniform" />
                                    <TextBlock Text="⚽" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.4"
                                               Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="Kurz" Binding="{Binding Kurzname}" Width="52" />
                    <DataGridTextColumn Header="Land" Binding="{Binding Land.Name}" Width="130" />
                    <DataGridTextColumn Header="Art" Binding="{Binding Mannschaftsart}" Width="70" />

                    <DataGridTextColumn Header="OFF" Binding="{Binding OffensivRating}" Width="44">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="#059669" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="MIF" Binding="{Binding MittelfeldRating}" Width="44">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="#D97706" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="DEF" Binding="{Binding DefensivRating}" Width="44">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="⭐ Ges." Binding="{Binding GesamtRating, StringFormat={}{0:F1}}" Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Platzhalter -->
            <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="⚽" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Mannschaft auswählen oder" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                           FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Formular -->
            <ScrollViewer Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" MaxWidth="580">

                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,12" />

                    <!-- Wappen -->
                    <DockPanel Margin="0,0,0,16">
                        <Grid Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0">
                            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                            <Image Source="{Binding WappenDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding WappenDaten, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" Margin="4" />
                            <TextBlock Text="⚽" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding WappenDaten, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="Bild wählen…" Command="{Binding WappenWaehlenCommand}"
                                    HorizontalAlignment="Left" FontSize="12" Padding="8,4" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Entfernen" Command="{Binding WappenEntfernenCommand}"
                                    Visibility="{Binding WappenDaten, Converter={StaticResource NullToCollapsed}}"
                                    HorizontalAlignment="Left" FontSize="11" Padding="8,3" Cursor="Hand" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Name" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="#D1D5DB" BorderThickness="1" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Kurzname" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Kurzname, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="#D1D5DB" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Art" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding ArtOptionen}"
                                      SelectedItem="{Binding AusgewaehlteArt}"
                                      IsEnabled="{Binding IstNeuModus}"
                                      Padding="8,5" FontSize="13"
                                      BorderBrush="#D1D5DB" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Land" FontSize="12" Foreground="#374151" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Laender}"
                              SelectedItem="{Binding AusgewaehltesLand}"
                              DisplayMemberPath="Name"
                              Padding="8,5" FontSize="13" Margin="0,0,0,24"
                              BorderBrush="#D1D5DB" BorderThickness="1" />

                    <!-- Ratings -->
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Gesamt " FontSize="12" Foreground="#6B7280"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GesamtRating}" FontSize="16"
                                       FontWeight="Bold" Foreground="{StaticResource AccentStrongBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="RATINGS" FontWeight="SemiBold" FontSize="11"
                                   Foreground="#9CA3AF" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Offensiv" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding OffensivRating}" Minimum="1" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding OffensivRating}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mittelfeld" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding MittelfeldRating}" Minimum="1" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MittelfeldRating}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Defensiv" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding DefensivRating}" Minimum="1" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DefensivRating}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="STÄRKEN" FontWeight="SemiBold" FontSize="11"
                               Foreground="#9CA3AF" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Heimstärke" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding Heimstaerke}" Minimum="1" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Heimstaerke}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Auswärtsstärke" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding Auswaertsstaerke}" Minimum="1" Maximum="99" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Auswaertsstaerke}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Fehlermeldung -->
                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{StaticResource ErrorSoftBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
