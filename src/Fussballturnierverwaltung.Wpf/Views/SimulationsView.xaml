<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.SimulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="340" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <!-- Modus-Auswahl + Simulations-Modus -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel>
                    <ComboBox SelectedIndex="{Binding ModusIndex}" FontSize="12" Margin="0,0,0,6">
                        <ComboBoxItem Content="Turnierspiel" />
                        <ComboBoxItem Content="Freies Einzelspiel" />
                    </ComboBox>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Modus:" FontSize="11"
                                   Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding ModusOptionen}"
                                  SelectedItem="{Binding AusgewaehlterModus}"
                                  DisplayMemberPath="Anzeige"
                                  FontSize="11" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ── Turnierspiel-Modus ── -->
            <DockPanel Visibility="{Binding IstTurnierModus, Converter={StaticResource BoolToVisibility}}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">

                        <TextBlock Text="TURNIER" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding Instanzen}"
                                  SelectedItem="{Binding AusgewaehlteInstanz}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />

                        <TextBlock Text="RUNDE" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding Runden}"
                                  SelectedItem="{Binding AusgewaehlteRunde}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />

                        <StackPanel Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="SPIEL" FontSize="10" FontWeight="Bold"
                                       Foreground="#94A3B8" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{Binding Spiele}"
                                      SelectedItem="{Binding AusgewaehlteSpiel}"
                                      FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SpielZeile}">
                                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding HeimName}" />
                                            <Run Text=" – " Foreground="#94A3B8" />
                                            <Run Text="{Binding AuswaertsName}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding ErgebnisText}" Foreground="#64748B" FontFamily="Consolas" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="Simulieren"
                                    Command="{Binding TurnierSpielSimulierenBefehl}"
                                    Margin="0,14,0,0" Padding="0,10" FontSize="13"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding AusgewaehltesSpielAbgeschlossen, Converter={StaticResource InverseBoolToVisibility}}"
                                    Background="#8B5CF6" Foreground="White" BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#8B5CF6" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <StackPanel Visibility="{Binding AusgewaehltesSpielAbgeschlossen, Converter={StaticResource BoolToVisibility}}">

                                <Button Content="Ergebnis überschreiben"
                                        Command="{Binding ErgebnisUeberschreibenBefehl}"
                                        Margin="0,14,0,0" Padding="0,10" FontSize="13"
                                        HorizontalAlignment="Stretch"
                                        Background="#8B5CF6" Foreground="White" BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#8B5CF6" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Zurücksetzen"
                                        Command="{Binding ErgebnisZuruecksetzenBefehl}"
                                        Margin="0,8,0,0" Padding="0,10" FontSize="13"
                                        HorizontalAlignment="Stretch"
                                        Background="#EF4444" Foreground="White" BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#EF4444" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                            </StackPanel>

                        </StackPanel>

                        <TextBlock Text="Simuliert…" FontSize="12" Foreground="#94A3B8"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>

            <!-- ── Einzelspiel-Modus ── -->
            <DockPanel Visibility="{Binding IstEinzelspielModus, Converter={StaticResource BoolToVisibility}}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">

                        <TextBlock Text="HEIMTEAM" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,4,0,4" />
                        <ComboBox ItemsSource="{Binding AlleMannschaften}"
                                  SelectedItem="{Binding EinzelspielHeim}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />

                        <TextBlock Text="AUSWÄRTSTEAM" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding AlleMannschaften}"
                                  SelectedItem="{Binding EinzelspielAuswaerts}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />

                        <TextBlock Text="REGELWERK (OPTIONAL)" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A3B8" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding AlleRegelwerke}"
                                  SelectedItem="{Binding EinzelspielRegelwerk}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />
                        <TextBlock Text="Leer = kein Tiebreaker" FontSize="10"
                                   Foreground="#94A3B8" Margin="0,2,0,0" />

                        <CheckBox Content="Mit Rückspiel"
                                  IsChecked="{Binding EinzelspielMitRueckspiel}"
                                  Margin="0,14,0,0" FontSize="13" />

                        <Button Content="Simulieren"
                                Command="{Binding EinzelspielFreiBefehl}"
                                Margin="0,14,0,0" Padding="0,10" FontSize="13"
                                HorizontalAlignment="Stretch"
                                Background="#8B5CF6" Foreground="White" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#8B5CF6" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="Simuliert…" FontSize="12" Foreground="#94A3B8"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>

        </DockPanel>

        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Rechter Bereich: Protokoll ── -->
        <DockPanel Grid.Column="2">

            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SPIELPROTOKOLL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" />
                    <TextBlock Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Text=" · "
                               Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding ProtokollSpielInfo}" FontSize="11" FontWeight="Bold"
                               Foreground="#475569"
                               Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- Fehlermeldung -->
            <Border DockPanel.Dock="Top" Margin="16,10,16,0"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="4" Padding="12,8"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Status -->
            <Border DockPanel.Dock="Top" Margin="16,8,16,0"
                    Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="4" Padding="12,8"
                    Visibility="{Binding StatusMeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding StatusMeldung}" Foreground="#166534"
                           FontSize="12" />
            </Border>

            <!-- Ergebnis-Karte -->
            <Border DockPanel.Dock="Top"
                    Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="6" Padding="16,12" Margin="16,12,16,0"
                    Visibility="{Binding HatProtokoll, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="ERGEBNIS" FontSize="10" FontWeight="Bold"
                               Foreground="#16A34A" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ProtokollZeilen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1E293B" FontFamily="Consolas" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Spielverlauf (Ausführliche Simulation) -->
            <Border DockPanel.Dock="Top"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="4" Margin="16,8,16,0"
                    Visibility="{Binding HatProtokollEreignisse, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="SPIELVERLAUF" FontSize="10" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="12,8,12,4" />

                    <Grid Margin="12,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HEIM" FontSize="9" FontWeight="Bold"
                                   Foreground="#CBD5E1" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="AUSWÄRTS" FontSize="9" FontWeight="Bold"
                                   Foreground="#CBD5E1" HorizontalAlignment="Left" />
                    </Grid>
                    <Separator />

                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProtokollEreignisse}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EinzelspielEreignisZeile}">
                                    <Grid>
                                        <!-- Ereignis-Zeile -->
                                        <Grid Margin="12,4"
                                              Visibility="{Binding IstTrenner, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IstHeimSeite, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Art}" FontSize="11"
                                                           Foreground="#1E293B" TextAlignment="Right" />
                                                <TextBlock Text=" ◄" FontSize="11" FontWeight="Bold"
                                                           Foreground="#8B5CF6" Margin="4,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Minute}" FontSize="11"
                                                       Foreground="#64748B" FontFamily="Consolas"
                                                       HorizontalAlignment="Center" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding IstHeimSeite, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="► " FontSize="11" FontWeight="Bold"
                                                           Foreground="#8B5CF6" />
                                                <TextBlock Text="{Binding Art}" FontSize="11" Foreground="#1E293B" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Abschnittstrenner -->
                                        <Grid Margin="12,10"
                                              Visibility="{Binding IstTrenner, Converter={StaticResource BoolToVisibility}}">
                                            <Separator VerticalAlignment="Center" />
                                            <Border Background="White" HorizontalAlignment="Center" Padding="8,0">
                                                <TextBlock Text="{Binding TrennerText}" FontSize="9" FontWeight="Bold"
                                                           Foreground="#94A3B8" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Leer-Zustand -->
            <TextBlock Text="Spiel auswählen und auf Simulieren klicken&#x0a;— oder über Spielplan → Ausführliche Simulation starten."
                       Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="340" TextAlignment="Center"
                       Visibility="{Binding HatProtokoll, Converter={StaticResource InverseBoolToVisibility}}" />

        </DockPanel>

    </Grid>
</UserControl>
