<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.SimulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <UserControl.Resources>
        <!-- Flache ComboBox fuer die Breadcrumb-Leiste (Turnier/Runde/Spiel) -->
        <Style x:Key="BreadcrumbCombo" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinWidth" Value="90" />
        </Style>

        <Style x:Key="BreadcrumbTrenner" TargetType="TextBlock">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSubtleBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

    </UserControl.Resources>

    <DockPanel>

        <!-- Kopf-Leiste: Breadcrumb (Turnier › Runde › Spiel) — Issue #174: Einzelspiel-Simulation
             ist jetzt ein eigenständiger Menüpunkt, kein Modus-Umschalter mehr nötig -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏆" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding AusgewaehlteInstanz.Name}" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" />

                <TextBlock Style="{StaticResource BreadcrumbTrenner}"
                           Visibility="{Binding AusgewaehlteInstanz, Converter={StaticResource NullToCollapsed}}" />
                <ComboBox ItemsSource="{Binding Runden}"
                          SelectedItem="{Binding AusgewaehlteRunde}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource BreadcrumbCombo}"
                          Visibility="{Binding AusgewaehlteInstanz, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Style="{StaticResource BreadcrumbTrenner}"
                           Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox ItemsSource="{Binding Spiele}"
                          SelectedItem="{Binding AusgewaehlteSpiel}"
                          Style="{StaticResource BreadcrumbCombo}"
                          MinWidth="220"
                          Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SpielZeile}">
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding HeimName}" />
                                <Run Text=" – " Foreground="{StaticResource TextSubtleBrush}" />
                                <Run Text="{Binding AuswaertsName}" />
                                <Run Text=" " />
                                <Run Text="{Binding ErgebnisText}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Simuliert…" FontSize="12" Foreground="{StaticResource TextSubtleBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <DockPanel>

            <!-- Team-Vorschau-Karte vor der Simulation -->
            <Border DockPanel.Dock="Top" Margin="16,16,16,0"
                    Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius8}" Padding="24,20"
                    Visibility="{Binding ZeigeVorschauKarte, Converter={StaticResource BoolToVisibility}}">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="24,0">
                        <Grid Width="48" Height="48" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Image Source="{Binding AusgewaehlteSpiel.HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding AusgewaehlteSpiel.HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" />
                            <TextBlock Text="🏳" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding AusgewaehlteSpiel.HeimWappen, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                        <TextBlock Text="{Binding AusgewaehlteSpiel.HeimName}"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="24,0">
                        <Grid Width="48" Height="48" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Image Source="{Binding AusgewaehlteSpiel.AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding AusgewaehlteSpiel.AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" />
                            <TextBlock Text="🏳" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding AusgewaehlteSpiel.AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                        <TextBlock Text="{Binding AusgewaehlteSpiel.AuswaertsName}"
                                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextStrongBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding AusgewaehlteSpiel.HeimRating, StringFormat={}⭐ {0:F1}}"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="vs" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" Margin="16,4,16,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="{Binding AusgewaehlteSpiel.AuswaertsRating, StringFormat={}⭐ {0:F1}}"
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Fehlermeldung -->
            <Border DockPanel.Dock="Top" Margin="16,10,16,0"
                    Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Padding="12,8"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Ergebnis-Karte -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource SuccessSoftBrush}" BorderBrush="#BBF7D0" BorderThickness="1"
                    CornerRadius="{StaticResource Radius6}" Padding="16,12" Margin="16,12,16,0"
                    Visibility="{Binding HatProtokoll, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="ERGEBNIS" FontSize="10" FontWeight="Bold"
                               Foreground="#16A34A" Margin="0,0,0,8" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding ProtokollZeilen}"
                                  HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProtokollErgebnisZeile}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                    <TextBlock Text="{Binding Label, StringFormat={}{0}:  }" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas"
                                               Visibility="{Binding Label, Converter={StaticResource NullToCollapsed}}" />

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ZeigtTeams, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Width="32" Height="32" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="🏳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.35"
                                                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding HeimName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Score}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" Margin="8,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding AuswaertsName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" Margin="0,0,5,0"
                                                   VerticalAlignment="Center" />
                                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="🏳" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.35"
                                                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Detail}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Score}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" VerticalAlignment="Center"
                                               Visibility="{Binding ZeigtTeams, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Spielverlauf (Ausführliche Simulation) -->
            <Border DockPanel.Dock="Top"
                    Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius4}" Margin="16,8,16,0"
                    Visibility="{Binding HatProtokollEreignisse, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="SPIELVERLAUF" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" Margin="12,8,12,4" />

                    <Grid Margin="12,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="HEIM" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="AUSWÄRTS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Left" />
                    </Grid>
                    <Separator />

                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProtokollEreignisse}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EinzelspielEreignisZeile}">
                                    <Grid>
                                        <!-- Ereignis-Zeile -->
                                        <Grid Margin="12,4"
                                              Visibility="{Binding IstTrenner, Converter={StaticResource InverseBoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IstHeimSeite, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Art}" FontSize="11"
                                                           Foreground="{StaticResource TextStrongBrush}" TextAlignment="Right" />
                                                <TextBlock Text=" ◄" FontSize="11" FontWeight="Bold"
                                                           Foreground="#8B5CF6" Margin="4,0,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Minute}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"
                                                       HorizontalAlignment="Center" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding IstHeimSeite, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="► " FontSize="11" FontWeight="Bold"
                                                           Foreground="#8B5CF6" />
                                                <TextBlock Text="{Binding Art}" FontSize="11" Foreground="{StaticResource TextStrongBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Abschnittstrenner -->
                                        <Grid Margin="12,10"
                                              Visibility="{Binding IstTrenner, Converter={StaticResource BoolToVisibility}}">
                                            <Separator VerticalAlignment="Center" />
                                            <Border Background="White" HorizontalAlignment="Center" Padding="8,0">
                                                <TextBlock Text="{Binding TrennerText}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSubtleBrush}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Leer-Zustand -->
            <TextBlock Text="Spiel auswählen und auf Simulieren klicken&#x0a;— oder über Spielplan → Ausführliche Simulation starten."
                       Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="340" TextAlignment="Center"
                       Visibility="{Binding ZeigeLeerZustand, Converter={StaticResource BoolToVisibility}}" />

        </DockPanel>
    </DockPanel>
</UserControl>
