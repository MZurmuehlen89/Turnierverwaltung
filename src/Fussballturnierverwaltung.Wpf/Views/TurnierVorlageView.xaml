<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierVorlageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <conv:VorlagenKategorieZuTextConverter x:Key="KategorieZuText" />
        <conv:RundenartZuTextConverter x:Key="RundenartZuText" />

        <!-- Von den Vorlagen-DataGrids (Runden, Übergangsregeln) gemeinsam genutzte Styles -->
        <Style x:Key="VorlagenGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="VorlagenGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <!-- Meldungs-Spalte (Issue #222, analog #188) — 0 Breite solange nichts zu melden ist. -->
            <ColumnDefinition Width="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolZuAngepinnterSpaltenbreite}, ConverterParameter=4}" />
            <ColumnDefinition Width="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolZuAngepinnterSpaltenbreite}, ConverterParameter=300}"
                              MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Filter + Liste ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="🔍  Suchen …"
                         materialDesign:HintAssist.IsFloating="False"
                         Padding="6,4" FontSize="13"
                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
            </Border>

            <!-- Kategorie-Filter -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <ComboBox ItemsSource="{Binding KategorieFilterOptionen}"
                          SelectedItem="{Binding KategorieFilter}"
                          DisplayMemberPath="Anzeige"
                          FontSize="13" />
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding VorlagenGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <StaticResource ResourceKey="StandardListBoxItemStyle" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Grid Width="28" Height="28" DockPanel.Dock="Left" Margin="0,0,8,0">
                                <Image Source="{Binding Logo, Converter={StaticResource BildDatenZuBildquelle}}"
                                       Visibility="{Binding Logo, Converter={StaticResource NullToCollapsed}}"
                                       Stretch="Uniform" />
                                <TextBlock Text="🏆" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Opacity="0.4"
                                           Visibility="{Binding Logo, Converter={StaticResource NullToVisible}}" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding VorlagenKategorie, Converter={StaticResource KategorieZuText}}"
                                               FontSize="11" Opacity="0.60" />
                                    <TextBlock Text=" · " FontSize="11" Opacity="0.60" />
                                    <TextBlock Text="{Binding ErforderlicheMannschaftsanzahl, StringFormat='{}{0} Teams'}"
                                               FontSize="11" Opacity="0.60" />
                                    <TextBlock FontSize="11" Opacity="0.60"
                                               Visibility="{Binding IstHistorisch, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text=" · " /><Run Text="historisch" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechte Spalte: Formular ── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Platzhalter wenn kein Formular -->
                <TextBlock Text="Wählen Sie eine Turniervorlage aus oder legen Sie eine neue an."
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <!-- Logo -->
                    <DockPanel Margin="0,0,0,16">
                        <Grid Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0">
                            <Border Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                            <Image Source="{Binding LogoDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding LogoDaten, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" Margin="4" />
                            <TextBlock Text="🏆" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding LogoDaten, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <Button Content="Bild wählen…" Command="{Binding LogoWaehlenCommand}"
                                    HorizontalAlignment="Left" FontSize="12" Padding="8,4" Margin="0,0,0,6" Cursor="Hand" />
                            <Button Content="Entfernen" Command="{Binding LogoEntfernenCommand}"
                                    Visibility="{Binding LogoDaten, Converter={StaticResource NullToCollapsed}}"
                                    HorizontalAlignment="Left" FontSize="11" Padding="8,3" Cursor="Hand" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <TextBlock Text="Beschreibung" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <!-- TURNIER-EINSTELLUNGEN -->
                    <TextBlock Text="TURNIER-EINSTELLUNGEN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,8,0,8" />

                    <TextBlock Text="Kategorie" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding KategorieOptionen}"
                              SelectedItem="{Binding AusgewaehlteKategorie}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Erforderliche Mannschaftsanzahl" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AnzahlMannschaften, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12" Width="120"
                             HorizontalAlignment="Left"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <CheckBox Content="Historisch (abgeschlossene Edition)"
                              IsChecked="{Binding IstHistorisch}"
                              FontSize="13" Margin="0,0,0,16" />

                    <!-- GÜLTIGKEIT -->
                    <TextBlock Text="GÜLTIGKEIT" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Gültig von (Jahr)" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding GueltigVon, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gültig bis (Jahr)" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding GueltigBis, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- TURNIERRUNDEN -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋" ToolTip="Runde hinzufügen"
                                    Command="{Binding RundeHinzufuegenCommand}"
                                    Width="28" Height="24" FontSize="14" Padding="0"
                                    Margin="0,0,4,0" Cursor="Hand" />
                            <Button Content="↑" ToolTip="Nach oben"
                                    Command="{Binding RundeNachObenCommand}"
                                    Width="28" Height="24" FontSize="13" Padding="0"
                                    Margin="0,0,4,0" Cursor="Hand" />
                            <Button Content="↓" ToolTip="Nach unten"
                                    Command="{Binding RundeNachUntenCommand}"
                                    Width="28" Height="24" FontSize="13" Padding="0"
                                    Margin="0,0,4,0" Cursor="Hand" />
                            <Button Content="－" ToolTip="Runde entfernen"
                                    Command="{Binding RundeEntfernenCommand}"
                                    Width="28" Height="24" FontSize="14" Padding="0"
                                    Cursor="Hand" />
                        </StackPanel>
                        <TextBlock Text="TURNIERRUNDEN" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" VerticalAlignment="Center" />
                    </DockPanel>

                    <DataGrid x:Name="RundenGrid"
                              ItemsSource="{Binding RundenZeilen}"
                              SelectedItem="{Binding AusgewaehlteRunde}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                              Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                              BorderThickness="0"
                              RowHeight="28"
                              FontSize="12"
                              Margin="0,0,0,16"
                              ColumnHeaderStyle="{StaticResource VorlagenGridColumnHeaderStyle}"
                              RowStyle="{StaticResource StandardDataGridRowStyle}"
                              CellStyle="{StaticResource VorlagenGridCellStyle}">

                        <DataGrid.Columns>

                            <!-- Name -->
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*" MinWidth="100" />

                            <!-- Rundenart: Anzeige per Converter, Bearbeitung per ComboBox -->
                            <DataGridTemplateColumn Header="Rundenart" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Rundenart, Converter={StaticResource RundenartZuText}}"
                                                   Margin="8,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Rundenart, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.RundenartOptionen,
                                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  BorderThickness="0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource RundenartZuText}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Eingang -->
                            <DataGridTextColumn Header="Eingang"
                                                Binding="{Binding EingangsMannschaftsanzahl, UpdateSourceTrigger=PropertyChanged}"
                                                Width="64">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Ausgang -->
                            <DataGridTextColumn Header="Ausgang"
                                                Binding="{Binding AusgangsMannschaftsanzahl, UpdateSourceTrigger=PropertyChanged}"
                                                Width="64">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Gruppen (nur bei Gruppenphase relevant, leer = nicht gesetzt) -->
                            <DataGridTextColumn Header="Gruppen"
                                                Binding="{Binding GruppenAnzahl, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                Width="64">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Hin+Rückspiel -->
                            <DataGridCheckBoxColumn Header="H+R"
                                                    Binding="{Binding MitRueckspiel, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="52" />

                            <!-- Auswärtstore -->
                            <DataGridCheckBoxColumn Header="AuswTor"
                                                    Binding="{Binding AuswaertstorRegelAktiv, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80" />

                            <!-- Regelwerk -->
                            <DataGridTemplateColumn Header="Regelwerk" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Regelwerk.Anzeige}"
                                                   VerticalAlignment="Center" Margin="4,0" FontSize="12" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Regelwerk, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.RegelwerkOptionen,
                                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Anzeige"
                                                  FontSize="12" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ÜBERGANGSREGELN (Issue #166) -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋" ToolTip="Übergangsregel hinzufügen"
                                    Command="{Binding UebergangsregelHinzufuegenCommand}"
                                    Width="28" Height="24" FontSize="14" Padding="0"
                                    Margin="0,0,4,0" Cursor="Hand" />
                            <Button Content="－" ToolTip="Übergangsregel entfernen"
                                    Command="{Binding UebergangsregelEntfernenCommand}"
                                    Width="28" Height="24" FontSize="14" Padding="0"
                                    Cursor="Hand" />
                        </StackPanel>
                        <TextBlock Text="ÜBERGANGSREGELN" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Definiert, welche Platzierungen einer Runde in welche Folgerunde übergehen. Wird beim Laden dieser Vorlage im Runden-Editor automatisch in echte Übergangsregeln zwischen den neu angelegten Runden übersetzt. Zeigt nur die Regeln der oben in der Runden-Tabelle ausgewählten Runde (als Quelle oder Ziel)."
                               FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Text="Wählen Sie oben eine Runde aus, um deren Übergangsregeln zu sehen."
                               FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,16"
                               Visibility="{Binding KeineRundeFokussiert, Converter={StaticResource BoolToVisibility}}" />

                    <DataGrid x:Name="UebergangsregelGrid"
                              Visibility="{Binding KeineRundeFokussiert, Converter={StaticResource InverseBoolToVisibility}}"
                              ItemsSource="{Binding UebergangsregelZeilenFuerFokussierteRunde}"
                              SelectedItem="{Binding AusgewaehlteUebergangsregel}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                              Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                              BorderThickness="0"
                              RowHeight="28"
                              FontSize="12"
                              Margin="0,0,0,16"
                              ColumnHeaderStyle="{StaticResource VorlagenGridColumnHeaderStyle}"
                              RowStyle="{StaticResource StandardDataGridRowStyle}"
                              CellStyle="{StaticResource VorlagenGridCellStyle}">

                        <DataGrid.Columns>

                            <!-- Quelle -->
                            <DataGridTemplateColumn Header="Quelle" Width="*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quelle.Name}" Margin="8,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Quelle, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.RundenZeilen,
                                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Name"
                                                  BorderThickness="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ziel -->
                            <DataGridTemplateColumn Header="Ziel" Width="*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Ziel.Name}" Margin="8,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Ziel, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.RundenZeilen,
                                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Name"
                                                  BorderThickness="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Gruppe (leer = alle Gruppen) -->
                            <DataGridTextColumn Header="Gruppe" Width="64"
                                                Binding="{Binding GruppeIndex, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Platz von/bis -->
                            <DataGridTextColumn Header="Platz von"
                                                Binding="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Platz bis"
                                                Binding="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                Width="72">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Gruppenübergreifende Rangfolge-Regel (Issue #217): leer = normale Regel,
                                 gesetzt = die N besten Teams dieser Platzierung über alle Gruppen hinweg -->
                            <DataGridTextColumn Header="Beste N"
                                                Binding="{Binding AnzahlBeste, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                Width="64">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Meldungs-Spalte (Issue #222, analog #188) ── Sammelt Speicherfehler und Live-Strukturfehler
             dauerhaft am rechten Rand, damit sie bei einem langen Formular nicht erst durch Scrollen
             sichtbar werden (siehe TurnierVorlageViewModel.AktualisiereStrukturFehler). -->
        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource MaterialDesign.Brush.Card.Border}"
                      Visibility="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="8,10,8,8" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

                <!-- Fehlermeldung -->
                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" TextWrapping="Wrap" />
                </Border>

                <!-- Formularfehler (Issue #234): Live-Vorschau von TurnierVorlageValidator (Basisdaten,
                     Turniereinstellungen, einzelne Runden-Felder) — bisher gar nicht geprüft. -->
                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,10" Margin="0,0,0,10"
                        Visibility="{Binding HatFormularFehler, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="FORMULARPRÜFUNG" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding FormularFehler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#991B1B"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Strukturfehler (Issue #222): Live-Vorschau der VorlagenUebergangsregelValidator-Prüfung,
                     die bisher nur beim Speichern lief. -->
                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,10"
                        Visibility="{Binding HatStrukturFehler, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="STRUKTURPRÜFUNG" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding StrukturFehler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#991B1B"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
