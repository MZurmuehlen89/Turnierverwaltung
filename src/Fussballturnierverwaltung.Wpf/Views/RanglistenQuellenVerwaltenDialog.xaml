<Window x:Class="Fussballturnierverwaltung.Wpf.Views.RanglistenQuellenVerwaltenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ranglisten-Quellen verwalten"
        Width="720" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Neu…" Click="NeuButton_Click" Padding="12,5" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Bearbeiten…" Click="BearbeitenButton_Click" Padding="12,5" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Löschen" Click="LoeschenButton_Click" Padding="12,5" Cursor="Hand" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Schließen" Click="SchliessenButton_Click" Padding="14,6" FontSize="12" Cursor="Hand" />
        </StackPanel>

        <DataGrid x:Name="QuellenGrid"
                  ItemsSource="{Binding Quellen}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                  HeadersVisibility="Column"
                  AlternationCount="2"
                  Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                  BorderThickness="0"
                  RowHeight="28"
                  FontSize="13"
                  RowStyle="{StaticResource StandardDataGridRowStyle}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*" MinWidth="200" />
                <DataGridTextColumn Header="Team-Spalte" Binding="{Binding MannschaftSpalte}" Width="90" />
                <DataGridTextColumn Header="Punkte-Spalte" Binding="{Binding PunkteSpalte}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
