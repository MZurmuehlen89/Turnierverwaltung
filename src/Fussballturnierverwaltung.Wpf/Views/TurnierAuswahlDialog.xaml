<Window x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierAuswahlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turnier auswählen"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="12">

        <!-- Suchfeld -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,4" Margin="0,0,0,8">
            <TextBox x:Name="SuchBox"
                     TextChanged="SuchBox_TextChanged"
                     Padding="6,4" FontSize="13"
                     BorderThickness="0">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="🔍  Suchen …" Foreground="#9CA3AF"
                                                           Margin="6,4" FontSize="13" />
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <!-- Übernehmen / Abbrechen -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Abbrechen" Click="AbbrechenButton_Click"
                    Padding="14,6" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Übernehmen" Click="UebernehmenButton_Click"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>

        <DataGrid x:Name="AuswahlGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E2E8F0"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F8FAFC"
                  Background="White"
                  BorderBrush="#E2E8F0" BorderThickness="1"
                  RowHeight="30"
                  FontSize="13"
                  MouseDoubleClick="AuswahlGrid_MouseDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E2E8F0" />
                    <Setter Property="Foreground" Value="#374151" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#DBEAFE" />
                            <Setter Property="Foreground" Value="#1E40AF" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="#EFF6FF" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Saison" Binding="{Binding SaisonOderJahr}" Width="100" />
                <DataGridTextColumn Header="Status"
                                     Binding="{Binding Status, Converter={StaticResource TurnierStatusZuText}}"
                                     Width="110" />
                <DataGridTextColumn Header="Vorlage" Binding="{Binding TurnierVorlage.Name}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
