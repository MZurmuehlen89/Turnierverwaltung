<Window x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierAuswahlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Turnier auswählen"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <DockPanel Margin="12">

        <!-- Suchfeld -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" Padding="6,4" Margin="0,0,0,8">
            <TextBox x:Name="SuchBox"
                     TextChanged="SuchBox_TextChanged"
                     materialDesign:HintAssist.Hint="🔍  Suchen …"
                     materialDesign:HintAssist.IsFloating="False"
                     Padding="6,4" FontSize="13"
                     BorderThickness="0" />
        </Border>

        <!-- Übernehmen / Abbrechen -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Abbrechen" Click="AbbrechenButton_Click"
                    Padding="14,6" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Übernehmen" Click="UebernehmenButton_Click"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>

        <DataGrid x:Name="AuswahlGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                  Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                  BorderThickness="0"
                  RowHeight="30"
                  FontSize="13"
                  MouseDoubleClick="AuswahlGrid_MouseDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="8,5" />
                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                    <Setter Property="BorderThickness" Value="0,0,1,0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.DataGrid.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <!-- Card.Border ist als Hover-Fläche heller als die geerbte helle Dark-Theme-Textfarbe verträgt
                                 (weiß auf hell) — Foreground hier auf die alte, für Hellflächen gedachte Textfarbe gepinnt. -->
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Saison" Binding="{Binding SaisonOderJahr}" Width="100" />
                <DataGridTextColumn Header="Status"
                                     Binding="{Binding Status, Converter={StaticResource TurnierStatusZuText}}"
                                     Width="110" />
                <DataGridTextColumn Header="Vorlage" Binding="{Binding TurnierVorlage.Name}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
