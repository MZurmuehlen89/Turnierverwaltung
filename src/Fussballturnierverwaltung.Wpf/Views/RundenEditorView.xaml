<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.RundenEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters">

    <UserControl.Resources>
        <conv:RundenartZuTextConverter x:Key="RundenartZuText" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <!-- Meldungs-Spalte (Issue #188-Folgefeedback) — 0 Breite solange nichts zu melden ist,
                 analog zu den Verband-Quoten in der Auslosung. -->
            <ColumnDefinition Width="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolZuAngepinnterSpaltenbreite}, ConverterParameter=4}" />
            <ColumnDefinition Width="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolZuAngepinnterSpaltenbreite}, ConverterParameter=300}"
                              MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- ── Spalte 1: Vorlage laden + Rundenliste ── -->
        <DockPanel Grid.Column="0">

            <!-- Placeholder wenn kein Turnier -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Turnier auswählen"
                       Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap"
                       Margin="12,60,12,0" TextAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <!-- Vorlage laden (nur wenn Turnier gewählt) -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7"
                    Visibility="{Binding RundenEditorAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="VORLAGE LADEN" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding TurnierVorlagen}"
                                  SelectedItem="{Binding AusgewaehlteVorlagenquelle}"
                                  DisplayMemberPath="Name"
                                  FontSize="12" />
                        <Button Grid.Column="2"
                                Content="Laden"
                                Command="{Binding VorlageRundenLadenCommand}"
                                Padding="8,4" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rundenliste -->
            <ListBox ItemsSource="{Binding Runden}"
                     SelectedItem="{Binding AusgewaehlteRunde}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding RundenEditorAktiv, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding Rundenart, Converter={StaticResource RundenartZuText}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding EingangsMannschaften}" />
                                <Run Text="→" />
                                <Run Text="{Binding AusgangsMannschaften}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- ── Spalte 2: Detailformular ── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Kein Turnier gewählt -->
                <TextBlock Text="Wählen Sie oben ein Turnier aus, um dessen Runden zu bearbeiten."
                           Foreground="{StaticResource TextSubtleBrush}" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

                <!-- Turnier gewählt: Runden-Placeholder oder Formular -->
                <StackPanel Visibility="{Binding RundenEditorAktiv, Converter={StaticResource BoolToVisibility}}">

                <!-- Keine Runde ausgewählt -->
                <TextBlock Text="Wählen Sie eine Runde aus der Liste oder klicken Sie auf ＋ für eine neue Runde."
                           Foreground="{StaticResource TextSubtleBrush}" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding FormularSichtbar, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- Formular (Runde ausgewählt) -->
                <StackPanel Visibility="{Binding FormularSichtbar, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="RUNDENDETAILS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />

                    <TextBlock Text="Rundenart" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RundenartOptionen}"
                              SelectedItem="{Binding Rundenart}"
                              FontSize="13" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RundenartZuText}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Eingang" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Eingang, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EingangEditierbar}"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                            <TextBlock Text="Diese Runde hat bereits eingehende Übergangsregeln — der Eingang wird automatisch aus deren Platzierungsbereichen berechnet."
                                       Foreground="{StaticResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding ZeigeUebergangsregelnEingangHinweis, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ausgang" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Ausgang, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding AusgangEditierbar}"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                            <TextBlock Text="Bei K.-o.-Rundenarten wird der Ausgang automatisch aus dem Eingang berechnet (Eingang / 2)."
                                       Foreground="{StaticResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding IstKoRundenart, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="Diese Runde hat bereits ausgehende Übergangsregeln — der Ausgang wird automatisch aus deren Platzierungsbereichen berechnet."
                                       Foreground="{StaticResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding ZeigeUebergangsregelnAusgangHinweis, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Gruppenanzahl (nur bei Gruppenphase) -->
                    <StackPanel Visibility="{Binding GruppenAnzahlSichtbar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Anzahl Gruppen" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding GruppenAnzahl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13" Margin="0,0,0,12"
                                 BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                    </StackPanel>

                    <TextBlock Text="Regelwerk" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RegelwerkOptionen}"
                              SelectedItem="{Binding Regelwerk}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <CheckBox Content="Mit Hin- und Rückspiel"
                              IsChecked="{Binding MitRueckspiel}"
                              IsEnabled="{Binding MitRueckspielVerfuegbar}"
                              FontSize="12" Margin="0,0,0,8" />

                    <CheckBox Content="Auswärtstorregel aktiv"
                              IsChecked="{Binding AuswaertstorRegelAktiv}"
                              IsEnabled="{Binding AuswaertstorAktivierbar}"
                              FontSize="12" Margin="16,0,0,16" />

                    <!-- Escape-Hatch für nicht-lineare Rundenketten (Issue #178) — sobald eingehende
                         Übergangsregeln existieren, wird die Checkbox automatisch mitgesetzt (Issue #186)
                         und ausgeblendet, da sie dann redundant wäre. -->
                    <StackPanel Visibility="{Binding ZeigeEingangUeberUebergangsregelnCheckbox, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Eingang wird über Übergangsregeln definiert"
                                  IsChecked="{Binding EingangUeberUebergangsregeln}"
                                  FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="Diese Runde wird nicht gegen die unmittelbar vorangehende Runde in der Liste geprüft, sondern erhält ihren Eingang aus den unten konfigurierten Übergangsregeln."
                                   Foreground="{StaticResource TextSubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding EingangUeberUebergangsregeln, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Eingehende Übergangsregeln (Issue #169) -->
                    <StackPanel Visibility="{Binding EingehendeUebergangsregelnSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,16">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Weitere Quellrunde"
                                    Command="{Binding NeuerUebergangsregelBlockCommand}"
                                    Padding="8,4" FontSize="12" Cursor="Hand" />
                            <TextBlock Text="EINGEHENDE ÜBERGANGSREGELN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding EingehendeUebergangsregelBloecke}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius4}" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>

                                            <!-- Kopfzeile: Quellrunden-Auswahl + Löschen -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Aus Runde:" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ComboBox Width="220" FontSize="12"
                                                              ItemsSource="{Binding DataContext.FrueherRundenOptionen,
                                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding QuellRunde}"
                                                              DisplayMemberPath="NameFuerQuellrundenAuswahl"
                                                              IsEnabled="{Binding IstNeu}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" ToolTip="Block entfernen"
                                                        Command="{Binding LoeschenCommand}"
                                                        Width="24" Height="24" Padding="0" FontSize="11" Cursor="Hand" />
                                            </Grid>

                                            <!-- Hinweis: Zeilen passen nicht mehr zur aktuellen Form der Quellrunde (Issue #183) -->
                                            <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius4}"
                                                    Padding="8,6" Margin="0,0,0,8"
                                                    Visibility="{Binding PasstZurQuellrunde, Converter={StaticResource InverseBoolToVisibility}}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Aktualisieren" Command="{Binding AktualisierenCommand}"
                                                            Padding="8,4" FontSize="11" Cursor="Hand" />
                                                    <TextBlock Text="Passt nicht mehr zur aktuellen Quellrunde (fehlende oder überzählige Gruppen/Spiele). Danach speichern nicht vergessen."
                                                               Foreground="#92400E" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>

                                            <!-- Gruppenphase: Standardbereich + Tabelle je Gruppe -->
                                            <StackPanel Visibility="{Binding IstGruppenphase, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Standard Platz" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding StandardPlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                    <TextBox Grid.Column="3" Text="{Binding StandardPlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" FontSize="12" />
                                                    <Button Grid.Column="5" Content="Für alle Gruppen anwenden"
                                                            Command="{Binding StandardAnwendenCommand}"
                                                            Padding="8,4" FontSize="11" Margin="8,0,0,0" Cursor="Hand" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding GruppenLabel}" FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                                <TextBox Grid.Column="3" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                                <Button Grid.Column="5" Content="Standard übernehmen" FontSize="10"
                                                                        Visibility="{Binding IstAbweichend, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.ZeileZuruecksetzenCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="6,3" Cursor="Hand" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Gruppenübergreifende Rangfolge-Regeln (Issue #184), z.B. "beste 2 Gruppendritte" -->
                                                <ItemsControl ItemsSource="{Binding GruppenuebergreifendeZeilen}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Beste N von Platz" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding Platzierung, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBlock Grid.Column="2" Text="Anzahl" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                <TextBox Grid.Column="3" Text="{Binding AnzahlBeste, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <Button Grid.Column="4" Content="✕" ToolTip="Zeile entfernen" FontSize="10"
                                                                        Command="{Binding DataContext.GruppenuebergreifendeZeileEntfernenCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="20" Height="20" Padding="0" Margin="8,0,0,0" Cursor="Hand" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="+ Gruppenübergreifende Regel" Command="{Binding NeueGruppenuebergreifendeZeileCommand}"
                                                        HorizontalAlignment="Left" Padding="8,4" FontSize="11" Margin="0,4,0,0" Cursor="Hand" />
                                            </StackPanel>

                                            <!-- Liga: einzelnes kompaktes Platzierungsbereich-Feld -->
                                            <Grid Visibility="{Binding IstLiga, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Platzierung" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBox Grid.Column="2" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- K.o./Finale/Spiel um Platz 3: Sonderfall, zurückhaltend -->
                                            <StackPanel Visibility="{Binding IstKoSonderfall, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Spielnummer" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding GruppeIndex, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <CheckBox Grid.Column="2" Content="Sieger" IsChecked="{Binding IstSieger}"
                                                                          FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
                                                                <CheckBox Grid.Column="3" Content="Verlierer" IsChecked="{Binding IstVerlierer}"
                                                                          FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Block-Aktionen -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Speichern" Command="{Binding SpeichernCommand}"
                                                        Padding="10,4" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
                                            </StackPanel>

                                            <!-- Block-Fehlermeldung: seit Issue #188-Folgefeedback in der
                                                 rechten Meldungs-Spalte (BlockFehlermeldungen), nicht mehr
                                                 hier inline — sonst bei vielen Blöcken nur durch Scrollen
                                                 sichtbar, siehe RundenEditorViewModel.AktualisiereBlockFehlermeldungen. -->

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Ausgehende Übergangsregeln (Issue #186) -->
                    <StackPanel Visibility="{Binding AusgehendeUebergangsregelnSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,16">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Weitere Zielrunde"
                                    Command="{Binding NeuerAusgehenderUebergangsregelBlockCommand}"
                                    Padding="8,4" FontSize="12" Cursor="Hand" />
                            <TextBlock Text="AUSGEHENDE ÜBERGANGSREGELN" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding AusgehendeUebergangsregelBloecke}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius4}" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>

                                            <!-- Kopfzeile: Zielrunden-Auswahl + Löschen -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Nach Runde:" FontSize="12" Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ComboBox Width="220" FontSize="12"
                                                              ItemsSource="{Binding DataContext.SpaeterRundenOptionen,
                                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding ZielRunde}"
                                                              DisplayMemberPath="NameFuerQuellrundenAuswahl"
                                                              IsEnabled="{Binding IstNeu}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" ToolTip="Block entfernen"
                                                        Command="{Binding LoeschenCommand}"
                                                        Width="24" Height="24" Padding="0" FontSize="11" Cursor="Hand" />
                                            </Grid>

                                            <!-- Hinweis: Zeilen passen nicht mehr zur aktuellen Form der Quellrunde (Issue #183) -->
                                            <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Radius4}"
                                                    Padding="8,6" Margin="0,0,0,8"
                                                    Visibility="{Binding PasstZurQuellrunde, Converter={StaticResource InverseBoolToVisibility}}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Aktualisieren" Command="{Binding AktualisierenCommand}"
                                                            Padding="8,4" FontSize="11" Cursor="Hand" />
                                                    <TextBlock Text="Passt nicht mehr zur aktuellen Quellrunde (fehlende oder überzählige Gruppen/Spiele). Danach speichern nicht vergessen."
                                                               Foreground="#92400E" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>

                                            <!-- Gruppenphase: Standardbereich + Tabelle je Gruppe -->
                                            <StackPanel Visibility="{Binding IstGruppenphase, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Standard Platz" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding StandardPlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                    <TextBox Grid.Column="3" Text="{Binding StandardPlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" FontSize="12" />
                                                    <Button Grid.Column="5" Content="Für alle Gruppen anwenden"
                                                            Command="{Binding StandardAnwendenCommand}"
                                                            Padding="8,4" FontSize="11" Margin="8,0,0,0" Cursor="Hand" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding GruppenLabel}" FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                                <TextBox Grid.Column="3" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                                <Button Grid.Column="5" Content="Standard übernehmen" FontSize="10"
                                                                        Visibility="{Binding IstAbweichend, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.ZeileZuruecksetzenCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="6,3" Cursor="Hand" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Gruppenübergreifende Rangfolge-Regeln (Issue #184), z.B. "beste 2 Gruppendritte" -->
                                                <ItemsControl ItemsSource="{Binding GruppenuebergreifendeZeilen}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Beste N von Platz" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding Platzierung, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBlock Grid.Column="2" Text="Anzahl" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                <TextBox Grid.Column="3" Text="{Binding AnzahlBeste, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <Button Grid.Column="4" Content="✕" ToolTip="Zeile entfernen" FontSize="10"
                                                                        Command="{Binding DataContext.GruppenuebergreifendeZeileEntfernenCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="20" Height="20" Padding="0" Margin="8,0,0,0" Cursor="Hand" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="+ Gruppenübergreifende Regel" Command="{Binding NeueGruppenuebergreifendeZeileCommand}"
                                                        HorizontalAlignment="Left" Padding="8,4" FontSize="11" Margin="0,4,0,0" Cursor="Hand" />
                                            </StackPanel>

                                            <!-- Liga: einzelnes kompaktes Platzierungsbereich-Feld -->
                                            <Grid Visibility="{Binding IstLiga, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Platzierung" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBox Grid.Column="2" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- K.o./Finale/Spiel um Platz 3: Sonderfall, zurückhaltend -->
                                            <StackPanel Visibility="{Binding IstKoSonderfall, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Spielnummer" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding GruppeIndex, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <CheckBox Grid.Column="2" Content="Sieger" IsChecked="{Binding IstSieger}"
                                                                          FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" />
                                                                <CheckBox Grid.Column="3" Content="Verlierer" IsChecked="{Binding IstVerlierer}"
                                                                          FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Block-Aktionen -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Speichern" Command="{Binding SpeichernCommand}"
                                                        Padding="10,4" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
                                            </StackPanel>

                                            <!-- Block-Fehlermeldung: seit Issue #188-Folgefeedback in der
                                                 rechten Meldungs-Spalte (BlockFehlermeldungen), nicht mehr
                                                 hier inline — sonst bei vielen Blöcken nur durch Scrollen
                                                 sichtbar, siehe RundenEditorViewModel.AktualisiereBlockFehlermeldungen. -->

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>

                </StackPanel><!-- end RundenEditorAktiv -->
            </StackPanel>
        </ScrollViewer>

        <!-- ── Meldungs-Spalte (Issue #188-Folgefeedback) ── Sammelt Fehlermeldung, Runden-Konsistenzfehler
             und Übergangsregel-Warnungen dauerhaft am rechten Rand, analog zu den Verband-Quoten in der
             Auslosung — bei vielen Runden/Gruppen sonst nur durch Scrollen sichtbar. -->
        <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      Visibility="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ZeigeMeldungsSpalte, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="8,10,8,8" Background="{StaticResource SurfaceBrush}">

                <!-- Fehlermeldung -->
                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" TextWrapping="Wrap" />
                </Border>

                <!-- Runden-Konsistenzfehler (immer sichtbar wenn Turnier aktiv) -->
                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,10" Margin="0,0,0,10"
                        Visibility="{Binding HatRundenFehler, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="RUNDEN-KONSISTENZ" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding RundenFehler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#991B1B"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Übergangsregel-Warnungen (Issue #188/#181): live berechnet, kein Speichern-Blocker
                     anders als "Runden-Konsistenz" oben — ersetzt die frühere Speichervorgang-MessageBox,
                     passend zu den übrigen bereits vor dem Speichern sichtbaren Validierungen. -->
                <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,10"
                        Visibility="{Binding HatRundenWarnungen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="ÜBERGANGSREGELN BETROFFEN" FontSize="10" FontWeight="Bold"
                                   Foreground="#D97706" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding RundenWarnungen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#B45309"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Block-Fehlermeldungen (Issue #188-Folgefeedback): Fehler einzelner Übergangsregel-Blöcke
                     (z.B. UebergangsregelValidator "liefern zusammen X Mannschaften, erwartet werden aber Y"),
                     mit Quell-/Zielrunde präfixiert, da der Blockkontext hier sonst verloren ginge. -->
                <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding HatBlockFehlermeldungen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="ÜBERGANGSREGELN FEHLERHAFT" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding BlockFehlermeldungen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#991B1B"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
