<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.RundenEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters">

    <UserControl.Resources>
        <conv:RundenartZuTextConverter x:Key="RundenartZuText" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Spalte 1: Vorlage laden + Rundenliste ── -->
        <DockPanel Grid.Column="0">

            <!-- Placeholder wenn kein Turnier -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Turnier auswählen"
                       Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap"
                       Margin="12,60,12,0" TextAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <!-- Vorlage laden (nur wenn Turnier gewählt) -->
            <Border DockPanel.Dock="Top" Background="#F8FAFC"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,7"
                    Visibility="{Binding RundenEditorAktiv, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="VORLAGE LADEN" FontSize="10" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding TurnierVorlagen}"
                                  SelectedItem="{Binding AusgewaehlteVorlagenquelle}"
                                  DisplayMemberPath="Name"
                                  FontSize="12" />
                        <Button Grid.Column="2"
                                Content="Laden"
                                Command="{Binding VorlageRundenLadenCommand}"
                                Padding="8,4" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rundenliste -->
            <ListBox ItemsSource="{Binding Runden}"
                     SelectedItem="{Binding AusgewaehlteRunde}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding RundenEditorAktiv, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Foreground="#64748B">
                                <Run Text="{Binding Rundenart, Converter={StaticResource RundenartZuText}}" />
                                <Run Text=" · " />
                                <Run Text="{Binding EingangsMannschaften}" />
                                <Run Text="→" />
                                <Run Text="{Binding AusgangsMannschaften}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Spalte 2: Detailformular ── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Kein Turnier gewählt -->
                <TextBlock Text="Wählen Sie oben ein Turnier aus, um dessen Runden zu bearbeiten."
                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

                <!-- Turnier gewählt: Runden-Placeholder oder Formular -->
                <StackPanel Visibility="{Binding RundenEditorAktiv, Converter={StaticResource BoolToVisibility}}">

                <!-- Keine Runde ausgewählt -->
                <TextBlock Text="Wählen Sie eine Runde aus der Liste oder klicken Sie auf ＋ für eine neue Runde."
                           Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap"
                           Visibility="{Binding FormularSichtbar, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- Formular (Runde ausgewählt) -->
                <StackPanel Visibility="{Binding FormularSichtbar, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="RUNDENDETAILS" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="#CBD5E1" BorderThickness="1" />

                    <TextBlock Text="Rundenart" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RundenartOptionen}"
                              SelectedItem="{Binding Rundenart}"
                              FontSize="13" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RundenartZuText}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Eingang" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Eingang, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ausgang" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Ausgang, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="13"
                                     BorderBrush="#CBD5E1" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Gruppenanzahl (nur bei Gruppenphase) -->
                    <StackPanel Visibility="{Binding GruppenAnzahlSichtbar, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Anzahl Gruppen" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                        <TextBox Text="{Binding GruppenAnzahl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13" Margin="0,0,0,12"
                                 BorderBrush="#CBD5E1" BorderThickness="1" />
                    </StackPanel>

                    <TextBlock Text="Regelwerk" FontSize="12" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding RegelwerkOptionen}"
                              SelectedItem="{Binding Regelwerk}"
                              DisplayMemberPath="Anzeige"
                              FontSize="13" Margin="0,0,0,12" />

                    <CheckBox Content="Mit Hin- und Rückspiel"
                              IsChecked="{Binding MitRueckspiel}"
                              IsEnabled="{Binding MitRueckspielVerfuegbar}"
                              FontSize="12" Margin="0,0,0,8" />

                    <CheckBox Content="Auswärtstorregel aktiv"
                              IsChecked="{Binding AuswaertstorRegelAktiv}"
                              IsEnabled="{Binding AuswaertstorAktivierbar}"
                              FontSize="12" Margin="16,0,0,16" />

                    <!-- Eingehende Übergangsregeln: nur bei bereits gespeicherter Runde (Issue #169) -->
                    <TextBlock Text="Bitte zuerst speichern, um Übergangsregeln aus Vorrunden festzulegen."
                               Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                               Visibility="{Binding RundeIstGespeichert, Converter={StaticResource InverseBoolToVisibility}}" />

                    <StackPanel Visibility="{Binding EingehendeUebergangsregelnSichtbar, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,16">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="+ Weitere Quellrunde"
                                    Command="{Binding NeuerUebergangsregelBlockCommand}"
                                    Padding="8,4" FontSize="12" Cursor="Hand" />
                            <TextBlock Text="EINGEHENDE ÜBERGANGSREGELN" FontSize="11" FontWeight="Bold"
                                       Foreground="#94A3B8" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding UebergangsregelBloecke}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>

                                            <!-- Kopfzeile: Quellrunden-Auswahl + Löschen -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Aus Runde:" FontSize="12" Foreground="#475569"
                                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ComboBox Width="220" FontSize="12"
                                                              ItemsSource="{Binding DataContext.FrueherRundenOptionen,
                                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding QuellRunde}"
                                                              DisplayMemberPath="Name"
                                                              IsEnabled="{Binding IstNeu}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="✕" ToolTip="Block entfernen"
                                                        Command="{Binding LoeschenCommand}"
                                                        Width="24" Height="24" Padding="0" FontSize="11" Cursor="Hand" />
                                            </Grid>

                                            <!-- Gruppenphase: Standardbereich + Tabelle je Gruppe -->
                                            <StackPanel Visibility="{Binding IstGruppenphase, Converter={StaticResource BoolToVisibility}}">
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Standard Platz" FontSize="11" Foreground="#64748B"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding StandardPlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                    <TextBox Grid.Column="3" Text="{Binding StandardPlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                             Padding="4,3" FontSize="12" />
                                                    <Button Grid.Column="5" Content="Für alle Gruppen anwenden"
                                                            Command="{Binding StandardAnwendenCommand}"
                                                            Padding="8,4" FontSize="11" Margin="8,0,0,0" Cursor="Hand" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding GruppenLabel}" FontSize="12"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                                <TextBox Grid.Column="3" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                                <Button Grid.Column="5" Content="Standard übernehmen" FontSize="10"
                                                                        Visibility="{Binding IstAbweichend, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.ZeileZuruecksetzenCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="6,3" Cursor="Hand" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Liga: einzelnes kompaktes Platzierungsbereich-Feld -->
                                            <Grid Visibility="{Binding IstLiga, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Platzierung" FontSize="11" Foreground="#64748B"
                                                           VerticalAlignment="Center" />
                                                <ItemsControl Grid.Column="1" Grid.ColumnSpan="3" ItemsSource="{Binding Zeilen}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBox Grid.Column="2" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- K.o./Finale/Spiel um Platz 3: Sonderfall, zurückhaltend -->
                                            <Expander Header="Erweitert (K.o.-Sonderfall)" FontSize="11"
                                                      Visibility="{Binding IstKoSonderfall, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl ItemsSource="{Binding Zeilen}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="40" />
                                                                    <ColumnDefinition Width="12" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="50" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Spielnummer" FontSize="11" Foreground="#64748B"
                                                                           VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Text="{Binding GruppeIndex, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBlock Grid.Column="3" Text="Platz (1=Sieger, 2=Verlierer)"
                                                                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="4" Text="{Binding PlatzierungVon, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" Margin="6,0,0,0" />
                                                                <TextBox Grid.Column="6" Text="{Binding PlatzierungBis, UpdateSourceTrigger=PropertyChanged}"
                                                                         Padding="4,3" FontSize="12" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <!-- Block-Aktionen -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Speichern" Command="{Binding SpeichernCommand}"
                                                        Padding="10,4" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
                                            </StackPanel>

                                            <!-- Block-Fehlermeldung -->
                                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                                    CornerRadius="4" Padding="10,6" Margin="0,8,0,0"
                                                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                                           FontSize="12" TextWrapping="Wrap" />
                                            </Border>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="12,8"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>

                <!-- Runden-Konsistenzfehler (immer sichtbar wenn Turnier aktiv) -->
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,16,0,0"
                        Visibility="{Binding HatRundenFehler, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="RUNDEN-KONSISTENZ" FontSize="10" FontWeight="Bold"
                                   Foreground="#DC2626" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding RundenFehler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#991B1B"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                </StackPanel><!-- end RundenEditorAktiv -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
