<Window x:Class="Fussballturnierverwaltung.Wpf.Views.MannschaftSchnellAnlegenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neue Mannschaft anlegen"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <StackPanel Margin="16">

        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Padding="6,4" Margin="0,0,0,10" />

        <TextBlock Text="Kürzel" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="KurznameBox" Padding="6,4" Margin="0,0,0,10" />

        <TextBlock Text="Art" FontWeight="SemiBold" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="NationalmannschaftRadio" Content="Nationalmannschaft" GroupName="Art"
                         IsChecked="True" Margin="0,0,16,0" />
            <RadioButton x:Name="VereinRadio" Content="Verein" GroupName="Art" />
        </StackPanel>

        <TextBlock Text="Land" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="LandBox" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True" Padding="6,4" Margin="0,0,0,10" />

        <TextBlock Text="Ratings (1–100)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Offensiv" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,2" />
                <TextBox x:Name="OffensivBox" Text="60" Padding="6,4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Mittelfeld" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,2" />
                <TextBox x:Name="MittelfeldBox" Text="60" Padding="6,4" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Defensiv" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,2" />
                <TextBox x:Name="DefensivBox" Text="60" Padding="6,4" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Heimstärke" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,2" />
                <TextBox x:Name="HeimstaerkeBox" Text="60" Padding="6,4" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Auswärtsstärke" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,2" />
                <TextBox x:Name="AuswaertsstaerkeBox" Text="60" Padding="6,4" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="FehlerText" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Click="AbbrechenButton_Click"
                    Padding="14,6" FontSize="12" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Anlegen" Click="AnlegenButton_Click"
                    Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>

    </StackPanel>
</Window>
