<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.LandUndVerbandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <TabControl SelectedIndex="{Binding AktiverTabIndex, Mode=TwoWay}"
                    BorderThickness="0">

            <!-- ═══════════════════════════════ Tab: Länder ══════════════════════════════ -->
            <TabItem Header="🌍  Länder">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="200" MaxWidth="420" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Linke Spalte: Suche + Filter + Liste -->
                    <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

                        <!-- Suchfeld -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                            <TextBox Text="{Binding LandSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍  Suchen …"
                                     materialDesign:HintAssist.IsFloating="False"
                                     Padding="6,4" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </Border>

                        <!-- Filter-Panel -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Verband" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding VerbandFilterOptionen}"
                                              SelectedItem="{Binding LandFilterVerbandOption}"
                                              DisplayMemberPath="Anzeige"
                                              Padding="4,2" FontSize="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kontinent" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding KontinentFilterOptionen}"
                                              SelectedItem="{Binding LandFilterKontinentOption}"
                                              DisplayMemberPath="Anzeige"
                                              Padding="4,2" FontSize="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                </Grid>
                                <Button Content="Filter zurücksetzen"
                                        Command="{Binding FilterZuruecksetzenCommand}"
                                        HorizontalAlignment="Right"
                                        FontSize="11" Padding="6,2" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <!-- Ladeindikator -->
                        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                                     Foreground="{StaticResource AccentBrush}"
                                     Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Liste -->
                        <ListBox ItemsSource="{Binding LaenderGefiltert}"
                                 SelectedItem="{Binding AusgewaehltesLand}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                                     und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                                     (theme-unabhängig hell) ist und unsere eigenen Trigger-Setter ignoriert. -->
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListBoxItem.Selected}" />
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Grid Width="28" Height="28" DockPanel.Dock="Left" Margin="0,0,8,0">
                                            <Image Source="{Binding Flagge, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding Flagge, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="🌍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.4"
                                                       Visibility="{Binding Flagge, Converter={StaticResource NullToVisible}}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding FifaCode}" DockPanel.Dock="Right"
                                                           Opacity="0.60" FontSize="11" FontFamily="Courier New"
                                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Verband.Kurzname}" DockPanel.Dock="Right"
                                                           FontSize="10" Opacity="0.60"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Kurzname}" FontSize="11"
                                                           Opacity="0.60" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4"
                                  HorizontalAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

                    <!-- Rechte Spalte: Formular -->
                    <Grid Grid.Column="2">

                        <!-- Platzhalter -->
                        <StackPanel Visibility="{Binding LandFormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                            <TextBlock Text="🌍" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="Land auswählen oder" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                                       FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Formular -->
                        <ScrollViewer Visibility="{Binding LandFormularAktiv, Converter={StaticResource BoolToVisibility}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,20,28,28" MaxWidth="560">

                                <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                                <!-- Flagge -->
                                <DockPanel Margin="0,0,0,16">
                                    <Grid Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0">
                                        <Border Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                                        <Image Source="{Binding LandFlaggeDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding LandFlaggeDaten, Converter={StaticResource NullToCollapsed}}"
                                               Stretch="Uniform" Margin="4" />
                                        <TextBlock Text="🌍" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.35"
                                                   Visibility="{Binding LandFlaggeDaten, Converter={StaticResource NullToVisible}}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="Bild wählen…" Command="{Binding LandFlaggeWaehlenCommand}"
                                                HorizontalAlignment="Left" FontSize="12" Padding="8,4" Margin="0,0,0,6" Cursor="Hand" />
                                        <Button Content="Entfernen" Command="{Binding LandFlaggeEntfernenCommand}"
                                                Visibility="{Binding LandFlaggeDaten, Converter={StaticResource NullToCollapsed}}"
                                                HorizontalAlignment="Left" FontSize="11" Padding="8,3" Cursor="Hand" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding LandName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" FontSize="13" Margin="0,0,0,12"
                                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kurzname" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding LandKurzname, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,5" FontSize="13"
                                                 BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FIFA-Code" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding LandFifaCode, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,5" FontSize="13" MaxLength="3"
                                                 CharacterCasing="Upper"
                                                 BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Kontinent" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding KontinentFormularOptionen}"
                                                  SelectedItem="{Binding LandKontinentOption}"
                                                  DisplayMemberPath="Anzeige"
                                                  Padding="8,5" FontSize="13"
                                                  BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Verband" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Verbaende}"
                                                  SelectedItem="{Binding LandVerband}"
                                                  DisplayMemberPath="Name"
                                                  Padding="8,5" FontSize="13"
                                                  BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>

                                <!-- Fehlermeldung -->
                                <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                        Background="{StaticResource ErrorSoftBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius4}" Padding="10,8">
                                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════ Tab: Verbände ═════════════════════════════ -->
            <TabItem Header="🏛  Verbände">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" MinWidth="200" MaxWidth="420" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Linke Spalte: Suche + Liste -->
                    <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

                        <!-- Suchfeld -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                            <TextBox Text="{Binding VerbandSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="🔍  Suchen …"
                                     materialDesign:HintAssist.IsFloating="False"
                                     Padding="6,4" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </Border>

                        <!-- Ladeindikator -->
                        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                                     Foreground="{StaticResource AccentBrush}"
                                     Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Liste -->
                        <ListBox ItemsSource="{Binding VerbaendeGefiltert}"
                                 SelectedItem="{Binding AusgewaehlterVerband}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                                     und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                                     (theme-unabhängig hell) ist und unsere eigenen Trigger-Setter ignoriert. -->
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListBoxItem.Selected}" />
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Grid Width="28" Height="28" DockPanel.Dock="Left" Margin="0,0,8,0">
                                            <Image Source="{Binding Logo, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding Logo, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="🏛" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.4"
                                                       Visibility="{Binding Logo, Converter={StaticResource NullToVisible}}" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Kurzname}" DockPanel.Dock="Right"
                                                           Opacity="0.60" FontSize="11"
                                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4"
                                  HorizontalAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

                    <!-- Rechte Spalte: Formular -->
                    <Grid Grid.Column="2">

                        <!-- Platzhalter -->
                        <StackPanel Visibility="{Binding VerbandFormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                            <TextBlock Text="🏛" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="Verband auswählen oder" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                                       FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Formular -->
                        <ScrollViewer Visibility="{Binding VerbandFormularAktiv, Converter={StaticResource BoolToVisibility}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="28,20,28,28" MaxWidth="480">

                                <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                                <!-- Logo -->
                                <DockPanel Margin="0,0,0,16">
                                    <Grid Width="64" Height="64" DockPanel.Dock="Left" Margin="0,0,16,0">
                                        <Border Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                                        <Image Source="{Binding VerbandLogoDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding VerbandLogoDaten, Converter={StaticResource NullToCollapsed}}"
                                               Stretch="Uniform" Margin="4" />
                                        <TextBlock Text="🏛" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.35"
                                                   Visibility="{Binding VerbandLogoDaten, Converter={StaticResource NullToVisible}}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Content="Bild wählen…" Command="{Binding VerbandLogoWaehlenCommand}"
                                                HorizontalAlignment="Left" FontSize="12" Padding="8,4" Margin="0,0,0,6" Cursor="Hand" />
                                        <Button Content="Entfernen" Command="{Binding VerbandLogoEntfernenCommand}"
                                                Visibility="{Binding VerbandLogoDaten, Converter={StaticResource NullToCollapsed}}"
                                                HorizontalAlignment="Left" FontSize="11" Padding="8,3" Cursor="Hand" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding VerbandName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" FontSize="13" Margin="0,0,0,12"
                                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                                <TextBlock Text="Kurzname" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding VerbandKurzname, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,5" FontSize="13" Margin="0,0,0,24"
                                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                                <!-- Fehlermeldung -->
                                <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                        Background="{StaticResource ErrorSoftBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                                        CornerRadius="{StaticResource Radius4}" Padding="10,8">
                                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
