<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.SpielberichtControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             x:Name="Wurzel">

    <!-- Issue #237: vereinheitlichte Spielbericht-Karte (Scoreboard + Zeitleiste) an Stelle der
         frueheren drei getrennten Boxen (grüne Ergebnis-Karte + weiße Spielverlauf-Karte). Wird
         identisch von SimulationsView (Turnierspiel) und EinzelspielSimulationsView (freie Simulation)
         eingebunden — DataContext liefert lose über Property-Namen (ProtokollZeilen/ProtokollEreignisse/
         HatProtokoll/HatProtokollEreignisse/ZeigeLeerZustand), beide ViewModels teilen diese Namen
         bereits über SimulationsProtokollHelfer. LeerZustandText ist der einzige View-spezifische Teil. -->

    <UserControl.Resources>
        <Style x:Key="TrennerPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Ereignis-Icon je Art: Ball (Tor/Golden-/Silver Goal/verwandelter Elfmeter), Gelbe/Rote
             Karte, verschossener Elfmeter (Ball mit Kreuz). Eigentor/Großchance/Taktikwechsel werden
             von SimulationsEngine derzeit nicht erzeugt und bleiben daher ohne Icon. -->
        <DataTemplate x:Key="EreignisIconVorlage" DataType="{x:Type vm:EinzelspielEreignisZeile}">
            <Grid Width="15" Height="15">
                <Viewbox Visibility="{Binding IstTor, Converter={StaticResource BoolToVisibility}}">
                    <Canvas Width="24" Height="24">
                        <Ellipse Width="24" Height="24" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" />
                        <Path Data="M12 7l3 2.2-1.1 3.5H10.1L9 9.2z" Fill="{StaticResource SuccessBrush}" />
                    </Canvas>
                </Viewbox>
                <Rectangle Width="10" Height="14" RadiusX="2" RadiusY="2" Fill="{StaticResource WarningBrush}"
                           Visibility="{Binding IstGelbeKarte, Converter={StaticResource BoolToVisibility}}" />
                <Rectangle Width="10" Height="14" RadiusX="2" RadiusY="2" Fill="{StaticResource ErrorBrush}"
                           Visibility="{Binding IstRoteKarte, Converter={StaticResource BoolToVisibility}}" />
                <Viewbox Visibility="{Binding IstElfmeterVerschossen, Converter={StaticResource BoolToVisibility}}">
                    <Canvas Width="24" Height="24">
                        <Ellipse Width="24" Height="24" Stroke="{StaticResource ErrorBrush}" StrokeThickness="2" />
                        <Path Data="M9 9l6 6M15 9l-6 6" Stroke="{StaticResource ErrorBrush}" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                CornerRadius="{StaticResource Radius4}"
                Visibility="{Binding HatProtokoll, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>

                <!-- ── Scoreboard-Kopf ── Hauptzeile (großes Ergebnis) oben, Hin-/Rückspiel-Beinzeilen
                     und "Weiter"-Hinweis darunter kompakt gestapelt statt nebeneinander (Issue #237,
                     Nutzer-Feedback aus dem manuellen Test) — Standard-Vertikalstapel des ItemsControl,
                     keine WrapPanel-Umleitung. -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ProtokollZeilen}"
                              HorizontalAlignment="Center" Margin="16,20,16,16" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProtokollErgebnisZeile}">
                            <Grid>

                                <!-- Hauptzeile: großes Scoreboard (Einzelspiel bzw. "Gesamt" bei Hin-/Rückspiel) -->
                                <StackPanel Orientation="Horizontal" Margin="4"
                                            Visibility="{Binding IstHauptzeile, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,14,0"
                                                Visibility="{Binding ZeigtTeams, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Width="40" Height="40" Margin="0,0,0,6">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="🏳" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.35"
                                                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding HeimName}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding Score}" FontSize="26" FontWeight="Black" FontFamily="Consolas"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   Visibility="{Binding HatDetail, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="14,0,0,0"
                                                Visibility="{Binding ZeigtTeams, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Width="40" Height="40" Margin="0,0,0,6">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" />
                                            <TextBlock Text="🏳" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.35"
                                                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding AuswaertsName}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Beinzeile: kompakte Textzeile (Hinspiel/Rückspiel-Einzelergebnis) — zeigt die
                                     Team-Reihenfolge mit, da sie im Rückspiel vertauscht ist (Heimrecht wechselt) -->
                                <TextBlock Visibility="{Binding IstBeinzeile, Converter={StaticResource BoolToVisibility}}"
                                           FontSize="11" HorizontalAlignment="Center" Margin="0,1" TextAlignment="Center">
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                    <Run Text=" " /><Run Text="{Binding HeimName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Run Text="–" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                    <Run Text="{Binding AuswaertsName, Mode=OneWay}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    <Run Text=" " /><Run Text="{Binding Score, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" /><Run Text="{Binding Detail, Mode=OneWay}" FontFamily="Consolas" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                </TextBlock>

                                <!-- Text-Zeile ohne Teams (z. B. "Weiter: TeamX"): kompakte Zeile, farblich hervorgehoben -->
                                <TextBlock Visibility="{Binding ZeigtTeams, Converter={StaticResource InverseBoolToVisibility}}"
                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Score, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── Zeitleiste ── nur wenn Ereignisse vorhanden, füllt die Restfläche -->
                <Grid Visibility="{Binding HatProtokollEreignisse, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Separator Grid.Row="0" />
                    <TextBlock Grid.Row="1" Text="SPIELVERLAUF" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="14,8,14,4" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="14,4,14,14">

                            <!-- Mittelachse -->
                            <Border Width="2" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" HorizontalAlignment="Center"
                                    Margin="0,18" />

                            <ItemsControl ItemsSource="{Binding ProtokollEreignisse}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EinzelspielEreignisZeile}">
                                        <Grid>

                                            <!-- Ereignis-Zeile -->
                                            <Grid Margin="0,5" Visibility="{Binding IstTrenner, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Heim-Seite -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                                            Visibility="{Binding IstHeimSeite, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Art}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                                                    <Grid Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <Ellipse Fill="{DynamicResource MaterialDesign.Brush.Background}" />
                                                        <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" Margin="2" />
                                                    </Grid>
                                                    <ContentPresenter Content="{Binding}" Margin="6,0,0,0"
                                                                       ContentTemplate="{StaticResource EreignisIconVorlage}" />
                                                </StackPanel>

                                                <!-- Minuten-Pille auf der Achse -->
                                                <Border Grid.Column="1" CornerRadius="999" Padding="6,2" HorizontalAlignment="Center" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IstTor}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="#BBF7D0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Minute}" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IstTor}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Auswärts-Seite -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left"
                                                            Visibility="{Binding IstHeimSeite, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <ContentPresenter Content="{Binding}" Margin="0,0,6,0"
                                                                       ContentTemplate="{StaticResource EreignisIconVorlage}" />
                                                    <Grid Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse Fill="{DynamicResource MaterialDesign.Brush.Background}" />
                                                        <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" Margin="2" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Art}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Abschnittstrenner mit Linie (HALBZEIT, 90 MINUTEN, VERLÄNGERUNG, ELFMETERSCHIESSEN) -->
                                            <Grid Margin="0,12" Visibility="{Binding ZeigtAlsAbschnittMitLinie, Converter={StaticResource BoolToVisibility}}">
                                                <Separator VerticalAlignment="Center" />
                                                <Border HorizontalAlignment="Center" CornerRadius="999" Padding="10,3" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TrennerArt}" Value="Elfmeter">
                                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningSoftBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TrennerText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrennerPillText}">
                                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TrennerArt}" Value="Elfmeter">
                                                                        <Setter Property="Foreground" Value="#B45309" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <!-- Eigenständige Marke ohne Linie (Anpfiff/Abpfiff/Beinabschnitt) -->
                                            <Grid Margin="0,6"
                                                  Visibility="{Binding ZeigtAlsEigenstaendigeMarke, Converter={StaticResource BoolToVisibility}}">
                                                <Border HorizontalAlignment="Center" CornerRadius="999" Padding="10,3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TrennerArt}" Value="Ende">
                                                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TrennerArt}" Value="Beinabschnitt">
                                                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding TrennerText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TrennerPillText}">
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TrennerArt}" Value="Beinabschnitt">
                                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </DockPanel>
        </Border>

        <!-- Leer-Zustand -->
        <TextBlock Text="{Binding LeerZustandText, ElementName=Wurzel}"
                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="340" TextAlignment="Center"
                   Visibility="{Binding ZeigeLeerZustand, Converter={StaticResource BoolToVisibility}}" />

    </Grid>
</UserControl>
