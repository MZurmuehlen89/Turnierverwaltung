<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.PaarungsfestlegungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Rundenliste mit Paarungsfestlegungs-Status ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <DockPanel DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="RUNDEN" FontSize="11"
                           FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="12,10,8,4" />
                <ListBox ItemsSource="{Binding Runden}"
                         SelectedItem="{Binding AusgewaehlteRunde}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <StaticResource ResourceKey="StandardListBoxItemStyle" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RundenPaarungsEintrag}">
                            <StackPanel>
                                <TextBlock Text="{Binding Runde.Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.60" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <!-- Trennlinie -->
        <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <TextBlock Text="Bitte zuerst ein Turnier auswählen."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Noch keine Runden angelegt — siehe Tab &quot;Runden&quot;."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HatKeineRunden, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Keine Runde ist als &quot;Fest vorgegeben&quot; markiert — Checkbox im Tab &quot;Runden&quot;."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HatKeineFestVorgegebenenRunden, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Bitte links eine Runde auswählen."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding KeinTurnierGewaehlt}" Value="False" />
                                    <Condition Binding="{Binding HatKeineRunden}" Value="False" />
                                    <Condition Binding="{Binding AusgewaehlteRunde}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Ausgewählte Runde hat bereits eine echte Auslosung -->
            <TextBlock Text="Diese Runde nutzt eine Auslosung — siehe Turnierdurchführung → Auslosung."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="400"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding AusgewaehlteRunde.IstEditierbarHier}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ── Paarungs-Workspace ── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Workspace, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Margin="16,14" DataContext="{Binding Workspace}">

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding TeamsStatusText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </DockPanel>

                    <!-- Fehlermeldung -->
                    <Border Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}">
                        Doppelklick oder Ziehen aus "Verfügbar" → Slot. Rechtsklick auf Slot → entfernen.
                    </TextBlock>

                    <Grid MinHeight="260" Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Verfügbare Teilnehmer -->
                        <DockPanel Grid.Column="0" VerticalAlignment="Top">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Background}"
                                    Padding="6,4" CornerRadius="4,4,0,0">
                                <TextBlock Text="{Binding VerfuegbareTeilnehmer.Count, StringFormat='Verfügbar ({0})'}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            </Border>
                            <TextBox DockPanel.Dock="Top"
                                     Text="{Binding TeilnehmerFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4" FontSize="12"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1,0,1,1" />
                            <ListBox x:Name="VerfuegbarListBox"
                                     ItemsSource="{Binding VerfuegbareTeilnehmerGefiltert}"
                                     SelectedItem="{Binding AusgewaehlterVerfuegbarTeilnehmer}"
                                     MaxHeight="400"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1,0,1,1"
                                     Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                     PreviewMouseLeftButtonDown="VerfuegbarListBox_PreviewMouseLeftButtonDown"
                                     MouseMove="VerfuegbarListBox_MouseMove"
                                     MouseDoubleClick="VerfuegbarListBox_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <StaticResource ResourceKey="StandardListBoxItemStyle" />
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TeilnehmerAnzeige}">
                                        <DockPanel>
                                            <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,6,0">
                                                <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                            </Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                                <TextBlock Text="{Binding Kuerzel}" FontSize="10"
                                                           Opacity="0.60"
                                                           Visibility="{Binding Kuerzel, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- KO-Modus: Paarungen -->
                        <StackPanel Grid.Column="2" Visibility="{Binding IstKoModus, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding KoPaarungen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ManuelleKoPaarungAnzeige}">
                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}"
                                                Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Margin="0,0,0,4">
                                            <Grid Margin="10,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PaarungsNr}"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <!-- Heim-Slot -->
                                                <Border Grid.Column="1"
                                                        Tag="{Binding HeimSlot}"
                                                        BorderThickness="1" CornerRadius="3" Padding="8,5"
                                                        AllowDrop="True"
                                                        Drop="ManuellerSlot_Drop"
                                                        DragOver="ManuellerSlot_DragOver"
                                                        DragEnter="ManuellerSlot_DragEnter"
                                                        DragLeave="ManuellerSlot_DragLeave"
                                                        MouseRightButtonUp="ManuellerSlot_MouseRightButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HeimSlot.IstLeer}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0"
                                                              Visibility="{Binding HeimSlot.IstLeer, Converter={StaticResource InverseBoolToVisibility}}">
                                                            <Image Source="{Binding HeimSlot.Team.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding HeimSlot.Team.Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" />
                                                            <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.35"
                                                                       Visibility="{Binding HeimSlot.Team.Wappen, Converter={StaticResource NullToVisible}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding HeimSlot.AnzeigeName}" FontSize="12"
                                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text=" vs " FontSize="12"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" VerticalAlignment="Center" Margin="6,0" />
                                                <!-- Auswärts-Slot -->
                                                <Border Grid.Column="3"
                                                        Tag="{Binding AuswaertsSlot}"
                                                        BorderThickness="1" CornerRadius="3" Padding="8,5"
                                                        AllowDrop="True"
                                                        Drop="ManuellerSlot_Drop"
                                                        DragOver="ManuellerSlot_DragOver"
                                                        DragEnter="ManuellerSlot_DragEnter"
                                                        DragLeave="ManuellerSlot_DragLeave"
                                                        MouseRightButtonUp="ManuellerSlot_MouseRightButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                                                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AuswaertsSlot.IstLeer}" Value="False">
                                                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <DockPanel>
                                                        <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0"
                                                              Visibility="{Binding AuswaertsSlot.IstLeer, Converter={StaticResource InverseBoolToVisibility}}">
                                                            <Image Source="{Binding AuswaertsSlot.Team.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding AuswaertsSlot.Team.Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" />
                                                            <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.35"
                                                                       Visibility="{Binding AuswaertsSlot.Team.Wappen, Converter={StaticResource NullToVisible}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding AuswaertsSlot.AnzeigeName}" FontSize="12"
                                                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Gruppenphase-Modus: Gruppen -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Gruppen}"
                                      Visibility="{Binding IstGruppenModus, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ManuelleGruppe}">
                                    <Border Width="160" Margin="0,0,8,8"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                                        <StackPanel>
                                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="10,5" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding GruppenName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Slots}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ManuellerGruppenSlot}">
                                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1"
                                                                Padding="10,5" MinHeight="30"
                                                                Tag="{Binding}"
                                                                AllowDrop="True"
                                                                Drop="ManuellerSlot_Drop"
                                                                DragOver="ManuellerSlot_DragOver"
                                                                DragEnter="ManuellerSlot_DragEnter"
                                                                DragLeave="ManuellerSlot_DragLeave"
                                                                MouseRightButtonUp="ManuellerSlot_MouseRightButtonUp">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IstLeer}" Value="False">
                                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DockPanel>
                                                                <Grid Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,5,0"
                                                                      Visibility="{Binding IstLeer, Converter={StaticResource InverseBoolToVisibility}}">
                                                                    <Image Source="{Binding Team.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                           Visibility="{Binding Team.Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                           Stretch="Uniform" />
                                                                    <TextBlock Text="🏳" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Opacity="0.35"
                                                                               Visibility="{Binding Team.Wappen, Converter={StaticResource NullToVisible}}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding AnzeigeName}" FontSize="12"
                                                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Abgeschlossen: read-only Anzeige derselben Grids (Slots bereits befüllt) -->
                    <TextBlock Text="Paarung abgeschlossen. „Zurücksetzen&quot; im Ribbon, um sie zu ändern."
                               FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,10"
                               Visibility="{Binding IstAbgeschlossen, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Visibility="{Binding IstAbgeschlossen, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding KoPaarungen}"
                                      Visibility="{Binding IstKoModus, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ManuelleKoPaarungAnzeige}">
                                    <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1" Padding="12,6">
                                        <TextBlock FontSize="13">
                                            <Run Text="{Binding HeimSlot.AnzeigeName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" vs " Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                            <Run Text="{Binding AuswaertsSlot.AnzeigeName, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Gruppen}"
                                      Visibility="{Binding IstGruppenModus, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ManuelleGruppe}">
                                    <Border Width="160" Margin="0,0,8,8"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius4}">
                                        <StackPanel>
                                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Padding="10,5" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding GruppenName}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Slots}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ManuellerGruppenSlot}">
                                                        <Border BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1" Padding="10,5">
                                                            <TextBlock Text="{Binding AnzeigeName}" FontSize="13" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
