<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierBaumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             xmlns:tabelle="clr-namespace:Fussballturnierverwaltung.Application.Tabelle;assembly=Fussballturnierverwaltung.Application"
             xmlns:enums="clr-namespace:Fussballturnierverwaltung.Domain.Enums;assembly=Fussballturnierverwaltung.Domain">

    <DockPanel>

        <!-- ── Hauptbereich ── -->
        <Grid>

            <!-- Kein Turnier gewählt -->
            <TextBlock Text="Bitte ein Turnier auswählen."
                       Foreground="#94A3B8" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <!-- Turnier gewählt -->
            <DockPanel Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}">

                <!-- Lade-Spinner -->
                <TextBlock DockPanel.Dock="Top" Text="Lade…" Margin="16,12"
                           Foreground="#94A3B8" FontSize="13"
                           Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                <!-- Fehlermeldung -->
                <Border DockPanel.Dock="Top" Margin="16,12,16,0"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="4" Padding="12,8"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Bracket-Bereich -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16"
                              Visibility="{Binding ZeigtBracketInhalt, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Vertical">

                        <!-- Runden-Köpfe -->
                        <Grid Height="32"
                              Width="{Binding CanvasBreite}"
                              HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding RundenKoepfe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BracketRundenkopf}">
                                        <TextBlock Text="{Binding Name}"
                                                   Width="{Binding Breite}"
                                                   TextAlignment="Center"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#475569" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Trennlinie unter Köpfen -->
                        <Border Height="1" Background="#E2E8F0"
                                Width="{Binding CanvasBreite}"
                                HorizontalAlignment="Left" Margin="0,0,0,8" />

                        <!-- Bracket (Linien + Knoten überlagert) -->
                        <Grid Width="{Binding CanvasBreite}"
                              Height="{Binding CanvasHoehe}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">

                            <!-- Verbindungslinien (untere Ebene) -->
                            <ItemsControl ItemsSource="{Binding VerbindungsLinien}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BracketLinie}">
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                              X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="#CBD5E1" StrokeThickness="1.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Bracket-Knoten (obere Ebene) -->
                            <ItemsControl ItemsSource="{Binding Knoten}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BracketKnotenAnzeige}">
                                        <Button Command="{Binding DataContext.KnotenAngeklicktBefehl, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                        <Border Width="185" Height="90"
                                                BorderThickness="1" CornerRadius="4"
                                                Background="White">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Label-Streifen (nur bei festem Bracket sichtbar) -->
                                            <Border Grid.Row="0" Background="#F8FAFC"
                                                    BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                                    CornerRadius="4,4,0,0"
                                                    Visibility="{Binding HatLabel, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="#94A3B8"
                                                           Padding="6,0"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Freilos -->
                                            <TextBlock Grid.Row="1" Text="–" FontSize="22" Foreground="#CBD5E1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- Reguläres Spiel -->
                                            <Grid Grid.Row="1" Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Heimmannschaft -->
                                                <Grid Grid.Row="0" Margin="8,4,8,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding HeimName}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569" />
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding HeimScore}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1E293B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Trennlinie -->
                                                <Border Grid.Row="1" Background="#F1F5F9" />

                                                <!-- Auswärtsmannschaft -->
                                                <Grid Grid.Row="2" Margin="8,2,8,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding AuswaertsName}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569" />
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding AuswaertsScore}"
                                                                   FontSize="13" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1E293B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                            <Setter Property="Foreground" Value="#166534" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ErgebnisDetail}"
                                                                   FontSize="9" Foreground="#94A3B8"
                                                                   Margin="3,2,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                            </Grid>
                                        </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── Gruppenphase-Ansicht (Issue #137, Phase A von #33) ── -->
                <DockPanel Visibility="{Binding ZeigtGruppenphase, Converter={StaticResource BoolToVisibility}}">

                    <!-- Tabellenstand-Snapshot nach Spieltag (Issue #141) -->
                    <Border DockPanel.Dock="Top" Background="White"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8"
                            Visibility="{Binding HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tabellenstand:" FontSize="11" Foreground="#64748B"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding TabellenSpieltagOptionen}"
                                      SelectedItem="{Binding TabellenBisSpieltagAuswahl}"
                                      FontSize="11" Padding="8,3" MinWidth="90">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SpieltagOptionZuText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <TextBlock Text="Noch keine Gruppenzuordnung — Gruppen erscheinen nach der Auslosung/Spielplan-Generierung."
                                   Foreground="#94A3B8" FontSize="13"
                                   HorizontalAlignment="Center" Margin="16,48"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding HatGruppenTabellenAnzeige, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding AnzeigeGruppenTabellen}"
                                      Visibility="{Binding HatGruppenTabellenAnzeige, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tabelle:GruppenTabelle}">
                                    <Button Command="{Binding DataContext.GruppeAngeklicktBefehl, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" BorderThickness="0" Padding="0" Background="Transparent"
                                            ToolTip="Klicken, um den Spielplan links auf diese Gruppe zu filtern."
                                            Margin="0,0,12,12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                    <Border Width="290"
                                            Background="White"
                                            BorderBrush="#E2E8F0" BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>

                                            <!-- Card-Header -->
                                            <Border Background="#1E40AF"
                                                    CornerRadius="8,8,0,0" Padding="12,8">
                                                <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
                                                    <Run Text="Gruppe " />
                                                    <Run Text="{Binding GruppenNummer}" />
                                                </TextBlock>
                                            </Border>

                                            <!-- Tabellen-Kopfzeile -->
                                            <Grid Background="#F8FAFC">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" Padding="6,5,0,5" />
                                                <TextBlock Grid.Column="1" Text="Team"
                                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                                           Padding="4,5" />
                                                <TextBlock Grid.Column="2" Text="Sp"
                                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="3" Text="Tore"
                                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="4" Text="Diff"
                                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="5" Text="Pkt"
                                                           FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" Padding="0,5,6,5" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="#E2E8F0" />

                                            <!-- Tabellen-Einträge -->
                                            <ItemsControl ItemsSource="{Binding Tabelle}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type tabelle:TabellenEintrag}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="26" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="46" />
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="28" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Qualifikationsstatus}" Value="{x:Static enums:Qualifikationsstatus.SicherQualifiziert}">
                                                                            <Setter Property="Background" Value="#F0FDF4" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Qualifikationsstatus}" Value="{x:Static enums:Qualifikationsstatus.SicherAusgeschieden}">
                                                                            <Setter Property="Background" Value="#FEF2F2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                        Margin="4,6,0,6">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,3,0"
                                                                         Fill="{Binding Qualifikationsstatus, Converter={StaticResource QualifikationsstatusZuFarbe}}" />
                                                                <TextBlock Text="{Binding Rang}"
                                                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Mannschaft.Name}"
                                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" Padding="4,6" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Spiele}"
                                                                       FontSize="12" Foreground="#475569"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                            <TextBlock Grid.Column="3"
                                                                       FontSize="12" Foreground="#475569"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6">
                                                                <Run Text="{Binding Tore}" /><Run Text=":" /><Run Text="{Binding Gegentore}" />
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="4" Text="{Binding Tordifferenz}"
                                                                       FontSize="12" Foreground="#475569"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                            <TextBlock Grid.Column="5" Text="{Binding Punkte}"
                                                                       FontSize="12" FontWeight="Bold" Foreground="#1E293B"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6,6,6" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ── Liga-/TopfLiga-/SchweizerSystem-Gesamttabelle (Issue #137, Phase A von #33) ── -->
                <DockPanel Visibility="{Binding ZeigtLigaTabelle, Converter={StaticResource BoolToVisibility}}">

                    <!-- Ansicht-Tabs (Gesamt/Hinrunde/Rückrunde/Heim/Auswärts, Issue #95) + Tabellenstand-Snapshot (Issue #141) -->
                    <Border DockPanel.Dock="Top" Background="White"
                            BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="6" Background="#F1F5F9" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Gesamt"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Gesamt}"
                                            Padding="10,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Gesamt}">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Hinrunde"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Hinrunde}"
                                            Padding="10,3" Cursor="Hand" FontSize="11"
                                            Visibility="{Binding ZeigtHinRueckrundenTabs, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Hinrunde}">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Rückrunde"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Rueckrunde}"
                                            Padding="10,3" Cursor="Hand" FontSize="11"
                                            Visibility="{Binding ZeigtHinRueckrundenTabs, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Rueckrunde}">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Heim"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Heimtabelle}"
                                            Padding="10,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Heimtabelle}">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Auswärts"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Auswaertstabelle}"
                                            Padding="10,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#64748B" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Auswaertstabelle}">
                                                        <Setter Property="Background" Value="White" />
                                                        <Setter Property="Foreground" Value="#1E40AF" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tabellenstand-Snapshot nach Spieltag (Issue #141) -->
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Tabellenstand:" FontSize="11" Foreground="#64748B"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding TabellenSpieltagOptionen}"
                                          SelectedItem="{Binding TabellenBisSpieltagAuswahl}"
                                          FontSize="11" Padding="8,3" MinWidth="90">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SpieltagOptionZuText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <TextBlock Text="Noch kein Spielplan generiert. Die Tabelle erscheint, sobald Spiele vorhanden sind."
                                   Foreground="#94A3B8" FontSize="13"
                                   HorizontalAlignment="Center" Margin="16,48"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding HatLigaTabelleAnzeige, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Border Background="White"
                                BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                VerticalAlignment="Top"
                                Visibility="{Binding HatLigaTabelleAnzeige, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>

                                <!-- Tabellen-Kopfzeile -->
                                <Grid Background="#F8FAFC">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="6,5,0,5" />
                                    <TextBlock Grid.Column="1" Text="Team"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               Padding="4,5" />
                                    <TextBlock Grid.Column="2" Text="Sp"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="3" Text="S"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="4" Text="U"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="5" Text="N"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="6" Text="Tore"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="7" Text="Diff"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="8" Text="Pkt"
                                               FontSize="10" FontWeight="Bold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" Padding="0,5,6,5" />
                                </Grid>

                                <Rectangle Height="1" Fill="#E2E8F0" />

                                <!-- Tabellen-Einträge -->
                                <ItemsControl ItemsSource="{Binding LigaTabelleAnzeige}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tabelle:TabellenEintrag}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Rang}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#64748B"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,6,0,6" />
                                                <TextBlock Grid.Column="1" Text="{Binding Mannschaft.Name}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Padding="4,6" />
                                                <TextBlock Grid.Column="2" Text="{Binding Spiele}"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="3" Text="{Binding Siege}"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="4" Text="{Binding Unentschieden}"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="5" Text="{Binding Niederlagen}"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="6"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6">
                                                    <Run Text="{Binding Tore}" /><Run Text=":" /><Run Text="{Binding Gegentore}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="7" Text="{Binding Tordifferenz}"
                                                           FontSize="12" Foreground="#475569"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="8" Text="{Binding Punkte}"
                                                           FontSize="12" FontWeight="Bold" Foreground="#1E293B"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6,6,6" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>

            </DockPanel>
        </Grid>

    </DockPanel>
</UserControl>
