<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierBaumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="300" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Turnier-Auswahl ── -->
        <DockPanel Grid.Column="0" Background="#F8FAFC">

            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8">
                <StackPanel>
                    <TextBlock Text="Turnier" FontSize="11" Foreground="#94A3B8"
                               FontWeight="Bold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Instanzen}"
                              SelectedItem="{Binding AusgewaehlteInstanz}"
                              DisplayMemberPath="Name"
                              FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Info-Box: Ribbon-Hinweise -->
            <Border DockPanel.Dock="Top" Margin="8,12,8,4"
                    Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                    CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Ribbon-Aktionen:" FontSize="11" FontWeight="Bold"
                               Foreground="#1D4ED8" Margin="0,0,0,4" />
                    <TextBlock FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Neu</Run>
                        <Run>→ Turnierbaum generieren</Run>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run FontWeight="SemiBold">Speichern</Run>
                        <Run>→ Sieger fortschreiben</Run>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run FontWeight="SemiBold">Löschen</Run>
                        <Run>→ Baum entfernen</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </DockPanel>

        <Border Grid.Column="1" Background="#E2E8F0" />

        <!-- ── Rechter Bereich: Bracket-Canvas ── -->
        <Grid Grid.Column="2">

            <!-- Kein Turnier gewählt -->
            <TextBlock Text="Bitte ein Turnier auswählen."
                       Foreground="#94A3B8" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding AusgewaehlteInstanz,
                                    Converter={StaticResource NullToCollapsed},
                                    ConverterParameter=invert}" />

            <!-- Turnier gewählt -->
            <DockPanel Visibility="{Binding AusgewaehlteInstanz, Converter={StaticResource NullToCollapsed}}">

                <!-- Lade-Spinner -->
                <TextBlock DockPanel.Dock="Top" Text="Lade…" Margin="16,12"
                           Foreground="#94A3B8" FontSize="13"
                           Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                <!-- Fehlermeldung -->
                <Border DockPanel.Dock="Top" Margin="16,12,16,0"
                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="4" Padding="12,8"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="#DC2626"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Statusmeldung / Kein Baum -->
                <Border DockPanel.Dock="Top" Margin="16,12,16,0"
                        Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                        CornerRadius="4" Padding="12,8"
                        Visibility="{Binding StatusMeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding StatusMeldung}" Foreground="#166534"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Bracket-Bereich -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16"
                              Visibility="{Binding HatBaum, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Vertical">

                        <!-- Runden-Köpfe -->
                        <Grid Height="32"
                              Width="{Binding CanvasBreite}"
                              HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding RundenKoepfe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="0" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BracketRundenkopf}">
                                        <TextBlock Text="{Binding Name}"
                                                   Width="{Binding Breite}"
                                                   TextAlignment="Center"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#475569" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Trennlinie unter Köpfen -->
                        <Border Height="1" Background="#E2E8F0"
                                Width="{Binding CanvasBreite}"
                                HorizontalAlignment="Left" Margin="0,0,0,8" />

                        <!-- Bracket (Linien + Knoten überlagert) -->
                        <Grid Width="{Binding CanvasBreite}"
                              Height="{Binding CanvasHoehe}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">

                            <!-- Verbindungslinien (untere Ebene) -->
                            <ItemsControl ItemsSource="{Binding VerbindungsLinien}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BracketLinie}">
                                        <Line X1="{Binding X1}" Y1="{Binding Y1}"
                                              X2="{Binding X2}" Y2="{Binding Y2}"
                                              Stroke="#CBD5E1" StrokeThickness="1.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Bracket-Knoten (obere Ebene) -->
                            <ItemsControl ItemsSource="{Binding Knoten}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BracketKnotenAnzeige}">
                                        <Border Width="185" Height="74"
                                                BorderThickness="1" CornerRadius="4"
                                                Background="White">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC" />
                                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                            <!-- Freilos -->
                                            <TextBlock Text="–" FontSize="22" Foreground="#CBD5E1"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />

                                            <!-- Reguläres Spiel -->
                                            <Grid Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Heimmannschaft -->
                                                <Grid Grid.Row="0" Margin="8,4,8,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding HeimName}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569" />
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding HeimScore}"
                                                               FontSize="13" FontWeight="Bold"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1E293B" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- Trennlinie -->
                                                <Border Grid.Row="1" Background="#F1F5F9" />

                                                <!-- Auswärtsmannschaft -->
                                                <Grid Grid.Row="2" Margin="8,2,8,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding AuswaertsName}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#475569" />
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#166534" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding AuswaertsScore}"
                                                                   FontSize="13" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1E293B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                                            <Setter Property="Foreground" Value="#166534" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ErgebnisDetail}"
                                                                   FontSize="9" Foreground="#94A3B8"
                                                                   Margin="3,2,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Grid>

    </Grid>
</UserControl>
