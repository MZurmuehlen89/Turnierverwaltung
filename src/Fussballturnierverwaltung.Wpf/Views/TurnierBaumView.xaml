<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierBaumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             xmlns:tabelle="clr-namespace:Fussballturnierverwaltung.Application.Tabelle;assembly=Fussballturnierverwaltung.Application"
             xmlns:enums="clr-namespace:Fussballturnierverwaltung.Domain.Enums;assembly=Fussballturnierverwaltung.Domain">

    <UserControl.Resources>
        <!-- Bracket-Spielpaarungskarte (Issue #108) — gemeinsam für die linke und rechte Rundenspalte,
             damit die Fenster-Navigation (aktuelle + nächste Runde) nicht zwei Kopien pflegen muss. -->
        <DataTemplate x:Key="BracketKartenTemplate" DataType="{x:Type vm:BracketKnotenAnzeige}">
            <!-- Height="Auto" ist Pflicht seit #257 (MaterialDesignThemes global gemerged): der implizite
                 MaterialDesign-Button-Style setzt eine feste Höhe, die trotz überschriebenem Button.Template
                 unten weiterhin greift und die Karte auf Label-Zeilenhöhe klemmt — der restliche Karteninhalt
                 wird dann unsichtbar abgeschnitten, ohne Fehler oder Exception. -->
            <Button Command="{Binding DataContext.KnotenAngeklicktBefehl, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Padding="0" Cursor="Hand" Height="Auto">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>

                <!-- Feste Kartenbreite (Issue #244-Nachbesserung): die Kartenposition wird über
                     Canvas.Top="{Binding FensterY}" gesetzt (siehe LinkeSpalteItems/RechteSpalteItems
                     weiter unten), damit die Verbindungslinien zwischen den Runden wie ein Trichter
                     aussehen (zwei Partien der aktuellen Runde laufen auf eine Partie der Folgerunde zu,
                     mit entsprechend mehr vertikalem Abstand). Das ist mit der bisherigen SharedSizeGroup-
                     Breitenanpassung an den längsten Teamnamen nicht mehr vereinbar — lange Namen werden
                     stattdessen per TextTrimming abgeschnitten. -->
                <Border Width="240" BorderThickness="1" CornerRadius="{StaticResource Radius6}" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IstFreilos}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HatErgebnis}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>

                        <!-- Label-Streifen (nur bei festem Bracket sichtbar) -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0"
                                Visibility="{Binding HatLabel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       Padding="10,4" />
                        </Border>

                        <!-- Datum-Kopfzeile -->
                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Background}" BorderThickness="0,0,0,1"
                                Visibility="{Binding HatDatum, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Datum}"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       HorizontalAlignment="Center" Padding="10,4" />
                        </Border>

                        <!-- Freilos -->
                        <TextBlock Text="–" FontSize="22" Foreground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                   HorizontalAlignment="Center" Padding="0,16"
                                   Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Reguläres Spiel -->
                        <Grid Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Heimmannschaft -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="12,10,8,4">
                                <Grid Width="18" Height="18" Margin="0,0,8,0">
                                    <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                           Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                           Stretch="Uniform" />
                                    <TextBlock Text="🏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.35"
                                               Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                </Grid>
                                <TextBlock Text="{Binding HeimName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HeimScore}"
                                       FontSize="15" FontWeight="Bold" Margin="8,10,12,4" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Trennlinie -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Background}" Height="1" Margin="12,4,0,4" VerticalAlignment="Center" />

                            <!-- Meta-Zeile zwischen den Scores (n.V., i.E.) -->
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ErgebnisDetail}"
                                       FontSize="9" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       HorizontalAlignment="Center" Margin="8,0,12,0" />

                            <!-- Auswärtsmannschaft -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="12,4,8,10">
                                <Grid Width="18" Height="18" Margin="0,0,8,0">
                                    <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                           Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                           Stretch="Uniform" />
                                    <TextBlock Text="🏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.35"
                                               Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                </Grid>
                                <TextBlock Text="{Binding AuswaertsName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuswaertsScore}"
                                       FontSize="15" FontWeight="Bold" Margin="8,4,12,10" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AuswaertsIstSieger}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeimIstSieger}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Gemeinsame Tabellenzeile für Gruppen-Karten (Issue #137) und gruppenübergreifende
             Rangfolge-Karten (Issue #212) — gleiche Qualifikationsstatus-Ampel/SicherPositioniert-Optik. -->
        <DataTemplate x:Key="TabellenEintragZeileTemplate" DataType="{x:Type tabelle:TabellenEintrag}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Qualifikationsstatus}" Value="{x:Static enums:Qualifikationsstatus.SicherQualifiziert}">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Qualifikationsstatus}" Value="{x:Static enums:Qualifikationsstatus.SicherAusgeschieden}">
                                <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="4,6,0,6">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SicherPositioniert}" Value="True">
                                    <Setter Property="ToolTip" Value="Position steht endgültig fest" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Ellipse Width="6" Height="6" Margin="0,0,3,0"
                             Fill="{Binding Qualifikationsstatus, Converter={StaticResource QualifikationsstatusZuFarbe}}" />
                    <TextBlock Text="{Binding Rang}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SicherPositioniert}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <DockPanel Grid.Column="1" Margin="4,6">
                    <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                        <Image Source="{Binding Mannschaft.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                               Visibility="{Binding Mannschaft.Wappen, Converter={StaticResource NullToCollapsed}}"
                               Stretch="Uniform" />
                        <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.35"
                                   Visibility="{Binding Mannschaft.Wappen, Converter={StaticResource NullToVisible}}" />
                    </Grid>
                    <TextBlock Text="{Binding Mannschaft.Name}"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="2" Text="{Binding Spiele}"
                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                <TextBlock Grid.Column="3"
                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6">
                    <Run Text="{Binding Tore}" /><Run Text=":" /><Run Text="{Binding Gegentore}" />
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding Tordifferenz}"
                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                <TextBlock Grid.Column="5" Text="{Binding Punkte}"
                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6,6,6" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource MaterialDesign.Brush.Background}"
               TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

        <!-- ── Hauptbereich ── -->
        <Grid>

            <!-- Kein Turnier gewählt -->
            <TextBlock Text="Bitte ein Turnier auswählen."
                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <!-- Turnier gewählt -->
            <DockPanel Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}">

                <!-- Lade-Spinner -->
                <TextBlock DockPanel.Dock="Top" Text="Lade…" Margin="16,12"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="13"
                           Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                <!-- Fehlermeldung -->
                <Border DockPanel.Dock="Top" Margin="16,12,16,0"
                        Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,8"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Bracket-Bereich: Fenster aus zwei benachbarten Runden (aktuelle + nächste) statt
                     Gesamtübersicht (Issue #108, an kicker.de-Vorbild angelehnt). Fester Bereich ohne
                     Größenänderung, beide Spalten teilen sich einen gemeinsamen ScrollViewer (Issue #244).
                     Eine vollständige Baum-Gesamtübersicht ohne Blättern ist als eigenes Folge-Issue
                     (#238) vorgesehen. -->
                <DockPanel Visibility="{Binding ZeigtBracketInhalt, Converter={StaticResource BoolToVisibility}}">

                    <!-- Rundennavigation -->
                    <Grid DockPanel.Dock="Top" Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding VorherigeRundeBefehl}"
                                Padding="10,6" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Visibility="{Binding HatVorherigeRunde, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◀" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding VorherigeRundeName}" FontSize="12"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Text="Turnierbaum"
                                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Button Grid.Column="2" Command="{Binding NaechsteRundeBefehl}"
                                Padding="10,6" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                Visibility="{Binding HatNaechsteRunde, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NaechsteRundeName}" FontSize="12"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="▶" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Primary.Foreground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Spaltenüberschriften (fix, scrollen nicht mit). Mittlere Spalte (GAP_BREITE) hält
                         Platz für die Verbindungslinien im Bracket-Bereich darunter frei, damit beide
                         Grids exakt dieselben Spaltenbreiten haben und die Karten nicht direkt aneinander
                         stoßen (Nutzer-Feedback: Linien brauchen sichtbaren Raum, um Sinn zu ergeben). -->
                    <Grid DockPanel.Dock="Top" Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LinkeSpalteName}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ZeigtZweiteSpalte}" Value="False">
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding RechteSpalteName}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding ZeigtZweiteSpalte, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Zwei Rundenspalten mit einheitlicher Kartenbreite je Spalte (an den längsten
                         Teamnamen dieser Spalte angepasst, über je eine eigene SharedSizeGroup-Scope).
                         Ein einziger gemeinsamer ScrollViewer für beide Spalten (Issue #244-Nachbesserung,
                         Nutzer-Feedback) statt zwei unabhängiger — vermeidet einen einseitig sichtbaren
                         Scrollbalken und hält beide Spalten immer auf gleicher Höhe synchron, ohne dass
                         das Code-Behind den Scroll-Offset manuell abgleichen muss.

                         Trichterform (Nutzer-Feedback): beide ItemsControls positionieren ihre Karten über
                         ein Canvas-ItemsPanel mit Canvas.Top="{Binding FensterY}" statt automatischem
                         Stapeln. FensterY (TurnierBaumViewModel.AktualisiereFensterPositionen) ist bewusst
                         NICHT dieselbe Position wie die globale, auf den ganzen Baum bemessene Y (die bleibt
                         für die künftige Gesamtübersicht #238 erhalten) — FensterY zählt nur die aktuell
                         sichtbaren Karten und ordnet sie kompakt an, sonst wirkt z.B. ein Halbfinale+Finale-
                         Fenster (nur 3 Karten) unnötig sperrig/leer. Eine Partie der Folgerunde landet auf
                         der exakten vertikalen Mitte ihrer zwei Partien der aktuellen Runde. Dafür feste
                         statt SharedSizeGroup-basierte Kartenbreite (siehe BracketKartenTemplate) und feste
                         Kartenbreite/-Höhe auf dem ItemsControl selbst, da ein Canvas nicht auf seinen
                         Inhalt aufsizet (Höhe kommt aus FensterCanvasHoehe, ebenfalls fensterlokal berechnet
                         — vermeidet unnötigen Scrollraum bei kleinen Fenstern).

                         Verbindungslinien (Issue #244): pixelgenaue Kanten lassen sich trotzdem nicht rein
                         aus FensterY berechnen (variable Kartenhöhe durch Label-/Datum-Kopfzeile) — stattdessen
                         misst TurnierBaumView.xaml.cs die real gerenderten Kartenpositionen nach jedem
                         Layout-Durchlauf und zeichnet die Linien in das VerbindungsCanvas-Overlay; durch
                         die jetzt korrekte vertikale Anordnung ergeben die gemessenen Linien automatisch
                         die Trichterform. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl x:Name="LinkeSpalteItems" Grid.Column="0"
                                          ItemsSource="{Binding LinkeSpalteKnoten}" ItemTemplate="{StaticResource BracketKartenTemplate}"
                                          Width="240" Height="{Binding FensterCanvasHoehe}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding FensterY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ZeigtZweiteSpalte}" Value="False">
                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>

                            <ItemsControl x:Name="RechteSpalteItems" Grid.Column="2"
                                          ItemsSource="{Binding RechteSpalteKnoten}" ItemTemplate="{StaticResource BracketKartenTemplate}"
                                          Width="240" Height="{Binding FensterCanvasHoehe}" HorizontalAlignment="Center"
                                          Visibility="{Binding ZeigtZweiteSpalte, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Top" Value="{Binding FensterY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <Canvas x:Name="VerbindungsCanvas" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="Transparent" IsHitTestVisible="False" ClipToBounds="True" />
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ── Gruppenphase-Ansicht (Issue #137, Phase A von #33) ── -->
                <DockPanel Visibility="{Binding ZeigtGruppenphase, Converter={StaticResource BoolToVisibility}}">

                    <!-- Tabellenstand-Snapshot nach Spieltag (Issue #141) -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="16,8"
                            Visibility="{Binding HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tabellenstand:" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding TabellenSpieltagOptionen}"
                                      SelectedItem="{Binding TabellenBisSpieltagAuswahl}"
                                      FontSize="11" Padding="8,3" MinWidth="90">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SpieltagOptionZuText}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <TextBlock Text="Noch keine Gruppenzuordnung — Gruppen erscheinen nach der Auslosung/Spielplan-Generierung."
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="16,48"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding HatGruppenTabellenAnzeige, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel Visibility="{Binding HatGruppenTabellenAnzeige, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding AnzeigeGruppenTabellen}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type tabelle:GruppenTabelle}">
                                    <!-- Height="Auto" gegen dieselbe MaterialDesign-Button-Höhenklemme wie bei
                                         BracketKartenTemplate weiter oben. -->
                                    <Button Command="{Binding DataContext.GruppeAngeklicktBefehl, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand" BorderThickness="0" Padding="0" Background="Transparent"
                                            ToolTip="Klicken, um den Spielplan links auf diese Gruppe zu filtern."
                                            Margin="0,0,12,12" Height="Auto">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                    <Border Width="290"
                                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius8}">
                                        <StackPanel>

                                            <!-- Card-Header -->
                                            <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    CornerRadius="8,8,0,0" Padding="12,8">
                                                <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
                                                    <Run Text="Gruppe " />
                                                    <Run Text="{Binding GruppenNummer}" />
                                                </TextBlock>
                                            </Border>

                                            <!-- Tabellen-Kopfzeile -->
                                            <Grid Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="6,5,0,5" />
                                                <TextBlock Grid.Column="1" Text="Team"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           Padding="4,5" />
                                                <TextBlock Grid.Column="2" Text="Sp"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="3" Text="Tore"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="4" Text="Diff"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="5" Text="Pkt"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5,6,5" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource MaterialDesign.Brush.Card.Border}" />

                                            <!-- Tabellen-Einträge -->
                                            <ItemsControl ItemsSource="{Binding Tabelle}"
                                                          ItemTemplate="{StaticResource TabellenEintragZeileTemplate}" />

                                        </StackPanel>
                                    </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Gruppenübergreifende Rangfolge-Regeln (Issue #184/#212) -->
                        <ItemsControl ItemsSource="{Binding UebergreifendeRangfolgenAnzeige}"
                                      Visibility="{Binding HatUebergreifendeRangfolgenAnzeige, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UebergreifendeRangfolgeAnzeige}">
                                    <Border Width="290"
                                            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius8}"
                                            Margin="0,0,12,12">
                                        <StackPanel>

                                            <!-- Card-Header -->
                                            <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    CornerRadius="8,8,0,0" Padding="12,8">
                                                <StackPanel>
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
                                                        <Run Text="Platz " />
                                                        <Run Text="{Binding Platzierung}" />
                                                        <Run Text=" gruppenübergreifend" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="White" FontSize="10" Opacity="0.85">
                                                        <Run Text="beste " /><Run Text="{Binding AnzahlBeste}" />
                                                        <Run Text=" → " /><Run Text="{Binding ZielRundeName}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Tabellen-Kopfzeile -->
                                            <Grid Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="#"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="6,5,0,5" />
                                                <TextBlock Grid.Column="1" Text="Team"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           Padding="4,5" />
                                                <TextBlock Grid.Column="2" Text="Sp"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="3" Text="Tore"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="4" Text="Diff"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5" />
                                                <TextBlock Grid.Column="5" Text="Pkt"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" Padding="0,5,6,5" />
                                            </Grid>

                                            <Rectangle Height="1" Fill="{DynamicResource MaterialDesign.Brush.Card.Border}" />

                                            <!-- Tabellen-Einträge -->
                                            <ItemsControl ItemsSource="{Binding Rangfolge}"
                                                          ItemTemplate="{StaticResource TabellenEintragZeileTemplate}" />

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ── Liga-/TopfLiga-/SchweizerSystem-Gesamttabelle (Issue #137, Phase A von #33) ── -->
                <DockPanel Visibility="{Binding ZeigtLigaTabelle, Converter={StaticResource BoolToVisibility}}">

                    <!-- Ansicht-Tabs (Gesamt/Hinrunde/Rückrunde/Heim/Auswärts, Issue #95) + Tabellenstand-Snapshot (Issue #141) -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="{StaticResource Radius6}" Background="{DynamicResource MaterialDesign.Brush.Background}" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Gesamt"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Gesamt}"
                                            Padding="10,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Gesamt}">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Hinrunde"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Hinrunde}"
                                            Padding="10,3" Cursor="Hand" FontSize="11"
                                            Visibility="{Binding ZeigtHinRueckrundenTabs, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Hinrunde}">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Rückrunde"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Rueckrunde}"
                                            Padding="10,3" Cursor="Hand" FontSize="11"
                                            Visibility="{Binding ZeigtHinRueckrundenTabs, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Rueckrunde}">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Heim"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Heimtabelle}"
                                            Padding="10,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Heimtabelle}">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Auswärts"
                                            Command="{Binding LigaAnsichtWaehlenBefehl}"
                                            CommandParameter="{x:Static tabelle:TabellenAnsicht.Auswaertstabelle}"
                                            Padding="10,3" Cursor="Hand" FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AktivTabButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AusgewaehlteLigaAnsicht}" Value="{x:Static tabelle:TabellenAnsicht.Auswaertstabelle}">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Tabellenstand-Snapshot nach Spieltag (Issue #141) -->
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Tabellenstand:" FontSize="11" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding TabellenSpieltagOptionen}"
                                          SelectedItem="{Binding TabellenBisSpieltagAuswahl}"
                                          FontSize="11" Padding="8,3" MinWidth="90">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SpieltagOptionZuText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <TextBlock Text="Noch kein Spielplan generiert. Die Tabelle erscheint, sobald Spiele vorhanden sind."
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="16,48"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding HatLigaTabelleAnzeige, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius8}"
                                VerticalAlignment="Top"
                                Visibility="{Binding HatLigaTabelleAnzeige, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>

                                <!-- Tabellen-Kopfzeile -->
                                <Grid Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="#"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="6,5,0,5" />
                                    <TextBlock Grid.Column="1" Text="Team"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               Padding="4,5" />
                                    <TextBlock Grid.Column="2" Text="Sp"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="3" Text="S"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="4" Text="U"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="5" Text="N"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="6" Text="Tore"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="7" Text="Diff"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5" />
                                    <TextBlock Grid.Column="8" Text="Pkt"
                                               FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                               HorizontalAlignment="Center" Padding="0,5,6,5" />
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource MaterialDesign.Brush.Card.Border}" />

                                <!-- Tabellen-Einträge -->
                                <ItemsControl ItemsSource="{Binding LigaTabelleAnzeige}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tabelle:TabellenEintrag}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="28" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Rang}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,6,0,6" />
                                                <DockPanel Grid.Column="1" Margin="4,6">
                                                    <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,5,0">
                                                        <Image Source="{Binding Mannschaft.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding Mannschaft.Wappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" />
                                                        <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Opacity="0.35"
                                                                   Visibility="{Binding Mannschaft.Wappen, Converter={StaticResource NullToVisible}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Mannschaft.Name}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Spiele}"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="3" Text="{Binding Siege}"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="4" Text="{Binding Unentschieden}"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="5" Text="{Binding Niederlagen}"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="6"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6">
                                                    <Run Text="{Binding Tore}" /><Run Text=":" /><Run Text="{Binding Gegentore}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="7" Text="{Binding Tordifferenz}"
                                                           FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6" />
                                                <TextBlock Grid.Column="8" Text="{Binding Punkte}"
                                                           FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0,6,6,6" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>

            </DockPanel>
        </Grid>

    </DockPanel>
</UserControl>
