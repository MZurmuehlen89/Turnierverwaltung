<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.RegelwerkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fussballturnierverwaltung.Wpf.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <conv:VerfahrenArtZuTextConverter x:Key="VerfahrenArtZuText" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}"
          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="380" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Linke Spalte: Suche + Liste ── -->
        <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

            <!-- Suchfeld -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="8,6">
                <TextBox Text="{Binding Suchbegriff, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="🔍  Suchen …"
                         materialDesign:HintAssist.IsFloating="False"
                         Padding="6,4" FontSize="13"
                         BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
            </Border>

            <!-- Ladeindikator -->
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Liste -->
            <ListBox ItemsSource="{Binding RegelwerkeGefiltert}"
                     SelectedItem="{Binding Ausgewaehltes}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                         und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                         (theme-unabhängig hell) ist und unsere eigenen Trigger-Setter ignoriert. -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListBoxItem.Selected}" />
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="10" Opacity="0.60">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}S:{0} U:{1} N:{2}">
                                            <Binding Path="PunkteRegeln[0].PunkteFuerSieg" FallbackValue="?" />
                                            <Binding Path="PunkteRegeln[0].PunkteFuerUnentschieden" FallbackValue="?" />
                                            <Binding Path="PunkteRegeln[0].PunkteFuerNiederlage" FallbackValue="?" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4"
                      HorizontalAlignment="Stretch" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

        <!-- ── Rechte Spalte ── -->
        <Grid Grid.Column="2">

            <!-- Platzhalter -->
            <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Regelwerk auswählen oder" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Menüleiste klicken"
                           FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Formular -->
            <ScrollViewer Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" MaxWidth="600">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <TextBlock Text="Beschreibung" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Beschreibung, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,5" FontSize="13" Margin="0,0,0,12"
                             BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Gültig von (Jahr)" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding GueltigVon, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Gültig bis (Jahr)" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding GueltigBis, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5" FontSize="13"
                                     BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- PUNKTESYSTEM -->
                    <TextBlock Text="PUNKTESYSTEM" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sieg" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding PunkteSieg}"
                                Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PunkteSieg}"
                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Unentschieden" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding PunkteUnentschieden}"
                                Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PunkteUnentschieden}"
                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Niederlage" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding PunkteNiederlage}"
                                Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PunkteNiederlage}"
                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ENTSCHEIDUNGSVERFAHREN -->
                    <TextBlock Text="ENTSCHEIDUNGSVERFAHREN (K.O.)" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="8" Margin="0,0,0,24">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding AusgewaehlteVerfahren}"
                                     SelectedItem="{Binding MarkiertesVerfahren}"
                                     Height="120" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                     Background="{DynamicResource MaterialDesign.Brush.Card.Background}" Margin="0,0,0,6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <!-- BasedOn ist Pflicht: ohne ihn verliert der Container das MaterialDesign-Template
                                         und fällt auf das native Aero2-Template zurück, dessen Hover-Overlay fest verdrahtet
                                         (theme-unabhängig hell) ist und unsere eigenen Trigger-Setter ignoriert. -->
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.ListBoxItem.Selected}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource VerfahrenArtZuText}}"
                                                   FontSize="12" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Hinzufügen-Zeile -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding VerfuegbareVerfahren}"
                                          SelectedItem="{Binding NeuesVerfahren}"
                                          Padding="6,4" FontSize="12" BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource VerfahrenArtZuText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Content="Hinzufügen"
                                        Command="{Binding VerfahrenHinzufuegenCommand}"
                                        Padding="10,4" FontSize="12" Cursor="Hand"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            </Grid>

                            <!-- Bearbeiten-Leiste -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="↑"
                                        Command="{Binding VerfahrenHochCommand}"
                                        Padding="8,3" FontSize="13" Margin="0,0,4,0" Cursor="Hand"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                        ToolTip="Nach oben" />
                                <Button Content="↓"
                                        Command="{Binding VerfahrenRunterCommand}"
                                        Padding="8,3" FontSize="13" Margin="0,0,4,0" Cursor="Hand"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                        ToolTip="Nach unten" />
                                <Button Content="Entfernen"
                                        Command="{Binding VerfahrenEntfernenCommand}"
                                        Padding="8,3" FontSize="12" Cursor="Hand"
                                        Foreground="#F87171" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RANKING-REGELSET -->
                    <TextBlock Text="RANKING-REGELSET" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,0,0,8" />

                    <ComboBox ItemsSource="{Binding RankingSetOptionen}"
                              SelectedItem="{Binding AusgewaehltesRankingSet}"
                              DisplayMemberPath="Anzeige"
                              Padding="8,5" FontSize="13" Margin="0,0,0,24"
                              BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="1" />

                    <!-- Fehlermeldung -->
                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{StaticResource ErrorSoftBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="{StaticResource Radius4}" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
