<Window x:Class="Fussballturnierverwaltung.Wpf.Views.RanglistenImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rangliste aus dem Internet importieren"
        Width="840" Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

    <Window.Resources>
        <Style x:Key="ImportGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="ImportGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.DataGrid.Selected}" />
                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsSelected" Value="False" />
                    </MultiTrigger.Conditions>
                    <!-- Eigener Hover-Brush statt Card.Border (Issue #268 Pkt. 2): Card.Border ist
                         auch AlternatingRowBackground, auf geraden Zeilen wäre der Hover sonst unsichtbar. -->
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.DataGrid.RowHoverBackground}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImportGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- ── Quelle wählen ── -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Quelle:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Quellen}" SelectedItem="{Binding AusgewaehlteQuelle}"
                      DisplayMemberPath="Name" Width="280" Padding="6,4" Margin="0,0,8,0" />
            <Button Content="Verwalten…" Click="QuellenVerwaltenButton_Click" Padding="10,5" Margin="0,0,8,0" Cursor="Hand" />
            <Button Content="Abrufen" Command="{Binding AbrufenCommand}" Padding="14,5" FontWeight="SemiBold" Cursor="Hand" />
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                     Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding Fehlermeldung}" Foreground="Red" TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}" />

        <!-- ── Ziel-Rangliste + Aktionen ── -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Visibility="{Binding VorschauVorhanden, Converter={StaticResource BoolToVisibility}}">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8" />
                    <TextBlock Text="Datum (yyyy-MM-dd)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Datum, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,8" />
                    <TextBlock Text="Quelle (Anzeigetext)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding QuelleText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <RadioButton Content="Neue Rangliste anlegen" GroupName="Ziel"
                                 IsChecked="{Binding NeueRanglisteErstellen}" Margin="0,0,0,8" />
                    <RadioButton Content="Bestehende Rangliste aktualisieren" GroupName="Ziel"
                                 IsChecked="{Binding BestehendeAktualisieren}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding VorhandeneRanglisten}" SelectedItem="{Binding ZielRangliste}"
                              DisplayMemberPath="Name" Padding="6,4"
                              IsEnabled="{Binding BestehendeAktualisieren}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="SchliessenButton_Click" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="Import ausführen" Command="{Binding ImportierenCommand}"
                        Padding="14,6" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </StackPanel>

        <!-- ── Vorschau ── -->
        <Grid Visibility="{Binding VorschauVorhanden, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Text="Automatisch zugeordnet" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Aufgeloest}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                          Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                          BorderThickness="0"
                          RowHeight="26" FontSize="12"
                          ColumnHeaderStyle="{StaticResource ImportGridColumnHeaderStyle}"
                          RowStyle="{StaticResource ImportGridRowStyle}"
                          CellStyle="{StaticResource ImportGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quellname" Binding="{Binding Quelle.RohName}" Width="*" />
                        <DataGridTextColumn Header="Mannschaft" Binding="{Binding Mannschaft.Name}" Width="*" />
                        <DataGridTextColumn Header="Punkte" Binding="{Binding Quelle.Punkte}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="Nicht erkannt — bitte zuordnen oder überspringen" FontWeight="SemiBold" Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding Unaufgeloest}" AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource MaterialDesign.Brush.DataGrid.Border}"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="{DynamicResource MaterialDesign.Brush.Card.Border}"
                          Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                          BorderThickness="0"
                          RowHeight="30" FontSize="12"
                          ColumnHeaderStyle="{StaticResource ImportGridColumnHeaderStyle}"
                          RowStyle="{StaticResource ImportGridRowStyle}"
                          CellStyle="{StaticResource ImportGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quellname" Binding="{Binding Quelle.RohName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Punkte" Binding="{Binding Quelle.Punkte}" Width="80" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Zuordnung" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Optionen}" SelectedItem="{Binding Ausgewaehlt, Mode=TwoWay}"
                                              DisplayMemberPath="Anzeige" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

    </DockPanel>
</Window>
