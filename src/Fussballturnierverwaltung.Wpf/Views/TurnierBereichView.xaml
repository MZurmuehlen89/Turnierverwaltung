<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierBereichView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fussballturnierverwaltung.Wpf.Views">

    <DockPanel>

        <!-- ── Fortschrittsanzeige (Turnier-Auswahl selbst kommt jetzt aus der äußeren
             Kopfzeile des Turnier-Bereichs, siehe TurnierEditorView) ── -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding FortschrittAnzeige, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding FortschrittAnzeige}"
                       FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
        </Border>

        <!-- ── Split-Ansicht: Spielplan links | Turnierbaum rechts (entfaellt bei nur einer Runde) ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <views:SpielplanView Grid.Column="0" DataContext="{Binding SpielplanVm}">
                <views:SpielplanView.Style>
                    <Style TargetType="views:SpielplanView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ZeigeSplitAnsicht, RelativeSource={RelativeSource AncestorType=Grid}}" Value="False">
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SpielplanView.Style>
            </views:SpielplanView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          Background="#E2E8F0" ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding ZeigeSplitAnsicht, Converter={StaticResource BoolToVisibility}}" />

            <views:TurnierBaumView Grid.Column="2" DataContext="{Binding TurnierBaumVm}"
                                    Visibility="{Binding DataContext.ZeigeSplitAnsicht, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

    </DockPanel>

</UserControl>
