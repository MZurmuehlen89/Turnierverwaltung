<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierBereichView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Fussballturnierverwaltung.Wpf.Views">

    <DockPanel>

        <!-- ── Gemeinsamer Header: Turnier-Auswahl ── -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Turnier" FontSize="11" FontWeight="Bold"
                           Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding Instanzen}"
                          SelectedItem="{Binding AusgewaehlteInstanz}"
                          DisplayMemberPath="Name"
                          Width="220" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- ── Split-Ansicht: Spielplan links | Turnierbaum rechts ── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <views:SpielplanView Grid.Column="0" DataContext="{Binding SpielplanVm}" />

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          Background="#E2E8F0" ResizeBehavior="PreviousAndNext" />

            <views:TurnierBaumView Grid.Column="2" DataContext="{Binding TurnierBaumVm}" />
        </Grid>

    </DockPanel>

</UserControl>
