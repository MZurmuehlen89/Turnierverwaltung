<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.EinzelspielSimulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             xmlns:dom="clr-namespace:Fussballturnierverwaltung.Domain.Entitaeten.Stammdaten;assembly=Fussballturnierverwaltung.Domain"
             xmlns:views="clr-namespace:Fussballturnierverwaltung.Wpf.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="TeamSucheTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Card.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="materialDesign:HintAssist.Hint" Value="🔍  Suche…" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>

        <!-- Issue #232: Wappen bzw. bei Nationalmannschaften Landesflagge neben der Mannschaft in
             beiden Team-Auswahl-ComboBoxen, mit Fallback-Platzhalter-Icon analog Issue #2/#229/#230. -->
        <DataTemplate x:Key="MannschaftMitWappenTemplate" DataType="{x:Type dom:Mannschaft}">
            <DockPanel>
                <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,6,0">
                    <Image Source="{Binding Converter={StaticResource MannschaftZuWappenBildquelle}}"
                           Visibility="{Binding Converter={StaticResource MannschaftHatWappen}}"
                           Stretch="Uniform" />
                    <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.35"
                               Visibility="{Binding Converter={StaticResource MannschaftHatKeinWappen}}" />
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource MaterialDesign.Brush.Background}"
               TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

        <!-- "Simuliert…"-Anzeige -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="10,8"
                Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Simuliert…" FontSize="12" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="340" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Linke Spalte: Team-Auswahl ── -->
            <DockPanel Grid.Column="0" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">

                        <TextBlock Text="HEIMTEAM" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,4,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding HeimSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TeamSucheTextBox}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                      SelectedItem="{Binding HeimVerbandFilter}"
                                      DisplayMemberPath="Anzeige"
                                      Padding="4,2" FontSize="12" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding HeimMannschaftenGefiltert}"
                                  SelectedItem="{Binding EinzelspielHeim}"
                                  ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                                  FontSize="13" />

                        <TextBlock Text="AUSWÄRTSTEAM" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,12,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AuswaertsSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TeamSucheTextBox}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                      SelectedItem="{Binding AuswaertsVerbandFilter}"
                                      DisplayMemberPath="Anzeige"
                                      Padding="4,2" FontSize="12" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AuswaertsMannschaftenGefiltert}"
                                  SelectedItem="{Binding EinzelspielAuswaerts}"
                                  ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                                  FontSize="13" />

                        <TextBlock Text="REGELWERK (OPTIONAL)" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding AlleRegelwerke}"
                                  SelectedItem="{Binding EinzelspielRegelwerk}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />
                        <TextBlock Text="Leer = kein Tiebreaker" FontSize="10"
                                   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Margin="0,2,0,0" />

                        <CheckBox Content="Mit Rückspiel"
                                  IsChecked="{Binding EinzelspielMitRueckspiel}"
                                  Margin="0,14,0,0" FontSize="13" />

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource MaterialDesign.Brush.Card.Border}" />

            <!-- ── Rechte Spalte: Protokoll-Anzeige ── -->
            <DockPanel Grid.Column="2">

                <!-- Header -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Card.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SPIELPROTOKOLL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                        <TextBlock Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" FontSize="11" FontWeight="Bold" Text=" · "
                                   Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding ProtokollSpielInfo}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                   Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- Fehlermeldung -->
                <Border DockPanel.Dock="Top" Margin="16,10,16,0"
                        Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,8"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Vereinheitlichte Spielbericht-Karte (Scoreboard + Zeitleiste, Issue #237) — letztes,
                     nicht gedocktes DockPanel-Kind, damit sie die Resthöhe ausfüllt statt bei fester Höhe
                     zu scrollen (Issue #236). -->
                <views:SpielberichtControl Margin="16,12,16,0"
                    LeerZustandText="Zwei Mannschaften auswählen und auf Simulieren klicken." />

            </DockPanel>

        </Grid>
    </DockPanel>
</UserControl>
