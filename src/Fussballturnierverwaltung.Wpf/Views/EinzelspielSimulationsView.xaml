<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.EinzelspielSimulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fussballturnierverwaltung.Wpf.ViewModels"
             xmlns:dom="clr-namespace:Fussballturnierverwaltung.Domain.Entitaeten.Stammdaten;assembly=Fussballturnierverwaltung.Domain">

    <UserControl.Resources>
        <Style x:Key="TeamSucheTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background">
                        <Setter.Value>
                            <VisualBrush Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="🔍  Suche…" Foreground="#9CA3AF" Margin="6,4" FontSize="12" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Issue #232: Wappen bzw. bei Nationalmannschaften Landesflagge neben der Mannschaft in
             beiden Team-Auswahl-ComboBoxen, mit Fallback-Platzhalter-Icon analog Issue #2/#229/#230. -->
        <DataTemplate x:Key="MannschaftMitWappenTemplate" DataType="{x:Type dom:Mannschaft}">
            <DockPanel>
                <Grid Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,6,0">
                    <Image Source="{Binding Converter={StaticResource MannschaftZuWappenBildquelle}}"
                           Visibility="{Binding Converter={StaticResource MannschaftHatWappen}}"
                           Stretch="Uniform" />
                    <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.35"
                               Visibility="{Binding Converter={StaticResource MannschaftHatKeinWappen}}" />
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>

        <!-- "Simuliert…"-Anzeige -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,8"
                Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Simuliert…" FontSize="12" Foreground="{StaticResource TextSubtleBrush}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" MaxWidth="340" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── Linke Spalte: Team-Auswahl ── -->
            <DockPanel Grid.Column="0" Background="{StaticResource SurfaceBrush}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">

                        <TextBlock Text="HEIMTEAM" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSubtleBrush}" Margin="0,4,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding HeimSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TeamSucheTextBox}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                      SelectedItem="{Binding HeimVerbandFilter}"
                                      DisplayMemberPath="Anzeige"
                                      Padding="4,2" FontSize="12" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding HeimMannschaftenGefiltert}"
                                  SelectedItem="{Binding EinzelspielHeim}"
                                  ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                                  FontSize="13" />

                        <TextBlock Text="AUSWÄRTSTEAM" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSubtleBrush}" Margin="0,12,0,4" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AuswaertsSuchbegriff, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource TeamSucheTextBox}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                      SelectedItem="{Binding AuswaertsVerbandFilter}"
                                      DisplayMemberPath="Anzeige"
                                      Padding="4,2" FontSize="12" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding AuswaertsMannschaftenGefiltert}"
                                  SelectedItem="{Binding EinzelspielAuswaerts}"
                                  ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                                  FontSize="13" />

                        <TextBlock Text="REGELWERK (OPTIONAL)" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSubtleBrush}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding AlleRegelwerke}"
                                  SelectedItem="{Binding EinzelspielRegelwerk}"
                                  DisplayMemberPath="Name"
                                  FontSize="13" />
                        <TextBlock Text="Leer = kein Tiebreaker" FontSize="10"
                                   Foreground="{StaticResource TextSubtleBrush}" Margin="0,2,0,0" />

                        <CheckBox Content="Mit Rückspiel"
                                  IsChecked="{Binding EinzelspielMitRueckspiel}"
                                  Margin="0,14,0,0" FontSize="13" />

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <!-- ── Rechte Spalte: Protokoll-Anzeige ── -->
            <DockPanel Grid.Column="2">

                <!-- Header -->
                <Border DockPanel.Dock="Top" Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SPIELPROTOKOLL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSubtleBrush}" />
                        <TextBlock Foreground="{StaticResource TextSubtleBrush}" FontSize="11" FontWeight="Bold" Text=" · "
                                   Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding ProtokollSpielInfo}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- Fehlermeldung -->
                <Border DockPanel.Dock="Top" Margin="16,10,16,0"
                        Background="{StaticResource ErrorSoftBrush}" BorderBrush="{StaticResource ErrorSoftBorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Padding="12,8"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <!-- Ergebnis-Karte -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource SuccessSoftBrush}" BorderBrush="#BBF7D0" BorderThickness="1"
                        CornerRadius="{StaticResource Radius6}" Padding="16,12" Margin="16,12,16,0"
                        Visibility="{Binding HatProtokoll, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="ERGEBNIS" FontSize="10" FontWeight="Bold"
                                   Foreground="#16A34A" Margin="0,0,0,8" HorizontalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding ProtokollZeilen}"
                                      HorizontalAlignment="Center" HorizontalContentAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProtokollErgebnisZeile}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                        <TextBlock Text="{Binding Label, StringFormat={}{0}:  }" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas"
                                                   Visibility="{Binding Label, Converter={StaticResource NullToCollapsed}}" />

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ZeigtTeams, Converter={StaticResource BoolToVisibility}}">
                                            <Grid Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding HeimName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Score}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" Margin="8,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AuswaertsName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" Margin="0,0,5,0"
                                                       VerticalAlignment="Center" />
                                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="🏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Score}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrongBrush}" FontFamily="Consolas" VerticalAlignment="Center"
                                                   Visibility="{Binding ZeigtTeams, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Spielverlauf (Ausführliche Simulation) -->
                <Border DockPanel.Dock="Top"
                        Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius4}" Margin="16,8,16,0"
                        Visibility="{Binding HatProtokollEreignisse, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="SPIELVERLAUF" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSubtleBrush}" Margin="12,8,12,4" />

                        <Grid Margin="12,0,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HEIM" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="AUSWÄRTS" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Left" />
                        </Grid>
                        <Separator />

                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProtokollEreignisse}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EinzelspielEreignisZeile}">
                                        <Grid>
                                            <!-- Ereignis-Zeile -->
                                            <Grid Margin="12,4"
                                                  Visibility="{Binding IstTrenner, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Visibility="{Binding IstHeimSeite, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Art}" FontSize="11"
                                                               Foreground="{StaticResource TextStrongBrush}" TextAlignment="Right" />
                                                    <TextBlock Text=" ◄" FontSize="11" FontWeight="Bold"
                                                               Foreground="#8B5CF6" Margin="4,0,0,0" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Minute}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"
                                                           HorizontalAlignment="Center" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding IstHeimSeite, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <TextBlock Text="► " FontSize="11" FontWeight="Bold"
                                                               Foreground="#8B5CF6" />
                                                    <TextBlock Text="{Binding Art}" FontSize="11" Foreground="{StaticResource TextStrongBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Abschnittstrenner -->
                                            <Grid Margin="12,10"
                                                  Visibility="{Binding IstTrenner, Converter={StaticResource BoolToVisibility}}">
                                                <Separator VerticalAlignment="Center" />
                                                <Border Background="White" HorizontalAlignment="Center" Padding="8,0">
                                                    <TextBlock Text="{Binding TrennerText}" FontSize="9" FontWeight="Bold"
                                                               Foreground="{StaticResource TextSubtleBrush}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Leer-Zustand -->
                <TextBlock Text="Zwei Mannschaften auswählen und auf Simulieren klicken."
                           Foreground="{StaticResource TextSubtleBrush}" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="340" TextAlignment="Center"
                           Visibility="{Binding ZeigeLeerZustand, Converter={StaticResource BoolToVisibility}}" />

            </DockPanel>

        </Grid>
    </DockPanel>
</UserControl>
