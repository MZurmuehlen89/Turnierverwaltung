<UserControl x:Class="Fussballturnierverwaltung.Wpf.Views.TurnierAuswahlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="InstanzCombo"
                  IsEditable="True"
                  IsTextSearchEnabled="False"
                  StaysOpenOnEdit="True"
                  ItemsSource="{Binding InstanzenGefiltert}"
                  SelectedItem="{Binding AusgewaehlteInstanz}"
                  DisplayMemberPath="Name"
                  TextBoxBase.TextChanged="InstanzCombo_TextChanged"
                  SelectionChanged="InstanzCombo_SelectionChanged"
                  Width="240" FontSize="13" />
        <Button Content="⋯" Width="26" Height="24" Margin="4,0,0,0"
                Click="AuswahlDialogButton_Click"
                ToolTip="Turnier aus vollständiger Liste wählen"
                FontSize="14" Cursor="Hand" />
    </StackPanel>

</UserControl>
