<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fussballturnierverwaltung.Domain\Fussballturnierverwaltung.Domain.csproj" />
    <ProjectReference Include="..\Fussballturnierverwaltung.Application\Fussballturnierverwaltung.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed-Bildmaterial (Issue #233): Flaggen aus flag-icons (MIT, THIRD-PARTY-NOTICES.md). Wappen und Logos mit
         fremden Rechten liegen im git-ignorierten Unterordner Privat (Klon des privaten Repos, #633) und werden
         eingebettet, wenn er vorhanden ist. -->
    <EmbeddedResource Include="Seed\Bildmaterial\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <!-- Npgsql bringt nur eine ältere Relational-Version mit; ohne eigenen Verweis fehlt zur Laufzeit die Version, gegen die über das Design-Paket kompiliert wird (FileNotFoundException in den Tests, #49) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
