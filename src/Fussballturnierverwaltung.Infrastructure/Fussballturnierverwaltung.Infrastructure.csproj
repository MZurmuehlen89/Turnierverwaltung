<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fussballturnierverwaltung.Domain\Fussballturnierverwaltung.Domain.csproj" />
    <ProjectReference Include="..\Fussballturnierverwaltung.Application\Fussballturnierverwaltung.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed-Bildmaterial (Issue #233): Flaggen aus flag-icons (MIT, THIRD-PARTY-NOTICES.md). Wappen und Logos mit
         fremden Rechten liegen im git-ignorierten Unterordner Privat (Klon des privaten Repos, #633) und werden
         eingebettet, wenn er vorhanden ist. -->
    <EmbeddedResource Include="Seed\Bildmaterial\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <!-- Hebt das transitive Pkcs aus Microsoft.Data.SqlClient (6.1.7 zieht 9.0.11) über die Sicherheitslücken
         GHSA-846f-f764-76mx und GHSA-2fmv-rv2c-59x7 (betroffen bis 9.0.20). Entfernen, sobald SqlClient selbst eine
         gepatchte Version mitbringt – prüfen mit: dotnet nuget why <Projekt> System.Security.Cryptography.Pkcs (#493) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
