<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Fussballturnierverwaltung.WinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views"
    xmlns:nav="using:Fussballturnierverwaltung.WinUi.Navigation"
    Title="Turnierverwaltung">

    <!-- Expliziter Background nötig: ohne ihn bleibt das Grid transparent und WinUI3s Fenster-Backdrop
         (Mica) folgt dann dem System-Theme statt der hier per RequestedTheme gesetzten App-internen
         Theme-Wahl — bei auseinanderlaufendem System-/App-Theme dann falsche Text/Hintergrund-Paarung. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <!-- View-Locator: ContentControl löst nach Laufzeittyp des Content über diese impliziten
                 DataTemplates auf (klassisches Binding, kein x:Bind — x:Bind ist stark typisiert und
                 kann AktuellesViewModel (ViewModelBase) nicht auf die konkrete View mappen). -->
            <DataTemplate x:Key="PlatzhalterTemplate" x:DataType="vm:PlatzhalterViewModel">
                <views:PlatzhalterPage />
            </DataTemplate>
            <DataTemplate x:Key="MannschaftenTemplate" x:DataType="vm:MannschaftenViewModel">
                <views:MannschaftenPage />
            </DataTemplate>
            <DataTemplate x:Key="LaenderUndVerbaendeTemplate" x:DataType="vm:LaenderUndVerbaendeViewModel">
                <views:LaenderUndVerbaendePage />
            </DataTemplate>
            <local:ViewModelTemplateSelector x:Key="ViewLocator"
                                              xmlns:local="using:Fussballturnierverwaltung.WinUi"
                                              PlatzhalterTemplate="{StaticResource PlatzhalterTemplate}"
                                              MannschaftenTemplate="{StaticResource MannschaftenTemplate}"
                                              LaenderUndVerbaendeTemplate="{StaticResource LaenderUndVerbaendeTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ribbon-Ersatz (kein first-party WinUI-3-Ribbon vorhanden, siehe #278-Recherche): CommandBar mit
             AppBarButton/AppBarToggleButton, gegen das jeweils aktive ViewModel gebunden (MainViewModel
             reicht die Ribbon-Properties des aktuellen ViewModel als Proxy durch). Die CommandBar selbst
             bleibt immer sichtbar (App-weite Aktionen wie der Dark-Mode-Toggle müssen unabhängig davon
             erreichbar sein, ob die aktive View überhaupt IRibbonAware ist) — nur der Fach-View-Titel und
             die Standardaktionen blenden sich individuell ein/aus.
             Positionierung (Nutzerwunsch aus #281-Test): CommandBar.PrimaryCommands rendert als Gruppe
             rechtsbündig (rechts von Content, vor dem Overflow) — "links" innerhalb dieser Gruppe ist
             NICHT dasselbe wie "ganz links im Fenster". Die Fach-View-Aktionen (inkl. dynamischer
             RibbonZusatzGruppen, siehe MainWindow.xaml.cs) laufen daher über CommandBar.Content (das
             fensterseitig links verankert ist); PrimaryCommands enthält dadurch nur noch den App-weiten
             Dark-Mode-Toggle, der so automatisch ganz rechts landet. -->
        <CommandBar x:Name="HauptCommandBar" Grid.Row="0" DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel x:Name="AktionenPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.RibbonTabTitel, Mode=OneWay}"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,16,0"
                               Visibility="{x:Bind ViewModel.HatRibbonBereich, Mode=OneWay}" />
                    <AppBarButton Icon="Add" Label="Neu" Command="{x:Bind ViewModel.RibbonNeuBefehl, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HatStandardAktionen, Mode=OneWay}" />
                    <AppBarButton Icon="Save" Label="Speichern" Command="{x:Bind ViewModel.RibbonSpeichernBefehl, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HatStandardAktionen, Mode=OneWay}" />
                    <AppBarButton Icon="Undo" Label="Abbrechen" Command="{x:Bind ViewModel.RibbonAbbrechenBefehl, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HatStandardAktionen, Mode=OneWay}" />
                    <AppBarSeparator Visibility="{x:Bind ViewModel.HatLoeschenAktion, Mode=OneWay}" />
                    <AppBarButton Icon="Delete" Label="Löschen" Command="{x:Bind ViewModel.RibbonLoeschenBefehl, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HatLoeschenAktion, Mode=OneWay}" />
                    <!-- Dynamische RibbonZusatzGruppen werden hier angehängt — siehe MainWindow.xaml.cs,
                         RibbonZusatzGruppenAktualisieren. -->
                </StackPanel>
            </CommandBar.Content>
            <!-- App-weit, immer sichtbar, bewusst ganz rechts -->
            <AppBarSeparator />
            <AppBarToggleButton Icon="View" Label="Dunkles Design"
                                 IsChecked="{x:Bind ViewModel.IstDunkelModus, Mode=OneWay}"
                                 Command="{x:Bind ViewModel.ThemeUmschaltenCommand}" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnDefinitions="220,1,*">

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="16,20,16,16">
                    <TextBlock Text="⚽" FontSize="22" />
                    <TextBlock Text="Turnierverwaltung" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavigationsGruppen, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="nav:NavigationsGruppe">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Titel}" Opacity="0.6" FontSize="11"
                                               FontWeight="SemiBold" Margin="16,16,8,4" />
                                    <ItemsControl ItemsSource="{x:Bind Eintraege}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="nav:NavigationsEintrag">
                                                <Button Content="{x:Bind Titel}" Command="{x:Bind Befehl}"
                                                        Background="Transparent" BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Margin="4,1" Padding="12,8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- Inhaltsbereich: klassisches Binding (nicht x:Bind) + ContentTemplateSelector, damit sich
                 die View nach dem Laufzeittyp von AktuellesViewModel richtet. -->
            <ContentControl x:Name="InhaltsBereich" Grid.Column="2"
                            Content="{Binding AktuellesViewModel}"
                            ContentTemplateSelector="{StaticResource ViewLocator}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
