<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurnierAuswahlDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Turnier auswählen"
    CloseButtonText="Schließen"
    DefaultButton="Close">

    <Grid Width="480" Height="420" RowDefinitions="Auto,Auto,*">
        <TextBox Grid.Row="0" PlaceholderText="🔍  Suchen …"
                 Text="{Binding Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8" />
        <Rectangle Grid.Row="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,0,0,8" />

        <ListView Grid.Row="2"
                  ItemsSource="{Binding InstanzenGefiltert}"
                  SelectedItem="{Binding AusgewaehlteInstanz, Mode=TwoWay}"
                  SelectionMode="Single"
                  DoubleTapped="ListView_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,90,110" Padding="0,6">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding SaisonOderJahr}" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" Opacity="0.6" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
