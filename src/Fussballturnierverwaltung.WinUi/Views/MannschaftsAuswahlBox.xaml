<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.MannschaftsAuswahlBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <AutoSuggestBox x:Name="Box"
                    QueryIcon="Find" UpdateTextOnSelect="False"
                    Text="{Binding SuchText, Mode=TwoWay}"
                    ItemsSource="{Binding Vorschlaege}"
                    TextChanged="Box_TextChanged"
                    QuerySubmitted="Box_QuerySubmitted"
                    GotFocus="Box_GotFocus"
                    LostFocus="Box_LostFocus">
        <AutoSuggestBox.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                           Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                           Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </AutoSuggestBox.ItemTemplate>
    </AutoSuggestBox>
</UserControl>
