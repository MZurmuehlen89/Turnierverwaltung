<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.RanglistenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnDefinitions="3*,1,2*">

        <!-- ── Linke Spalte: Suche + Liste ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <Border Grid.Row="0" Padding="8,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBox Text="{Binding Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="🔍  Suchen …" HorizontalAlignment="Stretch" />
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <ListView Grid.Row="2"
                      ItemsSource="{Binding RanglistenGefiltert}"
                      SelectedItem="{Binding Ausgewaehltes, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Datum}" FontSize="10" Opacity="0.6" />
                                <TextBlock FontSize="10" Opacity="0.6">
                                    <Run Text="{Binding Eintraege.Count}" /><Run Text=" Einträge" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Rechte Spalte: Formular ── -->
        <Grid Grid.Column="2" ColumnDefinitions="3*,1*">

            <StackPanel Grid.ColumnSpan="2"
                        Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Rangliste auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Column="0"
                          Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,24" ColumnDefinitions="*,16,*">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="Datum (JJJJ-MM-TT)" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Datum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                            <TextBlock Text="Quelle" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Quelle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <!-- EINTRÄGE -->
                    <TextBlock Text="EINTRÄGE" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,4" />
                    <TextBlock Text="Rang ergibt sich aus der Reihenfolge (per Hoch/Runter anpassbar). Punkte sind optional und rein informativ (z.B. FIFA-Punkte) — für Sortierung/Lostopf-Zuordnung zählt nur der Rang."
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8" Margin="0,0,0,24">
                        <StackPanel Spacing="6">

                            <Grid Padding="4,0" ColumnDefinitions="44,28,*,80">
                                <TextBlock Grid.Column="0" Text="Rang" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                <TextBlock Grid.Column="2" Text="Mannschaft" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                <TextBlock Grid.Column="3" Text="Punkte" FontSize="11" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right" />
                            </Grid>

                            <ListView ItemsSource="{Binding Eintraege}"
                                      SelectedItem="{Binding AusgewaehlterEintrag, Mode=TwoWay}"
                                      Height="220" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,2" ColumnDefinitions="44,28,*,80">
                                            <TextBlock Grid.Column="0" Text="{Binding Rang}" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Width="20" Height="20">
                                                <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="🏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Mannschaft.Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBox Grid.Column="3" Text="{Binding Punkte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntZuText}}"
                                                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                                                     ToolTipService.ToolTip="Optionaler Zusatzwert (z.B. FIFA-Punkte). Rein informativ." />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Team-Auswahl: Suchfeld + Verband-Filter, dann Auswahl -->
                            <Grid ColumnDefinitions="*,8,*">
                                <TextBox Grid.Column="0" Text="{Binding MannschaftSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="🔍  Suche…" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                          SelectedItem="{Binding MannschaftVerbandFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnDefinitions="*,8,Auto">
                                <ComboBox ItemsSource="{Binding VerfuegbareMannschaftenGefiltert}"
                                          SelectedItem="{Binding NeueMannschaft, Mode=TwoWay}"
                                          DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Content="Hinzufügen" Command="{Binding EintragHinzufuegenCommand}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button Content="↑" Command="{Binding EintragHochCommand}" ToolTipService.ToolTip="Nach oben" />
                                <Button Content="↓" Command="{Binding EintragRunterCommand}" ToolTipService.ToolTip="Nach unten" />
                                <Button Content="Entfernen" Command="{Binding EintragEntfernenCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
