<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.RanglistenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- Spaltenaufteilung wie Reiter „Quellen“ (#477): Liste | Formular | Meldungsspalte -->
    <Grid ColumnDefinitions="2.4*,1,5.7*,1,1.9*">

        <!-- ── Linke Spalte: Suche + Liste ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">

            <Border Grid.Row="0" Padding="8,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBox Text="{Binding Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="🔍  Suchen …" HorizontalAlignment="Stretch" />
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <ListView Grid.Row="2"
                      ItemsSource="{Binding RanglistenGefiltert}"
                      SelectedItem="{Binding Ausgewaehltes, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Datum, Converter={StaticResource DatumZuText}}" FontSize="10" Opacity="0.6" />
                                <TextBlock FontSize="10" Opacity="0.6">
                                    <Run Text="{Binding Eintraege.Count}" /><Run Text=" Einträge" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Datensatzanzahl (#366): einheitliche Fußzeile in allen Stammdaten-Editoren -->
            <Border Grid.Row="3" Padding="8,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding AnzahlText}" FontSize="11" Opacity="0.6" />
            </Border>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Formular (#477): Grunddaten und Ligapyramide oben fest, darunter die Eintragsliste als Hauptfläche ──
             Kein äußerer ScrollViewer: nur die Liste scrollt, die Werkzeugleiste darüber bleibt stehen (und die
             ListView virtualisiert, auch bei Hunderten Einträgen). -->
        <Grid Grid.Column="2">

            <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Rangliste auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <Grid Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                  RowDefinitions="Auto,Auto,Auto,*" Margin="28,20,28,16">

                <!-- ── Grunddaten ── -->
                <TextBlock Text="GRUNDDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                <Grid Grid.Row="1" ColumnDefinitions="*,16,Auto" RowDefinitions="Auto,12,Auto" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!-- Deutsches Format und deutscher Kalender (Monatsnamen, Woche ab Montag) unabhängig von der
                         Systemsprache. -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Datum" FontSize="12" Margin="0,0,0,3" />
                        <CalendarDatePicker Date="{Binding Datum, Mode=TwoWay}" Width="160"
                                            Language="de-DE" FirstDayOfWeek="Monday"
                                            DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                            PlaceholderText="TT.MM.JJJJ" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Text="Quelle" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Quelle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- ── Ligapyramide (aufklappbar, #393) ── -->
                <Expander Grid.Row="2" DataContext="{Binding Ligapyramide}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,16"
                          IsExpanded="{Binding Offen, Mode=TwoWay}"
                          Header="{Binding Kopf}" HeaderTemplate="{StaticResource AbschnittKopfVorlage}">
                    <StackPanel>
                        <TextBlock Text="Profigrenze (Spielklasse)" FontSize="12" Margin="0,0,0,3" />
                        <NumberBox Value="{Binding Profigrenze, Mode=TwoWay}"
                                   Minimum="1" SmallChange="1" SpinButtonPlacementMode="Compact"
                                   PlaceholderText="keine" HorizontalAlignment="Left" Width="160" />
                        <TextBlock Text="Für „Heimrecht für Unterklassige“: Ein Team unterhalb dieser Spielklasse hat gegen ein Team bis zu ihr Heimrecht (DFB-Pokal: 2). Leer = strikt die tiefere Klasse (Copa del Rey). Wirkt nur mit Liga-Abschnitten."
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,12" />

                        <StackPanel Visibility="{Binding HatAbschnitte, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Abschnitte" FontSize="12" Margin="0,0,0,3" />
                            <ItemsControl ItemsSource="{Binding Abschnitte}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Anzeige}" FontSize="12" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nur zur Ansicht – die Abschnitte lassen sich derzeit noch nicht bearbeiten."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- ── Einträge ── -->
                <Grid Grid.Row="3" DataContext="{Binding Eintragsliste}" RowDefinitions="Auto,Auto,Auto,*">

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                        <TextBlock Text="{Binding EintraegeUeberschrift}" FontWeight="SemiBold" FontSize="11" Opacity="0.6"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MarkierungText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Hinzufügen: hinter dem letzten markierten Eintrag, sonst am Ende -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,8,200" Margin="0,0,0,8">
                        <views:MannschaftsAuswahlBox DataContext="{Binding Hinzufuegen}"
                                                     PlaceholderText="Mannschaft hinzufügen …" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                                  SelectedItem="{Binding MannschaftVerbandFilterAuswahl, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch"
                                  ToolTipService.ToolTip="Auswahl zum Hinzufügen auf einen Verband beschränken" />
                    </Grid>

                    <!-- Aktionen für die markierten Einträge (Strg/Umschalt + Klick markiert mehrere) und Suche -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding EintraegeHochCommand}" ToolTipService.ToolTip="Markierte einen Platz nach oben">
                                <FontIcon Glyph="&#xE70E;" FontSize="14" />
                            </Button>
                            <Button Command="{Binding EintraegeRunterCommand}" ToolTipService.ToolTip="Markierte einen Platz nach unten">
                                <FontIcon Glyph="&#xE70D;" FontSize="14" />
                            </Button>
                            <NumberBox Value="{Binding ZielRang, Mode=TwoWay}" Minimum="1" PlaceholderText="Rang"
                                       Width="90" Margin="12,0,0,0"
                                       ToolTipService.ToolTip="Zielrang für die markierten Einträge" />
                            <Button Content="Auf Rang verschieben" Command="{Binding AufRangVerschiebenCommand}" />
                            <Button Content="Entfernen" Command="{Binding EintraegeEntfernenCommand}" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="kein Treffer" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                       Visibility="{Binding SucheOhneTreffer, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Text="{Binding SuchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="🔍  In Liste suchen …" Width="220"
                                     KeyDown="Suche_KeyDown"
                                     ToolTipService.ToolTip="Springt zum Treffer; Enter = nächster Treffer" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Padding="16,6" ColumnDefinitions="44,28,*,80"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="Rang" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                <TextBlock Grid.Column="2" Text="Mannschaft" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                <TextBlock Grid.Column="3" Text="Punkte" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <ListView x:Name="EintraegeListe" Grid.Row="1"
                                      ItemsSource="{Binding Eintraege}"
                                      SelectionMode="Extended"
                                      CanReorderItems="True" AllowDrop="True"
                                      SelectionChanged="EintraegeListe_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Abschnittsgrenze der Ligapyramide -->
                                            <TextBlock Text="{Binding AbschnittBeginn}" FontSize="11" FontWeight="SemiBold"
                                                       Opacity="0.6" Margin="0,6,0,2"
                                                       Visibility="{Binding AbschnittBeginn, Converter={StaticResource NullToCollapsed}}" />
                                            <Grid Padding="0,2" ColumnDefinitions="44,28,*,80">
                                                <TextBlock Grid.Column="0" Text="{Binding Rang}" VerticalAlignment="Center" />
                                                <Grid Grid.Column="1" Width="20" Height="20">
                                                    <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                           Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                           Stretch="Uniform" />
                                                    <TextBlock Text="🏳" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Opacity="0.35"
                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                                </Grid>
                                                <TextBlock Grid.Column="2" Text="{Binding Mannschaft.Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBox Grid.Column="3" Text="{Binding Punkte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntZuText}}"
                                                         HorizontalAlignment="Stretch" HorizontalContentAlignment="Right"
                                                         ToolTipService.ToolTip="Optionaler Zusatzwert (z.B. FIFA-Punkte). Rein informativ." />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Meldungsspalte ── -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,20,12,12" Spacing="6">
                <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="4" Padding="8,6">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                </Border>
                <TextBlock Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                           Text="Der Rang ergibt sich aus der Reihenfolge. Punkte sind optional und rein informativ (z. B. FIFA-Punkte) – für Sortierung und Lostöpfe zählt nur der Rang."
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
