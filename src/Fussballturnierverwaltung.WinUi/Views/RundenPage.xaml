<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.RundenPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fussballturnierverwaltung.WinUi.Views"
    xmlns:conv="using:Fussballturnierverwaltung.WinUi.Converters">

    <UserControl.Resources>
        <conv:RundenartZuTextConverter x:Key="RundenartZuText" />
        <local:BoolZuAuswahlHintergrundConverter x:Key="BoolZuAuswahlHintergrund" />

        <!-- Drei Formate für Übergangsregel-Zeilen, je nach Rundenart der Quellrunde (#284) — im Regelformular
             über RegelIstGruppenphase/RegelIstKoSonderfall/RegelIstLiga ausgewählt. -->
        <DataTemplate x:Key="ZeileGruppenphaseTemplate">
            <Grid ColumnDefinitions="70,Auto,44,Auto,44" Margin="0,2">
                <TextBlock Text="{Binding GruppenLabel}" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="Platz" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,0,4,0" />
                <TextBox Grid.Column="2" Text="{Binding PlatzierungVon, Mode=TwoWay}" />
                <TextBlock Grid.Column="3" Text="bis" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="4,0" />
                <TextBox Grid.Column="4" Text="{Binding PlatzierungBis, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ZeileKoSonderfallTemplate">
            <!-- MinWidth="0": CheckBox reserviert sonst ~120px je Box (WinUi/CLAUDE.md, #310) — engte die Zeile im
                 schmaleren Regelformular des Runden-Details ein (#348-Test). -->
            <Grid ColumnDefinitions="Auto,56,*" Margin="0,2">
                <TextBlock Text="Spiel" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding GruppeIndex, Mode=TwoWay}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" Margin="16,0,0,0">
                    <CheckBox Content="Sieger" IsChecked="{Binding IstSieger, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                    <CheckBox Content="Verlierer" IsChecked="{Binding IstVerlierer, Mode=TwoWay}" FontSize="12" MinWidth="0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ZeileLigaTemplate">
            <Grid ColumnDefinitions="Auto,44,Auto,44" Margin="0,2">
                <TextBlock Text="Platz" VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                <TextBox Grid.Column="1" Text="{Binding PlatzierungVon, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="bis" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="4,0" />
                <TextBox Grid.Column="3" Text="{Binding PlatzierungBis, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <!-- Gruppenübergreifende Rangfolge-Regel (z.B. "2 beste Gruppendritte") — nur bei Gruppenphase als
             Quellrunde, siehe UebergangsregelEditorViewModel.GruppenuebergreifendeZeilen. -->
        <DataTemplate x:Key="ZeileGruppenuebergreifendTemplate">
            <Grid ColumnDefinitions="Auto,44,Auto,44,Auto" Margin="0,2">
                <TextBlock Text="Beste" VerticalAlignment="Center" FontSize="11" Opacity="0.6" />
                <TextBox Grid.Column="1" Text="{Binding AnzahlBeste, Mode=TwoWay, Converter={StaticResource NullableIntZuText}}" />
                <TextBlock Grid.Column="2" Text="von Platz" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="4,0" />
                <TextBox Grid.Column="3" Text="{Binding Platzierung, Mode=TwoWay}" />
                <Button Grid.Column="4" Content="✕" FontSize="11" Padding="6,3" Margin="8,0,0,0"
                        Command="{Binding DataContext.UebergangsregelEditor.GruppenuebergreifendeZeileEntfernenCommand, ElementName=Root}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>

        <!-- Eingehend/Ausgehend-Zeile, einzeilig (#348: bleibt auch bei vielen Regeln, z.B. CL-Achtelfinale,
             kompakt). Normaler Button statt ToggleButton (#284), Hervorhebung rein über Background. -->
        <DataTemplate x:Key="RegelZeileTemplate">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,4"
                    Background="{Binding IstAusgewaehlt, Converter={StaticResource BoolZuAuswahlHintergrund}}"
                    Command="{Binding DataContext.UebergangsregelEditor.RegelAuswaehlenCommand, ElementName=Root}"
                    CommandParameter="{Binding}">
                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding QuellRunde.Name}" FontWeight="SemiBold" /><Run Text=" → " /><Run Text="{Binding ZielRunde.Name}" FontWeight="SemiBold" />
                    <Run Text="· " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Zeilen.Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text=" Einträge" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

        <!-- Sperre, solange kein (gespeichertes) Turnier gewählt ist -->
        <StackPanel Visibility="{Binding HatInstanz, Converter={StaticResource InverseBoolToVisibility}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="Bitte zuerst ein Turnier im Turnierkopf speichern" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding HatInstanz, Converter={StaticResource BoolToVisibility}}"
              RowDefinitions="Auto,*">

            <Border Grid.Row="0" Padding="12,8"
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding RundenBearbeitbar, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Nur für Turniere mit Status &quot;Geplant&quot; oder &quot;Vorlage&quot; bearbeitbar."
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" />
            </Border>

        <ContentControl Grid.Row="1" IsEnabled="{Binding RundenBearbeitbar}" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid ColumnDefinitions="260,1,3*,1,1.4*">

            <!-- ── Spalte 0: Rundenliste (inkl. Unstimmigkeits-Hinweis, #348 aus dem früheren Übergänge-Reiter) ── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="2"
                             Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Runden}"
                          SelectedItem="{Binding AusgewaehlteRunde, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock FontSize="11" Opacity="0.6">
                                    <Run Text="{Binding Rundenart, Converter={StaticResource RundenartZuText}}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding EingangsMannschaftsanzahl}" />
                                    <Run Text="→" />
                                    <Run Text="{Binding AusgangsMannschaftsanzahl}" />
                                </TextBlock>
                                <TextBlock Text="{Binding UnstimmigkeitText}" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HatUnstimmigkeit, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- ── Spalte 2: Rundenformular (oben) + Übergangsregeln der Runde (unten, #348) ── -->
            <Grid Grid.Column="2">
                <StackPanel Visibility="{Binding FormularSichtbar, Converter={StaticResource InverseBoolToVisibility}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Runde auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Visibility="{Binding FormularSichtbar, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch">

                        <TextBlock Text="RUNDENDETAILS" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                        <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Rundenart" FontSize="12" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding RundenartOptionen}"
                                          SelectedItem="{Binding RundenartAuswahl, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource RundenartZuText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch"
                                        Visibility="{Binding IstGruppenphase, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Gruppenanzahl" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding GruppenAnzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntZuText}}"
                                         HorizontalAlignment="Stretch" />
                                <ItemsRepeater ItemsSource="{Binding GruppenAnzahlVorschlaege}" Margin="0,4,0,0"
                                               Visibility="{Binding HatGruppenAnzahlVorschlaege, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" MinRowSpacing="4" MinColumnSpacing="4"
                                                            ItemsJustification="Start" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Anzeige}"
                                                    Command="{Binding ElementName=Root, Path=DataContext.GruppenAnzahlVorschlagWaehlenCommand}"
                                                    CommandParameter="{Binding}" FontSize="11" Padding="8,3" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch"
                                        Visibility="{Binding IstSchweizerSystem, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Anzahl Spieltage" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding AnzahlSpieltage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableIntZuText}}"
                                         HorizontalAlignment="Stretch" />
                                <TextBlock FontSize="11" Opacity="0.6" Margin="0,3,0,0">
                                    <Run Text="Vorschlag: " /><Run Text="{Binding AnzahlSpieltageVorschlag}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Eingang (Mannschaften)" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding EingangsMannschaftsanzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="Ausgang (Mannschaften)" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding AusgangsMannschaftsanzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Regelwerk" FontSize="12" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding RegelwerkOptionen}"
                                          SelectedItem="{Binding Regelwerk, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="Auslosungsart (Vorgabe)" FontSize="12" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding VorgegebeneAuslosungsartOptionen}"
                                          SelectedItem="{Binding VorgegebeneAuslosungsart, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Wird beim Anlegen der Auslosung vorausgewählt und bleibt dort änderbar."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Issue #356: nur Regeln, die bei Rundenart und Auslosungsart dieser Runde wirken können -->
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding HatRegelVorgabeOptionen, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Auslosungsregeln (Vorgabe)" FontSize="12" Margin="0,0,0,3" />
                            <ItemsControl ItemsSource="{Binding RegelVorgabeOptionen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Anzeige}" IsChecked="{Binding IstAktiv, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="{Binding Beschreibung}"
                                                  Visibility="{Binding IstVerfuegbar, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Sind beim Anlegen der Auslosung bereits aktiv und bleiben dort abwählbar."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Standard-Rangliste (Lostöpfe)" FontSize="12" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding RanglistenQuelleOptionen}"
                                          SelectedItem="{Binding StandardRanglistenQuelle, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Beim Anlegen der Auslosung werden die Lostöpfe nach der neuesten importierten Rangliste dieser Quelle befüllt."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <CheckBox Content="Titelverteidiger in Topf 1" IsChecked="{Binding TitelverteidigerInTopf1, Mode=TwoWay}"
                                          IsEnabled="{Binding TitelverteidigerInTopf1Aktivierbar}" Margin="0,0,0,4" />
                                <TextBlock Text="Unabhängig vom Ranglistenplatz (Titelverteidiger im Turnierkopf hinterlegen)."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="28,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8" ColumnDefinitions="*,16,*">
                            <StackPanel>
                                <CheckBox Content="Mit Rückspiel" IsChecked="{Binding MitRueckspiel, Mode=TwoWay}" Margin="0,0,0,4" />
                                <CheckBox Content="Auswärtstorregel aktiv" IsChecked="{Binding AuswaertstorRegelAktiv, Mode=TwoWay}"
                                          IsEnabled="{Binding AuswaertstorAktivierbar}" Margin="16,0,0,4" />
                                <!-- Issue #352 -->
                                <CheckBox Content="Neutraler Spielort" IsChecked="{Binding NeutralerSpielort, Mode=TwoWay}" Margin="0,8,0,4" />
                                <TextBlock Text="Kein Heimvorteil in der Simulation, außer für Gastgeber des Turniers (im Turnierkopf hinterlegen)."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="28,0,0,0" />
                                <!-- Issue #360 -->
                                <Grid Margin="0,12,0,0" ColumnDefinitions="*,48">
                                    <Slider Header="Überraschungsfaktor" Value="{Binding Ueberraschungsfaktor, Mode=TwoWay}"
                                            Minimum="0" Maximum="100" StepFrequency="5" TickFrequency="10" TickPlacement="Outside" />
                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                        <Run Text="{Binding Ueberraschungsfaktor}" /><Run Text=" %" />
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Dämpft in der Simulation den Einfluss der Stärkeunterschiede – „Pokal hat eigene Gesetze“. 0 % = normal, 100 % = Stärke egal."
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <CheckBox Content="Paarung fest vorgegeben" IsChecked="{Binding PaarungFestVorgegeben, Mode=TwoWay}"
                                          IsEnabled="{Binding PaarungFestVorgegebenVerfuegbar}" Margin="0,0,0,4" />
                                <TextBlock Text="Erst verfügbar, sobald die Runde eine eingehende Übergangsregel hat (siehe unten)."
                                           Visibility="{Binding PaarungFestVorgegebenVerfuegbar, Converter={StaticResource InverseBoolToVisibility}}"
                                           FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="28,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- ── Übergangsregeln der gewählten Runde (#348): links Eingehend/Ausgehend, rechts EIN
                             stabiles Regelformular (Populier-/Zurückschreib-Muster, keine editierbaren Karten —
                             siehe #284-Datenkorruption). ── -->
                        <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,12,0,16" />

                        <Grid DataContext="{Binding UebergangsregelEditor}" ColumnDefinitions="*,16,1.5*">

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="EINGEHENDE REGELN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Neu" FontSize="11" Command="{Binding NeueEingehendeRegelCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding EingehendeRegeln}" ItemTemplate="{StaticResource RegelZeileTemplate}" />

                                <Grid Margin="0,16,0,8" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="AUSGEHENDE REGELN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Neu" FontSize="11" Command="{Binding NeueAusgehendeRegelCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AusgehendeRegeln}" ItemTemplate="{StaticResource RegelZeileTemplate}" />
                            </StackPanel>

                            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="12" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock Text="Regel links auswählen oder &quot;+ Neu&quot; klicken" FontSize="12" Opacity="0.5"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,8"
                                               Visibility="{Binding ZeigeRegelformular, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <StackPanel Visibility="{Binding ZeigeRegelformular, Converter={StaticResource BoolToVisibility}}">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                            <TextBlock Text="ÜBERGANGSREGEL" FontWeight="SemiBold" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="Schließen" FontSize="11" Command="{Binding RegelFormularSchliessenCommand}" />
                                        </Grid>

                                        <TextBlock Text="Von (Quelle)" FontSize="12" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Runden}"
                                                  SelectedItem="{Binding RegelQuelle, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                                        <TextBlock Text="Nach (Ziel)" FontSize="12" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding Runden}"
                                                  SelectedItem="{Binding RegelZiel, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                                        <ItemsControl ItemsSource="{Binding NormaleZeilen}" ItemTemplate="{StaticResource ZeileGruppenphaseTemplate}"
                                                      Visibility="{Binding RegelIstGruppenphase, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding NormaleZeilen}" ItemTemplate="{StaticResource ZeileKoSonderfallTemplate}"
                                                      Visibility="{Binding RegelIstKoSonderfall, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding NormaleZeilen}" ItemTemplate="{StaticResource ZeileLigaTemplate}"
                                                      Visibility="{Binding RegelIstLiga, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding RegelIstGruppenphase, Converter={StaticResource BoolToVisibility}}">
                                            <Rectangle Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" Margin="0,0,0,8" />
                                            <TextBlock Text="GRUPPENÜBERGREIFEND" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding GruppenuebergreifendeZeilen}" ItemTemplate="{StaticResource ZeileGruppenuebergreifendTemplate}" />
                                            <Button Content="+ Gruppenübergreifende Regel" FontSize="11" Padding="8,4" Margin="0,6,0,0"
                                                    HorizontalAlignment="Left" Command="{Binding NeueGruppenuebergreifendeZeileCommand}" />
                                        </StackPanel>

                                        <Button Content="Regel löschen" Command="{Binding RegelLoeschenCommand}" Margin="0,16,0,0"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- ── Spalte 4: Meldungsspalte ── -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,20,12,12" Spacing="6">
                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="8,6">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding RundenFehler}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                        CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </ContentControl>
        </Grid>
    </Grid>
</UserControl>
