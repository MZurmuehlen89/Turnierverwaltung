<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielZeitstrahlControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- Issue #341 Teil B: kompakter horizontaler Zeitstrahl (Vorbild kicker.de "kick__game-timeline").
         Segmente und Elfmeter-Punktreihe deklarativ mit ThemeResource (folgen dem Dark Mode ohne Neuzeichnen),
         nur die Ereignis-Marker werden im Code-Behind auf den Canvas gesetzt — Canvas.Left per Binding ist
         in WinUI3 nicht zuverlässig (siehe TurnierBaumView). -->

    <UserControl.Resources>
        <DataTemplate x:Key="ElfmeterPunktVorlage" x:DataType="views:ElfmeterPunkt">
            <Grid Width="8" Height="8" Margin="1,0">
                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}"
                         Visibility="{x:Bind Treffer}" />
                <Ellipse Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="1.5"
                         Visibility="{x:Bind Fehlschuss}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Team-Kürzel auf Höhe der jeweiligen Marker-Reihe (Vorbild kicker.de) -->
        <Grid x:Name="KuerzelSpalte" Grid.Column="0" Height="42" Margin="0,0,8,0">
            <TextBlock x:Name="HeimKuerzelText" VerticalAlignment="Top" Height="16" LineHeight="16"
                       FontSize="10" FontWeight="Bold" Opacity="0.6" />
            <TextBlock x:Name="AuswaertsKuerzelText" VerticalAlignment="Bottom" Height="16" LineHeight="16"
                       FontSize="10" FontWeight="Bold" Opacity="0.6" />
        </Grid>

        <!-- Heim-Marker oben, Balken in der Mitte, Auswärts-Marker unten -->
        <Grid x:Name="Zeichenflaeche" Grid.Column="1" Height="42" SizeChanged="Zeichenflaeche_SizeChanged">
            <Grid x:Name="SegmentLeiste" Height="6" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" RadiusX="3" RadiusY="3" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Rectangle Grid.Column="2" RadiusX="3" RadiusY="3" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Rectangle Grid.Column="4" RadiusX="3" RadiusY="3" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" Opacity="0.6" />
                <Rectangle Grid.Column="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" Opacity="0.6" />
            </Grid>
            <Canvas x:Name="MarkerFlaeche" />
        </Grid>

        <!-- Elfmeterschießen als Punktreihe hinter dem Balken: gefüllt = verwandelt, Ring = verschossen -->
        <Grid x:Name="ElfmeterBereich" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
              ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="18" ColumnSpacing="6"
              Visibility="Collapsed">
            <TextBlock Grid.RowSpan="2" Text="i.E." FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
            <ItemsControl x:Name="HeimElfmeter" Grid.Column="1" Grid.Row="0"
                          ItemTemplate="{StaticResource ElfmeterPunktVorlage}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl x:Name="AuswaertsElfmeter" Grid.Column="1" Grid.Row="1"
                          ItemTemplate="{StaticResource ElfmeterPunktVorlage}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
