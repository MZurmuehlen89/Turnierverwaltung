<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.PaarungsSpaltenControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">

    <StackPanel>
        <!-- Spalten werden im Code-Behind aufgebaut (Anzahl hängt von Paarungszahl und Breite ab) -->
        <Grid x:Name="SpaltenGrid" HorizontalAlignment="Left" />

        <!-- Blättern, nur wenn nicht alle Spalten nebeneinander passen -->
        <StackPanel x:Name="BlaetterLeiste" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                    Visibility="Collapsed">
            <Button x:Name="ZurueckButton" Padding="8,4" Click="ZurueckButton_Click"
                    ToolTipService.ToolTip="Vorherige Paarungen">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76B;" FontSize="12" />
            </Button>
            <TextBlock x:Name="SeitenText" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            <Button x:Name="WeiterButton" Padding="8,4" Click="WeiterButton_Click"
                    ToolTipService.ToolTip="Nächste Paarungen">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76C;" FontSize="12" />
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
