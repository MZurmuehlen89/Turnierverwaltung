<?xml version="1.0" encoding="utf-8" ?>
<!-- Kopfzeile der Tabellen (#607) über Ligatabelle, Gruppenkarten und Rangfolge der Gruppenbesten. Platz und Team
     bleiben ohne Überschrift (Nutzerentscheid). Der linke Einzug von 7 px entspricht dem Zonenbalken der Zeilen
     (4 px breit, 3 px Abstand). -->
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TabellenKopfZeile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <UserControl.Resources>
        <Style x:Key="KopfText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid views:TabellenSpalten.Anwenden="True" Padding="7,6,4,4"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <TextBlock Grid.Column="2" Text="Sp." ToolTipService.ToolTip="Spiele" Style="{StaticResource KopfText}" />
        <TextBlock Grid.Column="3" Text="Tore" ToolTipService.ToolTip="Tore : Gegentore" Style="{StaticResource KopfText}" />
        <TextBlock Grid.Column="4" Text="Diff." ToolTipService.ToolTip="Tordifferenz" Style="{StaticResource KopfText}" />
        <TextBlock Grid.Column="5" Text="Pkt." ToolTipService.ToolTip="Punkte" Style="{StaticResource KopfText}" />
        <TextBlock Grid.Column="6" Text="BH" ToolTipService.ToolTip="Buchholz: Summe der Punkte aller bisherigen Gegner"
                   Style="{StaticResource KopfText}" Visibility="{x:Bind ZeigtBuchholz, Mode=OneWay}" />
    </Grid>
</UserControl>
