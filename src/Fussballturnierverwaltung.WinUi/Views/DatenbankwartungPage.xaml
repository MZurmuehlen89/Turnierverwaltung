<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.DatenbankwartungPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- Issue #370: Migrationsstand + "Prüfen / ergänzen" (Ribbon). Ergebnis als Protokoll, kein Dialog.
         #49: Karte „Verbindung“, Speichern/Abbrechen in der Ribbon-Gruppe „Verbindung“.
         #43: Karte „Sicherungen“, Befehle in der Ribbon-Gruppe „Sicherung“. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="680" Margin="32,28" HorizontalAlignment="Left">

            <!-- Seitentitel -->
            <TextBlock Text="Datenbankwartung" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock FontSize="13" Opacity="0.7" Margin="0,0,0,28" TextWrapping="Wrap"
                       Text="Datenbank auf den aktuellen Stand bringen und fehlende Stammdaten ergänzen. Vorhandene Datensätze werden dabei weder geändert noch gelöscht." />

            <!-- Lade-Indikator -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Prüfe und ergänze…" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />
            </Border>

            <!-- Fehlermeldung -->
            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12,8" Margin="0,0,0,16"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock AutomationProperties.AutomationId="Datenbankwartung.Fehlermeldung"
                           Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>

            <!-- ── Karte: Verbindung (#49) ── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="VERBINDUNG" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,12" />
                    <views:VerbindungsFelder DataContext="{Binding Verbindung}" />
                </StackPanel>
            </Border>

            <!-- ── Karte: Status ── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,12" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="PostgreSQL" FontSize="13" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="Datenbankwartung.Version"
                                   Text="{Binding PostgreSqlVersion}" FontSize="13" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Migrationen" FontSize="13" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="Datenbankwartung.Migrationen"
                                   Text="{Binding MigrationsStand}" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Karte: Sicherungen (#43) ── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel DataContext="{Binding Sicherung}">
                    <TextBlock Text="SICHERUNGEN" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                    <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Gesichert wird nur auf Knopfdruck. Wiederherstellen ersetzt den ganzen aktuellen Stand durch die gewählte Sicherung, danach startet das Programm neu. Eine Sicherung von woanders zum Wiederherstellen in diesen Ordner legen." />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="Ordner" FontSize="13" Opacity="0.7" />
                        <TextBlock Grid.Column="1" AutomationProperties.AutomationId="Sicherung.Ordner"
                                   Text="{Binding Ordner}" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Taetigkeit, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Taetigkeit}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontSize="13" />
                    </Border>

                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock AutomationProperties.AutomationId="Sicherung.Fehlermeldung"
                                   Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Border>

                    <TextBlock AutomationProperties.AutomationId="Sicherung.KeineSicherung"
                               Text="Noch keine Sicherung in diesem Ordner." FontSize="13" Opacity="0.7"
                               Visibility="{Binding KeineSicherung, Converter={StaticResource BoolToVisibility}}" />
                    <ListView AutomationProperties.AutomationId="Sicherung.Liste"
                              ItemsSource="{Binding Sicherungen}" SelectionMode="Single" MaxHeight="280"
                              SelectedItem="{Binding AusgewaehlteSicherung, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Padding="0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Zeitpunkt}" FontSize="13" Opacity="0.7" />
                                    <TextBlock Grid.Column="2" Text="{Binding Groesse}" FontSize="13" Opacity="0.7"
                                               MinWidth="64" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- ── Karte: Ablaufprotokoll (#413) ── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="ABLAUFPROTOKOLL" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                    <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Schreibt Bedienschritte, Wechsel und Ladevorgänge mit ihrer Dauer ins Log. Hilft, sporadische Fehler nachträglich ihrem Auslöser zuzuordnen. Warnungen und Fehler werden immer protokolliert." />
                    <ToggleSwitch IsOn="{Binding AblaufprotokollAktiv, Mode=TwoWay}"
                                  OnContent="Läuft mit" OffContent="Aus" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="Log-Ordner" FontSize="13" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{Binding LogOrdner}" FontSize="13"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Karte: Protokoll der letzten Prüfung ── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="20,16" Margin="0,0,0,16"
                    Visibility="{Binding LetztePruefung, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="PROTOKOLL" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,4" />
                    <TextBlock AutomationProperties.AutomationId="Datenbankwartung.LetztePruefung"
                               Text="{Binding LetztePruefung}" FontSize="12" Opacity="0.7" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ProtokollZeilen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock AutomationProperties.AutomationId="Datenbankwartung.ProtokollZeile"
                                           Text="{Binding}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
