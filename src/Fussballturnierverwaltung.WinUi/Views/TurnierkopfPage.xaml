<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurnierkopfPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Fussballturnierverwaltung.WinUi.Converters">

    <UserControl.Resources>
        <conv:TurnierKategorieZuTextConverter x:Key="TurnierKategorieZuText" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="3*,1*">

        <StackPanel Grid.ColumnSpan="2"
                    Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
            <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="Turnier auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Column="0"
                      Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch">

                <!-- ── Basisdaten ──────────────────────────────────────────────── -->
                <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12" ColumnDefinitions="64,12,Auto,20,*,16,*">
                    <Grid Width="64" Height="64" VerticalAlignment="Center">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                        <Image Source="{Binding LogoDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                               Visibility="{Binding LogoDaten, Converter={StaticResource NullToCollapsed}}"
                               Stretch="Uniform" Margin="4" />
                        <TextBlock Text="🏆" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.35"
                                   Visibility="{Binding LogoDaten, Converter={StaticResource NullToVisible}}" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                        <Button Content="Logo wählen…" Command="{Binding LogoWaehlenCommand}" HorizontalAlignment="Stretch" />
                        <Button Content="Entfernen" Command="{Binding LogoEntfernenCommand}"
                                IsEnabled="{Binding LogoDaten, Converter={StaticResource IstNichtNull}}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="Turnierkopf.Name"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <!-- Issue #367: kurze Formatangabe, unterscheidet gleichnamige Vorlagen in der Turnierliste -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                        <TextBlock Text="Variante" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Variante, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="Turnierkopf.Variante"
                                 PlaceholderText="z. B. 32 Teams · 1998–2022" MaxLength="100"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Beschreibung" FontSize="12" Margin="0,0,0,3" />
                <TextBox Text="{Binding Beschreibung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch" Margin="0,0,0,24"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                <!-- ── Turniereinstellungen ────────────────────────────────────── -->
                <TextBlock Text="TURNIEREINSTELLUNGEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*,16,*">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Kategorie" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding KategorieOptionen}"
                                  SelectedItem="{Binding Kategorie, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TurnierKategorieZuText}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                        <TextBlock Text="Mannschaftsanzahl" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding ZielMannschaftsanzahl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="Turnierkopf.Mannschaftsanzahl"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Status" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Status.Optionen}"
                                  SelectedItem="{Binding Status.Auswahl, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,*,16,*">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Saison/Jahr" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SaisonOderJahr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="Turnierkopf.Saison"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                        <TextBlock Text="Startjahr" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Startdatum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Endjahr" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Enddatum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Regelwerk-Standard" FontSize="12" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{Binding StandardRegelwerkOptionen}" AutomationProperties.AutomationId="Turnierkopf.StandardRegelwerk"
                          SelectedItem="{Binding StandardRegelwerk, Mode=TwoWay}"
                          DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" Margin="0,0,0,24"
                          ToolTipService.ToolTip="Wird automatisch für neue Runden im Runden-Editor vorbelegt." />

                <!-- ── Teilnehmer & Auslosung ──────────────────────────────────── -->
                <TextBlock Text="TEILNEHMER &amp; AUSLOSUNG" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,16" ColumnDefinitions="*,16,*,16,*">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="Verband" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Filter.VerbandOptionenGefiltert}"
                                  SelectedItem="{Binding Filter.VerbandFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                        <TextBlock Text="Land" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Filter.LandOptionenGefiltert}"
                                  SelectedItem="{Binding Filter.LandFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Stretch">
                        <TextBlock Text="Mannschaftsart" FontSize="12" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Filter.TeamfilterOptionen}"
                                  SelectedItem="{Binding Filter.TeamFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                          IsExpanded="{Binding TitelGastgeber.Offen, Mode=TwoWay}"
                          Header="{Binding TitelGastgeber.Kopf}" HeaderTemplate="{StaticResource AbschnittKopfVorlage}">
                    <Grid ColumnDefinitions="*,24,*">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="Titelverteidiger" FontSize="12" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding TitelGastgeber.TitelverteidigerOptionenGefiltert}"
                                      SelectedItem="{Binding TitelGastgeber.Titelverteidiger, Mode=TwoWay}"
                                      DisplayMemberPath="Anzeige" IsTextSearchEnabled="True"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                            <TextBlock Text="Optional, vorgefiltert nach dem Auslosungsfilter. Kommt bei Runden mit „Titelverteidiger in Topf 1“ unabhängig vom Ranglistenplatz in Topf 1."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Issue #352 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                            <TextBlock Text="Gastgeber" FontSize="12" Margin="0,0,0,3" />
                            <ItemsRepeater ItemsSource="{Binding TitelGastgeber.GastgeberZeilen}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding ElementName=Root, Path=DataContext.TitelGastgeber.GastgeberKandidaten}"
                                                      SelectedItem="{Binding Mannschaft, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" IsTextSearchEnabled="True"
                                                      HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="✕"
                                                    Command="{Binding ElementName=Root, Path=DataContext.TitelGastgeber.GastgeberEntfernenCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <Button Content="Gastgeber hinzufügen" Command="{Binding TitelGastgeber.GastgeberHinzufuegenCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <TextBlock Text="Optional. Gastgeber behalten in Runden mit neutralem Spielort ihren Heimvorteil (z. B. Ausrichter einer WM/EM oder der Verein, in dessen Stadion das Finale stattfindet)."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander>

                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{Binding Quoten.Sichtbar, Converter={StaticResource BoolToVisibility}}"
                          IsExpanded="{Binding Quoten.Offen, Mode=TwoWay}"
                          Header="{Binding Quoten.Kopf}" HeaderTemplate="{StaticResource AbschnittKopfVorlage}">
                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.ColumnSpan="3"
                                   Visibility="{Binding Quoten.KapazitaetsHinweisSichtbar, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="Die Summe der Quoten darf die Eingangskapazität der ersten Runde (" />
                            <Run Text="{Binding Quoten.ErsteRundeEingang}" />
                            <Run Text=") nicht übersteigen." />
                        </TextBlock>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Stretch"
                                    Visibility="{Binding Quoten.VerbandsQuotenSichtbar, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Verband-Quoten" FontSize="12" Margin="0,0,0,3" />
                            <!-- ItemsControl statt ItemsRepeater (#446): leert und befüllt „Abbrechen“ die Liste in
                                 einem Zug, ändert der ItemsRepeater seine Höhe erst nachträglich und die Spalte misst
                                 nicht neu — die letzte Zeile war abgeschnitten oder es blieb eine Leerzeile. -->
                            <ItemsControl ItemsSource="{Binding Quoten.VerbandsQuotenZeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,90,Auto" Margin="0,0,0,6">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding ElementName=Root, Path=DataContext.Quoten.AlleVerbaende}"
                                                      SelectedItem="{Binding Verband, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                            <NumberBox Grid.Column="1" Value="{Binding Anzahl, Mode=TwoWay}"
                                                       Minimum="1" SpinButtonPlacementMode="Inline" Margin="8,0,8,0" />
                                            <Button Grid.Column="2" Content="✕"
                                                    Command="{Binding ElementName=Root, Path=DataContext.Quoten.VerbandsQuoteEntfernenCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Verband hinzufügen" Command="{Binding Quoten.VerbandsQuoteHinzufuegenCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Ohne Verband-Quoten rückt die Landes-Quote in die linke Spalte. -->
                        <StackPanel Grid.Row="1" Grid.Column="{Binding Quoten.LandesQuotenSpalte}" HorizontalAlignment="Stretch"
                                    Visibility="{Binding Quoten.LandesQuotenSichtbar, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Landes-Quoten" FontSize="12" Margin="0,0,0,3" />
                            <ItemsControl ItemsSource="{Binding Quoten.LandesQuotenZeilen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,90,Auto" Margin="0,0,0,6">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding ElementName=Root, Path=DataContext.Quoten.AlleLaender}"
                                                      SelectedItem="{Binding Land, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                            <NumberBox Grid.Column="1" Value="{Binding Anzahl, Mode=TwoWay}"
                                                       Minimum="1" SpinButtonPlacementMode="Inline" Margin="8,0,8,0" />
                                            <Button Grid.Column="2" Content="✕"
                                                    Command="{Binding ElementName=Root, Path=DataContext.Quoten.LandesQuoteEntfernenCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Land hinzufügen" Command="{Binding Quoten.LandesQuoteHinzufuegenCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Meldungsspalte: Speicher-/Statusfehler und Formularfehler (Live-Vorschau, Issue #234). Die
             Speicher-Fehlermeldung stand früher am Formularende und lag bei langen Formularen außer Sicht (#367). -->
        <ScrollViewer Grid.Column="1"
                      Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,20,12,12">
                <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Fehlermeldung}" AutomationProperties.AutomationId="Turnierkopf.Fehlermeldung"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding FormularFehler}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                <TextBlock Text="{Binding}" AutomationProperties.AutomationId="Turnierkopf.Fehler" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="11" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
