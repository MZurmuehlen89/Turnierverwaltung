<?xml version="1.0" encoding="utf-8" ?>
<!-- Reiter „Teilnehmerpool“ der Auslosung (#576): links die Quotenliste, rechts Filter und die beiden Listen, die bis zum
     Fensterende wachsen (#593); was dem Pool fehlt, meldet die Seite für beide Reiter. DataContext ist das
     TeilnehmerpoolViewModel. -->
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TeilnehmerpoolAnsicht"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fussballturnierverwaltung.WinUi.Views">

    <UserControl.Resources>
        <!-- Gruppen der Pool-Liste; die Quelle setzt das Code-Behind, weil Ressourcen keinen DataContext erben -->
        <CollectionViewSource x:Key="PoolGruppenQuelle" IsSourceGrouped="True" />

        <!-- Zeile einer Quote (#593, vorher Kachel): rot, solange sie verletzt ist, der Tooltip nennt, was fehlt; anklickbar
             filtert sie beide Listen auf ihr Land bzw. ihren Verband, die aktive trägt einen Akzentrahmen. Freie Plätze
             und Gesamt sind nicht anklickbar. Der Tooltip hängt am Grid, damit er auch über ihnen erscheint. -->
        <DataTemplate x:Key="QuoteZeileTemplate">
            <Grid Margin="0,0,0,2" Background="Transparent" ToolTipService.ToolTip="{Binding Hinweis}">
                <Border CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        Visibility="{Binding Verletzt, Converter={StaticResource BoolToVisibility}}" />
                <Border CornerRadius="4" BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{Binding IstAktiv, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding Umschalten}" AutomationProperties.AutomationId="Auslosung.Quote"
                        AutomationProperties.Name="{Binding Name}"
                        AutomationProperties.HelpText="{Binding Hinweis}"
                        IsHitTestVisible="{Binding IstKlickbar}"
                        Background="Transparent" BorderThickness="0" Padding="8,4"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding AnzeigeText}" FontSize="12" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="Teilnehmerpool.KachelWert" />
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Zeile beider Listen: Ranglistenplatz, Wappen, Name, rechts das Land bzw. der Topf -->
        <DataTemplate x:Key="PoolZeileTemplate">
            <Grid ColumnDefinitions="30,8,20,8,*,Auto" Height="26" Padding="0,3">
                <TextBlock Grid.Column="0" Text="{Binding Rang}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Image Grid.Column="2" Source="{Binding Teilnehmer.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding Teilnehmer.Wappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Teilnehmer.AnzeigeName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="Teilnehmerpool.TeilnehmerName" />
                <TextBlock Grid.Column="5" Text="{Binding Zusatz}" FontSize="11" Margin="8,0,4,0" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Drei Spalten (#593): Quoten | Weitere verfügbar | Teilnehmerpool; Tausch per Doppelklick, Ziehen oder Rechtsklick —
         wie bei den Lostöpfen -->
    <Grid ColumnDefinitions="220,16,*,16,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,0,0,16">
        <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" ColumnDefinitions="2*,*,*" ColumnSpacing="8" Margin="0,0,0,4">
            <TextBox Grid.Column="0" PlaceholderText="🔍  Filtern …"
                     Text="{Binding Filter.TeilnehmerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Filter.VerbandFilterOptionen}"
                      SelectedItem="{Binding Filter.VerbandFilter, Mode=TwoWay}"
                      DisplayMemberPath="Anzeige"
                      Visibility="{Binding Filter.ZeigeVerbandFilter, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Teilnehmerpool.LandFilter"
                      ItemsSource="{Binding Filter.LandFilterOptionen}"
                      SelectedItem="{Binding Filter.LandFilter, Mode=TwoWay}"
                      DisplayMemberPath="Anzeige"
                      Visibility="{Binding Filter.ZeigeLandFilter, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="QUOTEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="WEITERE VERFÜGBAR" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
        <TextBlock Grid.Row="1" Grid.Column="4" FontWeight="SemiBold" FontSize="11" Opacity="0.6">
            <Run Text="TEILNEHMERPOOL" /><Run Text="  ·  " /><Run Text="{Binding PoolAnzahl}" />
        </TextBlock>

        <ScrollViewer Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Auto" local:HoeheBisFensterende.MindestHoehe="300">
            <ItemsControl ItemsSource="{Binding Quoten.Eintraege}" ItemTemplate="{StaticResource QuoteZeileTemplate}" />
        </ScrollViewer>
        <ListView Grid.Row="2" Grid.Column="2" x:Name="WeitereListView" AutomationProperties.AutomationId="Teilnehmerpool.Weitere"
                  ItemsSource="{Binding WeitereVerfuegbar}" ItemTemplate="{StaticResource PoolZeileTemplate}"
                  SelectionMode="Extended" CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                  DragItemsStarting="Liste_DragItemsStarting" DragOver="Liste_DragOver" Drop="WeitereListView_Drop"
                  DoubleTapped="Liste_DoubleTapped" RightTapped="Liste_RightTapped"
                  local:HoeheBisFensterende.MindestHoehe="300"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" />
        <ListView Grid.Row="2" Grid.Column="4" x:Name="PoolListView" AutomationProperties.AutomationId="Teilnehmerpool.Pool"
                  ItemTemplate="{StaticResource PoolZeileTemplate}"
                  SelectionMode="Extended" CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                  DragItemsStarting="Liste_DragItemsStarting" DragOver="Liste_DragOver" Drop="PoolListView_Drop"
                  DoubleTapped="Liste_DoubleTapped" RightTapped="Liste_RightTapped"
                  local:HoeheBisFensterende.MindestHoehe="300"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Kopf}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
    </Grid>
</UserControl>
