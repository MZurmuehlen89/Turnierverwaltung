<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurnierVorlagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels"
    xmlns:turniere="using:Fussballturnierverwaltung.Domain.Entitaeten.Turniere"
    x:Name="RootPage">

    <Grid ColumnDefinitions="260,1,*">

        <!-- Master-Liste -->
        <ListView Grid.Column="0" Margin="8"
                  ItemsSource="{x:Bind ViewModel.Vorlagen, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.Ausgewaehltes, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="turniere:TurnierVorlage">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- Formular -->
        <ScrollViewer Grid.Column="2" Margin="8" Visibility="{x:Bind ViewModel.FormularAktiv, Mode=OneWay}">
            <StackPanel Spacing="8">

                <TextBlock Text="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay}" Foreground="Red" />

                <TextBlock Text="Name" />
                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />

                <TextBlock Text="Beschreibung" />
                <TextBox Text="{x:Bind ViewModel.Beschreibung, Mode=TwoWay}" />

                <TextBlock Text="Erforderliche Mannschaftsanzahl" />
                <TextBox Text="{x:Bind ViewModel.AnzahlMannschaften, Mode=TwoWay}" Width="100" HorizontalAlignment="Left" />

                <!-- Runden: ListView-Pendant statt DataGrid (WinUI 3 hat kein gepflegtes DataGrid mehr,
                     siehe #278-Recherche) — jede Zeile ist ein horizontales Grid mit denselben Feldern wie
                     das WPF-RundenGrid, direkt inline editierbar über normale Controls statt Grid-Zellen. -->
                <TextBlock Text="Runden" FontWeight="Bold" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Runde hinzufügen" Command="{x:Bind ViewModel.RundeHinzufuegenCommand, Mode=OneWay}" />
                    <Button Content="Runde entfernen" Command="{x:Bind ViewModel.RundeEntfernenCommand, Mode=OneWay}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,150,64,64,52,80,*" ColumnSpacing="6" Padding="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Name" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Rundenart" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Eingang" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Ausgang" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="H+R" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="AuswTor" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="6" Text="Regelwerk" FontWeight="SemiBold" />
                </Grid>
                <ListView ItemsSource="{x:Bind ViewModel.RundenZeilen, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.AusgewaehlteRunde, Mode=TwoWay}"
                          MaxHeight="260" SelectionMode="Single">
                    <!-- Test auf Performance-Fund (2026-09-02): Standard-Einblende-Animationen pro
                         Container deaktiviert, um zu prüfen ob sie den trägen Ersteindruck verursachen. -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VorlagenRundeZeile">
                            <Grid ColumnDefinitions="*,150,64,64,52,80,*" ColumnSpacing="6" Padding="0,4">
                                <TextBox Grid.Column="0" Text="{x:Bind Name, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind RundenartOptionen}"
                                          SelectedItem="{x:Bind Rundenart, Mode=TwoWay}" />
                                <TextBox Grid.Column="2" Text="{x:Bind EingangsMannschaftsanzahl, Mode=TwoWay}" />
                                <TextBox Grid.Column="3" Text="{x:Bind AusgangsMannschaftsanzahl, Mode=TwoWay}" />
                                <CheckBox Grid.Column="4" IsChecked="{x:Bind MitRueckspiel, Mode=TwoWay}" />
                                <CheckBox Grid.Column="5" IsChecked="{x:Bind AuswaertstorRegelAktiv, Mode=TwoWay}" />
                                <ComboBox Grid.Column="6" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind RegelwerkOptionen}"
                                          DisplayMemberPath="Anzeige"
                                          SelectedItem="{x:Bind Regelwerk, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Übergangsregeln: analoges ListView-Pendant -->
                <TextBlock Text="Übergangsregeln" FontWeight="Bold" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Übergangsregel hinzufügen" Command="{x:Bind ViewModel.UebergangsregelHinzufuegenCommand, Mode=OneWay}" />
                    <Button Content="Übergangsregel entfernen" Command="{x:Bind ViewModel.UebergangsregelEntfernenCommand, Mode=OneWay}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*,64,72,72" ColumnSpacing="6" Padding="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Quelle" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Ziel" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Gruppe" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Platz von" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Platz bis" FontWeight="SemiBold" />
                </Grid>
                <ListView ItemsSource="{x:Bind ViewModel.UebergangsregelZeilen, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.AusgewaehlteUebergangsregel, Mode=TwoWay}"
                          MaxHeight="220" SelectionMode="Single">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VorlagenUebergangsRegelZeile">
                            <Grid ColumnDefinitions="*,*,64,72,72" ColumnSpacing="6" Padding="0,4">
                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind VerfuegbareRunden}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{x:Bind Quelle, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind VerfuegbareRunden}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{x:Bind Ziel, Mode=TwoWay}" />
                                <TextBox Grid.Column="2" Text="{x:Bind GruppeIndex, Mode=TwoWay}" />
                                <TextBox Grid.Column="3" Text="{x:Bind PlatzierungVon, Mode=TwoWay}" />
                                <TextBox Grid.Column="4" Text="{x:Bind PlatzierungBis, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
