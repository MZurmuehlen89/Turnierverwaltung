<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.StatistikView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:stat="using:Fussballturnierverwaltung.Application.Statistiken"
    xmlns:tabelle="using:Fussballturnierverwaltung.Application.Tabelle"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels">

    <UserControl.Resources>

        <ItemsPanelTemplate x:Key="ZellenReihe">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <Style x:Key="KartenRahmen" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MaxWidth" Value="820" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="KartenTitel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,10,12,6" />
        </Style>

        <Style x:Key="KartenHinweis" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="12,6,12,10" />
        </Style>

        <DataTemplate x:Key="SpaltenkopfTemplate" x:DataType="vm:StatistikSpalte">
            <TextBlock Text="{Binding Titel}" Width="{Binding Breite}" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                       TextAlignment="Center" ToolTipService.ToolTip="{Binding Erlaeuterung}" />
        </DataTemplate>

        <DataTemplate x:Key="ZellenTemplate" x:DataType="vm:StatistikZelle">
            <TextBlock Text="{Binding Text}" Width="{Binding Breite}" FontSize="12" FontWeight="{Binding Schriftstaerke}"
                       TextAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>

        <!-- Formreihe: Sieg grün, Unentschieden grau, Niederlage rot (Nutzerentscheidung #327). Drei Flächen statt
             einer gebundenen Farbe, damit die ThemeResource-Farben dem Hell-/Dunkel-Wechsel folgen. -->
        <DataTemplate x:Key="FormKaestchenTemplate" x:DataType="vm:FormKaestchen">
            <Grid Width="22" Height="22" Margin="2,0">
                <Border Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="4"
                        Visibility="{Binding IstSieg, Converter={StaticResource BoolToVisibility}}" />
                <Border Background="{ThemeResource SystemFillColorNeutralBrush}" CornerRadius="4"
                        Visibility="{Binding IstUnentschieden, Converter={StaticResource BoolToVisibility}}" />
                <Border Background="{ThemeResource SystemFillColorCriticalBrush}" CornerRadius="4"
                        Visibility="{Binding IstNiederlage, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Buchstabe}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ZeilenTemplate" x:DataType="vm:StatistikZeile">
            <Grid ColumnDefinitions="36,*,Auto,Auto" Padding="8,5"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBlock Grid.Column="0" Text="{Binding Rang}" FontSize="12" FontWeight="SemiBold" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Image Source="{Binding Mannschaft, Converter={StaticResource MannschaftZuWappen}}"
                           Visibility="{Binding Mannschaft, Converter={StaticResource MannschaftHatWappen}}"
                           Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Form}" Width="{Binding FormBreite}"
                              ItemTemplate="{StaticResource FormKaestchenTemplate}" ItemsPanel="{StaticResource ZellenReihe}"
                              VerticalAlignment="Center" />
                <ItemsControl Grid.Column="3" ItemsSource="{Binding Zellen}"
                              ItemTemplate="{StaticResource ZellenTemplate}" ItemsPanel="{StaticResource ZellenReihe}"
                              VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Ranglistenzeile: Klick öffnet die Seite der Mannschaft, Rechtsklick das Mannschaftsmenü (#324). Zeilen ohne
             Mannschaft (Verbände) bleiben ohne Aktion. -->
        <DataTemplate x:Key="RanglistenZeileTemplate" x:DataType="vm:StatistikZeile">
            <views:KlickFlaeche ZeigerHintergrund="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Tapped="RanglistenZeile_Tapped"
                                views:MannschaftsKontextmenue.MannschaftId="{Binding Mannschaft.Id}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ZeilenTemplate}"
                                HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False" />
            </views:KlickFlaeche>
        </DataTemplate>

        <!-- Nicht verfügbare Auswertung: ausgegraut, der Grund steht darunter. -->
        <DataTemplate x:Key="AuswertungTemplate" x:DataType="vm:StatistikAuswertung">
            <StackPanel Padding="0,6" Opacity="{Binding Deckkraft}">
                <TextBlock Text="{Binding Titel}" FontSize="13" />
                <TextBlock Text="{Binding Hinweis}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                           Visibility="{Binding Hinweis, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </DataTemplate>

        <!-- ── Bereich „Mannschaft“ (#324) ── -->

        <DataTemplate x:Key="KennzahlTemplate" x:DataType="vm:Kennzahl">
            <Grid ColumnDefinitions="*,90,130" Padding="12,5"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                  ToolTipService.ToolTip="{Binding Erlaeuterung}">
                <TextBlock Grid.Column="0" Text="{Binding Bezeichnung}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Wert}" FontSize="12" FontWeight="SemiBold"
                           TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Zusatz}" FontSize="12" Opacity="0.7"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="KennzahlBlockTemplate" x:DataType="vm:KennzahlBlock">
            <Border Style="{StaticResource KartenRahmen}" Margin="0,0,0,12">
                <StackPanel MinWidth="520">
                    <TextBlock Text="{Binding Titel}" Style="{StaticResource KartenTitel}" />
                    <Grid ColumnDefinitions="*,90,130" Padding="12,0,12,5"
                          Visibility="{Binding HatSpaltenkoepfe, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Grid.Column="1" Text="{Binding WertTitel}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="{Binding ZusatzTitel}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Kennzahlen}" ItemTemplate="{StaticResource KennzahlTemplate}" />
                    <TextBlock Text="{Binding Hinweis}" Style="{StaticResource KartenHinweis}"
                               Visibility="{Binding HatHinweis, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TorabschnittTemplate" x:DataType="stat:Torabschnitt">
            <Grid ColumnDefinitions="*,90,130" Padding="12,5"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock Grid.Column="0" Text="{Binding Bezeichnung}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Tore}" FontSize="12" FontWeight="SemiBold"
                           TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Gegentore}" FontSize="12"
                           TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MannschaftsSpielTemplate" x:DataType="vm:MannschaftsSpielZeile">
            <Grid ColumnDefinitions="30,*,24,*,Auto" ColumnSpacing="8" Padding="12,5"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <ContentControl Grid.Column="0" Content="{Binding Ausgang}" ContentTemplate="{StaticResource FormKaestchenTemplate}"
                                VerticalAlignment="Center" IsTabStop="False" />
                <TextBlock Grid.Column="1" Text="{Binding Runde}" FontSize="12" Opacity="0.8" TextWrapping="WrapWholeWords"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Ort}" FontSize="11" Opacity="0.6" TextAlignment="Center"
                           VerticalAlignment="Center" ToolTipService.ToolTip="H = Heim, A = Auswärts, N = neutraler Platz" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Background="Transparent"
                            views:MannschaftsKontextmenue.MannschaftId="{Binding Gegner.Id}">
                    <Image Source="{Binding Gegner, Converter={StaticResource MannschaftZuWappen}}"
                           Visibility="{Binding Gegner, Converter={StaticResource MannschaftHatWappen}}"
                           Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Text="{Binding Gegner.Name}" FontSize="12" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Ergebnis}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"
                               Visibility="{Binding HatDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ── Bereich „Turnier“ (#432) ── -->

        <DataTemplate x:Key="KachelTemplate" x:DataType="vm:Kachel">
            <Border Style="{StaticResource KartenRahmen}" Width="160" Padding="14,10"
                    ToolTipService.ToolTip="{Binding Erlaeuterung}">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Bezeichnung}" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{Binding Wert}" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Mannschaftsnamen mit Mannschaftsmenü wie auf der Mannschaftsseite; Heim rechtsbündig zum Ergebnis hin. -->
        <DataTemplate x:Key="TurnierSpielZeileTemplate" x:DataType="vm:TurnierSpielZeile">
            <Grid ColumnDefinitions="140,*,Auto,*,90" ColumnSpacing="8" Padding="12,5"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock Grid.Column="0" Text="{Binding Runde}" FontSize="12" Opacity="0.8" TextWrapping="WrapWholeWords"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Background="Transparent"
                            views:MannschaftsKontextmenue.MannschaftId="{Binding Heim.Id}">
                    <TextBlock Text="{Binding Heim.Name}" FontSize="12" TextWrapping="WrapWholeWords" TextAlignment="Right"
                               VerticalAlignment="Center" />
                    <Image Source="{Binding Heim, Converter={StaticResource MannschaftZuWappen}}"
                           Visibility="{Binding Heim, Converter={StaticResource MannschaftHatWappen}}"
                           Width="16" Height="16" Stretch="Uniform" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="44">
                    <TextBlock Text="{Binding Ergebnis}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.7" HorizontalAlignment="Center"
                               Visibility="{Binding HatDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Background="Transparent"
                            views:MannschaftsKontextmenue.MannschaftId="{Binding Auswaerts.Id}">
                    <Image Source="{Binding Auswaerts, Converter={StaticResource MannschaftZuWappen}}"
                           Visibility="{Binding Auswaerts, Converter={StaticResource MannschaftHatWappen}}"
                           Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Text="{Binding Auswaerts.Name}" FontSize="12" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding Wert}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SpielListeTemplate" x:DataType="vm:SpielListe">
            <Border Style="{StaticResource KartenRahmen}" Margin="0,0,0,12">
                <StackPanel MinWidth="520">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Titel}" Style="{StaticResource KartenTitel}" />
                        <TextBlock Grid.Column="1" Text="{Binding WertTitel}" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                                   VerticalAlignment="Bottom" Margin="0,0,12,6"
                                   Visibility="{Binding HatZeilen, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Zeilen}" ItemTemplate="{StaticResource TurnierSpielZeileTemplate}" />
                    <TextBlock Text="{Binding Hinweis}" Style="{StaticResource KartenHinweis}"
                               Visibility="{Binding HatHinweis, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*">

        <!-- ── Auswertungen ── -->
        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <ListView x:Name="AuswertungsListe"
                      ItemsSource="{Binding Auswertungen}"
                      SelectedItem="{Binding AusgewaehlteAuswertung, Mode=TwoWay}"
                      ItemTemplate="{StaticResource AuswertungTemplate}"
                      SelectionMode="Single" Padding="4,8" />
        </Border>

        <!-- ── Rangliste bzw. Mannschaft ── -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

            <Border Grid.Row="0" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="4" Padding="10,7" Margin="16,10,16,0"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding AusgewaehlteAuswertung.Titel}" FontSize="16" FontWeight="SemiBold"
                       Margin="16,14,16,0" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
                <Grid>
                    <TextBlock Text="{Binding Hinweis}" Opacity="0.6" FontSize="13" HorizontalAlignment="Center"
                               Margin="16,48" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding Hinweis, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Rangliste -->
                    <Border Style="{StaticResource KartenRahmen}" VerticalAlignment="Top"
                            Visibility="{Binding Tabelle, Converter={StaticResource NullToCollapsed}}">
                        <StackPanel MinWidth="520">
                            <Grid ColumnDefinitions="36,*,Auto,Auto" Padding="8,7"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Tabelle.NamensTitel}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                <TextBlock Grid.Column="2" Text="Letzte Spiele" Width="{Binding Tabelle.FormBreite}"
                                           FontSize="11" FontWeight="SemiBold" Opacity="0.6" TextAlignment="Center"
                                           ToolTipService.ToolTip="Älteste links, das jüngste Spiel rechts" />
                                <ItemsControl Grid.Column="3" ItemsSource="{Binding Tabelle.Spalten}"
                                              ItemTemplate="{StaticResource SpaltenkopfTemplate}"
                                              ItemsPanel="{StaticResource ZellenReihe}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Tabelle.Zeilen}" ItemTemplate="{StaticResource RanglistenZeileTemplate}" />
                        </StackPanel>
                    </Border>

                    <!-- Turnier (#432) -->
                    <StackPanel DataContext="{Binding TurnierSeite}" VerticalAlignment="Top"
                                Visibility="{Binding DataContext.IstTurnierbereich, ElementName=AuswertungsListe, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Kacheln}" ItemTemplate="{StaticResource KachelTemplate}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Verteilungen}" ItemTemplate="{StaticResource KennzahlBlockTemplate}" />
                        <ItemsControl ItemsSource="{Binding Spiellisten}" ItemTemplate="{StaticResource SpielListeTemplate}" />
                        <ItemsControl ItemsSource="{Binding Weitere}" ItemTemplate="{StaticResource KennzahlBlockTemplate}" />
                    </StackPanel>

                    <!-- Mannschaft (#324) -->
                    <StackPanel DataContext="{Binding Mannschaft}" Spacing="0" VerticalAlignment="Top"
                                Visibility="{Binding DataContext.IstMannschaftsbereich, ElementName=AuswertungsListe, Converter={StaticResource BoolToVisibility}}">

                        <views:MannschaftsAuswahlBox DataContext="{Binding Auswahl}" Width="320" HorizontalAlignment="Left"
                                                     Margin="0,0,0,12" PlaceholderText="Mannschaft suchen …"
                                                     Bestaetigt="MannschaftsAuswahl_Bestaetigt" />

                        <TextBlock Text="{Binding Hinweis}" Opacity="0.6" FontSize="13" Margin="0,24" TextWrapping="Wrap"
                                   Visibility="{Binding Hinweis, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel DataContext="{Binding Seite}"
                                    Visibility="{Binding DataContext.Seite, ElementName=MannschaftsBereichAnker, Converter={StaticResource NullToCollapsed}}">

                            <!-- Kopf -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,12" MaxWidth="820"
                                  HorizontalAlignment="Left" MinWidth="520">
                                <Image Grid.Column="0" Source="{Binding Mannschaft, Converter={StaticResource MannschaftZuWappen}}"
                                       Visibility="{Binding Mannschaft, Converter={StaticResource MannschaftHatWappen}}"
                                       Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Mannschaft.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding Untertitel}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Letzte Spiele" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                                               HorizontalAlignment="Right"
                                               ToolTipService.ToolTip="Älteste links, das jüngste Spiel rechts" />
                                    <ItemsControl ItemsSource="{Binding Form}" ItemTemplate="{StaticResource FormKaestchenTemplate}"
                                                  ItemsPanel="{StaticResource ZellenReihe}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Bilanz: Platz in der Rangliste Gesamt/Heim/Auswärts -->
                            <Border Style="{StaticResource KartenRahmen}" Margin="0,0,0,12">
                                <StackPanel MinWidth="520">
                                    <TextBlock Text="Bilanz" Style="{StaticResource KartenTitel}" />
                                    <Grid ColumnDefinitions="36,*,Auto" Padding="8,7"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
                                        <TextBlock Grid.Column="0" Text="Platz" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                                                   HorizontalAlignment="Center"
                                                   ToolTipService.ToolTip="Platz in der Rangliste Gesamt, Heim bzw. Auswärts" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Bilanz.Spalten}"
                                                      ItemTemplate="{StaticResource SpaltenkopfTemplate}"
                                                      ItemsPanel="{StaticResource ZellenReihe}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Bilanz.Zeilen}" ItemTemplate="{StaticResource ZeilenTemplate}" />
                                </StackPanel>
                            </Border>

                            <!-- Tabellenplatz-Verlauf je Runde mit Tabelle (#480); ein Klick öffnet den Tabellenverlauf. -->
                            <ItemsControl ItemsSource="{Binding DataContext.MannschaftsVerlauf.Bloecke, ElementName=AuswertungsListe}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MannschaftsVerlaufBlock">
                                        <Border Style="{StaticResource KartenRahmen}" Margin="0,0,0,12">
                                            <StackPanel MinWidth="520">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Style="{StaticResource KartenTitel}">
                                                        <Run Text="Tabellenplatz · " /><Run Text="{Binding Titel}" />
                                                    </TextBlock>
                                                    <HyperlinkButton Grid.Column="1" Content="Im Tabellenverlauf öffnen" FontSize="12"
                                                                     Margin="0,4,8,0" Click="VerlaufOeffnen_Click"
                                                                     ToolTipService.ToolTip="Mit allen Mannschaften und der Tabelle zu jedem Spieltag" />
                                                </Grid>
                                                <views:TabellenVerlaufDiagramm Verlauf="{Binding Verlauf}" Zonen="{Binding Zonen}"
                                                                               Hervorhebungen="{Binding Hervorhebung}" Margin="4,0,8,8"
                                                                               MannschaftGeklickt="BlockDiagramm_MannschaftGeklickt"
                                                                               SpieltagGeklickt="BlockDiagramm_SpieltagGeklickt" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Bloecke}" ItemTemplate="{StaticResource KennzahlBlockTemplate}" />

                            <!-- Tore nach Spielabschnitt -->
                            <Border Style="{StaticResource KartenRahmen}" Margin="0,0,0,12">
                                <StackPanel MinWidth="520">
                                    <TextBlock Text="Tore nach Spielabschnitt" Style="{StaticResource KartenTitel}" />
                                    <Grid ColumnDefinitions="*,90,130" Padding="12,5"
                                          Visibility="{Binding HatTorabschnitte, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Grid.Column="1" Text="Tore" FontSize="11" FontWeight="SemiBold" Opacity="0.6" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Gegentore" FontSize="11" FontWeight="SemiBold" Opacity="0.6" TextAlignment="Right" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Torabschnitte}" ItemTemplate="{StaticResource TorabschnittTemplate}" />
                                    <TextBlock Text="{Binding TorabschnittHinweis}" Style="{StaticResource KartenHinweis}"
                                               Visibility="{Binding HatTorabschnittHinweis, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- Spiele -->
                            <Border Style="{StaticResource KartenRahmen}" Margin="0,0,0,12">
                                <StackPanel MinWidth="520">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Spiele im Turnier" Style="{StaticResource KartenTitel}" />
                                        <HyperlinkButton Grid.Column="1" Content="Alle Spiele im Spielplan zeigen" FontSize="12"
                                                         Margin="0,4,8,0"
                                                         Command="{Binding DataContext.AlleSpieleZeigenCommand, ElementName=MannschaftsBereichAnker}"
                                                         ToolTipService.ToolTip="Wechselt in „Spielplan &amp; Baum“ – dort auch die noch offenen Spiele" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Spiele}" ItemTemplate="{StaticResource MannschaftsSpielTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Hält den DataContext des Bereichs (MannschaftsStatistikViewModel) für Bindungen innerhalb der Seite. -->
                        <Border x:Name="MannschaftsBereichAnker" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Tabellenverlauf (#480): Runde und Gruppe wählen, darunter die Kurve und die Tabellen der Runde zum
                         in der Kurve gewählten Spieltag. -->
                    <StackPanel DataContext="{Binding TabellenVerlauf}" Spacing="12" VerticalAlignment="Top"
                                Visibility="{Binding DataContext.IstTabellenverlaufsbereich, ElementName=AuswertungsListe, Converter={StaticResource BoolToVisibility}}">

                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <ComboBox Header="Runde" ItemsSource="{Binding Runden}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding AusgewaehlteRunde, Mode=TwoWay}" MinWidth="220"
                                      Visibility="{Binding HatMehrereRunden, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Spacing="4" Visibility="{Binding HatGruppen, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Gruppe" />
                                <ListView ItemsSource="{Binding Gruppen}" SelectedItem="{Binding AusgewaehlteGruppe, Mode=TwoWay}"
                                          SelectionMode="Single" ScrollViewer.HorizontalScrollMode="Disabled">
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsStackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinWidth" Value="36" />
                                            <Setter Property="Padding" Value="10,0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VerlaufGruppe">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding Hinweis}" Opacity="0.6" FontSize="13" TextWrapping="Wrap"
                                   Visibility="{Binding Hinweis, Converter={StaticResource NullToCollapsed}}" />

                        <StackPanel Spacing="8" Visibility="{Binding HatVerlauf, Converter={StaticResource BoolToVisibility}}">
                            <!-- Legende: hervorgehobene Mannschaften, Klick nimmt sie wieder heraus. -->
                            <ItemsControl ItemsSource="{Binding Hervorhebungen}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="tabelle:VerlaufHervorhebung">
                                        <Button Command="{Binding DataContext.HervorhebungEntfernenCommand, ElementName=TabellenVerlaufAnker}"
                                                CommandParameter="{Binding}" Padding="8,3"
                                                ToolTipService.ToolTip="Hervorhebung aufheben">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <views:VerlaufFarbMarke Farbe="{Binding Farbe}" Width="10" Height="10" CornerRadius="5"
                                                                        VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                <FontIcon Glyph="&#xE711;" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                       Text="Klick auf eine Linie hebt die Mannschaft hervor (bis zu drei), Klick auf einen Spieltag zeigt darunter die Tabelle nach diesem Spieltag." />

                            <views:TabellenVerlaufDiagramm Verlauf="{Binding Verlauf}" Zonen="{Binding Tabellen.Zonen}"
                                                           Hervorhebungen="{Binding Hervorhebungen}"
                                                           AusgewaehlterSpieltag="{Binding Tabellen.BisSpieltag}"
                                                           MannschaftGeklickt="Diagramm_MannschaftGeklickt"
                                                           SpieltagGeklickt="Diagramm_SpieltagGeklickt" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <TextBlock Text="Tabelle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding TabellenStandOptionen}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding AusgewaehlteTabellenStandOption, Mode=TwoWay}" MinWidth="180" />
                        </StackPanel>
                        <views:RundenTabellenAnzeige DataContext="{Binding Tabellen}" />

                        <!-- Hält den DataContext des Bereichs (TabellenVerlaufViewModel) für Bindungen in Vorlagen. -->
                        <Border x:Name="TabellenVerlaufAnker" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
