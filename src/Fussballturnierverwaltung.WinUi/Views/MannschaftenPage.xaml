<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.MannschaftenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnDefinitions="3*,1,2*">

        <!-- ── Linke Spalte: Filter-Leiste + Liste ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <!-- Filter-Leiste -->
            <Border Grid.Row="0" Padding="8,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">

                    <TextBox Text="{Binding Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍  Suchen …" Width="180" />

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Land" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding LandFilterOptionen}"
                                  SelectedItem="{Binding FilterLandOption, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" Width="130" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Verband" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding VerbandFilterOptionen}"
                                  SelectedItem="{Binding FilterVerbandOption, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" Width="130" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Art" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ArtFilterOptionen}"
                                  SelectedItem="{Binding FilterArtOption, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" Width="110" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Rating ≥" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <Slider Value="{Binding FilterMinRating, Mode=TwoWay}"
                                Minimum="0" Maximum="99" Width="90" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FilterMinRating}" FontSize="11" FontWeight="SemiBold"
                                   Width="20" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Content="↺ Zurücksetzen" Command="{Binding FilterZuruecksetzenCommand}" FontSize="11" />
                </StackPanel>
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <!-- Kopfzeile (ListView selbst hat keine Spaltenköpfe) -->
            <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="8,4,12,4" ColumnDefinitions="44,*,54,160,90,48,48,48,70">
                    <TextBlock Grid.Column="1" Text="Name" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="Kurz" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="3" Text="Land" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="4" Text="Art" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="5" Text="OFF" FontSize="11" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Text="MIF" FontSize="11" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="7" Text="DEF" FontSize="11" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="8" Text="⭐ Ges." FontSize="11" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Right" />
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding MannschaftenGefiltert}"
                          SelectedItem="{Binding Ausgewaehlte, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnDefinitions="44,*,54,160,90,48,48,48,70">
                                <Grid Width="28" Height="28">
                                    <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                           Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                           Stretch="Uniform" />
                                    <TextBlock Text="⚽" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.4"
                                               Visibility="{Binding Wappen, Converter={StaticResource NullToVisible}}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Kurzname}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Land.Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Mannschaftsart}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding OffensivRating}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Grid.Column="6" Text="{Binding MittelfeldRating}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="7" Text="{Binding DefensivRating}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Grid.Column="8" Text="{Binding GesamtRating, Converter={StaticResource RatingRunden}}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Rechte Spalte: Formular ──
             ColumnDefinitions="3*,1*" (= 75%/25%) statt MaxWidth+Left/Stretch: Eine StackPanel-Breite, die
             nur über HorizontalAlignment+MaxWidth begrenzt wird, bestimmt sich weiterhin bottom-up aus dem
             Inhalt (ein "Stretch"-Kind bekommt dabei keine echte Breite von oben vorgegeben) — dadurch
             änderte sich die Formularbreite je nach Textlänge im aktuellen Feld (z.B. Art: "Verein" vs.
             "Nationalmannschaft"). Eine echte Grid-Spalte bekommt ihre Breite dagegen ausschließlich vom
             Elternelement (Fund aus #281-Test) — deterministisch, unabhängig vom Inhalt. -->
        <Grid Grid.Column="2" ColumnDefinitions="3*,1*">

            <StackPanel Grid.ColumnSpan="2"
                        Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="⚽" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Mannschaft auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Column="0"
                          Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch" Spacing="0">

                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,16" ColumnDefinitions="64,16,*">
                        <Grid Width="64" Height="64">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                            <Image Source="{Binding WappenDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding WappenDaten, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" Margin="4" />
                            <TextBlock Text="⚽" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding WappenDaten, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                        <!-- Beide Buttons immer sichtbar (statt "Entfernen" nur bei vorhandenem Wappen):
                             sonst ändert sich beim Durchblättern der Mannschaften die Höhe dieser
                             StackPanel je nach Datensatz, wodurch die Steuerelemente sichtbar nach
                             oben/unten springen (Fund aus #281-Test). "Entfernen" stattdessen deaktiviert,
                             wenn kein Wappen hinterlegt ist. -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                            <Button Content="Bild wählen…" Command="{Binding WappenWaehlenCommand}" HorizontalAlignment="Left" />
                            <Button Content="Entfernen" Command="{Binding WappenEntfernenCommand}"
                                    IsEnabled="{Binding WappenDaten, Converter={StaticResource IstNichtNull}}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12" ColumnDefinitions="120,16,*">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="Kurzname" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Kurzname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Art" FontSize="12" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding ArtOptionen}"
                                      SelectedItem="{Binding AusgewaehlteArt, Mode=TwoWay}"
                                      IsEnabled="{Binding IstNeuModus}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Land" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Laender}"
                              SelectedItem="{Binding AusgewaehltesLand, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,24" />

                    <Grid Margin="0,0,0,12" ColumnDefinitions="*,Auto">
                        <TextBlock Text="RATINGS" FontWeight="SemiBold" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Gesamt" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GesamtRating}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Offensiv" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding OffensivRating, Mode=TwoWay}" Minimum="1" Maximum="99" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding OffensivRating}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,8" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Mittelfeld" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding MittelfeldRating, Mode=TwoWay}" Minimum="1" Maximum="99" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MittelfeldRating}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,24" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Defensiv" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding DefensivRating, Mode=TwoWay}" Minimum="1" Maximum="99" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding DefensivRating}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="STÄRKEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Heimstärke" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding Heimstaerke, Mode=TwoWay}" Minimum="1" Maximum="99" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Heimstaerke}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,24" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Auswärtsstärke" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" Value="{Binding Auswaertsstaerke, Mode=TwoWay}" Minimum="1" Maximum="99" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Auswaertsstaerke}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
