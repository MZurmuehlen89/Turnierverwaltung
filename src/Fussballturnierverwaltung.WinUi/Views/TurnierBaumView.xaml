<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurnierBaumView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views"
    xmlns:tabelle="using:Fussballturnierverwaltung.Application.Tabelle">

    <UserControl.Resources>

        <!-- Bracket-Spielpaarungskarte — feste Breite (Trichterlinien-Positionierung via Canvas.Top
             braucht feste Breite, siehe TurnierBaumViewModel-Klassendoku), Trimming hier bewusst in
             Kauf genommen (keine #262-Stelle, siehe Plan). -->
        <DataTemplate x:Key="BracketKartenTemplate" x:DataType="vm:BracketKnotenAnzeige">
            <Button Command="{Binding DataContext.KnotenAngeklicktBefehl, ElementName=Root}"
                    CommandParameter="{Binding}"
                    Padding="0" Width="240" HorizontalContentAlignment="Stretch">
                <Border BorderThickness="1" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{Binding HatErgebnis, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.5"
                                Visibility="{Binding HatLabel, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold" Opacity="0.8" Padding="10,4" />
                        </Border>
                        <TextBlock Text="{Binding Datum}" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                                   HorizontalAlignment="Center" Padding="10,4"
                                   Visibility="{Binding HatDatum, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="–" FontSize="22" Opacity="0.3" HorizontalAlignment="Center" Padding="0,16"
                                   Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />

                        <Grid Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}"
                              ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="12,10,8,4" Spacing="8">
                                <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                       Width="18" Height="18" Stretch="Uniform" />
                                <TextBlock Text="{Binding HeimName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           FontWeight="{Binding HeimIstSieger, Converter={StaticResource IstNichtNull}}" />
                            </StackPanel>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HeimScore}" FontSize="15" FontWeight="Bold" Margin="8,10,12,4" VerticalAlignment="Center" />

                            <Rectangle Grid.Row="1" Grid.Column="0" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="12,4,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ErgebnisDetail}" FontSize="9" Opacity="0.6" HorizontalAlignment="Center" Margin="8,0,12,0" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="12,4,8,10" Spacing="8">
                                <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                       Width="18" Height="18" Stretch="Uniform" />
                                <TextBlock Text="{Binding AuswaertsName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuswaertsScore}" FontSize="15" FontWeight="Bold" Margin="8,4,12,10" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Issue #340: Einzelergebnisse einer Hin-/Rückspiel-Paarung über die volle Kartenbreite. -->
                        <StackPanel Visibility="{Binding HatPaarungsText, Converter={StaticResource BoolToVisibility}}">
                            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="12,0" />
                            <TextBlock Text="{Binding PaarungsText}" FontSize="10" Opacity="0.6"
                                       HorizontalAlignment="Center" Padding="10,4,10,6" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Kompakte Karte der Gesamtübersicht (Issue #238): feste Größe KOMPAKT_W × KOMPAKT_H, damit die
             Verbindungslinien direkt aus den berechneten Positionen gezeichnet werden können. Der umgebende
             Button (Klick → Runde fokussieren) entsteht im Code-Behind. -->
        <DataTemplate x:Key="KompaktKartenTemplate" x:DataType="vm:BracketKnotenAnzeige">
            <Border BorderThickness="1" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <TextBlock Text="–" FontSize="18" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}"
                          ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="*,*" Padding="8,2,8,2" ColumnSpacing="6">
                        <Image Grid.Row="0" Grid.Column="0"
                               Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                               Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                               Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HeimName}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontWeight="{Binding HeimSchrift}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding HeimScore}" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <Image Grid.Row="1" Grid.Column="0"
                               Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                               Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                               Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuswaertsName}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontWeight="{Binding AuswaertsSchrift}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AuswaertsScore}" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="{Binding EntscheidungKurz}"
                                   FontSize="9" Opacity="0.6" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tabellenzeile für Gruppen-/Rangfolge-Karten. #262-Fix: keine feste schmale Breite/Trimming
             mehr auf der Team-Spalte — Karte ist breit genug (siehe Karten-Border unten), Name darf
             ggf. umbrechen statt abgeschnitten zu werden. -->
        <!-- Buchholz-Spalte (Schweizer System, Issue #329 Teil C) nur sichtbar, wenn die fokussierte
             Runde SchweizerSystem ist (TurnierBaumViewModel.ZeigtBuchholzSpalte) - dieselbe Vorlage wird
             auch für Gruppenphase-/Rangfolge-Karten verwendet, wo Buchholz nicht zutrifft. -->
        <!-- Tabellenzonen (Issue #358): Balken am linken Rand in der Farbe der Zone des aktuellen Rangs, Punkt
             vor dem Rang, sobald Weiterkommen bzw. Ausscheiden feststeht. Beide Flächen behalten ohne Farbe
             ihre Größe, damit die Spalten aller Zeilen fluchten. -->
        <DataTemplate x:Key="TabellenEintragZeileTemplate" x:DataType="tabelle:TabellenEintrag">
            <Grid ColumnDefinitions="Auto,*">
                <views:ZonenMarke Grid.Column="0" Farbe="{Binding ZonenFarbe}" Width="4" CornerRadius="2" Margin="3,2,0,2" />
                <Grid Grid.Column="1" ColumnDefinitions="36,*,26,50,34,30,34" Padding="0,4,4,4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <views:ZonenMarke Farbe="{Binding PunktFarbe}" Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Rang}" FontSize="12" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Image Source="{Binding Mannschaft, Converter={StaticResource MannschaftZuWappen}}"
                               Visibility="{Binding Mannschaft, Converter={StaticResource MannschaftHatWappen}}"
                               Width="16" Height="16" Stretch="Uniform" />
                        <TextBlock Text="{Binding Mannschaft.Name}" FontSize="12" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Spiele}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Run Text="{Binding Tore}" /><Run Text=":" /><Run Text="{Binding Gegentore}" />
                    </TextBlock>
                    <TextBlock Grid.Column="4" Text="{Binding Tordifferenz}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Punkte}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding Buchholz}" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding DataContext.Tabellen.ZeigtBuchholzSpalte, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Legende der Tabellenzonen (Issue #358) — ein Eintrag je Zone: Farbfläche + „Platz 1–2 → Achtelfinale“. -->
        <DataTemplate x:Key="ZonenLegendeTemplate" x:DataType="tabelle:ZonenLegendenEintrag">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
                <views:ZonenMarke Farbe="{Binding Farbe}" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">

        <TextBlock Text="Bitte ein Turnier auswählen." Opacity="0.5" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

        <Grid Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}">

            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="4" Padding="12,8" Margin="16,12,16,0" VerticalAlignment="Top"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- ── Bracket-Fenster (Issue #108/#244) ── -->
            <Grid RowDefinitions="Auto,Auto,*" Visibility="{Binding ZeigtBracketInhalt, Converter={StaticResource BoolToVisibility}}">

                <!-- Kopfzeile: ◀/▶ blättern rundenweise, der Button in der Mitte schaltet zwischen rundenweiser Ansicht
                     und Gesamtübersicht um (Issue #238). -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="16,12,16,8">
                    <Grid Grid.Column="0" HorizontalAlignment="Left"
                          Visibility="{Binding IstGesamtansicht, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Command="{Binding VorherigeRundeBefehl}" Background="Transparent" BorderThickness="0"
                                Visibility="{Binding HatVorherigeRunde, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="◀" FontSize="14" />
                                <TextBlock Text="{Binding VorherigeRundeName}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button Grid.Column="1" Command="{Binding GesamtansichtZeigenBefehl}"
                            Visibility="{Binding IstGesamtansicht, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                            <TextBlock Text="Gesamtübersicht" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                Visibility="{Binding IstGesamtansicht, Converter={StaticResource BoolToVisibility}}">
                        <Button Command="{Binding RundenweiseZeigenBefehl}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                <TextBlock Text="Rundenweise" />
                            </StackPanel>
                        </Button>
                        <Button Click="AllesAnzeigen_Click" ToolTipService.ToolTip="Ganzen Turnierbaum ins Fenster einpassen">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                                <TextBlock Text="Alles anzeigen" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ZoomAnzeige" MinWidth="44" VerticalAlignment="Center" TextAlignment="Right"
                                   FontSize="12" Opacity="0.7"
                                   ToolTipService.ToolTip="Zoomen mit Strg + Mausrad, verschieben durch Ziehen" />
                    </StackPanel>

                    <Grid Grid.Column="2" HorizontalAlignment="Right"
                          Visibility="{Binding IstGesamtansicht, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button Command="{Binding NaechsteRundeBefehl}" Background="Transparent" BorderThickness="0"
                                Visibility="{Binding HatNaechsteRunde, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding NaechsteRundeName}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="▶" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,60,*" Margin="16,0,16,8"
                      Visibility="{Binding IstGesamtansicht, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Grid.Column="0" Text="{Binding LinkeSpalteName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Grid.ColumnSpan="3" Visibility="{Binding ZeigtZweiteSpalte, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Grid.Column="0" Text="{Binding LinkeSpalteName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Visibility="{Binding ZeigtZweiteSpalte, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Grid.Column="2" Text="{Binding RechteSpalteName}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Visibility="{Binding ZeigtZweiteSpalte, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4"
                              Visibility="{Binding IstGesamtansicht, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid Margin="0,0,0,16" ColumnDefinitions="*,60,*">

                        <!-- Canvas.Top wird NICHT per ItemContainerStyle-Binding gesetzt (in WinUI3 nicht
                             zuverlässig ausgewertet, siehe TurnierBaumView.xaml.cs/PositioniereKarten) —
                             stattdessen programmatisch im Code-Behind, analog zur Verbindungslinien-Messung. -->
                        <ItemsControl x:Name="LinkeSpalteItems" Grid.Column="0"
                                      ItemsSource="{Binding LinkeSpalteKnoten}" ItemTemplate="{StaticResource BracketKartenTemplate}"
                                      Width="240" Height="{Binding FensterCanvasHoehe}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl x:Name="RechteSpalteItems" Grid.Column="2"
                                      ItemsSource="{Binding RechteSpalteKnoten}" ItemTemplate="{StaticResource BracketKartenTemplate}"
                                      Width="240" Height="{Binding FensterCanvasHoehe}" HorizontalAlignment="Center"
                                      Visibility="{Binding ZeigtZweiteSpalte, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Canvas x:Name="VerbindungsCanvas" Grid.Column="0" Grid.ColumnSpan="3"
                                Background="Transparent" IsHitTestVisible="False" />
                        <!-- Issue #340: Farbquelle der Verbindungslinien. ThemeResource wird hier nach dem Theme des
                             Elements aufgelöst (Dunkelmodus sitzt per RequestedTheme am Fenster-Wurzelelement) —
                             Application.Current.Resources lieferte dagegen immer die Hell-Variante. -->
                        <Rectangle x:Name="LinienFarbQuelle" Visibility="Collapsed"
                                   Fill="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                    </Grid>
                </ScrollViewer>

                <!-- ── Gesamtübersicht (Issue #238) mit Zoom/Verschieben (Issue #50) ── Inhalt (Karten, Linien,
                     Beschriftungen) baut TurnierBaumView.xaml.cs imperativ aus den berechneten Positionen auf. -->
                <ScrollViewer x:Name="GesamtScroll" Grid.Row="1" Grid.RowSpan="2"
                              ZoomMode="Enabled" MinZoomFactor="0.2" MaxZoomFactor="2"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IstGesamtansicht, Converter={StaticResource BoolToVisibility}}">
                    <Canvas x:Name="GesamtCanvas" Background="Transparent" />
                </ScrollViewer>
            </Grid>

            <!-- ── Gruppenphase-Ansicht ── -->
            <Grid RowDefinitions="Auto,*" Visibility="{Binding Tabellen.ZeigtGruppenphase, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,8" Spacing="6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding Tabellen.HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Tabellenstand:" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Tabellen.TabellenSpieltagOptionen}"
                              SelectedItem="{Binding Tabellen.TabellenBisSpieltagAuswahl, Mode=TwoWay}" FontSize="11" MinWidth="90" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Noch keine Gruppenzuordnung — Gruppen erscheinen nach der Auslosung/Spielplan-Generierung."
                                   Opacity="0.6" FontSize="13" HorizontalAlignment="Center" Margin="16,48" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding Tabellen.HatGruppenTabellenAnzeige, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Tabellen.AnzeigeGruppenTabellen}"
                                      Visibility="{Binding Tabellen.HatGruppenTabellenAnzeige, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tabelle:GruppenTabelle">
                                    <Button Command="{Binding DataContext.GruppeAngeklicktBefehl, ElementName=Root}"
                                            CommandParameter="{Binding}" Padding="0" Margin="0,0,12,12">
                                        <!-- #262-Fix: 340px statt der ursprünglich zu schmalen 290px-Karte, Team-Spalte
                                             oben zusätzlich mit WrapWholeWords statt Ellipsis. -->
                                        <Border Width="340" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8,8,0,0" Padding="12,8">
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
                                                        <Run Text="Gruppe " /><Run Text="{Binding GruppenNummer}" />
                                                    </TextBlock>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Tabelle}" ItemTemplate="{StaticResource TabellenEintragZeileTemplate}" />
                                                <!-- #397: noch nicht aufgelöste Plätze als eigene Zeile, damit die Gruppe vollständig wirkt -->
                                                <ItemsControl ItemsSource="{Binding OffenePlaetze}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="36,*,26,50,34,30,34" Padding="7,4,4,4" Opacity="0.6">
                                                                <TextBlock Grid.Column="0" Text="–" FontSize="12"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontStyle="Italic"
                                                                           TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3" Text="0:0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="4" Text="0" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="5" Text="0" FontSize="12" FontWeight="Bold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Tabellen.UebergreifendeRangfolgenAnzeige}"
                                      Visibility="{Binding Tabellen.HatUebergreifendeRangfolgenAnzeige, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UebergreifendeRangfolgeAnzeige">
                                    <Border Width="340" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,12">
                                        <StackPanel>
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8,8,0,0" Padding="12,8">
                                                <StackPanel>
                                                    <TextBlock Foreground="White" FontWeight="Bold" FontSize="13">
                                                        <Run Text="Platz " /><Run Text="{Binding Platzierung}" /><Run Text=" gruppenübergreifend" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="White" FontSize="10" Opacity="0.85">
                                                        <Run Text="beste " /><Run Text="{Binding AnzahlBeste}" /><Run Text=" → " /><Run Text="{Binding ZielRundeName}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Rangfolge}" ItemTemplate="{StaticResource TabellenEintragZeileTemplate}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Tabellen.ZonenLegende}" ItemTemplate="{StaticResource ZonenLegendeTemplate}"
                                      Visibility="{Binding Tabellen.HatZonenLegende, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Liga-/TopfLiga-/SchweizerSystem-Gesamttabelle ── -->
            <Grid RowDefinitions="Auto,*" Visibility="{Binding Tabellen.ZeigtLigaTabelle, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,8" Spacing="6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Button Content="Gesamt" Command="{Binding Tabellen.LigaAnsichtWaehlenBefehl}" CommandParameter="{x:Bind tabelle:TabellenAnsicht.Gesamt}" FontSize="11" Padding="10,3" />
                    <Button Content="Hinrunde" Command="{Binding Tabellen.LigaAnsichtWaehlenBefehl}" CommandParameter="{x:Bind tabelle:TabellenAnsicht.Hinrunde}" FontSize="11" Padding="10,3"
                            Visibility="{Binding Tabellen.ZeigtHinRueckrundenTabs, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Rückrunde" Command="{Binding Tabellen.LigaAnsichtWaehlenBefehl}" CommandParameter="{x:Bind tabelle:TabellenAnsicht.Rueckrunde}" FontSize="11" Padding="10,3"
                            Visibility="{Binding Tabellen.ZeigtHinRueckrundenTabs, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Heim" Command="{Binding Tabellen.LigaAnsichtWaehlenBefehl}" CommandParameter="{x:Bind tabelle:TabellenAnsicht.Heimtabelle}" FontSize="11" Padding="10,3" />
                    <Button Content="Auswärts" Command="{Binding Tabellen.LigaAnsichtWaehlenBefehl}" CommandParameter="{x:Bind tabelle:TabellenAnsicht.Auswaertstabelle}" FontSize="11" Padding="10,3" />
                    <TextBlock Text="Tabellenstand:" FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding Tabellen.HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox ItemsSource="{Binding Tabellen.TabellenSpieltagOptionen}"
                              SelectedItem="{Binding Tabellen.TabellenBisSpieltagAuswahl, Mode=TwoWay}" FontSize="11" MinWidth="90"
                              Visibility="{Binding Tabellen.HatVerfuegbareSpieltage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <TextBlock Text="Noch kein Spielplan generiert. Die Tabelle erscheint, sobald Spiele vorhanden sind."
                                   Opacity="0.6" FontSize="13" HorizontalAlignment="Center" Margin="16,48" TextWrapping="Wrap" TextAlignment="Center"
                                   Visibility="{Binding Tabellen.HatLigaTabelleAnzeige, Converter={StaticResource InverseBoolToVisibility}}" />

                        <StackPanel VerticalAlignment="Top" Spacing="8"
                                    Visibility="{Binding Tabellen.HatLigaTabelleAnzeige, Converter={StaticResource BoolToVisibility}}">
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <ItemsControl ItemsSource="{Binding Tabellen.LigaTabelleAnzeige}" ItemTemplate="{StaticResource TabellenEintragZeileTemplate}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Tabellen.ZonenLegende}" ItemTemplate="{StaticResource ZonenLegendeTemplate}"
                                          Visibility="{Binding Tabellen.HatZonenLegende, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
