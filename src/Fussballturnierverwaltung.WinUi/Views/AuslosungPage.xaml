<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.AuslosungPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Fussballturnierverwaltung.WinUi.Converters"
    xmlns:local="using:Fussballturnierverwaltung.WinUi.Views">

    <UserControl.Resources>
        <conv:AuslosungsartZuTextConverter x:Key="AuslosungsartZuText" />

        <DataTemplate x:Key="QuoteZeileTemplate">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding AnzeigeText}" FontSize="12" />
            </Grid>
        </DataTemplate>

        <SolidColorBrush x:Key="MatrixZelleHervorhebungBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />

        <!-- Gegner-Matrix (#362): Zelle mit Wappen + Kurzname, anklickbar für den Team-Fokus. Hervorhebung als
             Primary-Tint mit Akzentrahmen (keine Signalfarben), gebunden an die eigene IstHervorgehoben-Property.
             KlickFlaeche statt Button und so wenige Elemente wie möglich (#428): die Zelle steht in der Ligaphase
             288-mal da. Das Wappen ist an IstAufgedeckt gebunden, nicht an sein Vorhandensein — aufgedeckt hält es
             seinen Platz auch ohne Bild (Namen fluchten), verdeckt rückt das "…" an den linken Rand. -->
        <DataTemplate x:Key="GegnerMatrixZelleTemplate">
            <local:KlickFlaeche Width="116" Height="30" Padding="3,0" Margin="0,0,2,0"
                                ColumnDefinitions="Auto,*" CornerRadius="3" BorderThickness="1"
                                IstHervorgehoben="{Binding IstHervorgehoben}"
                                HervorhebungHintergrund="{StaticResource MatrixZelleHervorhebungBrush}"
                                HervorhebungRahmen="{ThemeResource AccentFillColorDefaultBrush}"
                                ZeigerHintergrund="{ThemeResource ButtonBackgroundPointerOver}"
                                ToolTipService.ToolTip="{Binding Name}"
                                Tapped="MatrixZelle_Tapped">
                <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding IstAufgedeckt, Converter={StaticResource BoolToVisibility}}"
                       Stretch="Uniform" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Anzeige}" Opacity="{Binding AnzeigeOpacity}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </local:KlickFlaeche>
        </DataTemplate>

        <!-- Gruppenkarten nebeneinander in gleichmäßigen Zeilen, höchstens vier je Zeile (#407) -->
        <ItemsPanelTemplate x:Key="GruppenRasterPanel">
            <local:GleichmaessigesRasterPanel MaxSpalten="4" />
        </ItemsPanelTemplate>

        <!-- Eine Paarung im Auslosungsergebnis; die Spaltenanordnung übernimmt PaarungsSpaltenControl (#407) -->
        <DataTemplate x:Key="PaarungsErgebnisTemplate">
            <Grid ColumnDefinitions="24,20,8,*,40,20,8,*" Height="24" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="{Binding PaarungsNummer}" Opacity="0.5" VerticalAlignment="Center" />
                <Image Grid.Column="1" Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding HeimName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding HeimName}" />
                <TextBlock Grid.Column="4" Text="vs." Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Grid.Column="5" Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="{Binding AuswaertsName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding AuswaertsName}" />
            </Grid>
        </DataTemplate>

        <!-- ── TV-Modus Gruppenphase/K.-o.-Runde (#408) ── -->

        <!-- Ein Platz im Lostopf: bleibt stehen und wird nur ausgegraut, damit sich das Layout nicht verschiebt -->
        <DataTemplate x:Key="TvTopfSlotTemplate">
            <Grid ColumnDefinitions="18,6,*" Height="26" Opacity="{Binding GezogenOpacity}">
                <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Anzeige}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- Fokus-Ansicht: der Topf, aus dem gerade gezogen wird -->
        <DataTemplate x:Key="TvFokusTopfTemplate">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource TvTopfSlotTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:GleichmaessigesRasterPanel MaxSpalten="2" MinSpaltenBreite="170" MaxSpaltenBreite="260" Abstand="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Fokus-Ansicht: die Gruppe, in die das gezogene Team kommt — der neue Platz ist hervorgehoben -->
        <DataTemplate x:Key="TvFokusGruppeTemplate">
            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                    CornerRadius="6" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="{Binding GruppenName}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Slots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="36" Margin="0,0,0,2">
                                    <Border CornerRadius="3" BorderThickness="1"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IstNeu, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
                                        </Border.Background>
                                    </Border>
                                    <Grid ColumnDefinitions="24,24,10,*" Margin="8,0" Opacity="{Binding BefuelltOpacity}">
                                        <TextBlock Grid.Column="0" FontSize="15" VerticalAlignment="Center" Opacity="0.6">
                                            <Run Text="{Binding Position}" /><Run Text="." />
                                        </TextBlock>
                                        <Image Grid.Column="1" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                               Stretch="Uniform" Width="24" Height="24" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Anzeige}" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Fokus-Ansicht: die Paarung, die gerade gezogen wird -->
        <DataTemplate x:Key="TvFokusPaarungTemplate">
            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                    CornerRadius="6" Padding="20,12">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                        <Run Text="Paarung" /><Run Text=" " /><Run Text="{Binding PaarungsNr}" />
                    </TextBlock>
                    <Grid ColumnDefinitions="*,Auto,*" Height="40">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Opacity="{Binding HeimBefuelltOpacity}">
                            <TextBlock Text="{Binding Heim}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" Width="32" Height="32" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Grid.Column="1" Width="80">
                            <TextBlock Text="vs." FontSize="14" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left"
                                    Opacity="{Binding AuswaertsBefuelltOpacity}"
                                    Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}">
                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Auswaerts}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Freilos" FontSize="20" Opacity="0.6" VerticalAlignment="Center"
                                   Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Gesamtübersicht: eine Paarung der laufenden Ziehung; Anordnung wie im Ergebnis über PaarungsSpaltenControl -->
        <DataTemplate x:Key="TvPaarungTemplate">
            <Grid ColumnDefinitions="24,20,8,*,40,20,8,*" Height="24" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="{Binding PaarungsNr}" Opacity="0.5" VerticalAlignment="Center" />
                <Image Grid.Column="1" Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Heim}" VerticalAlignment="Center"
                           Opacity="{Binding HeimBefuelltOpacity}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="vs." Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}" />
                <Image Grid.Column="5" Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="{Binding Auswaerts}" VerticalAlignment="Center"
                           Opacity="{Binding AuswaertsBefuelltOpacity}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Grid.Column="7" Text="Freilos" Opacity="0.6" VerticalAlignment="Center"
                           Visibility="{Binding IstFreilos, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- Gegnerliste des fokussierten Teams: Wappen, Name, Land -->
        <DataTemplate x:Key="FokusGegnerTemplate">
            <Grid ColumnDefinitions="20,8,*" Height="22">
                <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding Land}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Eine Gegner-Matrix (#362): Zeilen = Teams des Topfs, Spalten = je Gegner-Topf Heim/Auswärts.
             Gemeinsam genutzt von Ergebnisanzeige und TV-Modus (#364). -->
        <DataTemplate x:Key="GegnerMatrixTemplate">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <!-- Spaltenköpfe -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="200" />
                        <ItemsControl ItemsSource="{Binding Spalten}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="116" Margin="0,0,2,0" Padding="4,0">
                                        <TextBlock Text="{Binding TopfName}" FontSize="11" FontWeight="SemiBold"
                                                   Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Seite}" FontSize="11" Opacity="0.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Zeilen -->
                    <ItemsControl ItemsSource="{Binding Zeilen}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Border CornerRadius="3"
                                            Visibility="{Binding IstHervorgehoben, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.15" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <local:KlickFlaeche Width="200" Height="30" Padding="4,0" CornerRadius="3"
                                                            ColumnDefinitions="Auto,20,8,*"
                                                            ZeigerHintergrund="{ThemeResource ButtonBackgroundPointerOver}"
                                                            ToolTipService.ToolTip="{Binding Team.Land}"
                                                            Opacity="{Binding TeamOpacity}"
                                                            Tapped="MatrixTeam_Tapped">
                                            <TextBlock Grid.Column="0" Text="✓" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                                       Visibility="{Binding ZeigeGezogenHaken, Converter={StaticResource BoolToVisibility}}" />
                                            <Image Grid.Column="1" Source="{Binding Team.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding Team.Wappen, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Team.Name}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </local:KlickFlaeche>
                                        <ItemsControl ItemsSource="{Binding Gegner}"
                                                      ItemTemplate="{StaticResource GegnerMatrixZelleTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Spalte 0 auf 75% der ursprünglichen Breite gestutzt (Nutzerwunsch: mehr Platz für den Workspace) -->
    <Grid ColumnDefinitions="2.25*,1,9*">

        <!-- ── Spalte 0: Auslosungsliste ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Kein Turnier gewählt" Opacity="0.5" Margin="12"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <ListView Grid.Row="1"
                      Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}"
                      ItemsSource="{Binding Auslosungen}"
                      SelectedItem="{Binding AusgewaehlteAuslosung, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="{Binding TurnierRunde.Name}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Auslosungsart, Converter={StaticResource AuslosungsartZuText}}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Spalte 2: Neu-Formular / Detail-Workspace ── -->
        <Grid Grid.Column="2">

            <ProgressRing IsActive="{Binding IstLadend}"
                          Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}"
                          Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" />

            <TextBlock Text="Turnier und Runde wählen, dann &quot;Neu&quot; klicken"
                       Opacity="0.4" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ZeigtHinweis, Converter={StaticResource BoolToVisibility}}" />

            <!-- ── Neu-Formular ── -->
            <ScrollViewer Visibility="{Binding NeuFormAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Text="Neue Auslosung" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16" />

                    <TextBlock Text="Runde" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding NeuRundenOptionen}"
                              SelectedItem="{Binding NeuRunde, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                    <TextBox Text="{Binding NeuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <TextBlock Text="Auslosungsart" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding NeuAuslosungsartOptionen}"
                              SelectedItem="{Binding NeuAuslosungsartAusgewaehlt, Mode=TwoWay}"
                              DisplayMemberPath="Anzeige"
                              HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding AuslosungsartHinweis}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding AuslosungsartWarnung}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{Binding AuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock Text="Anzahl Lostöpfe" FontSize="12" Margin="0,0,0,3" />
                    <NumberBox Value="{Binding NeuAnzahlLostoepfe, Mode=TwoWay}"
                               IsEnabled="{Binding NeuAnzahlLostoepfeBearbeitbar}"
                               Minimum="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Detail-Workspace ── -->
            <ScrollViewer Visibility="{Binding DetailAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="{Binding AuslosungKopfzeile}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16" />

                    <!-- TV-Modus: Live-Ziehungsbanner (#303) -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="16,14" Margin="0,0,0,16"
                            Visibility="{Binding Ziehung.AnimationLaeuft, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="LIVE-ZIEHUNG" FontSize="11" FontWeight="Bold"
                                           Foreground="#FBBF24" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Ziehung.AnimationFortschrittText}" FontSize="11"
                                           Foreground="White" Opacity="0.7" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                                <!-- Pille "MANNSCHAFT" -->
                                <Border Background="#1E293B" CornerRadius="4" Padding="14,8" Margin="0,0,8,0" MinWidth="150">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Ziehung.AnimationBannerKopf}" FontSize="9" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Ziehung.AnimationBannerMannschaft}" FontSize="15" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="{Binding Ziehung.AnimationBannerTopf}" FontSize="10" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <!-- Pille "ZIEL" -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding Ziehung.AnimationBannerZiel, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="→" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="#1E293B" CornerRadius="4" Padding="14,8" Margin="0,0,8,0" MinWidth="110">
                                        <StackPanel>
                                            <TextBlock Text="ZIEL" FontSize="9" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Ziehung.AnimationBannerZiel}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#4ADE80" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Ziehung.AnimationBannerSlot}" FontSize="10" Foreground="White" Opacity="0.6" HorizontalAlignment="Center"
                                                       Visibility="{Binding Ziehung.AnimationBannerSlot, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- Pille "POSITION" -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding Ziehung.AnimationBannerPosition, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="→" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Border Background="#1E293B" CornerRadius="4" Padding="14,8" MinWidth="90">
                                        <StackPanel>
                                            <TextBlock Text="POSITION" FontSize="9" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Ziehung.AnimationBannerPosition}" FontSize="15" FontWeight="Bold"
                                                       Foreground="#60A5FA" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <!-- Ligaphase (#364): Gegner des gezogenen Teams namentlich nebeneinander — feste Plätze in
                                 Matrix-Spaltenreihenfolge, neue Gegner erscheinen nacheinander, bereits feststehende abgeblendet -->
                            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center"
                                        Visibility="{Binding Ziehung.AnimationZeigeBannerGegner, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GEGNER" FontSize="9" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Ziehung.AnimationBannerGegner}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="8,6" Margin="0,0,6,0" Width="112"
                                                    Opacity="{Binding Opacity}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Kopf}" FontSize="9" Foreground="White" Opacity="0.6"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Grid Height="22" Margin="0,2,0,0">
                                                        <TextBlock Text="…" FontSize="13" Foreground="White" Opacity="0.4"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding Zelle.IstAufgedeckt, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                    ToolTipService.ToolTip="{Binding Zelle.Name}"
                                                                    Visibility="{Binding Zelle.IstAufgedeckt, Converter={StaticResource BoolToVisibility}}">
                                                            <Image Source="{Binding Zelle.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding Zelle.Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Zelle.Kurzname}" FontSize="13" FontWeight="Bold" Foreground="White"
                                                                       MaxWidth="72" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TV-Modus Gruppenphase/K.-o.-Runde (#408, Vorbild UEFA-Gruppenauslosung bzw. DFB-Pokal): Fokus auf
                         den aktuellen Topf plus Zielgruppe bzw. aktuelle Paarung; nach jedem Topf bzw. nach je acht
                         Paarungen einmal die Gesamtübersicht. Nicht in der Ligaphase (#364). -->
                    <StackPanel Margin="0,0,0,16" IsHitTestVisible="False"
                                Visibility="{Binding Ziehung.AnimationZeigeListenFokus, Converter={StaticResource BoolToVisibility}}">

                        <!-- Fokus Gruppenphase -->
                        <StackPanel MaxWidth="1000"
                                    Visibility="{Binding Ziehung.AnimationIstGruppenmodus, Converter={StaticResource BoolToVisibility}}">
                            <!-- Alle Gruppen als Mini-Kacheln mit Füllstand; die Zielgruppe leuchtet auf. Entfällt bei
                                 nur einer Gruppe (Liga) — dort bleibt die Gruppe durchgehend im Fokus. -->
                            <ItemsControl ItemsSource="{Binding Ziehung.AnimationGruppen}" Margin="0,0,0,12" HorizontalAlignment="Center"
                                          Visibility="{Binding Ziehung.AnimationZeigeGruppenLeiste, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:GleichmaessigesRasterPanel MaxSpalten="12" MinSpaltenBreite="64" MaxSpaltenBreite="96" Abstand="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" />
                                            <Border CornerRadius="4" BorderThickness="2"
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding IstZiel, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Kurzname}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding FuellstandText}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,24,*">
                                <ContentControl Grid.Column="0" Content="{Binding Ziehung.AnimationFokusTopf}"
                                                ContentTemplate="{StaticResource TvFokusTopfTemplate}"
                                                HorizontalContentAlignment="Stretch" VerticalAlignment="Top" />
                                <Border Grid.Column="2" VerticalAlignment="Top" MinHeight="120"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding Ziehung.AnimationFokusGruppe, Converter={StaticResource NullToVisible}}">
                                    <TextBlock Text="Gruppe wird gezogen …" FontSize="14" Opacity="0.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentControl Grid.Column="2" Content="{Binding Ziehung.AnimationFokusGruppe}"
                                                ContentTemplate="{StaticResource TvFokusGruppeTemplate}"
                                                HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                                                Visibility="{Binding Ziehung.AnimationFokusGruppe, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </StackPanel>

                        <!-- Fokus K.-o.-Runde: aktuelle Paarung groß, darunter die Lostöpfe -->
                        <StackPanel Visibility="{Binding Ziehung.AnimationIstPaarungsmodus, Converter={StaticResource BoolToVisibility}}">
                            <Grid MaxWidth="900" Margin="0,0,0,12">
                                <!-- Pause nach einer vollständigen Paarung (#442): leerer Rahmen in der Größe der Karte,
                                     damit die Lostöpfe darunter nicht springen — der unsichtbare Inhalt bildet die
                                     Höhe von TvFokusPaarungTemplate nach -->
                                <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                        CornerRadius="6" Padding="20,12"
                                        Visibility="{Binding Ziehung.AnimationFokusPaarung, Converter={StaticResource NullToVisible}}">
                                    <StackPanel Opacity="0">
                                        <TextBlock Text="Paarung" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Grid Height="40" />
                                    </StackPanel>
                                </Border>
                                <ContentControl Content="{Binding Ziehung.AnimationFokusPaarung}"
                                                ContentTemplate="{StaticResource TvFokusPaarungTemplate}"
                                                HorizontalContentAlignment="Stretch"
                                                Visibility="{Binding Ziehung.AnimationFokusPaarung, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Ziehung.AnimationToepfe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:GleichmaessigesRasterPanel MaxSpalten="2" MinSpaltenBreite="340" MaxSpaltenBreite="4000" Abstand="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="14,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource TvTopfSlotTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <local:GleichmaessigesRasterPanel MaxSpalten="8" MinSpaltenBreite="150" MaxSpaltenBreite="220" Abstand="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- Gesamtübersicht Gruppenphase/K.-o.-Runde (#408) -->
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding Ziehung.AnimationZeigeListenUebersicht, Converter={StaticResource BoolToVisibility}}">

                        <!-- Gruppenphase: Töpfe kompakt, darunter alle Gruppen als Raster -->
                        <StackPanel Visibility="{Binding Ziehung.AnimationIstGruppenmodus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="LOSTÖPFE" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Ziehung.AnimationToepfe}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:GleichmaessigesRasterPanel MaxSpalten="6" MinSpaltenBreite="150" MaxSpaltenBreite="220" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8,4" CornerRadius="4,4,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Slots}" Margin="8,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="14,5,*" Height="20" Opacity="{Binding GezogenOpacity}">
                                                                <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                       Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Anzeige}" FontSize="11" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="GRUPPEN" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Ziehung.AnimationGruppen}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:GleichmaessigesRasterPanel MaxSpalten="6" MinSpaltenBreite="170" MaxSpaltenBreite="260" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,5" CornerRadius="4,4,0,0">
                                                    <TextBlock Text="{Binding GruppenName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Slots}" Margin="10,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="18,18,6,*" Height="26" Opacity="{Binding BefuelltOpacity}">
                                                                <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center" Opacity="0.6">
                                                                    <Run Text="{Binding Position}" /><Run Text="." />
                                                                </TextBlock>
                                                                <Image Grid.Column="1" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                       Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="3" Text="{Binding Anzeige}" FontSize="13" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- K.-o.-Runde: alle Paarungen spaltenweise wie im Ergebnis (#407) -->
                        <StackPanel Visibility="{Binding Ziehung.AnimationIstPaarungsmodus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="PAARUNGEN" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                            <local:PaarungsSpaltenControl Paarungen="{Binding Ziehung.AnimationPaarungen}"
                                                          ZeilenJeSpalte="16"
                                                          PaarungTemplate="{StaticResource TvPaarungTemplate}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- TV-Modus Ligaphase (#364): Fokus auf die Matrix des gerade gezogenen Topfs, nach jedem Topf
                         einmal die Übersicht aller Matrizen. Klicks gesperrt (Team-Fokus wirkt nur auf die Ergebnisanzeige). -->
                    <StackPanel Margin="0,0,0,16" IsHitTestVisible="False"
                                Visibility="{Binding Ziehung.AnimationIstMatrixmodus, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                                      Visibility="{Binding Ziehung.AnimationZeigeFokusMatrix, Converter={StaticResource BoolToVisibility}}">
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                    CornerRadius="6" Padding="6" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding Ziehung.AnimationFokusKopf}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="4,0,0,6" />
                                    <ContentControl Content="{Binding Ziehung.AnimationFokusMatrix}"
                                                    ContentTemplate="{StaticResource GegnerMatrixTemplate}" />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        <StackPanel Visibility="{Binding Ziehung.AnimationZeigeUebersicht, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ZWISCHENSTAND" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{Binding Ziehung.AnimationMatrizen}" ItemTemplate="{StaticResource GegnerMatrixTemplate}" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- Editierbare Basisdaten (nur solange nicht abgeschlossen) -->
                    <StackPanel Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,16,*,16,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding DetailName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Auslosungsart" FontSize="12" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding DetailAuslosungsartOptionen}"
                                          SelectedItem="{Binding DetailAuslosungsartAusgewaehlt, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Lostöpfe" FontSize="12" Margin="0,0,0,3" />
                                <NumberBox Value="{Binding DetailAnzahlLostoepfe, Mode=TwoWay}"
                                           IsEnabled="{Binding DetailAnzahlLostoepfeBearbeitbar}"
                                           Minimum="1" SpinButtonPlacementMode="Inline" Width="120" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding DetailAuslosungsartHinweis}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DetailAuslosungsartWarnung}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding DetailAuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Ranglisten-Automatik (Befüllen-Button lebt im Menü, "Auslosung"-Gruppe) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                                Visibility="{Binding IstAbgeschlossen, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Rangliste für Automatik:" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Arbeitsbereich.RanglisteOptionen}"
                                  SelectedItem="{Binding Arbeitsbereich.AusgewaehlteRanglisteOption, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" Width="220" />
                    </StackPanel>

                    <TextBlock Text="{Binding Arbeitsbereich.TeamsStatusText}" FontSize="12" Margin="0,0,0,12" />

                    <!-- Quoten nur zur Topfzuordnung (#441): ab dem Auslosen – Live-Ziehung wie Ergebnis – verborgen,
                         gleiche Bedingung wie der Töpfe/Teilnehmer-Workspace darunter. Gleiche Spalten wie dort, damit
                         die Quoten so breit sind wie die Verfügbar-Liste – über die volle Seitenbreite standen Name
                         und Stand zu weit auseinander -->
                    <Grid Visibility="{Binding IstAbgeschlossen, Converter={StaticResource InverseBoolToVisibility}}"
                          ColumnDefinitions="2.4*,16,7*">
                        <StackPanel Grid.Column="0">
                            <!-- Verbandsquoten (Nutzerwunsch: direkt bei der Teams-zugewiesen-Anzeige, nicht erst
                                 nach dem gesamten Zuweisungsbereich, damit Status und Quoten auf einen Blick sichtbar sind) -->
                            <StackPanel Visibility="{Binding Quoten.ZeigeVerbandsquoten, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                                <TextBlock Text="VERBAND-QUOTEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />
                                <ItemsRepeater ItemsSource="{Binding Quoten.Verbandsquoten}"
                                               ItemTemplate="{StaticResource QuoteZeileTemplate}" />
                            </StackPanel>

                            <!-- Landesquoten -->
                            <StackPanel Visibility="{Binding Quoten.ZeigeLandesquoten, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                                <TextBlock Text="LANDES-QUOTEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />
                                <ItemsRepeater ItemsSource="{Binding Quoten.Landesquoten}"
                                               ItemTemplate="{StaticResource QuoteZeileTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Töpfe/Teilnehmer-Workspace (vor Abschluss) ── -->
                    <!-- Verfügbar-Spalte auf 80% der ursprünglichen Breite gestutzt (Nutzerwunsch: mehr
                         Platz für die Lostöpfe) -->
                    <Grid Visibility="{Binding IstAbgeschlossen, Converter={StaticResource InverseBoolToVisibility}}"
                          ColumnDefinitions="2.4*,16,7*" Margin="0,0,0,16">

                        <!-- Verfügbare Teilnehmer -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="VERFÜGBAR" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" PlaceholderText="🔍  Filtern …"
                                     Text="{Binding Arbeitsbereich.Filter.TeilnehmerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6" />
                            <!-- Verbandsfilter (#421), nur sichtbar, wenn der Pool Teams mehrerer Verbände enthält -->
                            <ComboBox Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                      ItemsSource="{Binding Arbeitsbereich.Filter.VerbandFilterOptionen}"
                                      SelectedItem="{Binding Arbeitsbereich.Filter.VerbandFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Anzeige"
                                      Visibility="{Binding Arbeitsbereich.Filter.ZeigeVerbandFilter, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Länderfilter (#344), nur bei Vereinsturnieren über mehrere Länder -->
                            <ComboBox Grid.Row="3" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                      ItemsSource="{Binding Arbeitsbereich.Filter.LandFilterOptionen}"
                                      SelectedItem="{Binding Arbeitsbereich.Filter.LandFilter, Mode=TwoWay}"
                                      DisplayMemberPath="Anzeige"
                                      Visibility="{Binding Arbeitsbereich.Filter.ZeigeLandFilter, Converter={StaticResource BoolToVisibility}}" />
                            <ListView Grid.Row="4" x:Name="VerfuegbarListView"
                                      ItemsSource="{Binding Arbeitsbereich.VerfuegbareTeilnehmerGefiltert}"
                                      SelectionMode="Extended"
                                      CanDragItems="True" CanReorderItems="False"
                                      DragItemsStarting="VerfuegbarListView_DragItemsStarting"
                                      DoubleTapped="VerfuegbarListView_DoubleTapped"
                                      RightTapped="VerfuegbarListView_RightTapped"
                                      Height="450">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,8,*" Height="26" Padding="0,3">
                                            <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                   Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Lostöpfe -->
                        <ScrollViewer Grid.Column="2" Height="450"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Arbeitsbereich.Lostoepfe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="4" Margin="0,0,12,0" Width="220" Padding="8">
                                            <Grid RowDefinitions="Auto,*">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Button Grid.Column="1" Content="Leeren" FontSize="10" Padding="6,2"
                                                            Command="{Binding ElementName=Root, Path=DataContext.Arbeitsbereich.TopfLeerenCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                                <ListView Grid.Row="1" AllowDrop="True" CanReorderItems="False"
                                                          SelectionMode="Extended"
                                                          CanDragItems="True"
                                                          ItemsSource="{Binding Teilnehmer}" Height="380"
                                                          DragItemsStarting="TopfListView_DragItemsStarting"
                                                          DragOver="TopfListView_DragOver"
                                                          Drop="TopfListView_Drop"
                                                          DragEnter="TopfListView_DragEnter"
                                                          DragLeave="TopfListView_DragLeave"
                                                          RightTapped="TopfListView_RightTapped">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="20,8,*" Height="26" Padding="0,3">
                                                                <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                       Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Ergebnis-Anzeige (nach Abschluss, aber verborgen während der TV-Modus-Animation läuft) -->
                    <StackPanel Visibility="{Binding ZeigeErgebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNIS" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />

                        <!-- Gruppenergebnis -->
                        <ItemsControl Visibility="{Binding IstGruppenergebnis, Converter={StaticResource BoolToVisibility}}"
                                      ItemsSource="{Binding GruppenErgebnisse}"
                                      ItemsPanel="{StaticResource GruppenRasterPanel}"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding GruppenName}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsRepeater ItemsSource="{Binding Teams}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="20,8,*" Height="20" Margin="0,0,0,3">
                                                            <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                                   Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTipService.ToolTip="{Binding Name}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ligaphase: Gegner-Matrix je Topf (#362, Vorbild UEFA-TV-Grafik) — kein Spieltag, der gehört
                             in den Spielplan-Reiter -->
                        <StackPanel Visibility="{Binding IstGegnerMatrixergebnis, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Team anklicken, um es in allen Töpfen hervorzuheben und seine Gegner anzuzeigen."
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <!-- Gegnerliste des fokussierten Teams -->
                            <Border Visibility="{Binding GegnerMatrix.ZeigeFokusGegner, Converter={StaticResource BoolToVisibility}}"
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,12" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,8,*,Auto" Margin="0,0,0,8">
                                        <Image Grid.Column="0" Source="{Binding GegnerMatrix.FokusTeam.Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding GegnerMatrix.FokusTeam.Wappen, Converter={StaticResource NullToCollapsed}}"
                                               Stretch="Uniform" Width="24" Height="24" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="Gegner von " /><Run Text="{Binding GegnerMatrix.FokusTeam.Name}" />
                                        </TextBlock>
                                        <Button Grid.Column="3" Content="✕" FontSize="11" Padding="6,3"
                                                ToolTipService.ToolTip="Fokus aufheben"
                                                Command="{Binding GegnerMatrix.TeamFokussierenCommand}" />
                                    </Grid>
                                    <!-- Feste Spaltenbreiten: der Rahmen ist links ausgerichtet und passt sich dem Inhalt an —
                                         *-Spalten würden dann je Zeile einzeln nach Inhalt bemessen (Auswärts-Spalte verrutschte). -->
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                            Padding="0,0,0,4" Margin="0,0,0,2">
                                        <Grid ColumnDefinitions="90,280,16,280" Opacity="0.6">
                                            <TextBlock Grid.Column="0" Text="Topf" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="Heim" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="Auswärts" FontSize="11" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding GegnerMatrix.FokusGegner}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                                        Padding="0,4">
                                                    <Grid ColumnDefinitions="90,280,16,280">
                                                        <TextBlock Grid.Column="0" Text="{Binding TopfName}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                                        <ContentPresenter Grid.Column="1" Content="{Binding Heim}"
                                                                          ContentTemplate="{StaticResource FokusGegnerTemplate}" />
                                                        <ContentPresenter Grid.Column="3" Content="{Binding Auswaerts}"
                                                                          ContentTemplate="{StaticResource FokusGegnerTemplate}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Eine Matrix je Topf: Zeilen = Teams des Topfs, Spalten = je Gegner-Topf Heim/Auswärts -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{Binding GegnerMatrix.Matrizen}" ItemTemplate="{StaticResource GegnerMatrixTemplate}" />
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Paarungsergebnis -->
                        <local:PaarungsSpaltenControl Visibility="{Binding IstPaarungsergebnis, Converter={StaticResource BoolToVisibility}}"
                                                      Paarungen="{Binding ErgebnisseAnzeige}"
                                                      ZeilenJeSpalte="16"
                                                      PaarungTemplate="{StaticResource PaarungsErgebnisTemplate}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
