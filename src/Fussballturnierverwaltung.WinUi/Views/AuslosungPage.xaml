<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.AuslosungPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Fussballturnierverwaltung.WinUi.Converters">

    <UserControl.Resources>
        <conv:AuslosungsartZuTextConverter x:Key="AuslosungsartZuText" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="3*,1,9*">

        <!-- ── Spalte 0: Auslosungsliste ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Kein Turnier gewählt" Opacity="0.5" Margin="12"
                       Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource BoolToVisibility}}" />

            <ListView Grid.Row="1"
                      Visibility="{Binding KeinTurnierGewaehlt, Converter={StaticResource InverseBoolToVisibility}}"
                      ItemsSource="{Binding Auslosungen}"
                      SelectedItem="{Binding AusgewaehlteAuslosung, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="{Binding TurnierRunde.Name}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Auslosungsart, Converter={StaticResource AuslosungsartZuText}}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Spalte 2: Neu-Formular / Detail-Workspace ── -->
        <Grid Grid.Column="2">

            <ProgressRing IsActive="{Binding IstLadend}"
                          Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}"
                          Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" />

            <TextBlock Text="Turnier und Runde wählen, dann &quot;Neu&quot; klicken"
                       Opacity="0.4" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ZeigtHinweis, Converter={StaticResource BoolToVisibility}}" />

            <!-- ── Neu-Formular ── -->
            <ScrollViewer Visibility="{Binding NeuFormAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Text="Neue Auslosung" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16" />

                    <TextBlock Text="Runde" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding NeuRundenOptionen}"
                              SelectedItem="{Binding NeuRunde, Mode=TwoWay}"
                              DisplayMemberPath="Name" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                    <TextBox Text="{Binding NeuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <TextBlock Text="Auslosungsart" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding NeuAuslosungsartOptionen}"
                              SelectedValue="{Binding NeuAuslosungsart, Mode=TwoWay}"
                              SelectedValuePath="Wert" DisplayMemberPath="Anzeige"
                              HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding AuslosungsartHinweis}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding AuslosungsartWarnung}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               Visibility="{Binding AuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock Text="Anzahl Lostöpfe" FontSize="12" Margin="0,0,0,3" />
                    <NumberBox Value="{Binding NeuAnzahlLostoepfe, Mode=TwoWay}"
                               IsEnabled="{Binding NeuAnzahlLostoepfeBearbeitbar}"
                               Minimum="1" SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Detail-Workspace ── -->
            <ScrollViewer Visibility="{Binding DetailAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="{Binding AuslosungKopfzeile}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,16" />

                    <!-- Editierbare Basisdaten (nur solange nicht abgeschlossen) -->
                    <StackPanel Visibility="{Binding IstBearbeitbar, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="*,16,*,16,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                                <TextBox Text="{Binding DetailName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Auslosungsart" FontSize="12" Margin="0,0,0,3" />
                                <ComboBox ItemsSource="{Binding DetailAuslosungsartOptionen}"
                                          SelectedValue="{Binding DetailAuslosungsart, Mode=TwoWay}"
                                          SelectedValuePath="Wert" DisplayMemberPath="Anzeige"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Lostöpfe" FontSize="12" Margin="0,0,0,3" />
                                <NumberBox Value="{Binding DetailAnzahlLostoepfe, Mode=TwoWay}"
                                           IsEnabled="{Binding DetailAnzahlLostoepfeBearbeitbar}"
                                           Minimum="1" SpinButtonPlacementMode="Inline" Width="120" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding DetailAuslosungsartHinweis}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding DetailAuslosungsartWarnung}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding DetailAuslosungsartWarnung, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Ranglisten-Automatik (Befüllen-Button lebt im Menü, "Auslosung"-Gruppe) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                                Visibility="{Binding IstAbgeschlossen, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Rangliste für Automatik:" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox ItemsSource="{Binding RanglisteOptionen}"
                                  SelectedItem="{Binding AusgewaehlteRanglisteOption, Mode=TwoWay}"
                                  DisplayMemberPath="Anzeige" Width="220" />
                    </StackPanel>

                    <TextBlock Text="{Binding TeamsStatusText}" FontSize="12" Margin="0,0,0,12" />

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- ── Töpfe/Teilnehmer-Workspace (vor Abschluss) ── -->
                    <Grid Visibility="{Binding IstAbgeschlossen, Converter={StaticResource InverseBoolToVisibility}}"
                          ColumnDefinitions="3*,16,7*" Margin="0,0,0,16">

                        <!-- Verfügbare Teilnehmer -->
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="VERFÜGBAR" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,6" />
                            <TextBox Grid.Row="1" PlaceholderText="🔍  Filtern …"
                                     Text="{Binding TeilnehmerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6" />
                            <ListView Grid.Row="2" x:Name="VerfuegbarListView"
                                      ItemsSource="{Binding VerfuegbareTeilnehmerGefiltert}"
                                      CanDragItems="True" CanReorderItems="False"
                                      DragItemsStarting="VerfuegbarListView_DragItemsStarting"
                                      DoubleTapped="VerfuegbarListView_DoubleTapped"
                                      Height="450">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,8,*" Padding="0,3">
                                            <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Lostöpfe -->
                        <ScrollViewer Grid.Column="2" Height="450"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Lostoepfe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="4" Margin="0,0,12,0" Width="220" Padding="8">
                                            <Grid RowDefinitions="Auto,*">
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <Button Grid.Column="1" Content="Leeren" FontSize="10" Padding="6,2"
                                                            Command="{Binding ElementName=Root, Path=DataContext.TopfLeerenCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                                <ListView Grid.Row="1" AllowDrop="True" CanReorderItems="False"
                                                          ItemsSource="{Binding Teilnehmer}" Height="380"
                                                          DragOver="TopfListView_DragOver"
                                                          Drop="TopfListView_Drop"
                                                          DragEnter="TopfListView_DragEnter"
                                                          DragLeave="TopfListView_DragLeave"
                                                          RightTapped="TopfListView_RightTapped">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="20,8,*" Padding="0,3">
                                                                <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}" Stretch="Uniform" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Name}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Verbandsquoten -->
                    <StackPanel Visibility="{Binding ZeigeVerbandsQuoten, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,16">
                        <TextBlock Text="VERBAND-QUOTEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />
                        <ItemsRepeater ItemsSource="{Binding VerbandsQuotenAnzeige}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding VerbandName}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding AnzeigeText}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Ergebnis-Anzeige (nach Abschluss) -->
                    <StackPanel Visibility="{Binding IstAbgeschlossen, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNIS" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />

                        <!-- Gruppenergebnis -->
                        <ItemsControl Visibility="{Binding IstGruppenergebnis, Converter={StaticResource BoolToVisibility}}"
                                      ItemsSource="{Binding GruppenErgebnisse}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding GruppenName}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsRepeater ItemsSource="{Binding Teams}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="20,8,*" Margin="0,0,0,3">
                                                            <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}" Stretch="Uniform" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Paarungsergebnis -->
                        <ItemsControl Visibility="{Binding IstPaarungsergebnis, Converter={StaticResource BoolToVisibility}}"
                                      ItemsSource="{Binding ErgebnisseAnzeige}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,20,8,*,40,20,8,*" Margin="0,0,0,6">
                                        <TextBlock Grid.Column="0" Text="{Binding PaarungsNummer}" Opacity="0.5" Width="24" />
                                        <Image Grid.Column="1" Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="3" Text="{Binding HeimName}" />
                                        <TextBlock Grid.Column="4" Text="vs." Opacity="0.5" HorizontalAlignment="Center" />
                                        <Image Grid.Column="5" Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}" Stretch="Uniform" />
                                        <TextBlock Grid.Column="7" Text="{Binding AuswaertsName}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
