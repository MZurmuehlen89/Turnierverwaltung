<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.LaenderUndVerbaendePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Pivot SelectedIndex="{Binding AktiverTabIndex, Mode=TwoWay}">

        <!-- ═══════════════════════════════ Tab: Länder ══════════════════════════════ -->
        <PivotItem Header="🌍  Länder">
            <Grid ColumnDefinitions="3*,1,2*">

                <!-- ── Linke Spalte: Filter-Leiste + Liste ── -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0" Padding="8,6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBox Text="{Binding LandSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="🔍  Suchen …" Width="180" />

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Verband" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding VerbandFilterOptionen}"
                                          SelectedItem="{Binding LandFilterVerbandOption, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige" Width="140" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Kontinent" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding KontinentFilterOptionen}"
                                          SelectedItem="{Binding LandFilterKontinentOption, Mode=TwoWay}"
                                          DisplayMemberPath="Anzeige" Width="160" />
                            </StackPanel>

                            <Button Content="↺ Zurücksetzen" Command="{Binding FilterZuruecksetzenCommand}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                                 Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding LaenderGefiltert}"
                              SelectedItem="{Binding AusgewaehltesLand, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4" ColumnDefinitions="36,*,80">
                                    <Grid Width="28" Height="28">
                                        <Image Source="{Binding Flagge, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding Flagge, Converter={StaticResource NullToCollapsed}}"
                                               Stretch="Uniform" />
                                        <TextBlock Text="🌍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.4"
                                                   Visibility="{Binding Flagge, Converter={StaticResource NullToVisible}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Kurzname}" FontSize="11" Opacity="0.6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FifaCode}" FontSize="11" Opacity="0.6"
                                                   FontFamily="Courier New" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Verband.Kurzname}" FontSize="10" Opacity="0.6"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

                <!-- ── Rechte Spalte: Formular ── -->
                <Grid Grid.Column="2" ColumnDefinitions="3*,1*">

                    <StackPanel Grid.ColumnSpan="2"
                                Visibility="{Binding LandFormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                        <TextBlock Text="🌍" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Land auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="0"
                                  Visibility="{Binding LandFormularAktiv, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch">

                            <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,16" ColumnDefinitions="64,16,*">
                                <Grid Width="64" Height="64">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                    <Image Source="{Binding LandFlaggeDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                           Visibility="{Binding LandFlaggeDaten, Converter={StaticResource NullToCollapsed}}"
                                           Stretch="Uniform" Margin="4" />
                                    <TextBlock Text="🌍" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.35"
                                               Visibility="{Binding LandFlaggeDaten, Converter={StaticResource NullToVisible}}" />
                                </Grid>
                                <!-- Beide Buttons immer sichtbar (statt "Entfernen" nur bei vorhandener Flagge):
                                     sonst springen beim Durchblättern der Länder andere Steuerelemente vertikal,
                                     da sich die Höhe dieser StackPanel je nach Datensatz ändert (Fund aus #281). -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <Button Content="Bild wählen…" Command="{Binding LandFlaggeWaehlenCommand}" HorizontalAlignment="Left" />
                                    <Button Content="Entfernen" Command="{Binding LandFlaggeEntfernenCommand}"
                                            IsEnabled="{Binding LandFlaggeDaten, Converter={StaticResource IstNichtNull}}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding LandName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12" ColumnDefinitions="*,16,90">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="Kurzname" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding LandKurzname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FIFA-Code" FontSize="12" Margin="0,0,0,3" />
                                    <TextBox Text="{Binding LandFifaCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="3" CharacterCasing="Upper" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,24" ColumnDefinitions="*,16,*">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="Kontinent" FontSize="12" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding KontinentFormularOptionen}"
                                              SelectedItem="{Binding LandKontinentOption, Mode=TwoWay}"
                                              DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Verband" FontSize="12" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding Verbaende}"
                                              SelectedItem="{Binding LandVerband, Mode=TwoWay}"
                                              DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4" Padding="10,8">
                                <TextBlock Text="{Binding Fehlermeldung}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </PivotItem>

        <!-- ═══════════════════════════════ Tab: Verbände ═════════════════════════════ -->
        <PivotItem Header="🏛  Verbände">
            <Grid ColumnDefinitions="3*,1,2*">

                <!-- ── Linke Spalte: Filter-Leiste + Liste ── -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0" Padding="8,6"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                            <TextBox Text="{Binding VerbandSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="🔍  Suchen …" Width="180" />
                            <Button Content="↺ Zurücksetzen" Command="{Binding FilterZuruecksetzenCommand}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                                 Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding VerbaendeGefiltert}"
                              SelectedItem="{Binding AusgewaehlterVerband, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4" ColumnDefinitions="36,*,60">
                                    <Grid Width="28" Height="28">
                                        <Image Source="{Binding Logo, Converter={StaticResource BildDatenZuBildquelle}}"
                                               Visibility="{Binding Logo, Converter={StaticResource NullToCollapsed}}"
                                               Stretch="Uniform" />
                                        <TextBlock Text="🏛" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Opacity="0.4"
                                                   Visibility="{Binding Logo, Converter={StaticResource NullToVisible}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Kurzname}" FontSize="11" Opacity="0.6"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

                <!-- ── Rechte Spalte: Formular ── -->
                <Grid Grid.Column="2" ColumnDefinitions="3*,1*">

                    <StackPanel Grid.ColumnSpan="2"
                                Visibility="{Binding VerbandFormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                        <TextBlock Text="🏛" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Verband auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="0"
                                  Visibility="{Binding VerbandFormularAktiv, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch">

                            <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,16" ColumnDefinitions="64,16,*">
                                <Grid Width="64" Height="64">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                    <Image Source="{Binding VerbandLogoDaten, Converter={StaticResource BildDatenZuBildquelle}}"
                                           Visibility="{Binding VerbandLogoDaten, Converter={StaticResource NullToCollapsed}}"
                                           Stretch="Uniform" Margin="4" />
                                    <TextBlock Text="🏛" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Opacity="0.35"
                                               Visibility="{Binding VerbandLogoDaten, Converter={StaticResource NullToVisible}}" />
                                </Grid>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                    <Button Content="Bild wählen…" Command="{Binding VerbandLogoWaehlenCommand}" HorizontalAlignment="Left" />
                                    <Button Content="Entfernen" Command="{Binding VerbandLogoEntfernenCommand}"
                                            IsEnabled="{Binding VerbandLogoDaten, Converter={StaticResource IstNichtNull}}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding VerbandName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                            <TextBlock Text="Kurzname" FontSize="12" Margin="0,0,0,3" />
                            <TextBox Text="{Binding VerbandKurzname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" Margin="0,0,0,24" />

                            <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4" Padding="10,8">
                                <TextBlock Text="{Binding Fehlermeldung}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </PivotItem>

    </Pivot>
</UserControl>
