<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SimulationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- "Simulation"-Tab (#302), 1:1-Port aus Wpf/Views/SimulationsView.xaml — Breadcrumb-Leiste
         (Runde/Spiel statt Turnier/Runde/Spiel, da die Instanz von der geteilten Kopfzeile der
         Turnierdurchführung kommt) über Vorschau-Karte/Spielbericht-Karte. -->

    <Grid RowDefinitions="Auto,*">

        <!-- Kopf-Leiste: Runde/Spiel-Auswahl -->
        <Border Grid.Row="0" Padding="16,10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Runde:" VerticalAlignment="Center" Opacity="0.6" />
                <ComboBox ItemsSource="{Binding Runden}" SelectedItem="{Binding AusgewaehlteRunde, Mode=TwoWay}"
                          DisplayMemberPath="Name" MinWidth="140" />

                <TextBlock Text="Spiel:" VerticalAlignment="Center" Opacity="0.6"
                           Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}" />
                <ComboBox ItemsSource="{Binding Spiele}" SelectedItem="{Binding AusgewaehlteSpiel, Mode=TwoWay}"
                          MinWidth="260"
                          Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpielZeile">
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding HeimName}" />
                                <Run Text=" – " />
                                <Run Text="{Binding AuswaertsName}" />
                                <Run Text=" " />
                                <Run Text="{Binding ErgebnisText}" FontFamily="Consolas" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0"
                            Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}">
                    <ProgressRing IsActive="{Binding IstLadend}" Width="16" Height="16" />
                    <TextBlock Text="Simuliert …" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*">

            <!-- Team-Vorschau-Karte vor der Simulation -->
            <Border Grid.Row="0" Margin="16,16,16,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="24,20"
                    Visibility="{Binding ZeigeVorschauKarte, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                            <Image Source="{Binding AusgewaehlteSpiel.HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding AusgewaehlteSpiel.HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" />
                            <TextBlock Text="🏳" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding AusgewaehlteSpiel.HeimWappen, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                        <TextBlock Text="{Binding AusgewaehlteSpiel.HeimName}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="vs" FontSize="14" FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding AusgewaehlteSpiel.AuswaertsName}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                            <Image Source="{Binding AusgewaehlteSpiel.AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                   Visibility="{Binding AusgewaehlteSpiel.AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                   Stretch="Uniform" />
                            <TextBlock Text="🏳" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Opacity="0.35"
                                       Visibility="{Binding AusgewaehlteSpiel.AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Fehlermeldung -->
            <Border Grid.Row="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="4" Padding="10,7" Margin="16,10,16,0"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Vereinheitlichte Spielbericht-Karte (Scoreboard + Zeitleiste) — füllt die Restfläche -->
            <views:SpielberichtControl Grid.Row="2" Margin="16,12,16,16"
                LeerZustandText="Spiel auswählen und auf 'Turnierspiel simulieren' klicken — oder über Spielplan → 'Spielverlauf ansehen' springen." />

        </Grid>
    </Grid>
</UserControl>
