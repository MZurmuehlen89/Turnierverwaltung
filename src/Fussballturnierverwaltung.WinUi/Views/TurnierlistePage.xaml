<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurnierlistePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <Grid ColumnDefinitions="3*,1,7*">

        <!-- ── Spalte 0: Instanzliste — geteilter Kontext über alle vier Tabs hinweg ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*">

            <Border Grid.Row="0" Padding="8,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBox Text="{Binding TabKoordinator.Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="🔍  Suchen …" HorizontalAlignment="Stretch" />
            </Border>

            <ToggleSwitch Grid.Row="1" Margin="8,4"
                          OnContent="Vorlagen" OffContent="Turniere"
                          IsOn="{Binding TabKoordinator.NurVorlagenAnzeigen, Mode=TwoWay}" />

            <Rectangle Grid.Row="2" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Height="1" />

            <ListView Grid.Row="3"
                      ItemsSource="{Binding TabKoordinator.InstanzenGefiltert}"
                      SelectedItem="{Binding TabKoordinator.AusgewaehlteInstanz, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="{Binding Status}" />
                                <Run Text=" · " />
                                <Run Text="{Binding SaisonOderJahr}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Spalte 2: Pivot mit Turnierkopf-, Runden-, Übergänge- und Vorbelegung-Tab ── -->
        <Pivot Grid.Column="2" SelectedIndex="{Binding TabKoordinator.AktiverTabIndex, Mode=TwoWay}">
            <PivotItem Header="Turnierkopf">
                <views:TurnierkopfPage DataContext="{Binding TurnierkopfVm}" />
            </PivotItem>
            <PivotItem Header="Runden" IsEnabled="{Binding RundenTabAktiv}">
                <views:RundenPage DataContext="{Binding RundenVm}" />
            </PivotItem>
            <PivotItem Header="Übergänge" IsEnabled="{Binding RundenTabAktiv}">
                <views:RundenUebergaengePage DataContext="{Binding RundenUebergaengeVm}" />
            </PivotItem>
            <PivotItem Header="Vorbelegung" IsEnabled="{Binding RundenTabAktiv}">
                <views:VorbelegungPage DataContext="{Binding VorbelegungVm}" />
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
