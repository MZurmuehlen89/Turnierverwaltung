<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurnierdurchfuehrungPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <Grid RowDefinitions="Auto,*">

        <!-- ── Kompakte Kopfzeile statt permanenter Instanzliste (Nutzerfeedback #300-Test: nahm zu viel
             Platz ein) — Precedent: WPF TurnierAuswahlView/TurnierAuswahlDialog. Auswahl geteilt mit
             "Turniere" über AusgewaehlteTurnierInstanzService. ── -->
        <Border Grid.Row="0" Padding="16,10"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Turnier:" VerticalAlignment="Center" Opacity="0.6" />
                <Button Command="{Binding TurnierWaehlenCommand}">
                    <TextBlock Text="{Binding TabKoordinator.AusgewaehlteInstanz.Name, TargetNullValue='Kein Turnier gewählt'}"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Auslosung-, Spielplan & Baum- und Simulation-Tab (Platzhalter, folgen in #301/#302) ── -->
        <Pivot Grid.Row="1" SelectedIndex="{Binding TabKoordinator.AktiverTabIndex, Mode=TwoWay}">
            <PivotItem Header="Auslosung">
                <views:AuslosungPage DataContext="{Binding AuslosungTab}" />
            </PivotItem>
            <PivotItem Header="Spielplan &amp; Baum">
                <views:PlatzhalterPage DataContext="{Binding SpielplanUndBaumTab}" />
            </PivotItem>
            <PivotItem Header="Simulation">
                <views:PlatzhalterPage DataContext="{Binding SimulationTab}" />
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
