<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.RanglistenImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Reiter „Import“ der Ranglisten-Seite (#477, vorher Dialog aus #285). Spaltenaufteilung wie die anderen
         Reiter: Quellenliste | Import | Meldungsspalte. „Import ausführen“ steht nur in der Befehlsleiste. -->
    <Grid ColumnDefinitions="2.4*,1,5.7*,1,1.9*">

        <!-- ── Quellen ── -->
        <ListView Grid.Column="0"
                  ItemsSource="{Binding Quellen}"
                  SelectedItem="{Binding QuelleAuswahl, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Import ── -->
        <StackPanel Grid.Column="2"
                    Visibility="{Binding QuelleGewaehlt, Converter={StaticResource InverseBoolToVisibility}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
            <TextBlock Text="⬇" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="Quelle auswählen und" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Text="„Abrufen“ klicken" FontSize="14" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Kein äußerer ScrollViewer: nur die Tabelle scrollt (und virtualisiert, auch bei Hunderten Zeilen). -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" Margin="28,20,28,16"
              Visibility="{Binding QuelleGewaehlt, Converter={StaticResource BoolToVisibility}}">

            <!-- ── Quelle ── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="QUELLE" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />
                <Grid ColumnDefinitions="*,8,Auto,8,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AusgewaehlteQuelle.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AusgewaehlteQuelle.Url}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Quelle bearbeiten" Command="{Binding QuelleBearbeitenCommand}" />
                    <Button Grid.Column="4" Content="Abrufen" Command="{Binding AbrufenCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                             Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- ── Ziel ── -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16"
                        Visibility="{Binding VorschauVorhanden, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="ZIEL" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />
                <Grid ColumnDefinitions="Auto,16,*" Margin="0,0,0,12">
                    <RadioButton Content="Neue Rangliste anlegen" GroupName="ImportZiel"
                                 IsChecked="{Binding NeueRanglisteErstellen, Mode=TwoWay}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <RadioButton Content="Bestehende aktualisieren:" GroupName="ImportZiel"
                                     IsChecked="{Binding BestehendeAktualisieren, Mode=TwoWay}" />
                        <ComboBox ItemsSource="{Binding VorhandeneRanglisten}"
                                  SelectedItem="{Binding ZielRangliste, Mode=TwoWay}"
                                  DisplayMemberPath="Name" MinWidth="240" PlaceholderText="Rangliste wählen …"
                                  IsEnabled="{Binding BestehendeAktualisieren}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,16,Auto" RowDefinitions="Auto,12,Auto">
                    <StackPanel>
                        <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <!-- Deutsches Format und deutscher Kalender wie im Reiter „Ranglisten“. -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Datum" FontSize="12" Margin="0,0,0,3" />
                        <CalendarDatePicker Date="{Binding Datum, Mode=TwoWay}" Width="160"
                                            Language="de-DE" FirstDayOfWeek="Monday"
                                            DateFormat="{}{day.integer(2)}.{month.integer(2)}.{year.full}"
                                            PlaceholderText="TT.MM.JJJJ" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Text="Quelle (Anzeigetext)" FontSize="12" Margin="0,0,0,3" />
                        <TextBox Text="{Binding QuelleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── Tabellenkopf: Zusammenfassung, Filter, Spaltenköpfe ── -->
            <StackPanel Grid.Row="2"
                        Visibility="{Binding VorschauVorhanden, Converter={StaticResource BoolToVisibility}}">
                <Grid ColumnDefinitions="Auto,16,*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="ZEILEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding ZusammenfassungText}" FontSize="12" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <CheckBox Grid.Column="3" Content="Nur nicht erkannte" IsChecked="{Binding NurNichtErkannte, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnDefinitions="48,*,70,120,2*" Padding="12,0,12,4">
                    <TextBlock Text="#" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="Name in der Quelle" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="Punkte" FontSize="11" FontWeight="SemiBold" Opacity="0.6"
                               HorizontalAlignment="Right" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" Text="Status" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="4" Text="Mannschaft" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                </Grid>
            </StackPanel>

            <!-- ── Tabelle: alle Zeilen in Quellreihenfolge ── -->
            <Border Grid.Row="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding VorschauVorhanden, Converter={StaticResource BoolToVisibility}}">
                <ListView ItemsSource="{Binding ZeilenAnzeige}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,3">
                                <Grid ColumnDefinitions="48,*,70,120,2*" MinHeight="32">
                                    <TextBlock Text="{Binding Nummer}" VerticalAlignment="Center" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="{Binding Quelle.RohName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Quelle.RohName}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PunkteText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                               Opacity="{Binding StatusDeckkraft}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Erkannt.Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IstAutomatisch, Converter={StaticResource BoolToVisibility}}" />
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding Optionen}"
                                              SelectedItem="{Binding Auswahl, Mode=TwoWay}"
                                              DisplayMemberPath="Anzeige" HorizontalAlignment="Stretch"
                                              Visibility="{Binding IstNichtErkannt, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <!-- Inline-Schnell-Anlegen (Issue #227/#285) statt separatem Dialog -->
                                <Border Visibility="{Binding NeuAnlegenAktiv, Converter={StaticResource BoolToVisibility}}"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="10" Margin="48,6,0,6">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,8,*">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Name" FontSize="11" Opacity="0.6" />
                                                <TextBox Text="{Binding NeuName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Kürzel" FontSize="11" Opacity="0.6" />
                                                <TextBox Text="{Binding NeuKurzname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <RadioButton Content="Nationalmannschaft"
                                                         IsChecked="{Binding NeuIstNationalmannschaft, Mode=TwoWay}" />
                                            <RadioButton Content="Verein"
                                                         IsChecked="{Binding NeuIstVerein, Mode=TwoWay}" />
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding Laender}"
                                                  SelectedItem="{Binding NeuLand, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" PlaceholderText="Land wählen…"
                                                  HorizontalAlignment="Stretch" />

                                        <TextBlock Text="{Binding NeuFehler}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding NeuFehler, Converter={StaticResource NullToCollapsed}}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button Content="Abbrechen" Command="{Binding NeuAnlegenAbbrechenCommand}" />
                                            <Button Content="Anlegen" Command="{Binding MannschaftAnlegenCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Meldungsspalte ── -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,20,12,12" Spacing="6">
                <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="4" Padding="8,6">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="11" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Nicht erkannte Zeilen stehen auf „bitte zuordnen“. Offene und übersprungene Zeilen werden nicht importiert; der Rang ergibt sich aus der Reihenfolge der übrigen."
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                           Visibility="{Binding VorschauVorhanden, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
