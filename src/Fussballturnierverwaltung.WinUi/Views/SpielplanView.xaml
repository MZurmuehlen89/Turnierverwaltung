<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielplanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <UserControl.Resources>
        <Style x:Key="SpielKopfzeileTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style x:Key="ErgebnisZeilenTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SpielKopfzeileTextStyle}">
            <Setter Property="Width" Value="130" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ErgebnisToreTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ErgebnisDoppelpunktStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*">

        <!-- ── Spalte 0: Mannschaft (#479) und Runden ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <TextBlock Grid.Row="0" Text="MANNSCHAFT" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="12,10,8,4" />
            <views:MannschaftsAuswahlBox Grid.Row="1" Margin="8,0,8,4" DataContext="{Binding Mannschaftsfilter}"
                                         PlaceholderText="Alle Mannschaften"
                                         ToolTipService.ToolTip="Alle Spiele einer Mannschaft über alle Runden anzeigen"
                                         Bestaetigt="MannschaftsAuswahl_Bestaetigt" />
            <TextBlock Grid.Row="2" Text="RUNDEN" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="12,10,8,4" />
            <ListView Grid.Row="3" ItemsSource="{Binding Runden}" AutomationProperties.AutomationId="Spielplan.Runden"
                      SelectedItem="{Binding RundenlistenAuswahl, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13" Padding="0,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ── Spalte 1: Spielliste, darunter die Ergebnis-Leiste (#391) ── -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <TextBlock Text="Bitte ein Turnier und eine Runde oder eine Mannschaft auswählen."
                       Opacity="0.5" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ZeigtSpielliste, Converter={StaticResource InverseBoolToVisibility}}" />


            <Grid RowDefinitions="Auto,Auto,*" Visibility="{Binding ZeigtSpielliste, Converter={StaticResource BoolToVisibility}}">

                <!-- Kopfzeile -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Opacity="0.6">
                        <Run Text="SPIELE · " />
                        <Run Text="{Binding KopfzeilenTitel}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Spiele.Count}" />
                        <Run Text=" Spiel(e)" />
                        <Run Text="{Binding KopfzeilenHinweis}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{Binding ZeigtSchweizerRundenSteuerung, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SchweizerFortschrittsText}" AutomationProperties.AutomationId="Spielplan.SchweizerFortschritt"
                                   FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <Button Content="{Binding NaechsteSchweizerRundeLabel}" Command="{Binding NaechsteSchweizerRundeBefehl}"
                                AutomationProperties.AutomationId="Spielplan.NaechsterSpieltag" FontSize="11" Padding="8,3" />
                    </StackPanel>
                </Grid>

                <!-- Fehlermeldung -->
                <Border Grid.Row="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="4" Padding="10,7" Margin="12,8,12,0"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2">

                    <!-- ── Gesamtliste ── -->
                    <Grid RowDefinitions="Auto,*" Visibility="{Binding ZeigtGesamtliste, Converter={StaticResource BoolToVisibility}}">
                        <Grid Grid.Row="0" ColumnDefinitions="46,40,40,*,110,*,90" Padding="8,6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Grid.Column="0" Text="ST" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Nr" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Gr." Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Heim" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Ergebnis" Style="{StaticResource SpielKopfzeileTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Auswärts" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource SpielKopfzeileTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="1" x:Name="SpielListView" AutomationProperties.AutomationId="Spielplan.Spiele"
                                  ItemsSource="{Binding Spiele}" SelectedItem="{Binding AusgewaehlteSpiel, Mode=TwoWay}"
                                  SelectionMode="Extended" SelectionChanged="SpielListView_SelectionChanged"
                                  ContextRequested="SpielListView_ContextRequested">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="46,40,40,*,110,*,90" RowDefinitions="Auto,Auto" Padding="8,4" Margin="{Binding PaarungsAbstand}">
                                        <TextBlock Grid.Column="0" Text="{Binding SpieltagAnzeige}" AutomationProperties.AutomationId="Spiel.Kennung" FontSize="12" Opacity="0.6" />
                                        <TextBlock Grid.Column="1" Text="{Binding Spielnummer}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="{Binding GruppeAnzeige}" FontSize="11" Opacity="0.6" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding HeimName}" AutomationProperties.AutomationId="Spiel.Heim" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding ErgebnisText}" AutomationProperties.AutomationId="Spiel.Ergebnis" FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding ErgebnisDetail}" AutomationProperties.AutomationId="Spiel.ErgebnisZusatz" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding AuswaertsName}" AutomationProperties.AutomationId="Spiel.Auswaerts" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="6" Text="{Binding StatusAnzeige}" AutomationProperties.AutomationId="Spiel.Status" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                        <!-- Issue #340: Gesamtergebnis unter dem K.-o.-Rückspiel, zentriert unter der Ergebnis-Spalte. -->
                                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Text="{Binding GesamtText}"
                                                   FontSize="11" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   Visibility="{Binding HatGesamtText, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- ── Auf Gruppe/Spieltag fokussierte Liste (Issue #141/#246; Spieltag-Blättern für alle
                         Rundenarten mit Spieltagen, Vorbild kicker.de: ‹ [n. Spieltag ▾] ›, Issue #363) ── -->
                    <Grid RowDefinitions="Auto,Auto,*" Visibility="{Binding ZeigeFokusListe, Converter={StaticResource BoolToVisibility}}">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="12,8"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        Visibility="{Binding IstGefiltertAufGruppe, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="✕ Filter aufheben" Command="{Binding ZurueckZurUebersichtBefehl}" FontSize="11" Padding="8,4" />
                                <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13">
                                    <Run Text="Gruppe " />
                                    <Run Text="{Binding AusgewaehlteGruppe.GruppenNummer}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{Binding Fokus.HatMehrereSpieltage, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="&#x2039;" Command="{Binding Fokus.VorigerSpieltagBefehl}" FontSize="16" Padding="10,0,10,2"
                                        ToolTipService.ToolTip="Voriger Spieltag" />
                                <ComboBox ItemsSource="{Binding Fokus.Optionen}" DisplayMemberPath="Anzeige"
                                          AutomationProperties.AutomationId="Spielplan.Spieltag"
                                          SelectedItem="{Binding Fokus.AusgewaehlteOption, Mode=TwoWay}"
                                          MinWidth="150" FontWeight="SemiBold" />
                                <Button Content="&#x203A;" Command="{Binding Fokus.NaechsterSpieltagBefehl}" FontSize="16" Padding="10,0,10,2"
                                        ToolTipService.ToolTip="Nächster Spieltag" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="46,40,*,110,*,90" Padding="8,6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Grid.Column="0" Text="ST" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Nr" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Heim" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Ergebnis" Style="{StaticResource SpielKopfzeileTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Auswärts" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource SpielKopfzeileTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="2" x:Name="FokusSpielListView" AutomationProperties.AutomationId="Spielplan.Spiele"
                                  ItemsSource="{Binding Fokus.Spiele}" SelectedItem="{Binding AusgewaehlteSpiel, Mode=TwoWay}"
                                  SelectionMode="Extended" SelectionChanged="SpielListView_SelectionChanged"
                                  ContextRequested="SpielListView_ContextRequested">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="46,40,*,110,*,90" RowDefinitions="Auto,Auto" Padding="8,4">
                                        <!-- Issue #363: Gruppenphase — Zwischenüberschrift über der ersten Partie jeder Gruppe. -->
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="6" Text="{Binding GruppenKopf}"
                                                   FontSize="12" FontWeight="Bold" Margin="0,6,0,4"
                                                   Visibility="{Binding HatGruppenKopf, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SpieltagAnzeige}" AutomationProperties.AutomationId="Spiel.Kennung" FontSize="12" Opacity="0.6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Spielnummer}" FontSize="12" Opacity="0.6" />
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding HeimName}" AutomationProperties.AutomationId="Spiel.Heim" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding ErgebnisText}" AutomationProperties.AutomationId="Spiel.Ergebnis" FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding ErgebnisDetail}" AutomationProperties.AutomationId="Spiel.ErgebnisZusatz" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding AuswaertsName}" AutomationProperties.AutomationId="Spiel.Auswaerts" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding StatusAnzeige}" AutomationProperties.AutomationId="Spiel.Status" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- ── Mannschaftsansicht (#479): alle Spiele einer Mannschaft über alle Runden ── -->
                    <Grid RowDefinitions="Auto,*" Visibility="{Binding IstMannschaftsansicht, Converter={StaticResource BoolToVisibility}}">
                        <Grid Grid.Row="0" ColumnDefinitions="2*,66,40,3*,110,3*,90" Padding="8,6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Grid.Column="0" Text="Runde" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="1" Text="ST" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Nr" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Heim" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Ergebnis" Style="{StaticResource SpielKopfzeileTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Auswärts" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource SpielKopfzeileTextStyle}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="Für diese Mannschaft gibt es im Turnier noch keine Spiele."
                                   Opacity="0.5" FontSize="13" HorizontalAlignment="Center" Margin="0,24,0,0"
                                   Visibility="{Binding ZeigtKeineMannschaftsSpiele, Converter={StaticResource BoolToVisibility}}" />
                        <ListView Grid.Row="1" x:Name="MannschaftsSpielListView" AutomationProperties.AutomationId="Spielplan.Spiele"
                                  ItemsSource="{Binding Spiele}" SelectedItem="{Binding AusgewaehlteSpiel, Mode=TwoWay}"
                                  SelectionMode="Extended" SelectionChanged="SpielListView_SelectionChanged"
                                  ContextRequested="SpielListView_ContextRequested">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*,66,40,3*,110,3*,90" RowDefinitions="Auto,Auto" Padding="8,4">
                                        <TextBlock Grid.Column="0" Text="{Binding RundeAnzeige}" FontSize="12" Opacity="0.75"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SpieltagAnzeige}" AutomationProperties.AutomationId="Spiel.Kennung" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Spielnummer}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" Opacity="{Binding HeimDeckkraft}">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding HeimName}" AutomationProperties.AutomationId="Spiel.Heim" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding ErgebnisText}" AutomationProperties.AutomationId="Spiel.Ergebnis" FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding ErgebnisDetail}" AutomationProperties.AutomationId="Spiel.ErgebnisZusatz" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" Opacity="{Binding AuswaertsDeckkraft}">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding AuswaertsName}" AutomationProperties.AutomationId="Spiel.Auswaerts" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="6" Text="{Binding MannschaftsStatusAnzeige}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Text="{Binding GesamtText}"
                                                   FontSize="11" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   Visibility="{Binding HatGesamtText, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

            <!-- ── Ergebnis-Leiste (#391): unter der Spielliste statt als Spalte neben ihr; bleibt ohne gewähltes
                 Spiel mit Hinweis stehen, damit die Liste beim Wählen nicht springt ── -->
            <Border Grid.Row="1" x:Name="ErgebnisFormular" MinHeight="140"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding ZeigtSpielliste, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <TextBlock Text="Spiel in der Liste oder im Baum auswählen, um das Ergebnis einzugeben."
                               AutomationProperties.AutomationId="Ergebnis.Hinweis"
                               Opacity="0.6" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding FormAktiv, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="24" Padding="16,10"
                          Visibility="{Binding FormAktiv, Converter={StaticResource BoolToVisibility}}">

                        <!-- Links: Paarung und Hinweise zum Spiel -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding Formular.SpielInfo}" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                            <TextBlock FontSize="15" FontWeight="Bold" TextWrapping="Wrap">
                                <Run Text="{Binding Formular.HeimName}" />
                                <Run Text=" – " />
                                <Run Text="{Binding Formular.AuswaertsName}" />
                            </TextBlock>
                            <Border BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,5"
                                    Visibility="{Binding Formular.ZeigtErgebnisHinweis, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Dieses Spiel hat bereits ein Ergebnis. Zum Neu-Simulieren zuerst über 'Löschen' zurücksetzen."
                                           AutomationProperties.AutomationId="Ergebnis.HatErgebnis" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Text="Die Paarung steht noch nicht fest." AutomationProperties.AutomationId="Ergebnis.Platzhalter"
                                       FontSize="12" Opacity="0.7"
                                       Visibility="{Binding Formular.IstPlatzhalterSpiel, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Mitte: Spielstände in der Reihenfolge des Spielverlaufs, unter der Ergebnis-Spalte der Liste -->
                        <StackPanel Grid.Column="1" Spacing="6"
                                    Visibility="{Binding Formular.ZeigtEingabe, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="90 MINUTEN" Style="{StaticResource ErgebnisZeilenTextStyle}" />
                                <TextBox x:Name="ErstesFormularFeld" AutomationProperties.AutomationId="Ergebnis.HeimTore"
                                         Text="{Binding Formular.HeimToreRegulaer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ErgebnisToreTextBoxStyle}" />
                                <TextBlock Text=":" Style="{StaticResource ErgebnisDoppelpunktStyle}" />
                                <TextBox AutomationProperties.AutomationId="Ergebnis.AuswaertsTore"
                                         Text="{Binding Formular.AuswaertsToreRegulaer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ErgebnisToreTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding Formular.VerlaengerungAktiv, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="NACH VERLÄNGERUNG" Style="{StaticResource ErgebnisZeilenTextStyle}" />
                                <TextBox AutomationProperties.AutomationId="Ergebnis.HeimToreVerlaengerung"
                                         Text="{Binding Formular.HeimToreVerlaengerung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ErgebnisToreTextBoxStyle}" />
                                <TextBlock Text=":" Style="{StaticResource ErgebnisDoppelpunktStyle}" />
                                <TextBox AutomationProperties.AutomationId="Ergebnis.AuswaertsToreVerlaengerung"
                                         Text="{Binding Formular.AuswaertsToreVerlaengerung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ErgebnisToreTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding Formular.ElfmeterAktiv, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="ELFMETERSCHIESSEN" Style="{StaticResource ErgebnisZeilenTextStyle}" />
                                <TextBox AutomationProperties.AutomationId="Ergebnis.HeimElfmetertore"
                                         Text="{Binding Formular.HeimElfmetertore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ErgebnisToreTextBoxStyle}" />
                                <TextBlock Text=":" Style="{StaticResource ErgebnisDoppelpunktStyle}" />
                                <TextBox AutomationProperties.AutomationId="Ergebnis.AuswaertsElfmetertore"
                                         Text="{Binding Formular.AuswaertsElfmetertore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ErgebnisToreTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        Visibility="{Binding Formular.LosAktiv, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Formular.LosUeberschrift}" Style="{StaticResource ErgebnisZeilenTextStyle}" />
                                <RadioButton GroupName="Losgewinner" AutomationProperties.AutomationId="Ergebnis.LosHeim"
                                             Content="{Binding Formular.HeimName}" MinWidth="0"
                                             IsChecked="{Binding Formular.LosFuerHeim, Mode=TwoWay}" />
                                <RadioButton GroupName="Losgewinner" AutomationProperties.AutomationId="Ergebnis.LosAuswaerts"
                                             Content="{Binding Formular.AuswaertsName}" MinWidth="0"
                                             IsChecked="{Binding Formular.LosFuerAuswaerts, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Rechts: Silver-Goal-Haken und Live-Prüfung der Eingabe -->
                        <StackPanel Grid.Column="2" Spacing="8">
                            <CheckBox AutomationProperties.AutomationId="Ergebnis.SilverGoal"
                                      IsChecked="{Binding Formular.SilverGoalNachErsterHaelfte, Mode=TwoWay}"
                                      Visibility="{Binding Formular.SilverGoalWaehlbar, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Silver Goal" />
                                    <Run Text="(ohne Häkchen n.V. nach 120 Minuten)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </CheckBox>
                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="4" Padding="10,7"
                                    Visibility="{Binding Formular.EingabeFehler, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="{Binding Formular.EingabeFehler}" AutomationProperties.AutomationId="Ergebnis.Fehler"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
