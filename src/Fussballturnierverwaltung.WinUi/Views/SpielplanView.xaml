<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielplanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SpielKopfzeileTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
    </UserControl.Resources>

    <Grid ColumnDefinitions="220,*,Auto">

        <!-- ── Spalte 0: Runden ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <TextBlock Grid.Row="0" Text="RUNDEN" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="12,10,8,4" />
            <ListView Grid.Row="1" ItemsSource="{Binding Runden}"
                      SelectedItem="{Binding AusgewaehlteRunde, Mode=TwoWay}" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13" Padding="0,4" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ── Spalte 1: Spielliste ── -->
        <Grid Grid.Column="1">
            <TextBlock Text="Bitte ein Turnier und eine Runde auswählen."
                       Opacity="0.5" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding HatRunde, Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- Busy-Indikator während "Runde simulieren" (Nutzerwunsch: kann bei vielen Spielen länger
                 dauern, IstSimulierend existierte bereits im ViewModel, war aber in keiner View gebunden). -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,10,16,0" Visibility="{Binding IstSimulierend, Converter={StaticResource BoolToVisibility}}">
                <ProgressRing IsActive="{Binding IstSimulierend}" Width="18" Height="18" />
                <TextBlock Text="Simuliert …" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>

            <Grid RowDefinitions="Auto,Auto,*" Visibility="{Binding HatRunde, Converter={StaticResource BoolToVisibility}}">

                <!-- Kopfzeile -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Opacity="0.6">
                        <Run Text="SPIELE · " />
                        <Run Text="{Binding AusgewaehlteRunde.Name}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Spiele.Count}" />
                        <Run Text=" Spiel(e)" />
                        <Run Text="{Binding RundenHinweis}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{Binding ZeigtSchweizerRundenSteuerung, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding SchweizerFortschrittsText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                        <Button Content="{Binding NaechsteSchweizerRundeLabel}" Command="{Binding NaechsteSchweizerRundeBefehl}" FontSize="11" Padding="8,3" />
                    </StackPanel>
                </Grid>

                <!-- Fehlermeldung -->
                <Border Grid.Row="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="4" Padding="10,7" Margin="12,8,12,0"
                        Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="2">

                    <!-- ── Gesamtliste ── -->
                    <Grid RowDefinitions="Auto,*" Visibility="{Binding ZeigeFokusListe, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid Grid.Row="0" ColumnDefinitions="46,40,40,*,110,*,90" Padding="8,6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Grid.Column="0" Text="ST" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Nr" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Gr." Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Heim" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Ergebnis" Style="{StaticResource SpielKopfzeileTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Auswärts" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource SpielKopfzeileTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="1" x:Name="SpielListView"
                                  ItemsSource="{Binding Spiele}" SelectedItem="{Binding AusgewaehlteSpiel, Mode=TwoWay}"
                                  SelectionMode="Extended" SelectionChanged="SpielListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="46,40,40,*,110,*,90" RowDefinitions="Auto,Auto" Padding="8,4" Margin="{Binding PaarungsAbstand}">
                                        <TextBlock Grid.Column="0" Text="{Binding SpieltagAnzeige}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Grid.Column="1" Text="{Binding Spielnummer}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="{Binding GruppeAnzeige}" FontSize="11" Opacity="0.6" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding HeimName}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding ErgebnisText}" FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding ErgebnisDetail}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding AuswaertsName}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="6" Text="{Binding StatusAnzeige}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                        <!-- Issue #340: Gesamtergebnis unter dem K.-o.-Rückspiel, zentriert unter der Ergebnis-Spalte. -->
                                        <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Text="{Binding GesamtText}"
                                                   FontSize="11" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   Visibility="{Binding HatGesamtText, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- ── Auf Gruppe/Spieltag fokussierte Liste (Issue #141/#246; Spieltag-Blättern für alle
                         Rundenarten mit Spieltagen, Vorbild kicker.de: ‹ [n. Spieltag ▾] ›, Issue #363) ── -->
                    <Grid RowDefinitions="Auto,Auto,*" Visibility="{Binding ZeigeFokusListe, Converter={StaticResource BoolToVisibility}}">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Padding="12,8"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        Visibility="{Binding IstGefiltertAufGruppe, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="✕ Filter aufheben" Command="{Binding ZurueckZurUebersichtBefehl}" FontSize="11" Padding="8,4" />
                                <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="13">
                                    <Run Text="Gruppe " />
                                    <Run Text="{Binding AusgewaehlteGruppe.GruppenNummer}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{Binding Fokus.HatMehrereSpieltage, Converter={StaticResource BoolToVisibility}}">
                                <Button Content="&#x2039;" Command="{Binding Fokus.VorigerSpieltagBefehl}" FontSize="16" Padding="10,0,10,2"
                                        ToolTipService.ToolTip="Voriger Spieltag" />
                                <ComboBox ItemsSource="{Binding Fokus.Optionen}" DisplayMemberPath="Anzeige"
                                          SelectedItem="{Binding Fokus.AusgewaehlteOption, Mode=TwoWay}"
                                          MinWidth="150" FontWeight="SemiBold" />
                                <Button Content="&#x203A;" Command="{Binding Fokus.NaechsterSpieltagBefehl}" FontSize="16" Padding="10,0,10,2"
                                        ToolTipService.ToolTip="Nächster Spieltag" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="46,40,*,110,*,90" Padding="8,6"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Grid.Column="0" Text="ST" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Nr" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Heim" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Ergebnis" Style="{StaticResource SpielKopfzeileTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Auswärts" Style="{StaticResource SpielKopfzeileTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Status" Style="{StaticResource SpielKopfzeileTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="2" x:Name="FokusSpielListView"
                                  ItemsSource="{Binding Fokus.Spiele}" SelectedItem="{Binding AusgewaehlteSpiel, Mode=TwoWay}"
                                  SelectionMode="Extended" SelectionChanged="SpielListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="46,40,*,110,*,90" RowDefinitions="Auto,Auto" Padding="8,4">
                                        <!-- Issue #363: Gruppenphase — Zwischenüberschrift über der ersten Partie jeder Gruppe. -->
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="6" Text="{Binding GruppenKopf}"
                                                   FontSize="12" FontWeight="Bold" Margin="0,6,0,4"
                                                   Visibility="{Binding HatGruppenKopf, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding SpieltagAnzeige}" FontSize="12" Opacity="0.6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Spielnummer}" FontSize="12" Opacity="0.6" />
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding HeimName}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding ErgebnisText}" FontSize="14" FontWeight="Bold" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding ErgebnisDetail}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="5">
                                            <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                                                   Width="16" Height="16" Stretch="Uniform" />
                                            <TextBlock Text="{Binding AuswaertsName}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding StatusAnzeige}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <!-- ── Spalte 2: Ergebnis-Formular ── -->
        <Border Grid.Column="2" x:Name="ErgebnisFormular" Width="310"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding FormAktiv, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14">

                    <TextBlock Text="{Binding Formular.SpielInfo}" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
                    <TextBlock FontSize="15" FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap">
                        <Run Text="{Binding Formular.HeimName}" />
                        <Run Text=" vs. " />
                        <Run Text="{Binding Formular.AuswaertsName}" />
                    </TextBlock>

                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="REGULÄRE SPIELZEIT" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="0,0,0,6" />
                    <Grid ColumnDefinitions="*,20,*" Margin="0,0,0,12">
                        <TextBox Grid.Column="0" x:Name="ErstesFormularFeld" Text="{Binding Formular.HeimToreRegulaer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=":" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Formular.AuswaertsToreRegulaer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" FontWeight="Bold" TextAlignment="Center" />
                    </Grid>

                    <TextBlock Text="HALBZEITSTAND (OPTIONAL)" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="0,0,0,6" />
                    <Grid ColumnDefinitions="*,20,*" Margin="0,0,0,12">
                        <TextBox Grid.Column="0" Text="{Binding Formular.HeimHalbzeitTore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding Formular.AuswaertsHalbzeitTore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                    </Grid>

                    <StackPanel Visibility="{Binding Formular.VerlaengerungAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ERGEBNIS NACH VERLÄNGERUNG" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,20,*" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" Text="{Binding Formular.HeimToreVerlaengerung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding Formular.AuswaertsToreVerlaengerung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Visibility="{Binding Formular.ElfmeterAktiv, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ELFMETER" Style="{StaticResource SpielKopfzeileTextStyle}" Margin="0,0,0,6" />
                        <Grid ColumnDefinitions="*,20,*" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" Text="{Binding Formular.HeimElfmetertore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding Formular.AuswaertsElfmetertore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Border BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,7" Margin="0,0,0,12"
                            Visibility="{Binding Formular.HatErgebnis, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Dieses Spiel hat bereits ein Ergebnis. Zum Neu-Simulieren zuerst über 'Löschen' zurücksetzen."
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
