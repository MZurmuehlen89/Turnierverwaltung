<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielberichtControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views"
    x:Name="Wurzel">

    <!-- Issue #237/#302: vereinheitlichte Spielbericht-Karte. Der Karteninhalt liegt seit #247 in
         SpielberichtKarte; dieses Control ergänzt den Leer-Zustand. -->

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <views:SpielberichtKarte />

        <!-- Leer-Zustand -->
        <TextBlock Text="{Binding LeerZustandText, ElementName=Wurzel}"
                   Opacity="0.5" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="340" TextAlignment="Center"
                   Visibility="{Binding ZeigeLeerZustand, Converter={StaticResource BoolToVisibility}}" />

    </Grid>
</UserControl>
