<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielberichtControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views"
    x:Name="Wurzel">

    <!-- Issue #237/#302: vereinheitlichte Spielbericht-Karte. Der Karteninhalt liegt seit #247 in
         SpielberichtKarte; dieses Control ergänzt den Leer-Zustand. -->

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- Wrapper tragen die Visibility: am Element mit eigenem DataContext liefe die Bindung gegen die Ansicht.
             #247: das Wiederholungsspiel hat eine eigene Uhr und steht als zweite Karte neben dem Spiel; das
             SpaltenPanel stellt sie bei schmaler Fläche untereinander und schaltet dafür den Bildlauf um. -->
        <Grid Visibility="{Binding HatProtokoll, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Disabled">
                <views:SpaltenPanel>
                    <Grid>
                        <views:SpielberichtKarte DataContext="{Binding Protokoll}" AutomationProperties.AutomationId="Spielbericht.Spiel" />
                    </Grid>
                    <Grid Visibility="{Binding HatProtokollWiederholung, Converter={StaticResource BoolToVisibility}}">
                        <views:SpielberichtKarte DataContext="{Binding ProtokollWiederholung}"
                                                 AutomationProperties.AutomationId="Spielbericht.Wiederholungsspiel" />
                    </Grid>
                </views:SpaltenPanel>
            </ScrollViewer>
        </Grid>

        <!-- Leer-Zustand -->
        <TextBlock Text="{Binding LeerZustandText, ElementName=Wurzel}"
                   Opacity="0.5" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="340" TextAlignment="Center"
                   Visibility="{Binding ZeigeLeerZustand, Converter={StaticResource BoolToVisibility}}" />

    </Grid>
</UserControl>
