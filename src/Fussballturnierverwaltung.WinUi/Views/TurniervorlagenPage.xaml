<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.TurniervorlagenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <Grid ColumnDefinitions="3*,1,7*">

        <!-- ── Spalte 0: Vorlagenliste — geteilter Kontext über beide Tabs hinweg ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <Border Grid.Row="0" Padding="8,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBox Text="{Binding TabKoordinator.Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="🔍  Suchen …" HorizontalAlignment="Stretch" />
            </Border>

            <ListView Grid.Row="2"
                      ItemsSource="{Binding TabKoordinator.VorlagenGefiltert}"
                      SelectedItem="{Binding TabKoordinator.AusgewaehlteVorlage, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="{Binding VorlagenKategorie}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ErforderlicheMannschaftsanzahl}" />
                                <Run Text=" Teams" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Spalte 2: Pivot mit Turnierkopf- und Runden&Übergänge-Tab ── -->
        <Pivot Grid.Column="2" SelectedIndex="{Binding TabKoordinator.AktiverTabIndex, Mode=TwoWay}">
            <PivotItem Header="Turnierkopf">
                <views:TurnierkopfPage DataContext="{Binding TurnierkopfVm}" />
            </PivotItem>
            <PivotItem Header="Runden" IsEnabled="{Binding RundenTabAktiv}">
                <views:VorlagenRundenPage DataContext="{Binding RundenVm}" />
            </PivotItem>
            <PivotItem Header="Übergänge" IsEnabled="{Binding RundenTabAktiv}">
                <views:VorlagenRundenUebergaengePage DataContext="{Binding RundenUebergaengeVm}" />
            </PivotItem>
            <PivotItem Header="Vorbelegung" IsEnabled="{Binding RundenTabAktiv}">
                <views:VorlagenPaarungenPage DataContext="{Binding PaarungenVm}" />
            </PivotItem>
        </Pivot>
    </Grid>
</UserControl>
