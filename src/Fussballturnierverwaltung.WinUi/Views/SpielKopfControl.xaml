<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielKopfControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Issue #341: Spielkopf nach kicker.de-Vorbild (DataContext = vm:SpielKopf) — Kontextzeile über der
         Ergebnis-Box, links/rechts großes Wappen mit Teamname und Untertitel, in der Mitte die Box mit
         Ergebnis, Entscheidungsart und abgesetztem Zwischenstands-Streifen. Gemeinsam genutzt von
         SpielberichtControl (Einzelspiel/Turnier-Simulation) und den Hinspiel-/Rückspiel-Karten. -->

    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*" ColumnSpacing="16">

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Kontext}" AutomationProperties.AutomationId="SpielKopf.Kontext"
                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,0,6"
                   Visibility="{Binding HatKontext, Converter={StaticResource BoolToVisibility}}" />

        <!-- Heimteam -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Image Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" />
                <TextBlock Text="🏳" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"
                           Visibility="{Binding HeimWappen, Converter={StaticResource NullToVisible}}" />
            </Grid>
            <TextBlock Text="{Binding HeimName}" AutomationProperties.AutomationId="SpielKopf.HeimName" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HeimUntertitel}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"
                       Visibility="{Binding HatHeimUntertitel, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Ergebnis-Box -->
        <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" MinWidth="120" CornerRadius="4"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel>
                <StackPanel Padding="14,6,14,6">
                    <TextBlock Text="{Binding Score}" AutomationProperties.AutomationId="SpielKopf.Score" FontSize="30" FontWeight="Bold" FontFamily="Consolas"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Entscheidung}" AutomationProperties.AutomationId="SpielKopf.Entscheidung" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Visibility="{Binding HatEntscheidung, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" Padding="10,3" CornerRadius="0,0,4,4"
                        Visibility="{Binding HatZwischenstaende, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Zwischenstaende}" AutomationProperties.AutomationId="SpielKopf.Zwischenstaende" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Auswärtsteam -->
        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Image Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                       Stretch="Uniform" />
                <TextBlock Text="🏳" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"
                           Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToVisible}}" />
            </Grid>
            <TextBlock Text="{Binding AuswaertsName}" AutomationProperties.AutomationId="SpielKopf.AuswaertsName" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AuswaertsUntertitel}" FontSize="11" Opacity="0.6" HorizontalAlignment="Center"
                       Visibility="{Binding HatAuswaertsUntertitel, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
