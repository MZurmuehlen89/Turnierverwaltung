<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.SpielplanUndBaumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <Grid RowDefinitions="Auto,*">

        <!-- Fortschrittsanzeige -->
        <Border Grid.Row="0" Padding="12,8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding FortschrittAnzeige, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding FortschrittAnzeige}" FontSize="12" VerticalAlignment="Center" />
        </Border>

        <!-- Split-Ansicht: Spielplan links | Turnierbaum rechts (feste 600px-Breite, entfällt bei
             nur einer Runde ohne Tabellendarstellung, siehe SpielplanUndBaumViewModel.ZeigeSplitAnsicht) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">

            <views:SpielplanView Grid.Column="0" DataContext="{Binding SpielplanVm}" />

            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding ZeigeSplitAnsicht, Converter={StaticResource BoolToVisibility}}" />

            <Border Grid.Column="2" Width="600"
                    Visibility="{Binding ZeigeSplitAnsicht, Converter={StaticResource BoolToVisibility}}">
                <views:TurnierBaumView DataContext="{Binding TurnierBaumVm}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
