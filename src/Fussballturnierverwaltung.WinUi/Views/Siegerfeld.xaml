<?xml version="1.0" encoding="utf-8" ?>
<!-- Siegerfeld des Turnierbaums (#527): Pokal, Wappen und Name des Turniersiegers auf goldenem Grund. Solange der Sieger
     offen ist, ein gestrichelter neutraler Rahmen mit blassem Pokal. Steht in der Gesamtübersicht über dem Finale, in der
     rundenweisen Ansicht unter der Finalkarte. DataContext: SiegerfeldAnzeige. -->
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.Siegerfeld"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels">

    <Grid x:DataType="vm:SiegerfeldAnzeige">
        <Border CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource SiegerFarbeBrush}" Background="{ThemeResource SiegerHintergrundBrush}"
                Visibility="{Binding IstEntschieden, Converter={StaticResource BoolToVisibility}}" />
        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1" StrokeDashArray="4,3"
                   Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                   Visibility="{Binding IstEntschieden, Converter={StaticResource InverseBoolToVisibility}}" />

        <StackPanel Spacing="4" Padding="10,8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Viewbox Width="26" Height="26" Opacity="{Binding PokalDeckkraft}">
                <Canvas Width="24" Height="24">
                    <Path Data="M7,4 H17 V9 A5,5 0 0 1 7,9 Z" Fill="{ThemeResource SiegerFarbeBrush}" Opacity="0.2" />
                    <Path Data="M7,4 H17 V9 A5,5 0 0 1 7,9 Z M7,6 H4 V7.5 A3.5,3.5 0 0 0 7.5,11 M17,6 H20 V7.5 A3.5,3.5 0 0 1 16.5,11 M12,14 V18 M8.5,20 H15.5 M10,18 H14"
                          Stroke="{ThemeResource SiegerFarbeBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        Visibility="{Binding IstEntschieden, Converter={StaticResource BoolToVisibility}}">
                <Image Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                       Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                       Width="18" Height="18" Stretch="Uniform" />
                <TextBlock Text="{Binding SiegerName}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="Turnierbaum.Turniersieger" />
            </StackPanel>

            <TextBlock Text="{Binding Untertitel}" FontSize="11" Opacity="0.7" TextAlignment="Center"
                       HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </Grid>
</UserControl>
