<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.RanglistenBereichPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- Seite „Ranglisten“ (#477): Reiter statt Dialoge, jeder Reiter behält seinen Zustand beim Wechsel. -->
    <Pivot SelectedIndex="{Binding AktiverTabIndex, Mode=TwoWay}">
        <PivotItem Header="Ranglisten">
            <views:RanglistenPage DataContext="{Binding Ranglisten}" />
        </PivotItem>
        <PivotItem Header="Quellen">
            <views:RanglistenQuellenPage DataContext="{Binding Quellen}" />
        </PivotItem>
    </Pivot>
</UserControl>
