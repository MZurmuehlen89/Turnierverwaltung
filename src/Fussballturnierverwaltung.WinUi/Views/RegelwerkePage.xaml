<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.RegelwerkePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Fussballturnierverwaltung.WinUi.Converters">

    <UserControl.Resources>
        <conv:VerfahrenArtZuTextConverter x:Key="VerfahrenArtZuText" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="3*,1,2*">

        <!-- ── Linke Spalte: Suche + Liste ── -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto">

            <Border Grid.Row="0" Padding="8,6"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <TextBox AutomationProperties.AutomationId="Regelwerke.Suche"
                         Text="{Binding Suchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="🔍  Suchen …" HorizontalAlignment="Stretch" />
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                         Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />

            <ListView Grid.Row="2"
                      AutomationProperties.AutomationId="Regelwerke.Liste"
                      ItemsSource="{Binding RegelwerkeGefiltert}"
                      SelectedItem="{Binding Ausgewaehltes, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock AutomationProperties.AutomationId="Regelwerke.ListeName"
                                       Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock FontSize="11" Opacity="0.6">
                                <Run Text="S:" /><Run Text="{Binding PunkteRegeln[0].PunkteFuerSieg}" />
                                <Run Text=" U:" /><Run Text="{Binding PunkteRegeln[0].PunkteFuerUnentschieden}" />
                                <Run Text=" N:" /><Run Text="{Binding PunkteRegeln[0].PunkteFuerNiederlage}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Datensatzanzahl (#366): einheitliche Fußzeile in allen Stammdaten-Editoren -->
            <Border Grid.Row="3" Padding="8,4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding AnzahlText}" FontSize="11" Opacity="0.6" />
            </Border>
        </Grid>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Rechte Spalte: Formular ── -->
        <Grid Grid.Column="2" ColumnDefinitions="3*,1*">

            <StackPanel Grid.ColumnSpan="2"
                        Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" />
                <TextBlock Text="Regelwerk auswählen oder" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="&quot;Neu&quot; in der Befehlsleiste klicken" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Column="0"
                          Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,28" HorizontalAlignment="Stretch">

                    <!-- BASISDATEN -->
                    <TextBlock Text="BASISDATEN" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                    <TextBlock Text="Name" FontSize="12" Margin="0,0,0,3" />
                    <TextBox AutomationProperties.AutomationId="Regelwerke.Name"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                    <TextBlock Text="Beschreibung" FontSize="12" Margin="0,0,0,3" />
                    <TextBox Text="{Binding Beschreibung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Stretch" Margin="0,0,0,12"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                    <Grid Margin="0,0,0,24" ColumnDefinitions="*,16,*">
                        <StackPanel HorizontalAlignment="Stretch">
                            <TextBlock Text="Gültig von (Jahr)" FontSize="12" Margin="0,0,0,3" />
                            <TextBox AutomationProperties.AutomationId="Regelwerke.GueltigVon"
                                     Text="{Binding GueltigVon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Stretch">
                            <TextBlock Text="Gültig bis (Jahr)" FontSize="12" Margin="0,0,0,3" />
                            <TextBox AutomationProperties.AutomationId="Regelwerke.GueltigBis"
                                     Text="{Binding GueltigBis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <!-- PUNKTESYSTEM -->
                    <TextBlock Text="PUNKTESYSTEM" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Sieg" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" AutomationProperties.AutomationId="Regelwerke.PunkteSieg"
                                Value="{Binding PunkteSieg, Mode=TwoWay}"
                                Minimum="0" Maximum="10" StepFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PunkteSieg}"
                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,8" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Unentschieden" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" AutomationProperties.AutomationId="Regelwerke.PunkteUnentschieden"
                                Value="{Binding PunkteUnentschieden, Mode=TwoWay}"
                                Minimum="0" Maximum="10" StepFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PunkteUnentschieden}"
                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,24" ColumnDefinitions="110,*,36">
                        <TextBlock Text="Niederlage" VerticalAlignment="Center" FontSize="13" />
                        <Slider Grid.Column="1" AutomationProperties.AutomationId="Regelwerke.PunkteNiederlage"
                                Value="{Binding PunkteNiederlage, Mode=TwoWay}"
                                Minimum="0" Maximum="10" StepFrequency="1" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding PunkteNiederlage}"
                                   FontSize="13" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- ENTSCHEIDUNGSVERFAHREN -->
                    <TextBlock Text="ENTSCHEIDUNGSVERFAHREN (K.O.)" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8" Margin="0,0,0,24">
                        <StackPanel Spacing="6">
                            <ListView ItemsSource="{Binding AusgewaehlteVerfahren}"
                                      SelectedItem="{Binding MarkiertesVerfahren, Mode=TwoWay}"
                                      Height="120" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource VerfahrenArtZuText}}" FontSize="12" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid ColumnDefinitions="*,8,Auto">
                                <ComboBox ItemsSource="{Binding VerfuegbareVerfahren}"
                                          SelectedItem="{Binding NeuesVerfahren, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource VerfahrenArtZuText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Hinzufügen" Command="{Binding VerfahrenHinzufuegenCommand}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button Content="↑" Command="{Binding VerfahrenHochCommand}" ToolTipService.ToolTip="Nach oben" />
                                <Button Content="↓" Command="{Binding VerfahrenRunterCommand}" ToolTipService.ToolTip="Nach unten" />
                                <Button Content="Entfernen" Command="{Binding VerfahrenEntfernenCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- RANKING-REGELSET: Rangfolge in Liga und Gruppe, Kriterien nur zur Anzeige (#354) -->
                    <TextBlock Text="RANGFOLGE IN LIGA UND GRUPPE" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />

                    <ComboBox ItemsSource="{Binding RankingSetOptionen}"
                              SelectedItem="{Binding AusgewaehltesRankingSet, Mode=TwoWay}"
                              DisplayMemberPath="Anzeige"
                              HorizontalAlignment="Stretch" Margin="0,0,0,8" />

                    <StackPanel Margin="0,0,0,24">
                        <ItemsControl ItemsSource="{Binding RangfolgeKriterien}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="28,*" Margin="0,3">
                                        <TextBlock Text="{Binding Nummer}" FontSize="12" Opacity="0.6" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12" />
                                            <TextBlock Text="{Binding Beschreibung}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Ohne Regelset entscheiden Punkte, Tordifferenz und erzielte Tore."
                                   Visibility="{Binding HatKeinRankingSet, Converter={StaticResource BoolToVisibility}}"
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            CornerRadius="4" Padding="10,8">
                        <TextBlock AutomationProperties.AutomationId="Regelwerke.Fehlermeldung"
                                   Text="{Binding Fehlermeldung}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="12" TextWrapping="Wrap" />
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
