<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.EinzelspielSimulationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels"
    xmlns:dom="using:Fussballturnierverwaltung.Domain.Entitaeten.Stammdaten"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- #289, 1:1-Port aus Wpf/Views/EinzelspielSimulationsView.xaml — linke Spalte Team-Auswahl,
         rechte Spalte vereinheitlichte Spielbericht-Karte (SpielberichtControl, geteilt mit
         SimulationsView aus #302). -->

    <UserControl.Resources>
        <!-- Wappen bzw. bei Nationalmannschaften Landesflagge (Issue #230/#232, Precedent:
             TurnierBaumView.xaml) — Converter berücksichtigen den Flaggen-Fallback, anders als eine
             direkte Mannschaft.Wappen-Bindung. -->
        <DataTemplate x:Key="MannschaftMitWappenTemplate" x:DataType="dom:Mannschaft">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Image Source="{Binding Converter={StaticResource MannschaftZuWappen}}"
                       Visibility="{Binding Converter={StaticResource MannschaftHatWappen}}"
                       Width="16" Height="16" Stretch="Uniform" />
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="260,1,*">

        <!-- ── Linke Spalte: Team-Auswahl ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Margin="14,12" Spacing="0">

                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,10">
                    <ProgressRing IsActive="{Binding IstLadend}" Width="16" Height="16" />
                    <TextBlock Text="Simuliert …" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="HEIMTEAM" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,4,0,4" />
                <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Text="{Binding HeimSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍  Suche…" FontSize="12" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                              SelectedItem="{Binding HeimVerbandFilter, Mode=TwoWay}"
                              DisplayMemberPath="Anzeige" FontSize="12" HorizontalAlignment="Stretch" />
                </Grid>
                <ComboBox ItemsSource="{Binding HeimMannschaftenGefiltert}"
                          SelectedItem="{Binding EinzelspielHeim, Mode=TwoWay}"
                          ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                          FontSize="13" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                <TextBlock Text="AUSWÄRTSTEAM" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Text="{Binding AuswaertsSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍  Suche…" FontSize="12" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                              SelectedItem="{Binding AuswaertsVerbandFilter, Mode=TwoWay}"
                              DisplayMemberPath="Anzeige" FontSize="12" HorizontalAlignment="Stretch" />
                </Grid>
                <ComboBox ItemsSource="{Binding AuswaertsMannschaftenGefiltert}"
                          SelectedItem="{Binding EinzelspielAuswaerts, Mode=TwoWay}"
                          ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                          FontSize="13" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                <TextBlock Text="REGELWERK (OPTIONAL)" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AlleRegelwerke}"
                          SelectedItem="{Binding EinzelspielRegelwerk, Mode=TwoWay}"
                          DisplayMemberPath="Name" FontSize="13" HorizontalAlignment="Stretch" />
                <TextBlock Text="Leer = kein Tiebreaker" FontSize="10" Opacity="0.6" Margin="0,2,0,0" />

                <CheckBox Content="Mit Rückspiel" IsChecked="{Binding EinzelspielMitRueckspiel, Mode=TwoWay}"
                          FontSize="13" Margin="0,14,0,0" />

            </StackPanel>
        </ScrollViewer>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Rechte Spalte: Protokoll-Anzeige ── -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">

            <Border Grid.Row="0" Padding="16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SPIELPROTOKOLL" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                    <TextBlock Text=" · " FontSize="11" FontWeight="Bold" Opacity="0.6"
                               Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding ProtokollSpielInfo}" FontSize="11" FontWeight="Bold"
                               Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="4" Padding="10,7" Margin="16,10,16,0"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <views:SpielberichtControl Grid.Row="2" Margin="16,12,16,16"
                LeerZustandText="Zwei Mannschaften auswählen und auf Simulieren klicken." />

        </Grid>

    </Grid>
</UserControl>
