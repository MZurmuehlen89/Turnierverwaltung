<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.EinzelspielSimulationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Fussballturnierverwaltung.WinUi.ViewModels"
    xmlns:dom="using:Fussballturnierverwaltung.Domain.Entitaeten.Stammdaten"
    xmlns:views="using:Fussballturnierverwaltung.WinUi.Views">

    <!-- #289, 1:1-Port aus Wpf/Views/EinzelspielSimulationsView.xaml — linke Spalte Team-Auswahl,
         rechte Spalte vereinheitlichte Spielbericht-Karte (SpielberichtControl, geteilt mit
         SimulationsView aus #302).

         #248: Bei "Mit Rückspiel" ersetzt eine eigene, kompaktere Protokoll-Darstellung
         (HinRueckProtokollBereich unten) die SpielberichtControl — zwei aufklappbare Karten
         (Hinspiel/Rückspiel, WinUI-Expander) statt einer kombinierten Zeitleiste, da der Spielverlauf
         jetzt je Bein direkt in dessen Karte steht statt in einem gemeinsamen Abschnitt am Ende.
         Bewusst eigene, kleinere Kopie der Zeitleisten-Vorlage aus SpielberichtControl.xaml statt
         Wiederverwendung — SpielberichtControl rendert eine eigene Karte mit großem Scoreboard-Kopf,
         die innerhalb eines Expanders verschachtelt unpassend doppelte Rahmen/Chrome ergäbe. -->

    <UserControl.Resources>
        <!-- Wappen bzw. bei Nationalmannschaften Landesflagge (Issue #230/#232, Precedent:
             TurnierBaumView.xaml) — Converter berücksichtigen den Flaggen-Fallback, anders als eine
             direkte Mannschaft.Wappen-Bindung. -->
        <DataTemplate x:Key="MannschaftMitWappenTemplate" x:DataType="dom:Mannschaft">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Image Source="{Binding Converter={StaticResource MannschaftZuWappen}}"
                       Visibility="{Binding Converter={StaticResource MannschaftHatWappen}}"
                       Width="16" Height="16" Stretch="Uniform" />
                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="MiniTrennerPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Ereignis-Icon je Art, 1:1 aus SpielberichtControl.xaml (eigene Kopie, s. Kommentar oben). -->
        <DataTemplate x:Key="MiniEreignisIconVorlage">
            <Grid Width="13" Height="13">
                <Viewbox Visibility="{Binding IstTor, Converter={StaticResource BoolToVisibility}}">
                    <Canvas Width="24" Height="24">
                        <Ellipse Width="24" Height="24" Stroke="{ThemeResource SystemFillColorSuccessBrush}" StrokeThickness="2" />
                        <Path Data="M12 7l3 2.2-1.1 3.5H10.1L9 9.2z" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                    </Canvas>
                </Viewbox>
                <Rectangle Width="9" Height="12" RadiusX="2" RadiusY="2" Fill="{ThemeResource SystemFillColorCautionBrush}"
                           Visibility="{Binding IstGelbeKarte, Converter={StaticResource BoolToVisibility}}" />
                <Rectangle Width="9" Height="12" RadiusX="2" RadiusY="2" Fill="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="{Binding IstRoteKarte, Converter={StaticResource BoolToVisibility}}" />
                <Viewbox Visibility="{Binding IstElfmeterVerschossen, Converter={StaticResource BoolToVisibility}}">
                    <Canvas Width="24" Height="24">
                        <Ellipse Width="24" Height="24" Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="2" />
                        <Path Data="M9 9l6 6M15 9l-6 6" Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- Eine Zeile der Mini-Zeitleiste innerhalb einer Hinspiel-/Rückspiel-Karte — Mittelachse mit
             Minuten-Pille, Ereignis auf der jeweiligen Team-Seite (kompaktere Kopie des ItemTemplates aus
             SpielberichtControl.xaml, ohne Wappen-Bild — bei freier Simulation zweier beliebiger Teams
             lohnt sich der Bild-Ladeaufwand hier nicht extra je Zeile). -->
        <DataTemplate x:Key="MiniZeitleisteZeileVorlage" x:DataType="vm:EinzelspielEreignisZeile">
            <Grid>
                <Grid Margin="0,4" Visibility="{Binding IstTrenner, Converter={StaticResource InverseBoolToVisibility}}"
                      ColumnDefinitions="*,40,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IstHeimSeite, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Art}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6" HorizontalAlignment="Right"
                                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <ContentPresenter Content="{Binding}" Margin="6,0,0,0"
                                           ContentTemplate="{StaticResource MiniEreignisIconVorlage}" />
                    </StackPanel>
                    <Grid Grid.Column="1" HorizontalAlignment="Center">
                        <Border CornerRadius="999" Padding="5,2" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Visibility="{Binding IstTor, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding Minute}" FontSize="9" FontFamily="Consolas" Opacity="0.6" />
                        </Border>
                        <Border CornerRadius="999" Padding="5,2" BorderThickness="1"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{Binding IstTor, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Minute}" FontSize="9" FontFamily="Consolas"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left"
                                Visibility="{Binding IstHeimSeite, Converter={StaticResource InverseBoolToVisibility}}">
                        <ContentPresenter Content="{Binding}" Margin="0,0,6,0"
                                           ContentTemplate="{StaticResource MiniEreignisIconVorlage}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Art}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6" HorizontalAlignment="Left"
                                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Abschnittstrenner mit Linie (HALBZEIT etc.) -->
                <Grid Margin="0,8" Visibility="{Binding ZeigtAlsAbschnittMitLinie, Converter={StaticResource BoolToVisibility}}">
                    <Border VerticalAlignment="Center" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Border HorizontalAlignment="Center" CornerRadius="999" Padding="8,2" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding IstElfmeterTrenner, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding TrennerText}" Opacity="0.6" Style="{StaticResource MiniTrennerPillText}" />
                    </Border>
                    <Border HorizontalAlignment="Center" CornerRadius="999" Padding="8,2" BorderThickness="1"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            Visibility="{Binding IstElfmeterTrenner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding TrennerText}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Style="{StaticResource MiniTrennerPillText}" />
                    </Border>
                </Grid>

                <!-- Eigenständige Marke ohne Linie (Anpfiff/Abpfiff) -->
                <Grid Margin="0,4" Visibility="{Binding ZeigtAlsEigenstaendigeMarke, Converter={StaticResource BoolToVisibility}}">
                    <Border HorizontalAlignment="Center" CornerRadius="999" Padding="8,2"
                            Background="{ThemeResource TextFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding TrennerText}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   Style="{StaticResource MiniTrennerPillText}" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Kopf einer Hinspiel-/Rückspiel-Karte (Expander.Header), Issue #341: derselbe Spielkopf wie in der
             Spielbericht-Karte (kicker-Vorbild) plus kompakter Zeitstrahl — alles aus einem SpielBeinAnsicht-
             Objekt, damit der Header über Header/HeaderTemplate gebunden bleibt (ein ContentPresenter mit
             Content-Binding im UIElement-Header zeigte nach neuer Simulation veraltete bzw. leere Kopfzeilen). -->
        <DataTemplate x:Key="BeinKopfVorlage" x:DataType="vm:SpielBeinAnsicht">
            <StackPanel Padding="4,10,4,4">
                <views:SpielKopfControl DataContext="{Binding Kopf}" />
                <views:SpielZeitstrahlControl Margin="0,12,0,2"
                                              Ereignisse="{Binding Ereignisse}"
                                              HeimKuerzel="{Binding Kopf.HeimKuerzel}"
                                              AuswaertsKuerzel="{Binding Kopf.AuswaertsKuerzel}"
                                              IconVorlage="{StaticResource MiniEreignisIconVorlage}"
                                              Visibility="{Binding HatEreignisse, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Sidebar-Breite 347 = 260 * 4/3 (ein Drittel breiter, Nutzer-Vorgabe #248-Feinschliff) -->
    <Grid ColumnDefinitions="347,1,*">

        <!-- ── Linke Spalte: Team-Auswahl ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Margin="14,12" Spacing="0">

                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,10">
                    <ProgressRing IsActive="{Binding IstLadend}" Width="16" Height="16" />
                    <TextBlock Text="Simuliert …" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="HEIMTEAM" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,4,0,4" />
                <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" AutomationProperties.AutomationId="Einzelspiel.HeimSuche" Text="{Binding HeimSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍  Suche…" FontSize="12" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                              SelectedItem="{Binding HeimVerbandFilter, Mode=TwoWay}"
                              DisplayMemberPath="Anzeige" FontSize="12" HorizontalAlignment="Stretch" />
                </Grid>
                <ComboBox ItemsSource="{Binding HeimMannschaftenGefiltert}" AutomationProperties.AutomationId="Einzelspiel.Heim"
                          SelectedItem="{Binding EinzelspielHeim, Mode=TwoWay}"
                          ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                          FontSize="13" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                <TextBlock Text="AUSWÄRTSTEAM" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,4" />
                <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" AutomationProperties.AutomationId="Einzelspiel.AuswaertsSuche" Text="{Binding AuswaertsSuchbegriff, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍  Suche…" FontSize="12" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding VerbandFilterOptionen}"
                              SelectedItem="{Binding AuswaertsVerbandFilter, Mode=TwoWay}"
                              DisplayMemberPath="Anzeige" FontSize="12" HorizontalAlignment="Stretch" />
                </Grid>
                <ComboBox ItemsSource="{Binding AuswaertsMannschaftenGefiltert}" AutomationProperties.AutomationId="Einzelspiel.Auswaerts"
                          SelectedItem="{Binding EinzelspielAuswaerts, Mode=TwoWay}"
                          ItemTemplate="{StaticResource MannschaftMitWappenTemplate}"
                          FontSize="13" HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                <TextBlock Text="REGELWERK (OPTIONAL)" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding AlleRegelwerke}" AutomationProperties.AutomationId="Einzelspiel.Regelwerk"
                          SelectedItem="{Binding EinzelspielRegelwerk, Mode=TwoWay}"
                          DisplayMemberPath="Name" FontSize="13" HorizontalAlignment="Stretch" />
                <TextBlock Text="Leer = kein Tiebreaker" FontSize="10" Opacity="0.6" Margin="0,2,0,0" />

                <CheckBox Content="Mit Rückspiel" AutomationProperties.AutomationId="Einzelspiel.MitRueckspiel" IsChecked="{Binding EinzelspielMitRueckspiel, Mode=TwoWay}"
                          FontSize="13" Margin="0,14,0,0" />

                <!-- #248: manuelle Hinspiel-Eingabe — dauerhaft sichtbar (nicht nur vor der ersten
                     Simulation!) und mit dem jeweils aktuellen Ergebnis vorausgefüllt, sonst gäbe es
                     nach dem Simulieren keine Korrekturmöglichkeit mehr. "Hinspiel simulieren" steht
                     nur oben im Ribbon, nicht nochmal hier als Button. -->
                <StackPanel Visibility="{Binding EinzelspielMitRueckspiel, Converter={StaticResource BoolToVisibility}}">
                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,14,0,14" />
                    <TextBlock Text="HINSPIEL-ERGEBNIS" FontSize="10" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,10" />
                    <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,10">
                        <NumberBox Grid.Column="0" AutomationProperties.AutomationId="Einzelspiel.HinspielHeimTore" Header="{Binding EinzelspielHeim.Name}"
                                   Value="{Binding HinspielHeimToreEingabe, Mode=TwoWay}"
                                   Minimum="0" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="2" AutomationProperties.AutomationId="Einzelspiel.HinspielAuswaertsTore" Header="{Binding EinzelspielAuswaerts.Name}"
                                   Value="{Binding HinspielAuswaertsToreEingabe, Mode=TwoWay}"
                                   Minimum="0" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Button Content="Übernehmen" AutomationProperties.AutomationId="Einzelspiel.HinspielUebernehmen" Command="{Binding HinspielUebernehmenBefehl}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

        <!-- ── Rechte Spalte: Protokoll-Anzeige ── -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">

            <Border Grid.Row="0" Padding="16,10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SPIELPROTOKOLL" FontSize="11" FontWeight="Bold" Opacity="0.6" />
                    <TextBlock Text=" · " FontSize="11" FontWeight="Bold" Opacity="0.6"
                               Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding ProtokollSpielInfo}" FontSize="11" FontWeight="Bold"
                               Visibility="{Binding ProtokollSpielInfo, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="4" Padding="10,7" Margin="16,10,16,0"
                    Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Fehlermeldung}" AutomationProperties.AutomationId="Einzelspiel.Fehlermeldung" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- Ohne Rückspiel: unverändert die vereinheitlichte Spielbericht-Karte. -->
            <views:SpielberichtControl Grid.Row="2" Margin="16,12,16,16"
                Visibility="{Binding EinzelspielMitRueckspiel, Converter={StaticResource InverseBoolToVisibility}}"
                LeerZustandText="Zwei Mannschaften auswählen und auf Simulieren klicken." />

            <!-- Mit Rückspiel (#248): zwei aufklappbare Karten statt einer kombinierten Zeitleiste. -->
            <Grid Grid.Row="2" Visibility="{Binding EinzelspielMitRueckspiel, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="Hinspiel oben simulieren oder Score eintippen und übernehmen."
                           Visibility="{Binding ZeigeHinRueckLeerZustand, Converter={StaticResource BoolToVisibility}}"
                           Opacity="0.5" FontSize="13" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="340" TextAlignment="Center" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HatHinspielErgebnis, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="16,12,16,16" Spacing="10">

                        <Expander AutomationProperties.AutomationId="Einzelspiel.Hinspiel"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsExpanded="{Binding HinspielOffen, Mode=TwoWay}"
                                  Header="{Binding HinspielAnsicht}" HeaderTemplate="{StaticResource BeinKopfVorlage}">
                            <StackPanel Visibility="{Binding HatHinspielEreignisse, Converter={StaticResource BoolToVisibility}}"
                                        Margin="8,4">
                                <ItemsControl ItemsSource="{Binding HinspielEreignisse}"
                                              ItemTemplate="{StaticResource MiniZeitleisteZeileVorlage}" />
                            </StackPanel>
                        </Expander>

                        <Border Visibility="{Binding HatRueckspielErgebnis, Converter={StaticResource InverseBoolToVisibility}}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="14,11">
                            <TextBlock Text="Rückspiel steht noch aus — oben „Rückspiel simulieren“ klicken."
                                       Opacity="0.5" FontSize="13" />
                        </Border>

                        <Expander AutomationProperties.AutomationId="Einzelspiel.Rueckspiel"
                                  Visibility="{Binding HatRueckspielErgebnis, Converter={StaticResource BoolToVisibility}}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsExpanded="{Binding RueckspielOffen, Mode=TwoWay}"
                                  Header="{Binding RueckspielAnsicht}" HeaderTemplate="{StaticResource BeinKopfVorlage}">
                            <StackPanel Visibility="{Binding HatRueckspielEreignisse, Converter={StaticResource BoolToVisibility}}"
                                        Margin="8,4">
                                <ItemsControl ItemsSource="{Binding RueckspielEreignisse}"
                                              ItemTemplate="{StaticResource MiniZeitleisteZeileVorlage}" />
                            </StackPanel>
                        </Expander>

                        <!-- Gesamtergebnis, Issue #341: derselbe Spielkopf wie in den Karten darüber (Kontext
                             "Gesamt", Zusatz wie "Ergebnis nach Hinspiel"/"nach Elfmeterschießen (3:4)" unter dem
                             Summenergebnis) — schon nach dem Hinspiel sichtbar. -->
                        <Border Visibility="{Binding GesamtKopf, Converter={StaticResource NullToCollapsed}}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="20,14,52,14">
                            <views:SpielKopfControl AutomationProperties.AutomationId="Einzelspiel.Gesamt" DataContext="{Binding GesamtKopf}" />
                        </Border>

                        <Border Visibility="{Binding SiegerText, Converter={StaticResource NullToCollapsed}}"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" HorizontalAlignment="Center">
                            <TextBlock AutomationProperties.AutomationId="Einzelspiel.Sieger"
                                       FontSize="13" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}">
                                <Run Text="{Binding SiegerText}" />
                            </TextBlock>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>
</UserControl>
