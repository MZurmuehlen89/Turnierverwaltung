<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.VorlagenPaarungenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- Sperre, solange keine (gespeicherte) Vorlage gewählt ist -->
        <StackPanel Visibility="{Binding HatVorlage, Converter={StaticResource InverseBoolToVisibility}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="Bitte zuerst die Vorlage im Turnierkopf speichern" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding HatVorlage, Converter={StaticResource BoolToVisibility}}"
              ColumnDefinitions="260,1,2.4*,1,1*">

            <!-- ── Spalte 0: Runden mit fest vorgegebener Paarung ── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="RUNDEN MIT FESTER PAARUNG" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="12,12,12,8" />
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                             Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />
                <ListView Grid.Row="2"
                          ItemsSource="{Binding PaarungsRunden}"
                          SelectedItem="{Binding AusgewaehlteRunde, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Padding="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2"
                            Visibility="{Binding KeinePaarungsrundenVorhanden, Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" Opacity="0.5">
                    <TextBlock Text="Keine Runde ist als 'Paarung fest vorgegeben' markiert." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Im Tab 'Runden' aktivierbar (ab der zweiten Runde)." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- ── Spalte 2: Verfügbare Platzhalter (Drag-Quelle) + Slots der ausgewählten Runde (Drop-Ziel) ──
                 Layout/Interaktion orientiert an WPF-Original PaarungsfestlegungView: Drag&Drop aus "Verfügbar",
                 Klick wählt einen Slot fürs Formular (Spalte 4), Rechtsklick auf besetzten Slot entfernt ihn. -->
            <Grid Grid.Column="2">
                <StackPanel Visibility="{Binding FormularSichtbar, Converter={StaticResource InverseBoolToVisibility}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Runde links auswählen" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <Grid Visibility="{Binding FormularSichtbar, Converter={StaticResource BoolToVisibility}}"
                      ColumnDefinitions="200,12,*" Margin="12,20,12,12" RowDefinitions="Auto,*">

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Ziehen aus &quot;Verfügbar&quot; auf einen Slot. Rechtsklick auf einen besetzten Slot entfernt ihn."
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <!-- Verfügbare Platzhalter (Drag-Quelle) -->
                    <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="VERFÜGBAR" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,8" />
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding VerfuegbarePlatzhalterPool}"
                                  CanDragItems="True" CanReorderItems="False"
                                  DragItemsStarting="VerfuegbarListView_DragItemsStarting"
                                  DoubleTapped="VerfuegbarListView_DoubleTapped"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Padding="0,4" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- KO-Modus: paarweise Anzeige (Heim vs. Auswärts) -->
                    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IstKoModus, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding KoPaare}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                                            Padding="10,7" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="28,*,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding PaarungsNummer}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" DataContext="{Binding HeimSlot}"
                                                    Background="Transparent"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="8,6"
                                                    AllowDrop="True"
                                                    Drop="Slot_Drop" DragOver="Slot_DragOver" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave"
                                                    Tapped="Slot_Tapped" RightTapped="Slot_RightTapped">
                                                <TextBlock Text="{Binding AnzeigeText}" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text=" vs " FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="6,0" />
                                            <Border Grid.Column="3" DataContext="{Binding AuswaertsSlot}"
                                                    Background="Transparent"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="3" Padding="8,6"
                                                    AllowDrop="True"
                                                    Drop="Slot_Drop" DragOver="Slot_DragOver" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave"
                                                    Tapped="Slot_Tapped" RightTapped="Slot_RightTapped">
                                                <TextBlock Text="{Binding AnzeigeText}" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Gruppenphase/Liga/SchweizerSystem-Modus: gruppierte Anzeige -->
                    <ScrollViewer Grid.Row="1" Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IstGruppenModus, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding PaarungsGruppen}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180" Margin="0,0,10,10" VerticalAlignment="Top"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,6" CornerRadius="4,4,0,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                                                Padding="10,6" MinHeight="32"
                                                                AllowDrop="True"
                                                                Drop="Slot_Drop" DragOver="Slot_DragOver" DragEnter="Slot_DragEnter" DragLeave="Slot_DragLeave"
                                                                Tapped="Slot_Tapped" RightTapped="Slot_RightTapped">
                                                            <TextBlock Text="{Binding AnzeigeText}" FontSize="12" TextWrapping="Wrap" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- ── Spalte 4: Zuweisungsformular (Klick-Alternative zu Drag&Drop) + Meldungen ── -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*">

                <StackPanel Grid.Row="0" Margin="20" Visibility="{Binding SlotFormularSichtbar, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="ZUWEISUNG" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding AusgewaehlterSlot.Label}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Platzhalter" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding AuswaehlbarePlatzhalter}"
                              SelectedItem="{Binding FormularPlatzhalter, Mode=TwoWay}"
                              PlaceholderText="— nicht zugewiesen —"
                              HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                    <Button Content="Zuweisung entfernen" Command="{Binding ZuweisungEntfernenCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,20,12,12" Spacing="6">
                        <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4" Padding="8,6">
                            <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding RundenFehler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
