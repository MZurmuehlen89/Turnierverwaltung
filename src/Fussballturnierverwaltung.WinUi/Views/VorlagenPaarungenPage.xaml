<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.VorlagenPaarungenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- Sperre, solange keine (gespeicherte) Vorlage gewählt ist -->
        <StackPanel Visibility="{Binding HatVorlage, Converter={StaticResource InverseBoolToVisibility}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock Text="Bitte zuerst die Vorlage im Turnierkopf speichern" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <Grid Visibility="{Binding HatVorlage, Converter={StaticResource BoolToVisibility}}"
              ColumnDefinitions="260,1,2*,1,1.4*">

            <!-- ── Spalte 0: Runden mit fest vorgegebener Paarung ── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="RUNDEN MIT FESTER PAARUNG" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="12,12,12,8" />
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2"
                             Visibility="{Binding IstLadend, Converter={StaticResource BoolToVisibility}}" />
                <ListView Grid.Row="2"
                          ItemsSource="{Binding PaarungsRunden}"
                          SelectedItem="{Binding AusgewaehlteRunde, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Padding="0,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2"
                            Visibility="{Binding KeinePaarungsrundenVorhanden, Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" Opacity="0.5">
                    <TextBlock Text="Keine Runde ist als 'Paarung fest vorgegeben' markiert." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Im Tab 'Runden' aktivierbar (ab der zweiten Runde)." FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- ── Spalte 2: Slots der ausgewählten Runde ── -->
            <Grid Grid.Column="2">
                <StackPanel Visibility="{Binding FormularSichtbar, Converter={StaticResource InverseBoolToVisibility}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="Runde links auswählen" FontSize="14" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

                <ListView Visibility="{Binding FormularSichtbar, Converter={StaticResource BoolToVisibility}}"
                          ItemsSource="{Binding Slots}"
                          SelectedItem="{Binding AusgewaehlterSlot, Mode=TwoWay}"
                          SelectionMode="Single" Margin="12,20,12,12">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding AnzeigeText}" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Rectangle Grid.Column="3" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" />

            <!-- ── Spalte 4: Zuweisungsformular + Meldungen ── -->
            <Grid Grid.Column="4" RowDefinitions="Auto,*">

                <StackPanel Grid.Row="0" Margin="20" Visibility="{Binding SlotFormularSichtbar, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="ZUWEISUNG" FontWeight="SemiBold" FontSize="11" Opacity="0.6" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding AusgewaehlterSlot.Label}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="Platzhalter" FontSize="12" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding AuswaehlbarePlatzhalter}"
                              SelectedItem="{Binding FormularPlatzhalter, Mode=TwoWay}"
                              PlaceholderText="— nicht zugewiesen —"
                              HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                    <Button Content="Zuweisung entfernen" Command="{Binding ZuweisungEntfernenCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,20,12,12" Spacing="6">
                        <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4" Padding="8,6">
                            <TextBlock Text="{Binding Fehlermeldung}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="11" TextWrapping="Wrap" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding RundenFehler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                            CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
