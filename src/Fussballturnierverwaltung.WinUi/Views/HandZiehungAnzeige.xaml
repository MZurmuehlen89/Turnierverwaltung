<?xml version="1.0" encoding="utf-8" ?>
<!-- Ziehung von Hand (#482): Ansage, Lostöpfe und Gruppen bzw. Paarungen, optisch an die Gesamtübersicht der
     TV-Ziehung angelehnt. Anklickbar (Akzentrahmen) ist nur, was der aktuelle Schritt anbietet; Gesperrtes ist
     ausgegraut, der Grund steht im Tooltip. KlickFlaeche statt Button (#428): ein WM-Feld hat rund 100 Elemente. -->
<UserControl
    x:Class="Fussballturnierverwaltung.WinUi.Views.HandZiehungAnzeige"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fussballturnierverwaltung.WinUi.Views">

    <UserControl.Resources>
        <SolidColorBrush x:Key="WaehlbarBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />

        <DataTemplate x:Key="HandZiehungPaarungTemplate">
            <Grid Height="26" Margin="0,0,0,4" CornerRadius="3">
                <Border Background="{StaticResource WaehlbarBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="3"
                        Visibility="{Binding IstOffen, Converter={StaticResource BoolToVisibility}}" />
                <Grid ColumnDefinitions="24,20,8,*,40,20,8,*" Margin="4,0">
                    <TextBlock Grid.Column="0" Text="{Binding PaarungsNr}" Opacity="0.5" VerticalAlignment="Center" />
                    <Image Grid.Column="1" Source="{Binding HeimWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                           Visibility="{Binding HeimWappen, Converter={StaticResource NullToCollapsed}}"
                           Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding HeimName}" Opacity="{Binding HeimOpacity}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="vs." Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IstFreilos, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Image Grid.Column="5" Source="{Binding AuswaertsWappen, Converter={StaticResource BildDatenZuBildquelle}}"
                           Visibility="{Binding AuswaertsWappen, Converter={StaticResource NullToCollapsed}}"
                           Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="{Binding AuswaertsName}" Opacity="{Binding AuswaertsOpacity}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Ansage des Moderators -->
        <Border Background="#0F172A" CornerRadius="6" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="ZIEHUNG VON HAND" FontSize="11" FontWeight="Bold" Foreground="#FBBF24"
                               HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding FortschrittText}" FontSize="11" Foreground="White" Opacity="0.7"
                               AutomationProperties.AutomationId="HandZiehung.Fortschritt"
                               HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding Ansage}" FontSize="18" FontWeight="SemiBold" Foreground="White"
                           AutomationProperties.AutomationId="HandZiehung.Ansage"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,4" />
            </StackPanel>
        </Border>

        <Border Visibility="{Binding Fehler, Converter={StaticResource NullToCollapsed}}"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,16">
            <TextBlock Text="{Binding Fehler}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Lostöpfe: gezogene Teams bleiben stehen und werden ausgegraut -->
        <TextBlock Text="LOSTÖPFE" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Toepfe}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:GleichmaessigesRasterPanel MaxSpalten="6" MinSpaltenBreite="170" MaxSpaltenBreite="240" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8,4" CornerRadius="4,4,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Teams}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:KlickFlaeche ColumnDefinitions="16,6,*" Height="24" Padding="4,0" Margin="0,0,0,2"
                                                            CornerRadius="3" BorderThickness="1"
                                                            Opacity="{Binding GezogenOpacity}"
                                                            IstHervorgehoben="{Binding Wahl.IstWaehlbar}"
                                                            HervorhebungHintergrund="{StaticResource WaehlbarBrush}"
                                                            HervorhebungRahmen="{ThemeResource AccentFillColorDefaultBrush}"
                                                            ToolTipService.ToolTip="{Binding Wahl.SperrGrund}"
                                                            Ausgeloest="Team_Ausgeloest"
                                                            AutomationProperties.AutomationId="HandZiehung.Team"
                                                            AutomationProperties.Name="{Binding Name}">
                                            <Image Grid.Column="0" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                   Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                   Opacity="{Binding Wahl.Opacity}"
                                                   Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                                       Opacity="{Binding Wahl.Opacity}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name}" /><Run Text=" " /><Run Text="{Binding Platzhalter}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </TextBlock>
                                        </local:KlickFlaeche>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Gruppen (Liga/Schweizer System: eine Teilnehmerliste mit Schlüsselzahlen) -->
        <StackPanel Visibility="{Binding ZeigeGruppen, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="GRUPPEN" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Gruppen}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:GleichmaessigesRasterPanel MaxSpalten="6" MinSpaltenBreite="170" MaxSpaltenBreite="260" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <local:KlickFlaeche CornerRadius="4" BorderThickness="1"
                                                IstHervorgehoben="{Binding Wahl.IstWaehlbar}"
                                                HervorhebungHintergrund="{StaticResource WaehlbarBrush}"
                                                HervorhebungRahmen="{ThemeResource AccentFillColorDefaultBrush}"
                                                ToolTipService.ToolTip="{Binding Wahl.SperrGrund}"
                                                Ausgeloest="Gruppe_Ausgeloest"
                                                AutomationProperties.AutomationId="HandZiehung.Gruppe"
                                                AutomationProperties.Name="{Binding Name}">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4"
                                        Opacity="{Binding Wahl.Opacity}">
                                    <StackPanel>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,5" CornerRadius="4,4,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Plaetze}" Margin="6,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <local:KlickFlaeche ColumnDefinitions="22,18,6,*" Height="26" Padding="4,0"
                                                                        CornerRadius="3" BorderThickness="1"
                                                                        IstHervorgehoben="{Binding Wahl.IstWaehlbar}"
                                                                        HervorhebungHintergrund="{StaticResource WaehlbarBrush}"
                                                                        HervorhebungRahmen="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        ToolTipService.ToolTip="{Binding Wahl.SperrGrund}"
                                                                        Ausgeloest="Platz_Ausgeloest"
                                                                        AutomationProperties.AutomationId="HandZiehung.Platz"
                                                                        AutomationProperties.Name="{Binding Position}">
                                                        <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center" Opacity="0.6">
                                                            <Run Text="{Binding Position}" /><Run Text="." />
                                                        </TextBlock>
                                                        <Image Grid.Column="1" Source="{Binding Wappen, Converter={StaticResource BildDatenZuBildquelle}}"
                                                               Visibility="{Binding Wappen, Converter={StaticResource NullToCollapsed}}"
                                                               Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Anzeige}" FontSize="13" VerticalAlignment="Center"
                                                                   Opacity="{Binding BefuelltOpacity}" TextTrimming="CharacterEllipsis" />
                                                    </local:KlickFlaeche>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </local:KlickFlaeche>
                            <!-- Beim Positions-Zug: die Gruppe, in die das gezogene Team kommt -->
                            <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="4"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding IstZiel, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- K.-o.-Runde: Paarungen spaltenweise wie im Ergebnis (#407) -->
        <StackPanel Visibility="{Binding IstPaarungsmodus, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="PAARUNGEN" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="0,0,0,8" />
            <local:PaarungsSpaltenControl Paarungen="{Binding Paarungen}"
                                          ZeilenJeSpalte="16"
                                          PaarungTemplate="{StaticResource HandZiehungPaarungTemplate}" />
        </StackPanel>
    </StackPanel>
</UserControl>
