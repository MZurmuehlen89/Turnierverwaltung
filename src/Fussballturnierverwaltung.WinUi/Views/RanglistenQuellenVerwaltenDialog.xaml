<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Fussballturnierverwaltung.WinUi.Views.RanglistenQuellenVerwaltenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ranglisten-Quellen verwalten"
    CloseButtonText="Schließen"
    DefaultButton="Close">

    <!-- Standard-ContentDialog-Theme begrenzt Breite/Höhe auf klein (ContentDialogMaxWidth ≈ 548) —
         ohne diese Überschreibung wird der Inhalt abgeschnitten statt den Dialog zu vergrößern
         (analoger Fund zu RanglistenImportDialog, #285-Test). -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
    </ContentDialog.Resources>

    <Grid Width="900" Height="620" RowDefinitions="Auto,*">

        <!-- Aktionen für die im rechten Bereich ausgewählte/bearbeitete Quelle, analog zum Ribbon der
             Fach-Views (IRibbonAware): Auswahl in der Liste öffnet das Formular direkt, ein eigener
             "Bearbeiten…"-Button wäre redundant. -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,8">
            <AppBarButton Icon="Add" Label="Neu" Command="{Binding NeuCommand}" />
            <AppBarButton Icon="Save" Label="Speichern" Command="{Binding SpeichernCommand}" />
            <AppBarButton Icon="Undo" Label="Abbrechen" Command="{Binding FormularAbbrechenCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="Delete" Label="Löschen" Command="{Binding LoeschenCommand}" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnDefinitions="1*,1,1*">

            <!-- ── Linke Spalte: Liste ── -->
            <ListView Grid.Column="0"
                      ItemsSource="{Binding Quellen}"
                      SelectedItem="{Binding Ausgewaehlte, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Rectangle Grid.Column="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" Margin="8,0" />

            <!-- ── Rechte Spalte: Formular ── -->
            <Grid Grid.Column="2">

                <StackPanel Visibility="{Binding FormularAktiv, Converter={StaticResource InverseBoolToVisibility}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4">
                    <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center" />
                    <TextBlock Text="Quelle auswählen oder „Neu“" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <ScrollViewer Visibility="{Binding FormularAktiv, Converter={StaticResource BoolToVisibility}}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="4">

                        <TextBlock Text="Name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Text="URL" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="Webseite prüfen" Command="{Binding WebseitePruefenCommand}" />
                        </Grid>
                        <TextBlock Text="Ohne URL ist die Quelle von Hand gepflegt (etwa eine Ligapyramide): Sie wird nicht importiert, ihre Ranglisten ordnest du im Ranglisten-Editor zu."
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

                        <TextBlock Text="Seite wird geladen…" Opacity="0.6" Margin="0,4,0,0"
                                   Visibility="{Binding IstPruefend, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding TabellenGefunden, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="1. Tabelle auswählen" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListView ItemsSource="{Binding TabellenOptionen}"
                                      SelectedItem="{Binding AusgewaehlteTabelle, Mode=TwoWay}"
                                      DisplayMemberPath="Beschreibung" Height="130" SelectionMode="Single" />
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding AusgewaehlteTabelle, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Text="2. Spalten zuordnen" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Team-/Landname-Spalte" Margin="0,0,0,4" />
                                    <ListView ItemsSource="{Binding MannschaftSpaltenOptionen}"
                                              SelectedItem="{Binding AusgewaehlteMannschaftSpalte, Mode=TwoWay}"
                                              DisplayMemberPath="Beschreibung" Height="120" SelectionMode="Single" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Punkte-Spalte (optional)" Margin="0,0,0,4" />
                                    <ListView ItemsSource="{Binding PunkteSpaltenOptionen}"
                                              SelectedItem="{Binding AusgewaehltePunkteSpalte, Mode=TwoWay}"
                                              DisplayMemberPath="Beschreibung" Height="120" SelectionMode="Single" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Erste Zeile ist Kopfzeile (überspringen)"
                                      IsChecked="{Binding KopfzeileUeberspringen, Mode=TwoWay}" Margin="0,10,0,0" />
                        </StackPanel>

                        <Border Visibility="{Binding Fehlermeldung, Converter={StaticResource NullToCollapsed}}"
                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Fehlermeldung}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
