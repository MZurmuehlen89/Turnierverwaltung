{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/Vorfilter.sh\" 'git.*(commit|push)' Commit-Pruefung.ps1 Push-Pruefung.ps1",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/Vorfilter.sh\" 'migrations[[:space:]]+add' Migration-Anwenden-Hinweis.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
